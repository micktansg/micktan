---
interface Props {
  title: string;
  date?: Date;
}

const { title, date } = Astro.props;
const dateStr = date
  ? date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<article class="room">
  <nav class="back-nav">
    <a href="/room/">&larr; the room</a>
  </nav>

  <header>
    <h1>{title}</h1>
    {dateStr && <p class="date">{dateStr}</p>}
  </header>

  <div class="prose">
    <slot />
  </div>
</article>

<style>
  .room {
    max-width: 38rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    font-family: 'Lora', Georgia, serif;
    line-height: 1.65;
    color: #f0ece4;
  }

  .back-nav { margin-bottom: 4rem; font-size: 0.9rem; opacity: 0.4; transition: opacity 200ms; }
  .back-nav:hover { opacity: 0.8; }
  .back-nav a { color: inherit; text-decoration: none; }

  header { margin-bottom: 3rem; }
  header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1.2;
  }

  .date { margin-top: 1rem; font-size: 0.85rem; opacity: 0.45; font-style: italic; }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre) { margin-bottom: 1.4em; }

  .prose :global(h2) { font-size: 1.4rem; font-weight: 500; margin-top: 2.5em; margin-bottom: 1em; }
  .prose :global(h3) { font-size: 1.15rem; font-weight: 500; margin-top: 2em; margin-bottom: 0.8em; }

  .prose :global(a) { color: #f4a563; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose :global(a:hover) { color: #ffd9a0; }

  .prose :global(blockquote) {
    border-left: 2px solid rgba(244, 165, 99, 0.5);
    padding-left: 1.2rem;
    margin-left: 0;
    font-style: italic;
    opacity: 0.85;
  }

  .prose :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.9em;
    background: rgba(240, 236, 228, 0.08);
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }

  .prose :global(pre) {
    background: #1a1a18;
    padding: 1.2rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.9rem;
  }

  .prose :global(pre code) { background: transparent; padding: 0; }

  .prose :global(img),
  .prose :global(video) { max-width: 100%; height: auto; border-radius: 4px; margin: 1.5rem 0; }

  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.5rem; }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(240, 236, 228, 0.15);
    margin: 3rem 0;
  }
</style>
