---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
  ogImage?: string;
  ogAlt?: string;
}

const {
  title = 'Mick Tan',
  description = 'a room of interactive objects by mick tan. mostly buggy stuff.',
  themeColor = '#2a2a27',
  ogImage = '/og.png',
  ogAlt = 'A dark field with a cream lens revealing the word Observing.',
} = Astro.props;

const SITE = 'https://micktan.com';
const canonicalUrl = SITE + Astro.url.pathname;
const ogImageUrl = SITE + ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mick Tan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <slot />
    {/* Site-wide exit veil: any <a data-veil-exit[="#color"]> fades this over
        the page before navigating — the symmetric twin of the hall's ink
        flood. Rooms opt in by adding the attribute to their back links. */}
    <div class="site-exit-veil" id="siteExitVeil" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #2a2a27;
    --ink: #f0ece4;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { background: var(--paper); color: var(--ink); font-family: 'Lora', Georgia, serif; min-height: 100vh; }
  ::selection { background: #ebe9e0; color: #1a1812; }

  .site-exit-veil {
    position: fixed;
    inset: 0;
    background: var(--veil-c, #f0ece4);
    opacity: 0;
    pointer-events: none;
    z-index: 9999;
    transition: opacity 420ms cubic-bezier(.4, 0, .2, 1);
  }
  .site-exit-veil.active { opacity: 1; pointer-events: auto; }

  @media (prefers-reduced-motion: reduce) {
    .site-exit-veil { transition: opacity 160ms linear; }
  }
</style>

<script>
  // Exit-veil utility. Lives in the Layout so every page shares one
  // implementation; pages opt links in with data-veil-exit.
  let veilExitAbort: AbortController | null = null;

  const initVeilExit = () => {
    veilExitAbort?.abort();
    veilExitAbort = new AbortController();
    const { signal } = veilExitAbort;

    const veil = document.getElementById('siteExitVeil');
    if (!veil) return;
    veil.classList.remove('active');

    // bfcache restores come back with the veil still up.
    window.addEventListener('pageshow', () => veil.classList.remove('active'), { signal });

    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement)?.closest?.('a[data-veil-exit]') as HTMLAnchorElement | null;
      if (!a) return;
      const me = e as MouseEvent;
      if (me.metaKey || me.ctrlKey || me.shiftKey || me.button === 1) return;
      e.preventDefault();
      veil.style.setProperty('--veil-c', a.dataset.veilExit || '#f0ece4');
      veil.classList.add('active');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => { window.location.href = a.href; }, reduce ? 180 : 440);
    }, { signal });
  };

  document.addEventListener('astro:page-load', initVeilExit);
</script>
