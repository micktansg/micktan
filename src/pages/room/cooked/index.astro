---
import Layout from '../../../layouts/Layout.astro';
import data from './songs.json';

const { songs, personas } = data;
---

<Layout
  title="cooked. — Mick Tan"
  description="a 90s big beat banger reviewer-guessing game"
  themeColor="#fdf3e6"
  ogImage="/og/cooked.png"
  ogAlt="cooked. — a vinyl record on a warm peach field. 90s big beat song reviews."
>
  <main class="cooked">
    <a class="back" href="/room/" data-astro-prefetch data-veil-exit>&larr; the room</a>

    <header class="head">
      <h1>cooked. <span class="emoji">🍳</span></h1>
      <p class="sub">90s big beat song reviews.</p>
      <p class="score" id="score" aria-live="polite">— / —</p>
    </header>

    <section class="picker" id="picker" aria-label="pick a song">
      <ol class="grid">
        {songs.map(s => (
          <li>
            <button class="card" data-song-id={s.id} type="button" aria-label={`play ${s.title} by ${s.artist}`}>
              <span class="cover" style={`background-image: url('${s.coverArt}')`}></span>
              <span class="meta">
                <span class="title">{s.title}</span>
                <span class="artist">{s.artist} · {s.year}</span>
              </span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <section class="play" id="play" hidden>
      <button class="back-to-picker" type="button" id="backToPicker">← back to the menu</button>

      <div class="player">
        <iframe
          id="ytFrame"
          width="100%"
          height="100%"
          src="about:blank"
          title="YouTube player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <h2 class="now-playing" id="nowPlaying"></h2>
      <p class="now-meta" id="nowMeta"></p>

      <article class="review" id="reviewBox">
        <p class="prompt">a review by <span class="who">an unnamed taster</span>:</p>
        <div class="review-body" id="reviewBody"></div>
      </article>

      <form class="guess" id="guessForm">
        <label for="guessInput">who wrote this sh!t? 👀</label>
        <input
          id="guessInput"
          name="guess"
          type="text"
          autocomplete="off"
          maxlength="80"
          placeholder="type your best guess…"
          required
        />
        <input type="text" name="hp" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <button type="submit" id="guessBtn">roast me</button>
      </form>

      <article class="result" id="result" hidden aria-live="polite">
        <p class="result-line" id="resultLine"></p>
        <p class="reply" id="replyBody"></p>
        <div class="result-actions">
          <button type="button" id="seeAll">see all 4 voices</button>
          <button type="button" id="nextVoice">another voice for this song</button>
          <button type="button" id="nextSong" class="primary">next song →</button>
        </div>
        <details class="all-voices" id="allVoices" hidden>
          <summary>the other 3 reviewers said:</summary>
          <div id="allVoicesBody"></div>
        </details>
      </article>
    </section>

    <section class="request" aria-label="request a song">
      <h3>request a song 🥹</h3>
      <p>didn't see your fav 90s banger? tell the chef. (one request per minute, please be a person.)</p>
      <form id="requestForm">
        <input id="reqSong" name="song" type="text" placeholder="song name *" aria-label="song name (required)" maxlength="100" required />
        <input id="reqArtist" name="artist" type="text" placeholder="artist (optional)" aria-label="artist (optional)" maxlength="100" />
        <input type="text" name="hp" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <button type="submit" id="reqBtn">submit</button>
      </form>
      <p class="req-status" id="reqStatus" aria-live="polite"></p>
    </section>

    <p class="next-room"><a href="/room/ssb/" data-veil-exit="#f7f7f8" data-astro-prefetch>next room — SSB calculator. &rarr;</a></p>
  </main>
</Layout>

<style>
  :root {
    --paper-cooked: #fdf3e6;
    --paper-cooked-2: #ffd9c2;
    --ink-cooked: #2a1a14;
    --ink-soft: rgba(42, 26, 20, 0.7);
    --accent-1: #ff5e7e;
    --accent-2: #ff9a3e;
    --accent-3: #6c63ff;
    --card-bg: #ffffff;
    --card-shadow: 0 4px 16px rgba(42, 26, 20, 0.08);
    --card-shadow-hover: 0 10px 30px rgba(255, 94, 126, 0.18);
  }

  html, body {
    background: var(--paper-cooked);
    color: var(--ink-cooked);
    font-family: 'Quicksand', system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow-x: hidden;
  }

  .cooked {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 8rem;
    background:
      radial-gradient(ellipse at top right, #ffe9d4 0%, transparent 60%),
      radial-gradient(ellipse at bottom left, #ffdde6 0%, transparent 55%),
      linear-gradient(180deg, var(--paper-cooked) 0%, var(--paper-cooked-2) 100%);
    min-height: 100vh;
    border-radius: 0;
  }

  .back {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 200ms;
    letter-spacing: 0.03em;
  }
  .back:hover { color: var(--accent-1); }

  .head { margin: 4rem 0 3rem; }
  .head h1 {
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }
  .head h1 .emoji { display: inline-block; transform: rotate(-12deg); }
  .head .sub {
    margin-top: 1rem;
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 32rem;
    line-height: 1.5;
  }
  .head .sub .nowrap { white-space: nowrap; }
  .head .score {
    margin-top: 1.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent-1);
    letter-spacing: 0.02em;
  }

  .picker { margin-bottom: 4rem; }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.2rem;
  }

  .card {
    width: 100%;
    border: none;
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    border-radius: 14px;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    text-align: left;
    transition: transform 240ms cubic-bezier(.2,.8,.2,1), box-shadow 240ms, scale 240ms;
    font-family: inherit;
    color: inherit;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--card-shadow-hover); }
  .card:active { transform: translateY(-1px) scale(0.99); }

  /* Keyboard focus, in the room's own voice. */
  .card:focus-visible,
  .guess button:focus-visible,
  .result-actions button:focus-visible,
  .request button:focus-visible,
  .back:focus-visible,
  .back-to-picker:focus-visible,
  .all-voices summary:focus-visible {
    outline: 3px solid var(--accent-3);
    outline-offset: 3px;
    border-radius: 6px;
  }
  .guess input[type="text"]:focus-visible,
  .request input[type="text"]:focus-visible {
    outline: none;
  }

  /* Safety: closed sections must never eat clicks, whatever display they carry. */
  [hidden] { display: none !important; }

  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-size: cover;
    background-position: center;
    background-color: #ffd9c2;
  }
  .meta {
    display: block;
    padding: 0.85rem 1rem 1rem;
  }
  .title {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink-cooked);
  }
  .artist {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .play { animation: fadeIn 320ms ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .back-to-picker {
    background: transparent;
    border: none;
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    min-height: 44px;
    padding: 0.4rem 0.4rem 0.4rem 0;
    margin-bottom: 1rem;
  }
  .back-to-picker:hover { color: var(--accent-1); }

  .player {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: var(--card-shadow);
  }
  .player iframe { width: 100%; height: 100%; border: 0; }

  .now-playing {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.4rem;
  }
  .now-meta {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0 0 2rem;
  }

  .review {
    background: var(--card-bg);
    border-radius: 14px;
    padding: 1.5rem 1.6rem;
    box-shadow: var(--card-shadow);
    margin-bottom: 1.6rem;
  }
  .review .prompt {
    color: var(--ink-soft);
    font-size: 0.85rem;
    margin: 0 0 1rem;
    letter-spacing: 0.01em;
  }
  .review .who {
    background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 700;
  }
  .review-body {
    font-size: 1rem;
    line-height: 1.65;
    white-space: pre-wrap;
  }

  .guess {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: 2rem;
  }
  .guess label {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .guess input[type="text"] {
    font: inherit;
    padding: 0.85rem 1rem;
    border: 2px solid rgba(42, 26, 20, 0.1);
    border-radius: 12px;
    background: var(--card-bg);
    color: inherit;
    font-size: 1rem;
    transition: border-color 200ms;
  }
  .guess input[type="text"]:focus {
    outline: none;
    border-color: var(--accent-1);
  }
  .guess .hp { display: none; }

  .guess button {
    align-self: start;
    background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
    color: #fff;
    border: none;
    min-height: 44px;
    padding: 0.85rem 2rem;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 200ms, box-shadow 200ms;
    box-shadow: 0 4px 16px rgba(255, 94, 126, 0.32);
  }
  .guess button:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(255, 94, 126, 0.42); }
  .guess button:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

  .result {
    background: var(--card-bg);
    border-radius: 14px;
    padding: 1.5rem 1.6rem;
    box-shadow: var(--card-shadow);
    animation: fadeIn 320ms ease-out;
  }
  .result-line {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
  }
  .result-line.correct { color: #2d8a4f; }
  .result-line.wrong { color: #d6446a; }
  .reply {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    font-style: italic;
    color: var(--ink-cooked);
  }
  .result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .result-actions button {
    background: transparent;
    border: 1.5px solid rgba(42, 26, 20, 0.2);
    min-height: 44px;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    color: inherit;
    transition: border-color 200ms, background 200ms, color 200ms;
  }
  .result-actions button:hover {
    border-color: var(--accent-1);
    background: var(--accent-1);
    color: #fff;
  }
  .result-actions button.primary {
    background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
    color: #fff;
    border-color: transparent;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(255, 94, 126, 0.28);
  }
  .result-actions button.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 94, 126, 0.36);
  }

  .all-voices {
    margin-top: 1.4rem;
    border-top: 1px dashed rgba(42, 26, 20, 0.15);
    padding-top: 1rem;
  }
  .all-voices summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent-3);
    font-size: 0.92rem;
    padding: 0.4rem 0;
    list-style: none;
  }
  .all-voices summary::marker { display: none; }
  .all-voices summary::-webkit-details-marker { display: none; }
  /* :global() because these blocks are injected at runtime by JS via
     document.createElement — they don't get Astro's scoping data attribute,
     so the default scoped selectors wouldn't match. */
  :global(#allVoicesBody .voice-block) {
    margin-top: 2rem;
    padding: 1.4rem 1.4rem 1.5rem;
    background: rgba(255, 217, 194, 0.32);
    border-radius: 12px;
    border-left: 3px solid #ff9a3e;
  }
  :global(#allVoicesBody .voice-block:first-child) { margin-top: 1.4rem; }
  :global(#allVoicesBody .voice-block + .voice-block) { margin-top: 2rem; }
  :global(#allVoicesBody .voice-block .voice-label) {
    font-size: 0.85rem;
    font-weight: 700;
    color: #6c63ff;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 0.8rem;
  }
  :global(#allVoicesBody .voice-block .voice-text) {
    white-space: pre-wrap;
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .request {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px dashed rgba(42, 26, 20, 0.15);
  }
  .request h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
  }
  .request p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0 0 1.4rem;
  }
  .request form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .request input[type="text"] {
    flex: 1;
    min-width: 200px;
    font: inherit;
    min-height: 44px;
    padding: 0.7rem 1rem;
    border: 2px solid rgba(42, 26, 20, 0.1);
    border-radius: 12px;
    background: var(--card-bg);
    color: inherit;
    font-size: 0.95rem;
    transition: border-color 200ms;
  }
  .request input[type="text"]:focus {
    outline: none;
    border-color: var(--accent-3);
  }
  .request .hp { display: none; }
  .request button {
    background: var(--accent-3);
    color: #fff;
    border: none;
    min-height: 44px;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: transform 200ms;
  }
  .request button:hover { transform: translateY(-2px); }
  .request button:disabled { opacity: 0.55; cursor: not-allowed; }
  .req-status {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    min-height: 1.2em;
  }
  .req-status.ok { color: #2d8a4f; }
  .req-status.err { color: var(--accent-1); }

  .next-room {
    margin-top: 3.5rem;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .next-room a { color: var(--ink-soft); text-decoration: none; padding: 0.6rem; display: inline-block; }
  .next-room a:hover { color: var(--accent-1); }
  .next-room a:focus-visible { outline: 3px solid var(--accent-3); outline-offset: 3px; border-radius: 6px; }

  @media (max-width: 600px) {
    .cooked { padding: 2rem 1rem 6rem; }
    .head { margin: 2rem 0 2rem; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }
    .meta { padding: 0.7rem 0.8rem; }
    .title { font-size: 0.95rem; }
    .artist { font-size: 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .play, .result { animation: none; }
    .card { transition: none; }
  }
</style>

<script type="application/json" id="cookedData" is:inline set:html={JSON.stringify({ songs, personas })}></script>

<script>
  // Lifecycle: this room originally ran its script once at parse time, so
  // arriving via ClientRouter SPA navigation left every control dead.
  // Standard site pattern now: init on astro:page-load, AbortController
  // cleans listeners between navigations, pageshow recovers bfcache restores.
  type Song = { id: string; title: string; artist: string; year: number; coverArt: string; youtubeId: string; reviews: Record<string, string> };
  type Persona = { label: string; icon: string };

  let cookedAbort: AbortController | null = null;

  const initCooked = () => {
    const root = document.querySelector('main.cooked');
    if (!root) return;

    cookedAbort?.abort();
    cookedAbort = new AbortController();
    const { signal } = cookedAbort;

    let songsData: Song[] = [];
    let personasData: Record<string, Persona> = {};
    try {
      const raw = JSON.parse(document.getElementById('cookedData')?.textContent ?? '{}');
      songsData = raw.songs ?? [];
      personasData = raw.personas ?? {};
    } catch { return; }

    const $ = (id: string) => document.getElementById(id);

    // localStorage score
    const SCORE_KEY = 'cooked.score';
    const loadScore = (): { correct: number; total: number } => {
      try { return JSON.parse(localStorage.getItem(SCORE_KEY) ?? '') || { correct: 0, total: 0 }; }
      catch { return { correct: 0, total: 0 }; }
    };
    const saveScore = (s: { correct: number; total: number }) => {
      try { localStorage.setItem(SCORE_KEY, JSON.stringify(s)); } catch {}
    };
    const renderScore = () => {
      const s = loadScore();
      const el = $('score');
      if (!el) return;
      el.textContent = s.total === 0 ? 'no rounds played yet' : `you've guessed ${s.correct} / ${s.total}`;
    };
    renderScore();

    let currentSongId: string | null = null;
    let currentPersona: string | null = null;
    let lastSubmit = 0;

    const personaKeys = Object.keys(personasData);
    const pickRandom = (exclude: string | null) => {
      const pool = personaKeys.filter(k => k !== exclude);
      return pool[Math.floor(Math.random() * pool.length)];
    };

    const showSong = (songId: string | undefined, personaOverride?: string) => {
      const song = songsData.find(s => s.id === songId);
      if (!song || !songId) return;

      // If we're already on this song (e.g. user clicked "try another voice"),
      // keep the YouTube iframe untouched so playback continues without a reload.
      const sameSong = currentSongId === songId;

      currentSongId = songId;
      currentPersona = personaOverride || personaKeys[Math.floor(Math.random() * personaKeys.length)];

      $('picker')!.hidden = true;
      $('play')!.hidden = false;
      $('result')!.hidden = true;
      const allVoices = $('allVoices') as HTMLDetailsElement;
      allVoices.hidden = true;
      allVoices.open = false;

      $('nowPlaying')!.textContent = song.title;
      $('nowMeta')!.textContent = `${song.artist} · ${song.year}`;
      $('reviewBody')!.textContent = song.reviews[currentPersona];

      const yt = $('ytFrame') as HTMLIFrameElement;
      yt.title = `YouTube player — ${song.title}`;
      if (!sameSong) {
        yt.src = `https://www.youtube.com/embed/${song.youtubeId}?autoplay=1&rel=0`;
      }

      const guessInput = $('guessInput') as HTMLInputElement;
      const guessBtn = $('guessBtn') as HTMLButtonElement;
      guessInput.value = '';
      guessInput.disabled = false;
      guessBtn.disabled = false;
      guessBtn.textContent = 'roast me';
      guessInput.focus();

      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const goToPicker = () => {
      ($('ytFrame') as HTMLIFrameElement).src = 'about:blank';
      $('play')!.hidden = true;
      $('picker')!.hidden = false;
      currentSongId = null;
      currentPersona = null;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // bfcache restore can bring the page back mid-game with the player view
    // up and stale listeners gone — reset to the picker.
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) goToPicker();
    }, { signal });

    document.querySelectorAll<HTMLButtonElement>('.card').forEach(btn => {
      btn.addEventListener('click', () => showSong(btn.dataset.songId), { signal });
    });

    $('backToPicker')!.addEventListener('click', goToPicker, { signal });

    const localGrade = (actual: string, guess: string) => {
      const lower = guess.toLowerCase();
      const map: Record<string, string[]> = {
        foodie: ['food', 'tiktok', 'chef', 'cook', 'eat', 'foodie', 'restaurant', 'noodle', 'shiok', 'singapore'],
        agent: ['property', 'real estate', 'agent', 'realtor', 'house', 'home', 'broker', 'listing', 'leasehold', 'freehold'],
        guru: ['wealth', 'finance', 'guru', 'invest', 'stock', 'crypto', 'money', 'rich', 'broker', 'asset', 'portfolio'],
        founder: ['linkedin', 'founder', 'startup', 'tech', 'hustle', 'entrepreneur', 'ceo', 'build in public', 'productivity']
      };
      const matched = map[actual]?.some(k => lower.includes(k));
      return {
        correct: !!matched,
        reply: matched
          ? 'yeah ok you got me 🤌'
          : `not quite — that was the ${personasData[actual].label.toLowerCase()} ${personasData[actual].icon}`,
      };
    };

    const showResult = (result: { correct: boolean; reply: string }) => {
      const score = loadScore();
      score.total += 1;
      if (result.correct) score.correct += 1;
      saveScore(score);
      renderScore();

      const resultEl = $('result')!;
      const lineEl = $('resultLine')!;
      const replyEl = $('replyBody')!;
      const p = personasData[currentPersona ?? ''];

      if (result.correct) {
        lineEl.textContent = `✓ nailed it. that was the ${p.label.toLowerCase()} ${p.icon}`;
        lineEl.className = 'result-line correct';
      } else {
        lineEl.textContent = `✕ nope — that was the ${p.label.toLowerCase()} ${p.icon}`;
        lineEl.className = 'result-line wrong';
      }
      replyEl.textContent = result.reply;
      resultEl.hidden = false;
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    $('guessForm')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const now = Date.now();
      if (now - lastSubmit < 2000) return;
      lastSubmit = now;

      const form = e.currentTarget as HTMLFormElement;
      const guess = (form.elements.namedItem('guess') as HTMLInputElement).value.trim();
      const hp = (form.elements.namedItem('hp') as HTMLInputElement).value;
      if (!guess || guess.length > 80) return;
      if (hp) return;

      const guessBtn = $('guessBtn') as HTMLButtonElement;
      const guessInput = $('guessInput') as HTMLInputElement;
      guessInput.disabled = true;
      guessBtn.disabled = true;
      guessBtn.textContent = 'roasting…';

      let result;
      try {
        const r = await fetch('/api/judge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ songId: currentSongId, persona: currentPersona, guess })
        });
        if (!r.ok) throw new Error('bad response');
        result = await r.json();
      } catch {
        // Soft fallback: simple keyword grading
        result = localGrade(currentPersona ?? '', guess);
      }

      showResult(result);
    }, { signal });

    $('seeAll')!.addEventListener('click', () => {
      const song = songsData.find(s => s.id === currentSongId);
      if (!song) return;
      const body = $('allVoicesBody')!;
      body.innerHTML = '';
      Object.entries(song.reviews).forEach(([key, text]) => {
        if (key === currentPersona) return;
        const block = document.createElement('div');
        block.className = 'voice-block';
        const label = document.createElement('span');
        label.className = 'voice-label';
        label.textContent = `${personasData[key].icon} ${personasData[key].label.toLowerCase()}`;
        block.appendChild(label);
        const txt = document.createElement('div');
        txt.className = 'voice-text';
        txt.textContent = text;
        block.appendChild(txt);
        body.appendChild(block);
      });
      const details = $('allVoices') as HTMLDetailsElement;
      details.hidden = false;
      details.open = true;
      details.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, { signal });

    $('nextVoice')!.addEventListener('click', () => {
      if (currentSongId) showSong(currentSongId, pickRandom(currentPersona));
    }, { signal });

    // "next song" jumps directly to a random different song from the curated 8.
    $('nextSong')!.addEventListener('click', () => {
      const others = songsData.filter(s => s.id !== currentSongId);
      if (!others.length) { goToPicker(); return; }
      const next = others[Math.floor(Math.random() * others.length)];
      showSong(next.id);
    }, { signal });

    $('requestForm')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const reqBtn = $('reqBtn') as HTMLButtonElement;
      const status = $('reqStatus')!;
      const song = (form.elements.namedItem('song') as HTMLInputElement).value.trim();
      const artist = (form.elements.namedItem('artist') as HTMLInputElement).value.trim();
      const hp = (form.elements.namedItem('hp') as HTMLInputElement).value;
      if (!song || song.length > 100 || hp) return;
      if (artist.length > 100) return;

      reqBtn.disabled = true;
      reqBtn.textContent = 'sending…';
      status.className = 'req-status';
      status.textContent = '';

      try {
        const r = await fetch('/api/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ song, artist, hp })
        });
        if (r.ok) {
          status.className = 'req-status ok';
          status.textContent = 'we got it 🤌 the chef will look';
          form.reset();
        } else if (r.status === 429) {
          status.className = 'req-status err';
          status.textContent = 'slow down — one request per minute, you bot energy';
        } else {
          const j = await r.json().catch(() => ({}));
          status.className = 'req-status err';
          status.textContent = j.error || 'something broke. try again later.';
        }
      } catch {
        status.className = 'req-status err';
        status.textContent = 'no signal. try again in a sec.';
      } finally {
        reqBtn.disabled = false;
        reqBtn.textContent = 'submit';
      }
    }, { signal });
  };

  document.addEventListener('astro:page-load', initCooked);
</script>
