---
// ctrl-s. — save points you can't load.
// An ever-growing isometric pixel world of Ari's memories. Canvas game loop
// (floor796-style): one clock, manifest-driven sprites, pan/zoom camera.
// Photos ride along AES-encrypted; the passphrase lives only in family heads.

import Layout from '../../../layouts/Layout.astro';
import { nextRoom } from '../../../data/rooms.mjs';
const next = nextRoom('ctrl-s');
---

<Layout
  title="ctrl-s. — save points you can't load."
  description="a growing pixel world of saved moments. the file only appends."
  themeColor="#efe7d8"
  ogImage="/og/ctrl-s.png"
  ogAlt="ctrl-s. save points you can't load. — an isometric pixel floor tile under a warm cream sky."
>
  <main class="ctrls">
    <a class="back" href="/room/" data-astro-prefetch data-veil-exit>&larr; the room</a>

    <header class="head" aria-hidden="true">
      <h1>ctrl-s.</h1>
      <p class="sub">save points you can't load.</p>
    </header>

    <canvas
      data-world
      role="img"
      aria-label="a pixel-art floor of saved memories — drag to wander between them"
    ></canvas>

    <p class="hint" data-hint>drag to wander &middot; scroll to zoom &middot; tap a memory</p>
    <p class="count" data-count></p>

    <p class="next-room">
      <a href={next.href} data-veil-exit={next.bg}>next room — {next.title} &rarr;</a>
    </p>

    <!-- memory card -->
    <aside class="card" data-card hidden aria-live="polite">
      <button class="card-close" data-card-close aria-label="close">&times;</button>
      <h2 data-card-title></h2>
      <p class="card-date" data-card-date></p>
      <p class="card-blurb" data-card-blurb></p>
      <div class="card-album" data-card-album hidden>
        <div class="album-locked" data-album-locked>
          <button class="unlock-btn" data-unlock-btn>&#128274; view the photographs</button>
          <form class="unlock-form" data-unlock-form hidden>
            <input
              type="password"
              data-unlock-input
              placeholder="the family words"
              autocomplete="off"
              autocapitalize="none"
            />
            <button type="submit">open</button>
            <p class="unlock-err" data-unlock-err hidden>that's not it. the door stays shut.</p>
          </form>
        </div>
        <div class="album-grid" data-album-grid hidden></div>
      </div>
      <p class="card-noalbum" data-card-noalbum hidden>no photographs filed. (yet.)</p>
    </aside>

    <!-- ctrl+s toast -->
    <div class="toast" data-toast hidden>
      <span data-toast-text>saved.</span>
    </div>

    <noscript>
      <div class="nojs">
        <p>this room is a living pixel world — it needs javascript to breathe.</p>
        <p>what you're missing: a small girl, a cake, one candle, everything after.</p>
      </div>
    </noscript>
  </main>
</Layout>

<style>
  html, body { overflow: hidden; }

  .ctrls {
    position: fixed;
    inset: 0;
    color: #4a4234;
    font-family: 'Lora', Georgia, serif;
    user-select: none;
    -webkit-user-select: none;
  }

  canvas[data-world] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }
  canvas[data-world].dragging { cursor: grabbing; }
  canvas[data-world].pointing { cursor: pointer; }

  .back {
    position: absolute;
    top: 1.4rem;
    left: 1.4rem;
    color: #4a4234;
    opacity: 0.55;
    text-decoration: none;
    font-size: 0.85rem;
    z-index: 5;
    transition: opacity 200ms;
    padding: 0.8rem;
    margin: -0.8rem;
  }
  .back:hover { opacity: 0.95; }
  .back:focus-visible {
    outline: 2px dashed rgba(74, 66, 52, 0.6);
    outline-offset: 2px;
    border-radius: 4px;
    opacity: 0.95;
  }

  .head {
    position: absolute;
    top: 3.2rem;
    left: 1.4rem;
    z-index: 4;
    pointer-events: none;
  }
  .head h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .head .sub {
    margin-top: 0.35rem;
    font-style: italic;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    opacity: 0.55;
  }

  .hint {
    position: absolute;
    right: 1.4rem;
    bottom: 1.2rem;
    z-index: 4;
    font-size: 0.72rem;
    font-style: italic;
    opacity: 0.4;
    pointer-events: none;
    transition: opacity 600ms;
  }
  .hint.faded { opacity: 0; }

  .count {
    position: absolute;
    left: 1.4rem;
    bottom: 1.2rem;
    z-index: 4;
    font-size: 0.72rem;
    font-family: 'Courier New', monospace;
    opacity: 0.45;
    pointer-events: none;
  }

  .next-room {
    position: absolute;
    right: 1.4rem;
    top: 1.4rem;
    z-index: 5;
    font-size: 0.8rem;
  }
  .next-room a { color: #4a4234; opacity: 0.5; text-decoration: none; transition: opacity 200ms; }
  .next-room a:hover { opacity: 0.95; }

  /* ---------- memory card ---------- */
  .card {
    position: absolute;
    z-index: 10;
    right: 1.2rem;
    bottom: 1.2rem;
    width: min(24rem, calc(100vw - 2.4rem));
    max-height: min(70vh, 34rem);
    overflow-y: auto;
    background: #faf6ec;
    border: 1px solid rgba(74, 66, 52, 0.18);
    border-radius: 10px;
    padding: 1.4rem 1.5rem 1.5rem;
    box-shadow: 0 12px 40px rgba(58, 48, 30, 0.18);
  }
  .card h2 { font-size: 1.3rem; font-weight: 500; padding-right: 1.5rem; }
  .card-date {
    margin-top: 0.2rem;
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    opacity: 0.55;
  }
  .card-blurb { margin-top: 0.8rem; line-height: 1.55; font-size: 0.92rem; opacity: 0.85; }
  .card-close {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    background: none;
    border: none;
    font-size: 1.3rem;
    color: inherit;
    opacity: 0.4;
    cursor: pointer;
    padding: 0.3rem 0.5rem;
  }
  .card-close:hover { opacity: 0.9; }

  .card-album { margin-top: 1.1rem; }
  .unlock-btn {
    background: transparent;
    border: 1px dashed rgba(74, 66, 52, 0.4);
    color: inherit;
    font-family: inherit;
    font-size: 0.82rem;
    padding: 0.55rem 0.9rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 200ms;
  }
  .unlock-btn:hover { border-color: rgba(74, 66, 52, 0.8); background: rgba(74, 66, 52, 0.05); }
  .unlock-form { margin-top: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .unlock-form input {
    flex: 1;
    min-width: 10rem;
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid rgba(74, 66, 52, 0.3);
    border-radius: 6px;
    background: #fff;
    color: inherit;
  }
  .unlock-form button {
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(74, 66, 52, 0.5);
    border-radius: 6px;
    background: #4a4234;
    color: #faf6ec;
    cursor: pointer;
  }
  .unlock-err { width: 100%; font-size: 0.78rem; font-style: italic; color: #8c4a3c; }
  .album-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .album-grid :global(img) {
    width: 100%;
    border-radius: 6px;
    display: block;
    cursor: zoom-in;
  }
  .album-grid :global(img.zoomed) {
    position: fixed;
    inset: 0;
    z-index: 50;
    width: 100vw;
    height: 100vh;
    object-fit: contain;
    background: rgba(30, 26, 18, 0.94);
    border-radius: 0;
    cursor: zoom-out;
  }
  .card-noalbum { margin-top: 1rem; font-size: 0.8rem; font-style: italic; opacity: 0.5; }

  /* ---------- ctrl+s toast ---------- */
  .toast {
    position: absolute;
    left: 50%;
    bottom: 3.4rem;
    transform: translateX(-50%);
    z-index: 20;
    background: #4a4234;
    color: #faf6ec;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    padding: 0.7rem 1.3rem;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(58, 48, 30, 0.3);
    pointer-events: none;
  }

  .nojs {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.6rem;
    text-align: center;
    padding: 2rem;
    font-style: italic;
    opacity: 0.75;
    z-index: 30;
    background: #efe7d8;
  }

  @media (max-width: 640px) {
    .card { right: 0.8rem; left: 0.8rem; bottom: 0.8rem; width: auto; }
    .hint { display: none; }
  }
</style>

<script>
  import { memories, FRAME_MS } from '../../../data/ctrl-s-memories.mjs';

  let abort: AbortController | null = null;

  const init = () => {
    const canvas = document.querySelector('canvas[data-world]') as HTMLCanvasElement | null;
    if (!canvas) return; // not this page
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;
    const ctx = canvas.getContext('2d')!;

    // ---------- world ----------
    const PAD = 520; // wanderable margin around the memories
    const bounds = memories.reduce(
      (b, m) => ({
        minX: Math.min(b.minX, m.x), minY: Math.min(b.minY, m.y),
        maxX: Math.max(b.maxX, m.x + m.w), maxY: Math.max(b.maxY, m.y + m.h),
      }),
      { minX: Infinity, minY: Infinity, maxX: -Infinity, maxY: -Infinity }
    );

    // ---------- sprite loading (lazy-ready: loads when near the viewport) ----------
    type Loaded = { img: HTMLImageElement; ready: boolean; alpha?: Uint8Array };
    const sheets = new Map<string, Loaded>();
    const ensureSheet = (m: (typeof memories)[number]) => {
      let s = sheets.get(m.id);
      if (!s) {
        const img = new Image();
        s = { img, ready: false };
        img.onload = () => {
          s!.ready = true;
          // Cache frame 0's alpha channel for hit-testing. Tiles sit edge to
          // edge, so their bounding boxes overlap and a rectangle test would
          // hand clicks to whichever memory draws last — you'd tap one baby
          // and open her neighbour's card. Shape-testing is the only honest way.
          try {
            const off = document.createElement('canvas');
            off.width = m.w; off.height = m.h;
            const octx = off.getContext('2d', { willReadFrequently: true })!;
            octx.drawImage(img, 0, 0, m.w, m.h, 0, 0, m.w, m.h);
            const px = octx.getImageData(0, 0, m.w, m.h).data;
            const a = new Uint8Array(m.w * m.h);
            for (let i = 0; i < a.length; i++) a[i] = px[i * 4 + 3];
            s!.alpha = a;
          } catch { /* no alpha cache -> falls back to the bounding box */ }
        };
        img.src = m.sheet;
        sheets.set(m.id, s);
      }
      return s;
    };

    // Topmost memory whose artwork actually covers this world point. Walks the
    // draw order backwards, so the nearest tile answers first.
    const memoryAt = (wx: number, wy: number) => {
      for (let i = memories.length - 1; i >= 0; i--) {
        const m = memories[i];
        const lx = Math.floor(wx - m.x), ly = Math.floor(wy - m.y);
        if (lx < 0 || ly < 0 || lx >= m.w || ly >= m.h) continue;
        const a = sheets.get(m.id)?.alpha;
        if (!a || a[ly * m.w + lx] > 8) return m;
      }
      return undefined;
    };

    // ---------- camera ----------
    const cam = { x: 0, y: 0, z: 1 }; // world coords at viewport center, zoom
    const dpr = () => Math.min(window.devicePixelRatio || 1, 2);
    const resize = () => {
      canvas.width = canvas.clientWidth * dpr();
      canvas.height = canvas.clientHeight * dpr();
    };
    resize();
    window.addEventListener('resize', resize, { signal });

    const cx = () => (bounds.minX + bounds.maxX) / 2;
    const cy = () => (bounds.minY + bounds.maxY) / 2;
    cam.x = cx();
    cam.y = cy();
    const fit = Math.min(
      canvas.clientWidth / (bounds.maxX - bounds.minX + 300),
      canvas.clientHeight / (bounds.maxY - bounds.minY + 300)
    );
    cam.z = Math.min(Math.max(fit, 0.4), 1.1);

    const clampCam = () => {
      cam.z = Math.min(Math.max(cam.z, 0.3), 2.8);
      cam.x = Math.min(Math.max(cam.x, bounds.minX - PAD), bounds.maxX + PAD);
      cam.y = Math.min(Math.max(cam.y, bounds.minY - PAD), bounds.maxY + PAD);
    };

    const toWorld = (sx: number, sy: number) => ({
      x: cam.x + (sx - canvas.clientWidth / 2) / cam.z,
      y: cam.y + (sy - canvas.clientHeight / 2) / cam.z,
    });

    // ---------- render loop ----------
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;
    const tick = (now: number) => {
      const d = dpr();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      // camera transform: world -> screen
      ctx.setTransform(
        cam.z * d, 0, 0, cam.z * d,
        canvas.width / 2 - cam.x * cam.z * d,
        canvas.height / 2 - cam.y * cam.z * d
      );
      // Smooth when shrinking (stops the fine outlines shimmering as you zoom
      // out), crisp when magnifying past 1:1 — pixel art wants hard pixels, not
      // a blur, once you're closer than the sheet's own resolution.
      ctx.imageSmoothingEnabled = cam.z * d < 1;
      const frameIdx = reduceMotion ? 0 : Math.floor(now / FRAME_MS);
      for (const m of memories) {
        const s = ensureSheet(m);
        if (!s.ready) continue;
        const f = frameIdx % m.frames;
        // sheet frames are stored at world scale: frame f sits at x = f * m.w
        ctx.drawImage(s.img, f * m.w, 0, m.w, m.h, m.x, m.y, m.w, m.h);
      }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    signal.addEventListener('abort', () => cancelAnimationFrame(raf));

    // ---------- input: drag / pinch / wheel ----------
    const pointers = new Map<number, { x: number; y: number }>();
    let dragMoved = 0;
    let pinchDist = 0;
    const hint = document.querySelector('[data-hint]');

    canvas.addEventListener('pointerdown', (e) => {
      canvas.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      dragMoved = 0;
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
      }
      canvas.classList.add('dragging');
    }, { signal });

    canvas.addEventListener('pointermove', (e) => {
      const prev = pointers.get(e.pointerId);
      if (!prev) {
        // hover cursor
        const w = toWorld(e.clientX, e.clientY);
        canvas.classList.toggle('pointing', !!memoryAt(w.x, w.y));
        return;
      }
      const dx = e.clientX - prev.x;
      const dy = e.clientY - prev.y;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      dragMoved += Math.abs(dx) + Math.abs(dy);
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const nd = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchDist > 0) {
          cam.z *= nd / pinchDist;
          clampCam();
        }
        pinchDist = nd;
      } else if (pointers.size === 1) {
        cam.x -= dx / cam.z;
        cam.y -= dy / cam.z;
        clampCam();
        if (dragMoved > 40) hint?.classList.add('faded');
      }
    }, { signal });

    const endPointer = (e: PointerEvent) => {
      const wasTap = pointers.has(e.pointerId) && dragMoved < 6 && pointers.size === 1;
      pointers.delete(e.pointerId);
      pinchDist = 0;
      if (pointers.size === 0) canvas.classList.remove('dragging');
      if (wasTap) {
        const w = toWorld(e.clientX, e.clientY);
        const hit = memoryAt(w.x, w.y);
        if (hit) openCard(hit);
        else closeCard();
      }
    };
    canvas.addEventListener('pointerup', endPointer, { signal });
    canvas.addEventListener('pointercancel', (e) => { pointers.delete(e.pointerId); }, { signal });

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const before = toWorld(e.clientX, e.clientY);
      cam.z *= e.deltaY < 0 ? 1.12 : 1 / 1.12;
      clampCam();
      const after = toWorld(e.clientX, e.clientY);
      cam.x += before.x - after.x;
      cam.y += before.y - after.y;
      clampCam();
      hint?.classList.add('faded');
    }, { signal, passive: false });

    // ---------- memory card ----------
    const card = document.querySelector('[data-card]') as HTMLElement;
    const cardTitle = card.querySelector('[data-card-title]') as HTMLElement;
    const cardDate = card.querySelector('[data-card-date]') as HTMLElement;
    const cardBlurb = card.querySelector('[data-card-blurb]') as HTMLElement;
    const cardAlbum = card.querySelector('[data-card-album]') as HTMLElement;
    const cardNoAlbum = card.querySelector('[data-card-noalbum]') as HTMLElement;
    const albumLocked = card.querySelector('[data-album-locked]') as HTMLElement;
    const albumGrid = card.querySelector('[data-album-grid]') as HTMLElement;
    const unlockBtn = card.querySelector('[data-unlock-btn]') as HTMLButtonElement;
    const unlockForm = card.querySelector('[data-unlock-form]') as HTMLFormElement;
    const unlockInput = card.querySelector('[data-unlock-input]') as HTMLInputElement;
    const unlockErr = card.querySelector('[data-unlock-err]') as HTMLElement;
    let currentMemory: (typeof memories)[number] | null = null;
    let albumUrls: string[] = [];

    const fmtDate = (iso: string) => {
      const d = new Date(iso + 'T00:00:00');
      const months = ['january','february','march','april','may','june','july','august','september','october','november','december'];
      return `${String(d.getDate()).padStart(2, '0')} ${months[d.getMonth()]} ${d.getFullYear()}`;
    };

    const closeCard = () => {
      card.hidden = true;
      currentMemory = null;
      albumUrls.forEach((u) => URL.revokeObjectURL(u));
      albumUrls = [];
      albumGrid.innerHTML = '';
    };

    const openCard = (m: (typeof memories)[number]) => {
      closeCard();
      currentMemory = m;
      cardTitle.textContent = m.title;
      cardDate.textContent = fmtDate(m.date);
      cardBlurb.textContent = m.blurb;
      cardAlbum.hidden = !m.album;
      cardNoAlbum.hidden = m.album;
      albumLocked.hidden = false;
      albumGrid.hidden = true;
      unlockForm.hidden = true;
      unlockBtn.hidden = false;
      unlockErr.hidden = true;
      card.hidden = false;
      // a remembered passphrase unlocks silently
      const pass = sessionStorage.getItem('ctrls-pass');
      if (m.album && pass) tryUnlock(pass, true);
    };

    card.querySelector('[data-card-close]')!.addEventListener('click', closeCard, { signal });

    // ---------- encrypted album ----------
    const b64ToBytes = (b64: string) =>
      Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

    const deriveKey = async (pass: string, salt: Uint8Array) => {
      const base = await crypto.subtle.importKey(
        'raw', new TextEncoder().encode(pass), 'PBKDF2', false, ['deriveKey']
      );
      return crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: salt as BufferSource, iterations: 250000, hash: 'SHA-256' },
        base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']
      );
    };

    const tryUnlock = async (pass: string, silent = false) => {
      const m = currentMemory;
      if (!m) return;
      try {
        const meta = await fetch(`/room/ctrl-s/album/${m.id}/album.json`).then((r) => {
          if (!r.ok) throw new Error('no album');
          return r.json();
        });
        const key = await deriveKey(pass, b64ToBytes(meta.salt));
        const urls: string[] = [];
        for (const f of meta.files) {
          const buf = await fetch(`/room/ctrl-s/album/${m.id}/${f.src}`).then((r) => r.arrayBuffer());
          const plain = await crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: b64ToBytes(f.iv) as BufferSource }, key, buf
          );
          urls.push(URL.createObjectURL(new Blob([plain], { type: 'image/jpeg' })));
        }
        if (currentMemory !== m) { urls.forEach((u) => URL.revokeObjectURL(u)); return; }
        sessionStorage.setItem('ctrls-pass', pass);
        albumUrls = urls;
        albumGrid.innerHTML = '';
        urls.forEach((u) => {
          const img = document.createElement('img');
          img.src = u;
          img.alt = 'a saved photograph';
          img.addEventListener('click', () => img.classList.toggle('zoomed'), { signal });
          albumGrid.appendChild(img);
        });
        albumLocked.hidden = true;
        albumGrid.hidden = false;
      } catch {
        if (!silent) {
          unlockErr.hidden = false;
          unlockInput.select();
        }
      }
    };

    unlockBtn.addEventListener('click', () => {
      unlockBtn.hidden = true;
      unlockForm.hidden = false;
      unlockInput.focus();
    }, { signal });

    unlockForm.addEventListener('submit', (e) => {
      e.preventDefault();
      unlockErr.hidden = true;
      const v = unlockInput.value.trim();
      if (v) tryUnlock(v);
    }, { signal });

    // ---------- ctrl+s ----------
    const toast = document.querySelector('[data-toast]') as HTMLElement;
    const toastText = toast.querySelector('[data-toast-text]') as HTMLElement;
    let toastTimers: number[] = [];
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
        e.preventDefault();
        toastTimers.forEach(clearTimeout);
        toast.hidden = false;
        toastText.textContent = 'saved.';
        toastTimers = [
          window.setTimeout(() => { toastText.textContent = 'she keeps growing anyway.'; }, 1100),
          window.setTimeout(() => { toast.hidden = true; }, 3600),
        ];
      }
      if (e.key === 'Escape') closeCard();
    }, { signal });

    // ---------- counter ----------
    const count = document.querySelector('[data-count]') as HTMLElement;
    count.textContent = `save points: ${memories.length}`;
  };

  document.addEventListener('astro:page-load', init);
  init();
</script>
