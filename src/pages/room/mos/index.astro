---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="MOS — Ministry of Silly. Walk." description="alternate L and R. walk silly. don't fall.">
  <main class="mos">
    <a class="back" href="/room/" data-astro-prefetch>&larr; the room</a>

    <header class="hud-head">
      <h1>MOS.</h1>
      <p class="sub">Ministry of Silly. Walk.</p>
      <p class="tribute">after the Monty Python sketch by John Cleese &amp; Graham Chapman, 1970.</p>
    </header>

    <div class="hud-counter">
      <div class="now"><span data-counter>0</span><em>m</em></div>
      <div class="time" data-time-row><span data-time>30</span><em>s</em></div>
      <div class="best">best — <span data-best>0</span> m</div>
    </div>

    <div class="stage">
      <canvas data-stage></canvas>
    </div>

    <div class="pads" aria-hidden="false">
      <button data-pad="L" class="pad" aria-label="left step"><span>L</span></button>
      <button data-pad="R" class="pad" aria-label="right step"><span>R</span></button>
    </div>

    <div class="overlay" data-overlay hidden>
      <div class="card">
        <div class="stamp" data-stamp>REJECTED</div>
        <h2>Application rejected.</h2>
        <p class="reason" data-reason>The Ministry regrets to inform you.</p>
        <dl>
          <dt>Distance</dt><dd><span data-final>0</span> m</dd>
          <dt>Best</dt><dd><span data-final-best>0</span> m</dd>
        </dl>
        <p class="retry">tap to resubmit</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Light parchment palette — clean warm cream, sepia ink, faded brown
     accents. A touch warmer than /room/ so MOS reads as its own surface
     without going saturated/sickly like the earlier manila. */
  html, body { background: #f2ecd6; overflow: hidden; }

  .mos {
    position: fixed;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    color: #3a2e1a;
    font-family: 'Lora', Georgia, serif;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }

  .back {
    position: absolute;
    top: 1.4rem;
    left: 1.4rem;
    color: #3a2e1a;
    opacity: 0.4;
    text-decoration: none;
    font-size: 0.85rem;
    z-index: 5;
    transition: opacity 200ms;
  }
  .back:hover { opacity: 0.95; }

  .hud-head {
    /* top padding clears the absolutely-positioned back link above */
    padding: 3.4rem 2rem 0.4rem;
    text-align: left;
    pointer-events: none;
  }
  .hud-head h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .hud-head .sub {
    margin-top: 0.3rem;
    font-style: italic;
    font-size: clamp(0.9rem, 1.6vw, 1.1rem);
    opacity: 0.6;
  }
  .hud-head .tribute {
    margin-top: 0.5rem;
    font-style: italic;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    opacity: 0.32;
    max-width: 28rem;
  }

  .hud-counter {
    position: absolute;
    top: 1.4rem;
    right: 1.6rem;
    text-align: right;
    font-feature-settings: 'tnum';
    pointer-events: none;
    z-index: 4;
  }
  .hud-counter .now {
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    font-weight: 500;
    line-height: 1;
  }
  .hud-counter .now em {
    font-style: normal;
    font-size: 0.55em;
    opacity: 0.5;
    margin-left: 0.25em;
  }
  .hud-counter .time {
    margin-top: 0.5rem;
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    font-weight: 500;
    line-height: 1;
    color: #3a2e1a;
    transition: color 200ms;
  }
  .hud-counter .time em {
    font-style: normal;
    font-size: 0.6em;
    opacity: 0.5;
    margin-left: 0.18em;
  }
  .hud-counter .time.low { color: #b22222; animation: time-pulse 720ms ease-in-out infinite; }
  @keyframes time-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }
  .hud-counter .best {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .stage {
    position: relative;
    overflow: hidden;
  }
  .stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pads {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid rgba(58, 46, 26, 0.22);
  }
  .pad {
    background: transparent;
    border: 0;
    border-right: 1px solid rgba(58, 46, 26, 0.22);
    color: #3a2e1a;
    padding: 1.4rem 0;
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.4em;
    cursor: pointer;
    transition: background 90ms ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .pad:last-child { border-right: 0; }
  .pad span { opacity: 0.45; transition: opacity 120ms; }
  .pad:hover span { opacity: 0.85; }
  .pad.flash { background: rgba(58, 46, 26, 0.10); }
  .pad.flash span { opacity: 1; }
  .pad.flash-bad { background: rgba(178, 34, 34, 0.18); }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(242, 236, 214, 0.9);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 10;
    cursor: pointer;
    animation: overlay-in 320ms ease-out both;
  }
  .overlay[hidden] { display: none !important; }

  @keyframes overlay-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .overlay .card {
    position: relative;
    text-align: center;
    padding: 3rem 3.5rem;
    max-width: 28rem;
    background: #f7f1de;
    border: 1px solid rgba(58, 46, 26, 0.24);
    box-shadow: 0 1px 0 rgba(58, 46, 26, 0.06), 0 24px 60px -30px rgba(58, 46, 26, 0.4);
  }

  .overlay .stamp {
    position: absolute;
    top: -0.6rem;
    right: -1.2rem;
    transform: rotate(8deg) scale(2.4);
    color: #b22222;
    border: 4px solid #b22222;
    padding: 0.3rem 0.9rem;
    font-family: 'Lora', Georgia, serif;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0.2em;
    opacity: 0;
    animation: stamp-slam 520ms cubic-bezier(.2,1.6,.4,1) 200ms both;
  }

  @keyframes stamp-slam {
    0%   { transform: rotate(20deg) scale(4); opacity: 0; }
    60%  { transform: rotate(6deg) scale(1.05); opacity: 1; }
    100% { transform: rotate(8deg) scale(1.1); opacity: 0.9; }
  }

  .overlay h2 {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 500;
    letter-spacing: -0.005em;
    margin-bottom: 0.4rem;
  }
  .overlay .reason {
    font-style: italic;
    opacity: 0.55;
    font-size: 0.9rem;
    margin-bottom: 1.6rem;
  }
  .overlay dl {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 1rem;
    row-gap: 0.4rem;
    justify-content: center;
    margin-bottom: 1.8rem;
    font-feature-settings: 'tnum';
  }
  .overlay dt {
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    opacity: 0.5;
    align-self: center;
  }
  .overlay dd { text-align: left; font-size: 1.1rem; }
  .overlay .retry {
    font-style: italic;
    opacity: 0.5;
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .hud-head { padding-top: 3rem; padding-left: 1.2rem; }
    .back { top: 1rem; left: 1rem; }
    .hud-counter { top: 1rem; right: 1rem; }
    .overlay .card { padding: 2.4rem 2rem; }
  }
</style>

<script>
  // ============================================================================
  // MOS — Ministry of Silly Walk
  // ----------------------------------------------------------------------------
  // Self-contained: renderer + game loop + input + audio + persistence.
  // Renderer ported from /room/mos-preview/.
  // ============================================================================

  type Pose = {
    torso: number;
    head: number;
    Lhip: number; Lknee: number;
    Rhip: number; Rknee: number;
    Lshoulder: number; Lelbow: number;
    Rshoulder: number; Relbow: number;
    hipLift: number;
    bodyDrift?: { x: number; y: number; rot: number };
  };

  const D = (deg: number) => (deg * Math.PI) / 180;

  const idle: Pose = {
    torso: D(-2), head: D(0),
    Lhip: D(0), Lknee: D(0),
    Rhip: D(0), Rknee: D(0),
    Lshoulder: D(2), Lelbow: D(2),
    Rshoulder: D(-2), Relbow: D(-2),
    hipLift: 0,
  };

  // R-foot-forward step poses. For an L-foot step we mirror at runtime.
  // All poses are deliberately exaggerated — Cleese, not jogging.
  const stepPoses: Pose[] = [
    // highKick — leg flung up past horizontal
    {
      torso: D(-16), head: D(6),
      Lhip: D(-6), Lknee: D(-4),
      Rhip: D(115), Rknee: D(-40),
      Lshoulder: D(28), Lelbow: D(12),
      Rshoulder: D(-58), Relbow: D(-30),
      hipLift: -2,
    },
    // longStride — extreme split
    {
      torso: D(12), head: D(-4),
      Lhip: D(-52), Lknee: D(10),
      Rhip: D(70), Rknee: D(-12),
      Lshoulder: D(-44), Lelbow: D(-14),
      Rshoulder: D(56), Relbow: D(28),
      hipLift: -12,
    },
    // bentShuffle — deep crouch, comedy waddle
    {
      torso: D(-6), head: D(4),
      Lhip: D(28), Lknee: D(-95),
      Rhip: D(-14), Rknee: D(-115),
      Lshoulder: D(-22), Lelbow: D(-72),
      Rshoulder: D(22), Relbow: D(-62),
      hipLift: 38,
    },
    // leanForward — folded forward, briefcase counterweight
    {
      torso: D(54), head: D(-32),
      Lhip: D(-30), Lknee: D(6),
      Rhip: D(38), Rknee: D(-18),
      Lshoulder: D(70), Lelbow: D(14),
      Rshoulder: D(-78), Relbow: D(-52),
      hipLift: 4,
    },
    // goosestep — ramrod-stiff military
    {
      torso: D(-10), head: D(0),
      Lhip: D(0), Lknee: D(0),
      Rhip: D(95), Rknee: D(0),
      Lshoulder: D(-44), Lelbow: D(-2),
      Rshoulder: D(44), Relbow: D(-2),
      hipLift: 0,
    },
    // kneeToFace — knee jerked up to chest height with sharp shin tuck
    {
      torso: D(-22), head: D(8),
      Lhip: D(-2), Lknee: D(-2),
      Rhip: D(125), Rknee: D(-130),
      Lshoulder: D(34), Lelbow: D(20),
      Rshoulder: D(-66), Relbow: D(-40),
      hipLift: -4,
    },
    // donkeyKick — leg flung BACKWARDS
    {
      torso: D(28), head: D(-18),
      Lhip: D(2), Lknee: D(-2),
      Rhip: D(-70), Rknee: D(-50),
      Lshoulder: D(60), Lelbow: D(18),
      Rshoulder: D(-58), Relbow: D(-32),
      hipLift: -8,
    },
    // jazzHands — both arms flung wide, body tilted, leg askew
    {
      torso: D(-4), head: D(-14),
      Lhip: D(-24), Lknee: D(0),
      Rhip: D(38), Rknee: D(-22),
      Lshoulder: D(-95), Lelbow: D(-30),
      Rshoulder: D(95), Relbow: D(30),
      hipLift: -4,
    },
    // scissorSplit — both legs out wide, near-split
    {
      torso: D(0), head: D(0),
      Lhip: D(-58), Lknee: D(4),
      Rhip: D(58), Rknee: D(-4),
      Lshoulder: D(8), Lelbow: D(0),
      Rshoulder: D(-8), Relbow: D(0),
      hipLift: -16,
    },
    // spasm — head thrown back, body twisted, limbs wrong
    {
      torso: D(-32), head: D(28),
      Lhip: D(48), Lknee: D(-50),
      Rhip: D(80), Rknee: D(20),
      Lshoulder: D(-72), Lelbow: D(40),
      Rshoulder: D(120), Relbow: D(-60),
      hipLift: -2,
    },
  ];

  const ragdollPose: Pose = {
    torso: D(75), head: D(-30),
    Lhip: D(110), Lknee: D(-50),
    Rhip: D(60), Rknee: D(-90),
    Lshoulder: D(160), Lelbow: D(-40),
    Rshoulder: D(-140), Relbow: D(70),
    hipLift: -40,
    bodyDrift: { x: 8, y: -20, rot: D(20) },
  };

  // Mirror a R-forward pose into an L-forward pose by swapping limb angles.
  function mirror(p: Pose): Pose {
    return {
      torso: p.torso,
      head: p.head,
      Lhip: p.Rhip, Lknee: p.Rknee,
      Rhip: p.Lhip, Rknee: p.Lknee,
      Lshoulder: p.Rshoulder, Lelbow: p.Relbow,
      Rshoulder: p.Lshoulder, Relbow: p.Lelbow,
      hipLift: p.hipLift,
      bodyDrift: p.bodyDrift,
    };
  }

  // Bone metrics
  const M = {
    torso: 62,
    thigh: 46,
    shin: 46,
    upperArm: 36,
    forearm: 32,
    head: 13,
    legW: 13,
    armW: 10,
    torsoW: 22,
    footLen: 14,
    footH: 5,
  };

  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
  function lerpPose(a: Pose, b: Pose, t: number): Pose {
    const driftA = a.bodyDrift ?? { x: 0, y: 0, rot: 0 };
    const driftB = b.bodyDrift ?? { x: 0, y: 0, rot: 0 };
    return {
      torso: lerp(a.torso, b.torso, t),
      head: lerp(a.head, b.head, t),
      Lhip: lerp(a.Lhip, b.Lhip, t),
      Lknee: lerp(a.Lknee, b.Lknee, t),
      Rhip: lerp(a.Rhip, b.Rhip, t),
      Rknee: lerp(a.Rknee, b.Rknee, t),
      Lshoulder: lerp(a.Lshoulder, b.Lshoulder, t),
      Lelbow: lerp(a.Lelbow, b.Lelbow, t),
      Rshoulder: lerp(a.Rshoulder, b.Rshoulder, t),
      Relbow: lerp(a.Relbow, b.Relbow, t),
      hipLift: lerp(a.hipLift, b.hipLift, t),
      bodyDrift: {
        x: lerp(driftA.x, driftB.x, t),
        y: lerp(driftA.y, driftB.y, t),
        rot: lerp(driftA.rot, driftB.rot, t),
      },
    };
  }

  function easeOutCubic(t: number) { return 1 - Math.pow(1 - t, 3); }
  function easeInCubic(t: number) { return t * t * t; }

  // Deterministic 0–1 hash from an integer seed. Used to scatter road
  // texture (stones, cracks) at fixed world positions so they scroll
  // past coherently without per-frame jitter.
  function hash01(n: number): number {
    let h = Math.imul(n | 0, 2654435761) >>> 0;
    h ^= h >>> 16;
    h = Math.imul(h, 2246822519) >>> 0;
    h ^= h >>> 13;
    h = Math.imul(h, 3266489917) >>> 0;
    h ^= h >>> 16;
    return h / 0xFFFFFFFF;
  }

  // Canvas `ellipse` throws IndexSizeError on a negative or non-finite
  // radius — a single bad pose computation can take down the loop. This
  // wrapper silently skips invalid calls and logs the first one for
  // diagnosis. Replaces every direct ctx.ellipse in this file.
  let _ellipseLogged = false;
  function safeEllipse(
    ctx: CanvasRenderingContext2D,
    x: number, y: number,
    rx: number, ry: number,
    rot: number, start: number, end: number,
  ) {
    if (!isFinite(x) || !isFinite(y) || !isFinite(rx) || !isFinite(ry) || rx < 0.05 || ry < 0.05) {
      if (!_ellipseLogged) {
        _ellipseLogged = true;
        console.warn('[mos] skipped ellipse with bad args', { x, y, rx, ry });
      }
      return;
    }
    ctx.ellipse(x, y, rx, ry, rot, start, end);
  }

  // Returns where the briefcase hand ends up in screen coords, so the caller
  // can drive the briefcase pendulum from outside the figure renderer.
  function drawFigure(ctx: CanvasRenderingContext2D, cx: number, groundY: number, pose: Pose, scale = 1): { handX: number; handY: number } {
    ctx.save();

    const drift = pose.bodyDrift;
    if (drift && (drift.x || drift.y || drift.rot)) {
      ctx.translate(cx + drift.x, groundY + drift.y);
      ctx.rotate(drift.rot);
      ctx.translate(-cx, -groundY);
    }

    const ink = '#2a1f10'; // sepia-black; reads warm against the manila bg
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = ink;
    ctx.fillStyle = ink;

    const hipX = cx;
    const hipY = groundY - (M.shin + M.thigh) * scale + pose.hipLift * scale;

    const torsoAng = pose.torso;
    const shoulderX = hipX + Math.sin(torsoAng) * M.torso * scale;
    const shoulderY = hipY - Math.cos(torsoAng) * M.torso * scale;

    const headAng = torsoAng + pose.head;
    const headDist = (M.head + 6) * scale;
    const headCX = shoulderX + Math.sin(headAng) * headDist;
    const headCY = shoulderY - Math.cos(headAng) * headDist;

    const limb = (rootX: number, rootY: number, parentAng: number, childAng: number, len1: number, len2: number) => {
      const a1 = parentAng;
      const midX = rootX + Math.sin(a1) * len1;
      const midY = rootY + Math.cos(a1) * len1;
      const a2 = a1 + childAng;
      const endX = midX + Math.sin(a2) * len2;
      const endY = midY + Math.cos(a2) * len2;
      return { midX, midY, endX, endY, a2 };
    };

    const lLeg = limb(hipX, hipY, pose.Lhip, pose.Lknee, M.thigh * scale, M.shin * scale);
    const rLeg = limb(hipX, hipY, pose.Rhip, pose.Rknee, M.thigh * scale, M.shin * scale);

    const legs = [
      { ang: pose.Lhip, joints: lLeg, side: 'L' as const },
      { ang: pose.Rhip, joints: rLeg, side: 'R' as const },
    ].sort((a, b) => Math.abs(b.ang) - Math.abs(a.ang));

    ctx.lineWidth = M.legW * scale;
    for (const leg of legs) {
      ctx.beginPath();
      ctx.moveTo(hipX, hipY);
      ctx.lineTo(leg.joints.midX, leg.joints.midY);
      ctx.lineTo(leg.joints.endX, leg.joints.endY);
      ctx.stroke();
      drawShoe(ctx, leg.joints.endX, leg.joints.endY, leg.joints.a2, scale);
    }

    ctx.lineWidth = M.torsoW * scale;
    ctx.beginPath();
    ctx.moveTo(hipX, hipY);
    ctx.lineTo(shoulderX, shoulderY);
    ctx.stroke();

    const lArm = limb(shoulderX, shoulderY, pose.Lshoulder + torsoAng, pose.Lelbow, M.upperArm * scale, M.forearm * scale);
    const rArm = limb(shoulderX, shoulderY, pose.Rshoulder + torsoAng, pose.Relbow, M.upperArm * scale, M.forearm * scale);

    ctx.lineWidth = M.armW * scale;
    ctx.beginPath();
    ctx.moveTo(shoulderX, shoulderY);
    ctx.lineTo(rArm.midX, rArm.midY);
    ctx.lineTo(rArm.endX, rArm.endY);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(shoulderX, shoulderY);
    ctx.lineTo(lArm.midX, lArm.midY);
    ctx.lineTo(lArm.endX, lArm.endY);
    ctx.stroke();

    // briefcase is rendered by the caller (it has its own swing physics).
    drawHead(ctx, headCX, headCY, headAng, scale);

    ctx.restore();

    // Apply the body-drift transform (used during ragdoll fall) to the
    // returned hand position so the briefcase still follows the hand once
    // the figure starts tumbling.
    let handX = lArm.endX, handY = lArm.endY;
    if (drift && (drift.x || drift.y || drift.rot)) {
      const sx = handX - cx, sy = handY - groundY;
      const c = Math.cos(drift.rot), s = Math.sin(drift.rot);
      handX = cx + drift.x + c * sx - s * sy;
      handY = groundY + drift.y + s * sx + c * sy;
    }
    return { handX, handY };
  }

  function drawShoe(ctx: CanvasRenderingContext2D, x: number, y: number, shinAng: number, scale: number) {
    const footAng = shinAng + Math.PI / 2;
    const halfLen = (M.footLen / 2) * scale;
    const heelX = x - Math.sin(footAng) * halfLen * 0.4;
    const heelY = y + Math.cos(footAng) * halfLen * 0.4;
    const toeX = x + Math.sin(footAng) * halfLen * 1.6;
    const toeY = y + Math.cos(footAng) * halfLen * 1.6;
    ctx.lineWidth = (M.footH + 2) * scale;
    ctx.beginPath();
    ctx.moveTo(heelX, heelY);
    ctx.lineTo(toeX, toeY);
    ctx.stroke();
  }

  function drawBriefcase(ctx: CanvasRenderingContext2D, handX: number, handY: number, scale: number, swingAngle = 0) {
    const w = 26 * scale;
    const h = 18 * scale;
    const handleH = 5 * scale;
    ctx.save();
    ctx.translate(handX, handY);
    ctx.rotate(swingAngle); // pendulum: 0 = hangs straight down
    ctx.fillStyle = '#2a1f10';
    ctx.strokeStyle = '#2a1f10';
    ctx.lineWidth = 2 * scale;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.lineTo(0, handleH);
    ctx.stroke();
    const r = 2 * scale;
    const x0 = -w / 2, y0 = handleH;
    ctx.beginPath();
    ctx.moveTo(x0 + r, y0);
    ctx.lineTo(x0 + w - r, y0);
    ctx.quadraticCurveTo(x0 + w, y0, x0 + w, y0 + r);
    ctx.lineTo(x0 + w, y0 + h - r);
    ctx.quadraticCurveTo(x0 + w, y0 + h, x0 + w - r, y0 + h);
    ctx.lineTo(x0 + r, y0 + h);
    ctx.quadraticCurveTo(x0, y0 + h, x0, y0 + h - r);
    ctx.lineTo(x0, y0 + r);
    ctx.quadraticCurveTo(x0, y0, x0 + r, y0);
    ctx.fill();
    // clasp — small rectangle at top centre of case
    ctx.fillStyle = '#f2ecd6';
    ctx.fillRect(-1.6 * scale, y0 + 1.5 * scale, 3.2 * scale, 2 * scale);
    ctx.restore();
  }

  function drawHead(ctx: CanvasRenderingContext2D, cx: number, cy: number, headAng: number, scale: number) {
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(headAng);

    const r = M.head * scale;
    const ink = '#2a1f10';
    const bg = '#f2ecd6';

    // Head — round skull
    ctx.fillStyle = ink;
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, Math.PI * 2);
    ctx.fill();

    // Nose — wedge poking from the front (figure faces right ⇒ +x)
    ctx.beginPath();
    ctx.moveTo(r * 0.65, -r * 0.15);
    ctx.quadraticCurveTo(r * 1.45, r * 0.0, r * 0.95, r * 0.28);
    ctx.lineTo(r * 0.62, r * 0.20);
    ctx.closePath();
    ctx.fill();

    // Mustache — drooping bar cut out of the lower face (bg colour, so it
    // reads as a shape against the silhouette). Cleese-style.
    ctx.fillStyle = bg;
    ctx.beginPath();
    ctx.moveTo(r * 0.10, r * 0.30);
    ctx.quadraticCurveTo(r * 0.55, r * 0.42, r * 1.05, r * 0.40);
    ctx.lineTo(r * 1.00, r * 0.56);
    ctx.quadraticCurveTo(r * 0.55, r * 0.62, r * 0.10, r * 0.50);
    ctx.closePath();
    ctx.fill();

    // Bowler — brim
    ctx.fillStyle = ink;
    const brimY = -r * 0.6;
    const brimW = r * 2.4;
    const brimH = r * 0.45;
    ctx.beginPath();
    safeEllipse(ctx, 0, brimY, brimW / 2, brimH / 2, 0, 0, Math.PI * 2);
    ctx.fill();

    // Crown
    const crownH = r * 1.1;
    const crownW = r * 1.5;
    const crownY = brimY - crownH * 0.45;
    ctx.beginPath();
    safeEllipse(ctx, 0, crownY, crownW / 2, crownH / 2, 0, 0, Math.PI * 2);
    ctx.fill();

    // Hatband — thin manila stripe at brim/crown junction
    ctx.fillStyle = bg;
    ctx.beginPath();
    safeEllipse(ctx, 0, brimY - r * 0.05, crownW * 0.46, brimH * 0.18, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
  }

  // ============================================================================
  // Game
  // ============================================================================

  type Phase = 'idle' | 'walking' | 'falling' | 'dead';

  function init() {
    const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-stage]');
    const counterEl = document.querySelector<HTMLElement>('[data-counter]');
    const bestEl = document.querySelector<HTMLElement>('[data-best]');
    const timeEl = document.querySelector<HTMLElement>('[data-time]');
    const timeRowEl = document.querySelector<HTMLElement>('[data-time-row]');
    const finalEl = document.querySelector<HTMLElement>('[data-final]');
    const finalBestEl = document.querySelector<HTMLElement>('[data-final-best]');
    const overlayEl = document.querySelector<HTMLElement>('[data-overlay]');
    const reasonEl = document.querySelector<HTMLElement>('[data-reason]');
    const padL = document.querySelector<HTMLElement>('.pad[data-pad="L"]');
    const padR = document.querySelector<HTMLElement>('.pad[data-pad="R"]');
    if (!canvas || !counterEl || !bestEl || !timeEl || !timeRowEl || !finalEl || !finalBestEl || !overlayEl || !reasonEl || !padL || !padR) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const ac = new AbortController();
    const sig = ac.signal;

    // ----- persistence -----
    // Stored as integer meters in `mos.best.m`. Old `mos.best` from the
    // initial cm-tracking build is intentionally orphaned.
    let best = parseInt(localStorage.getItem('mos.best.m') ?? '0', 10) || 0;
    bestEl.textContent = String(best);
    finalBestEl.textContent = String(best);

    // ----- audio -----
    let audioCtx: AudioContext | null = null;
    function ensureAudio() {
      if (audioCtx) return audioCtx;
      const C = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (!C) return null;
      audioCtx = new C();
      return audioCtx;
    }
    function clop(pitch = 1) {
      const a = ensureAudio();
      if (!a) return;
      const t = a.currentTime;
      const osc = a.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(140 * pitch, t);
      osc.frequency.exponentialRampToValueAtTime(60 * pitch, t + 0.07);
      const g = a.createGain();
      g.gain.setValueAtTime(0.16, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);
      osc.connect(g).connect(a.destination);
      osc.start(t);
      osc.stop(t + 0.1);
    }
    function thud() {
      const a = ensureAudio();
      if (!a) return;
      const t = a.currentTime;
      const osc = a.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(110, t);
      osc.frequency.exponentialRampToValueAtTime(35, t + 0.4);
      const g = a.createGain();
      g.gain.setValueAtTime(0.28, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.45);
      osc.connect(g).connect(a.destination);
      osc.start(t);
      osc.stop(t + 0.5);
    }

    // ----- canvas sizing -----
    let W = 0, H = 0, dpr = 1;
    function resize() {
      dpr = window.devicePixelRatio || 1;
      W = canvas!.clientWidth;
      H = canvas!.clientHeight;
      canvas!.width = Math.max(1, Math.floor(W * dpr));
      canvas!.height = Math.max(1, Math.floor(H * dpr));
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    // ----- state -----
    let phase: Phase = 'idle';
    let lastFoot: 'L' | 'R' | null = null;
    let lastTapTime = 0;
    let distance = 0; // metres (float for sub-step resolution)
    let scrollX = 0; // px in screen space
    const TIME_LIMIT = 30; // seconds — clock starts on first input
    let timeLeft = TIME_LIMIT;
    let prevPose: Pose = idle;
    let nextPose: Pose = idle;
    let stepStart = 0;
    let stepDuration = 360; // ms — pose transition length
    let returnToIdleAt = 0; // ms — when to start tween back to idle
    let returnDuration = 220;
    let returningToIdle = false;
    let fallStart = 0;
    const FALL_DURATION = 700;

    // ----- timing window -----
    function currentWindow(): number {
      // 1000ms at 0 m, drops to 320ms by 80 m.
      const t = Math.min(1, distance / 80);
      return Math.round(1000 - t * 680);
    }
    const MIN_GAP = 90; // ms — taps closer than this = trip

    // ----- step trigger -----
    function step(foot: 'L' | 'R') {
      const now = performance.now();

      if (phase === 'falling' || phase === 'dead') return;

      // First tap — establish foot, no further checks
      if (phase === 'idle') {
        phase = 'walking';
        lastFoot = foot;
        lastTapTime = now;
        commitStep(foot, now);
        return;
      }

      // Wrong foot
      if (foot === lastFoot) {
        fall('Wrong foot.');
        return;
      }

      const gap = now - lastTapTime;
      if (gap < MIN_GAP) {
        fall('Too eager.');
        return;
      }

      lastFoot = foot;
      lastTapTime = now;
      commitStep(foot, now);
    }

    function commitStep(foot: 'L' | 'R', now: number) {
      // Pick a random silly pose. Mirror it for left-foot steps so the L leg
      // does the dramatic thing.
      const base = stepPoses[Math.floor(Math.random() * stepPoses.length)];
      let target: Pose = foot === 'L' ? mirror(base) : { ...base };

      // Per-step jitter — every angle wobbles ±4° (limbs ±7°) so no two
      // steps land identically.
      target = jitterPose(target);

      // 22% of the time the arms do the wrong thing — both forward, both
      // back, or otherwise un-counterbalanced. Heightens the "this man
      // should not be walking" energy.
      if (Math.random() < 0.22) target = confuseArms(target);

      prevPose = currentPose; // start tween from wherever we are
      nextPose = target;
      stepStart = now;
      returningToIdle = false;
      returnToIdleAt = now + 160;

      // stride length in metres — vary per step so the counter ticks pleasantly
      const stride = 0.7 + Math.random() * 0.8; // 0.7–1.5 m
      distance += stride;
      counterEl.textContent = String(Math.floor(distance));

      // give the briefcase pendulum a kick on the dramatic-leg side so it
      // swings exuberantly rather than just hanging
      briefcaseVel += (Math.random() - 0.5) * 0.5 + (foot === 'R' ? 0.3 : -0.3);

      // visual pad flash
      flashPad(foot, false);

      // pitch the clop slightly per step
      const pitch = 0.85 + Math.random() * 0.4;
      clop(pitch);
    }

    function jitterPose(p: Pose): Pose {
      const j = (mag: number) => (Math.random() - 0.5) * 2 * mag;
      const limb = D(7), small = D(4);
      return {
        torso: p.torso + j(small),
        head: p.head + j(small),
        Lhip: p.Lhip + j(limb),
        Lknee: p.Lknee + j(limb),
        Rhip: p.Rhip + j(limb),
        Rknee: p.Rknee + j(limb),
        Lshoulder: p.Lshoulder + j(limb),
        Lelbow: p.Lelbow + j(limb),
        Rshoulder: p.Rshoulder + j(limb),
        Relbow: p.Relbow + j(limb),
        hipLift: p.hipLift + j(4),
        bodyDrift: p.bodyDrift,
      };
    }

    function confuseArms(p: Pose): Pose {
      // Three modes: both forward, both back, or both flailed wide.
      const mode = Math.floor(Math.random() * 3);
      if (mode === 0) {
        // both forward
        return { ...p, Lshoulder: D(50), Lelbow: D(20), Rshoulder: D(60), Relbow: D(30) };
      }
      if (mode === 1) {
        // both back
        return { ...p, Lshoulder: D(-60), Lelbow: D(-30), Rshoulder: D(-70), Relbow: D(-40) };
      }
      // both wide — jazzhands
      return { ...p, Lshoulder: D(-100), Lelbow: D(-30), Rshoulder: D(100), Relbow: D(30) };
    }

    function flashPad(foot: 'L' | 'R', bad: boolean) {
      const el = foot === 'L' ? padL : padR;
      const cls = bad ? 'flash-bad' : 'flash';
      el!.classList.add(cls);
      window.setTimeout(() => el!.classList.remove(cls), bad ? 380 : 140);
    }

    function fall(reason: string) {
      if (phase === 'falling' || phase === 'dead') return;
      phase = 'falling';
      fallStart = performance.now();
      prevPose = currentPose;
      nextPose = ragdollPose;
      thud();
      reasonEl!.textContent = reason;

      // brief red flash on whichever pad caused it (best guess: latest)
      if (lastFoot) flashPad(lastFoot, true);
    }

    function showOverlay() {
      const finalMetres = Math.floor(distance);
      finalEl!.textContent = String(finalMetres);
      if (finalMetres > best) {
        best = finalMetres;
        localStorage.setItem('mos.best.m', String(best));
        bestEl!.textContent = String(best);
      }
      finalBestEl!.textContent = String(best);
      overlayEl!.hidden = false;
    }

    function reset() {
      phase = 'idle';
      lastFoot = null;
      lastTapTime = 0;
      distance = 0;
      scrollX = 0;
      currentPose = idle;
      prevPose = idle;
      nextPose = idle;
      returningToIdle = false;
      briefcaseAngle = 0;
      briefcaseVel = 0;
      lastHandX = null;
      lastHandY = null;
      timeLeft = TIME_LIMIT;
      counterEl!.textContent = '0';
      bestEl!.textContent = String(best);
      timeEl!.textContent = String(TIME_LIMIT);
      timeRowEl!.classList.remove('low');
      overlayEl!.hidden = true;
    }

    // ----- input -----
    function onKey(e: KeyboardEvent) {
      if (phase === 'dead') return;
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
        e.preventDefault();
        step('L');
      } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
        e.preventDefault();
        step('R');
      }
    }
    window.addEventListener('keydown', onKey, { signal: sig });

    function bindPad(el: HTMLElement, foot: 'L' | 'R') {
      const handler = (e: Event) => {
        e.preventDefault();
        if (phase === 'dead') return;
        step(foot);
      };
      el.addEventListener('pointerdown', handler, { signal: sig });
    }
    bindPad(padL, 'L');
    bindPad(padR, 'R');

    // overlay click to retry
    overlayEl.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      reset();
    }, { signal: sig });

    // ----- current animated pose -----
    let currentPose: Pose = idle;

    // ----- world scroll -----
    // distance increases monotonically. scrollX = distance * pxPerM.
    const PX_PER_M = 120;

    // ----- briefcase pendulum -----
    // The briefcase swings on its handle as the figure jerks around. Lags
    // behind the hand — looks much sillier than rigid attachment.
    let briefcaseAngle = 0;
    let briefcaseVel = 0;
    let lastHandX: number | null = null;
    let lastHandY: number | null = null;
    let lastFrameMs = 0;

    // ----- main loop -----
    let raf = 0;
    let frameErrored = false;
    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      try {
        tickFrame(now);
      } catch (err) {
        // Don't let a single bad frame kill the loop — log once, recover.
        if (!frameErrored) {
          frameErrored = true;
          console.error('[mos] frame error:', err, {
            phase, distance, briefcaseAngle, briefcaseVel,
            W, H, dpr, timeLeft,
          });
        }
      }
    }

    function tickFrame(now: number) {
      // Late-tap detection (only while walking and after first step)
      if (phase === 'walking' && lastTapTime > 0) {
        const since = now - lastTapTime;
        if (since > currentWindow()) {
          fall('Too slow.');
        }
      }

      // Countdown — only ticks once first step has been committed.
      if (phase === 'walking' && timeLeft > 0) {
        const dtSec = lastFrameMs ? Math.max(0, Math.min(0.1, (now - lastFrameMs) / 1000)) : 0.016;
        timeLeft = Math.max(0, timeLeft - dtSec);
        const shown = Math.ceil(timeLeft);
        if (timeEl!.textContent !== String(shown)) timeEl!.textContent = String(shown);
        if (shown <= 10) timeRowEl!.classList.add('low');
        else timeRowEl!.classList.remove('low');
        if (timeLeft <= 0) {
          fall('Time elapsed.');
        }
      }

      // Pose interpolation
      if (phase === 'falling') {
        const t = Math.min(1, (now - fallStart) / FALL_DURATION);
        const eased = easeInCubic(t);
        currentPose = lerpPose(prevPose, nextPose, eased);
        if (t >= 1) {
          phase = 'dead';
          showOverlay();
        }
      } else if (phase === 'walking') {
        const elapsed = now - stepStart;
        if (!returningToIdle && elapsed >= 160) {
          // swap to return-to-idle tween
          returningToIdle = true;
          prevPose = currentPose;
          nextPose = idle;
          stepStart = now;
        }
        const dur = returningToIdle ? returnDuration : 160;
        const t = Math.min(1, elapsed / dur);
        const eased = easeOutCubic(t);
        currentPose = lerpPose(prevPose, nextPose, eased);
      } else if (phase === 'idle' || phase === 'dead') {
        // hold pose
      }

      // smooth scroll target
      const targetScroll = distance * PX_PER_M;
      scrollX += (targetScroll - scrollX) * 0.18;

      // Skip render if canvas hasn't laid out yet — avoids weird zero-size
      // gradient / draw calls.
      if (W < 2 || H < 2) return;

      render(now);
    }

    // Adds gentle, ever-present body sway. Same shape every run (sin), but
    // the figure never stands perfectly still — looks barely-balanced.
    function applyWobble(p: Pose, now: number): Pose {
      const t = now / 1000;
      return {
        ...p,
        torso: p.torso + Math.sin(t * 1.7) * D(2.2),
        head: p.head + Math.sin(t * 2.4 + 1) * D(3),
        hipLift: p.hipLift + Math.sin(t * 1.3 + 2) * 1.6,
      };
    }

    function render(_now: number) {
      ctx!.save();
      ctx!.scale(dpr, dpr);
      ctx!.clearRect(0, 0, W, H);

      // ----- ground / road surface -----
      const groundY = Math.min(H - 40, H * 0.78);
      const figureCX = Math.max(160, W * 0.32);
      const roadH = Math.max(4, Math.min(60, H - groundY - 4));

      // road band: slightly darker than the cream bg, desaturated so it
      // reads as soft earth rather than yellow paper.
      if (roadH > 4) {
        const roadGrad = ctx!.createLinearGradient(0, groundY, 0, groundY + roadH);
        roadGrad.addColorStop(0, '#e3dcc1');
        roadGrad.addColorStop(0.7, '#d6cdaf');
        roadGrad.addColorStop(1, '#c8be9c');
        ctx!.fillStyle = roadGrad;
        ctx!.fillRect(0, groundY, W, roadH);
      }

      // top edge — bolder ground line
      ctx!.strokeStyle = 'rgba(58,46,26,0.55)';
      ctx!.lineWidth = 1.5;
      ctx!.beginPath();
      ctx!.moveTo(0, groundY + 0.75);
      ctx!.lineTo(W, groundY + 0.75);
      ctx!.stroke();

      // visible-world bounds in metres
      const startM = Math.floor((distance - figureCX / PX_PER_M));
      const endM = distance + (W - figureCX) / PX_PER_M + 1;

      // ----- deterministic scattered stones on the road -----
      // Each ~0.18m slot has a chance of holding a stone. Same world position
      // ⇒ same stone, so they scroll past coherently.
      const stoneSlot = 0.18;
      const startSlot = Math.floor(startM / stoneSlot);
      const endSlot = Math.ceil(endM / stoneSlot);
      for (let s = startSlot; s <= endSlot; s++) {
        const present = hash01(s + 11);
        if (present < 0.45) continue;
        const wX = s * stoneSlot + hash01(s + 113) * stoneSlot;
        const x = figureCX + (wX - distance) * PX_PER_M;
        if (x < -6 || x > W + 6) continue;
        const r = 0.7 + hash01(s + 211) * 2.2;
        const yOff = 4 + hash01(s + 311) * (roadH - 8);
        const tone = 0.16 + hash01(s + 411) * 0.22;
        ctx!.fillStyle = `rgba(58,46,26,${tone.toFixed(3)})`;
        ctx!.beginPath();
        safeEllipse(ctx!, x, groundY + yOff, r, r * 0.72, 0, 0, Math.PI * 2);
        ctx!.fill();
      }

      // ----- cracks on the surface — sparse, on/near the ground line -----
      const crackSlot = 1.6;
      const cStart = Math.floor(startM / crackSlot);
      const cEnd = Math.ceil(endM / crackSlot);
      ctx!.strokeStyle = 'rgba(58,46,26,0.34)';
      ctx!.lineWidth = 1;
      for (let s = cStart; s <= cEnd; s++) {
        if (hash01(s + 5101) < 0.5) continue;
        const wX = s * crackSlot + hash01(s + 5201) * crackSlot;
        const x = figureCX + (wX - distance) * PX_PER_M;
        if (x < -10 || x > W + 10) continue;
        const len = 4 + hash01(s + 5301) * 9;
        const ang = (hash01(s + 5401) - 0.5) * 0.7;
        const yOff = 1 + hash01(s + 5501) * 4;
        const cx2 = Math.cos(ang) * len * 0.5;
        const cy2 = Math.sin(ang) * len * 0.5;
        ctx!.beginPath();
        ctx!.moveTo(x - cx2, groundY + yOff - cy2);
        ctx!.lineTo(x + cx2, groundY + yOff + cy2);
        ctx!.stroke();
      }

      // ----- distance ticks -----
      ctx!.fillStyle = 'rgba(58,46,26,0.55)';
      ctx!.font = '10px Lora, Georgia, serif';
      ctx!.textAlign = 'center';
      for (let m = Math.ceil(startM); m <= endM; m += 1) {
        const x = figureCX + (m - distance) * PX_PER_M;
        const major = m % 5 === 0;
        const tickH = major ? 11 : 5;
        ctx!.strokeStyle = major ? 'rgba(58,46,26,0.55)' : 'rgba(58,46,26,0.28)';
        ctx!.lineWidth = major ? 1.2 : 1;
        ctx!.beginPath();
        ctx!.moveTo(x + 0.5, groundY + 1);
        ctx!.lineTo(x + 0.5, groundY + 1 + tickH);
        ctx!.stroke();
        if (major && m >= 0) {
          ctx!.fillText(`${m}`, x, groundY + 26);
        }
      }

      // Figure at fixed screen position — only legs/body change as we walk.
      const figureScale = Math.min(1.15, Math.max(0.85, H / 520));

      // Apply continuous body wobble — small sine perturbations on torso,
      // head, and hipLift even at rest. Suppressed during ragdoll.
      const wobblePose: Pose = phase === 'falling' || phase === 'dead'
        ? currentPose
        : applyWobble(currentPose, _now);

      const { handX, handY } = drawFigure(ctx!, figureCX, groundY, wobblePose, figureScale);

      // ----- briefcase pendulum simulation -----
      // Treat briefcase as a damped torsion pendulum hanging from the hand.
      // Hand horizontal motion drives angular velocity; gravity restores
      // toward straight-down (angle = 0).
      const dt = lastFrameMs ? Math.min(0.05, (_now - lastFrameMs) / 1000) : 0.016;
      lastFrameMs = _now;
      if (lastHandX !== null && lastHandY !== null) {
        const dx = handX - lastHandX;
        // horizontal hand velocity kicks the pendulum
        briefcaseVel += dx * 0.018;
      }
      lastHandX = handX;
      lastHandY = handY;
      // gravity restores toward 0
      briefcaseVel += -briefcaseAngle * 8 * dt;
      // damping
      briefcaseVel *= Math.pow(0.92, dt * 60);
      briefcaseAngle += briefcaseVel * dt * 8;
      // clamp to avoid the briefcase rotating past the hand
      if (briefcaseAngle > 2.0) { briefcaseAngle = 2.0; briefcaseVel = 0; }
      if (briefcaseAngle < -2.0) { briefcaseAngle = -2.0; briefcaseVel = 0; }

      drawBriefcase(ctx!, handX, handY, figureScale, briefcaseAngle);

      // subtle vignette at edges, cream-tinted, to focus on figure
      const grad = ctx!.createLinearGradient(0, 0, W, 0);
      grad.addColorStop(0, 'rgba(242,236,214,0.55)');
      grad.addColorStop(0.12, 'rgba(242,236,214,0)');
      grad.addColorStop(0.88, 'rgba(242,236,214,0)');
      grad.addColorStop(1, 'rgba(242,236,214,0.55)');
      ctx!.fillStyle = grad;
      ctx!.fillRect(0, 0, W, H);

      ctx!.restore();
    }

    raf = requestAnimationFrame(frame);

    // ----- cleanup on SPA navigation -----
    function teardown() {
      cancelAnimationFrame(raf);
      ro.disconnect();
      ac.abort();
      if (audioCtx) {
        audioCtx.close().catch(() => {});
        audioCtx = null;
      }
      document.removeEventListener('astro:before-swap', teardown);
    }
    document.addEventListener('astro:before-swap', teardown, { once: true });
  }

  document.addEventListener('astro:page-load', init);
</script>
</Layout>
