---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const markdownRooms = await getCollection('rooms', ({ data, id }) => {
  return !data.draft && !id.startsWith('_');
});

// Interactive rooms — Astro pages under /src/pages/room/<slug>/ — aren't in
// the content collection, so list them by hand here. Add a new entry per
// interactive room as it ships.
const interactiveRooms = [
  {
    id: 'ssb',
    title: 'SSB calculator.',
    summary: 'work out SSB yields and payouts.',
    date: new Date('2026-05-16'),
    href: '/room/ssb/',
  },
  {
    id: 'domsday',
    title: 'domsday machine.',
    summary: 'no pain no gain.',
    date: new Date('2026-05-08'),
    href: '/room/domsday/',
  },
  {
    id: 'mos',
    title: 'MOS.',
    summary: 'ministry of silly. walk.',
    date: new Date('2026-05-01'),
    href: '/room/mos/',
  },
  {
    id: 'papercut',
    title: 'papercut.',
    summary: 'tamagotchi for creative worker. feed them exposure.',
    date: new Date('2026-05-01'),
    href: '/room/papercut/',
  },
  {
    id: 'corporateladder',
    title: 'corporatelardder.',
    summary: 'log workouts to climb the corporate lardder.',
    date: new Date('2026-05-01'),
    href: '/room/corporateladder/',
  },
  {
    id: 'cooked',
    title: 'cooked.',
    summary: '90s big beat song reviews.',
    date: new Date('2026-04-30'),
    href: '/room/cooked/',
  },
];

const rooms = [
  ...markdownRooms.map(r => ({
    id: r.id,
    title: r.data.title,
    summary: r.data.summary,
    date: r.data.date ? new Date(r.data.date) : null,
    href: `/room/${r.id}/`,
  })),
  ...interactiveRooms,
];

rooms.sort((a, b) => {
  const da = a.date ? a.date.valueOf() : 0;
  const db = b.date ? b.date.valueOf() : 0;
  return db - da;
});
---

<Layout title="The Room — Mick Tan" description="every room mick tan has built" themeColor="#f0ece4">
  <main class="inverse-page">
    <header class="page-head">
      <a href="/" class="home-link" data-astro-prefetch>&larr; home</a>
      <h1>the room</h1>
      <p class="sub">collection of bugs and stuff, mostly buggy stuff.</p>
    </header>

    {rooms.length === 0 ? (
      <div class="empty">
        <p>nothing here yet.</p>
        <p class="empty-sub">mick is somewhere, building.</p>
      </div>
    ) : (
      <ol class="room-list" role="list">
        {rooms.map((room, i) => (
          <li class="room-item" style={`--i: ${i}`}>
            <a href={room.href} class="room-link" data-astro-prefetch>
              <span class="room-number">{String(i + 1).padStart(2, '0')}</span>
              <span class="room-title">{room.title}</span>
              {room.summary && <span class="room-summary">{room.summary}</span>}
            </a>
          </li>
        ))}
      </ol>
    )}
  </main>
</Layout>

<style>
  /* Inverse of the landing page: cream surface, dark ink. */
  html, body { background: #f0ece4; }

  .inverse-page {
    min-height: 100vh;
    background: #f0ece4;
    color: #2a2a27;
    font-family: 'Lora', Georgia, serif;
    padding: 4rem 2rem 6rem;
    overflow-x: hidden;
  }

  .page-head {
    max-width: 56rem;
    margin: 0 auto 5rem;
    position: relative;
  }

  /* Padded for a ~44px tap target; negative margin keeps the visual position. */
  .home-link {
    display: inline-block;
    color: #2a2a27;
    text-decoration: none;
    font-size: 0.85rem;
    opacity: 0.6;
    padding: 0.8rem;
    margin: -0.8rem -0.8rem 2.2rem;
    transition: opacity 200ms;
  }
  .home-link:hover { opacity: 0.95; }
  .home-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 2px;
    border-radius: 4px;
    opacity: 0.95;
  }

  .page-head h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #1a1812;
  }

  .page-head .sub {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-style: italic;
    opacity: 0.65;
    max-width: 30rem;
  }

  .empty {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4rem 0;
    font-style: italic;
    opacity: 0.5;
  }
  .empty-sub { margin-top: 0.4rem; opacity: 0.7; }

  .room-list {
    max-width: 56rem;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  /* Staggered entrance: each row fades up in sequence, phase-set by --i.
     Replays on SPA navigations too, since the swap re-inserts the elements. */
  .room-item {
    border-top: 1px solid rgba(42, 42, 39, 0.16);
    animation: room-enter 480ms cubic-bezier(.2,.8,.2,1) backwards;
    animation-delay: calc(var(--i, 0) * 45ms);
  }
  .room-item:last-child {
    border-bottom: 1px solid rgba(42, 42, 39, 0.16);
  }

  @keyframes room-enter {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-item { animation: none; }
    .room-link { transition: none; }
  }

  .room-item:nth-child(odd) .room-link { padding-left: 2rem; }
  .room-item:nth-child(even) .room-link { padding-left: 0; padding-right: 2rem; text-align: right; }

  .room-link {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    align-items: baseline;
    padding: 1.6rem 0;
    color: inherit;
    text-decoration: none;
    transition: transform 280ms cubic-bezier(.2,.8,.2,1), color 200ms;
    position: relative;
  }

  .room-item:nth-child(even) .room-link {
    grid-template-columns: 1fr auto;
  }

  .room-item:nth-child(even) .room-number { order: 2; }
  .room-item:nth-child(even) .room-title,
  .room-item:nth-child(even) .room-summary { order: 1; }

  .room-link:hover,
  .room-link:focus-visible { transform: translateX(8px); }
  .room-item:nth-child(even) .room-link:hover,
  .room-item:nth-child(even) .room-link:focus-visible { transform: translateX(-8px); }

  .room-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Number and summary wake up when the row is engaged. */
  .room-link:hover .room-number,
  .room-link:focus-visible .room-number { opacity: 0.9; }
  .room-link:hover .room-summary,
  .room-link:focus-visible .room-summary { opacity: 0.85; }

  .room-number {
    font-size: 0.85rem;
    font-feature-settings: 'tnum';
    opacity: 0.5;
    align-self: baseline;
    transition: opacity 200ms;
  }

  .room-title {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  .room-summary {
    grid-column: 2;
    font-size: 0.95rem;
    font-style: italic;
    opacity: 0.65;
    margin-top: 0.4rem;
    transition: opacity 200ms;
  }

  .room-item:nth-child(even) .room-summary {
    grid-column: 1;
    text-align: right;
  }

  /* Narrow screens: the asymmetric zigzag needs width to read as intentional.
     Collapse EVERYTHING to left-aligned — link padding, grid order, number
     position, and summary alignment. Must stay LAST in this stylesheet: these
     overrides tie the even-row rules above on specificity, so they only win
     by source order. */
  @media (max-width: 600px) {
    .room-item:nth-child(odd) .room-link,
    .room-item:nth-child(even) .room-link {
      padding-left: 0; padding-right: 0; text-align: left;
      grid-template-columns: auto 1fr;
    }
    .room-item:nth-child(even) .room-number { order: 0; }
    .room-item:nth-child(even) .room-title,
    .room-item:nth-child(even) .room-summary { order: 0; }
    .room-item:nth-child(even) .room-summary { grid-column: 2; text-align: left; }
    .room-item:nth-child(even) .room-link:hover,
    .room-item:nth-child(even) .room-link:focus-visible { transform: translateX(8px); }
  }
</style>
