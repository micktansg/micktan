---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const markdownRooms = await getCollection('rooms', ({ data, id }) => {
  return !data.draft && !id.startsWith('_');
});

// Interactive rooms — Astro pages under /src/pages/room/<slug>/ — aren't in
// the content collection, so list them by hand here. Add a new entry per
// interactive room as it ships.
const interactiveRooms = [
  {
    id: 'ssb',
    title: 'SSB calculator.',
    summary: 'work out SSB yields and payouts.',
    date: new Date('2026-05-16'),
    href: '/room/ssb/',
  },
  {
    id: 'domsday',
    title: 'domsday machine.',
    summary: 'no pain no gain.',
    date: new Date('2026-05-08'),
    href: '/room/domsday/',
  },
  {
    id: 'mos',
    title: 'MOS.',
    summary: 'ministry of silly. walk.',
    date: new Date('2026-05-01'),
    href: '/room/mos/',
  },
  {
    id: 'papercut',
    title: 'papercut.',
    summary: 'tamagotchi for creative worker. feed them exposure.',
    date: new Date('2026-05-01'),
    href: '/room/papercut/',
  },
  {
    id: 'corporateladder',
    title: 'corporatelardder.',
    summary: 'log workouts to climb the corporate lardder.',
    date: new Date('2026-05-01'),
    href: '/room/corporateladder/',
  },
  {
    id: 'cooked',
    title: 'cooked.',
    summary: '90s big beat song reviews.',
    date: new Date('2026-04-30'),
    href: '/room/cooked/',
  },
];

const rooms = [
  ...markdownRooms.map(r => ({
    id: r.id,
    title: r.data.title,
    summary: r.data.summary,
    date: r.data.date ? new Date(r.data.date) : null,
    href: `/room/${r.id}/`,
  })),
  ...interactiveRooms,
];

rooms.sort((a, b) => {
  const da = a.date ? a.date.valueOf() : 0;
  const db = b.date ? b.date.valueOf() : 0;
  return db - da;
});
---

<Layout title="The Room — Mick Tan" description="every room mick tan has built" themeColor="#f0ece4">
  <main class="inverse-page">
    <header class="page-head">
      <a href="/" class="home-link" data-astro-prefetch>&larr; home</a>
      <h1>the room</h1>
      <p class="sub">collection of bugs and stuff, mostly buggy stuff.</p>
    </header>

    {rooms.length === 0 ? (
      <div class="empty">
        <p>nothing here yet.</p>
        <p class="empty-sub">mick is somewhere, building.</p>
      </div>
    ) : (
      <>
        <ol class="room-list" role="list">
          {rooms.map((room, i) => (
            <li class="room-item" style={`--i: ${i}`}>
              <a href={room.href} class="room-link" data-room={room.id} data-astro-prefetch>
                <span class="room-number">{String(i + 1).padStart(2, '0')}</span>
                <span class="room-title">{room.title}</span>
                {room.summary && <span class="room-summary">{room.summary}</span>}
              </a>
              {/* Touch / narrow viewports: tap-to-peek. Lives outside the <a>
                  (no nested interactives); display-gated by media query. */}
              <div class="peek-zone">
                <button class="peek-btn" type="button" aria-expanded="false" aria-controls={`peek-${room.id}`} data-peek={room.id}>
                  peek
                </button>
                <div class="peek-panel" id={`peek-${room.id}`} hidden>
                  <div class="peek-panel-mat" aria-hidden="true">
                    <div class="peek-panel-frame">
                      <iframe data-src={room.href} loading="lazy" title={`live preview — ${room.title}`} tabindex="-1"></iframe>
                    </div>
                  </div>
                  <p class="peek-panel-hint">live. tap the title above to step inside.</p>
                </div>
              </div>
            </li>
          ))}
        </ol>

        {/* Desktop cursor lens: a small live window that trails the pointer
            while a row is hovered — same reveal instinct as the homepage lens.
            Purely decorative (the rows are the real links): aria-hidden,
            pointer-events none, iframes src-less until first shown. */}
        <div class="peek-lens" aria-hidden="true">
          <div class="peek-lens-mat">
            {rooms.map((room) => (
              <div class="peek-frame" data-room={room.id} hidden>
                <iframe data-src={room.href} loading="lazy" title={`live preview — ${room.title}`} tabindex="-1"></iframe>
              </div>
            ))}
          </div>
          <p class="peek-lens-caption"><span class="live-dot"></span>live</p>
        </div>
      </>
    )}
  </main>
</Layout>

<style>
  /* Inverse of the landing page: cream surface, dark ink. */
  html, body { background: #f0ece4; }

  .inverse-page {
    min-height: 100vh;
    background: #f0ece4;
    color: #2a2a27;
    font-family: 'Lora', Georgia, serif;
    padding: 4rem 2rem 6rem;
    overflow-x: hidden;
  }

  .page-head {
    max-width: 56rem;
    margin: 0 auto 5rem;
    position: relative;
  }

  /* Padded for a ~44px tap target; negative margin keeps the visual position. */
  .home-link {
    display: inline-block;
    color: #2a2a27;
    text-decoration: none;
    font-size: 0.85rem;
    opacity: 0.6;
    padding: 0.8rem;
    margin: -0.8rem -0.8rem 2.2rem;
    transition: opacity 200ms;
  }
  .home-link:hover { opacity: 0.95; }
  .home-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 2px;
    border-radius: 4px;
    opacity: 0.95;
  }

  .page-head h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #1a1812;
  }

  .page-head .sub {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-style: italic;
    opacity: 0.65;
    max-width: 30rem;
  }

  .empty {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4rem 0;
    font-style: italic;
    opacity: 0.5;
  }
  .empty-sub { margin-top: 0.4rem; opacity: 0.7; }

  .room-list {
    max-width: 56rem;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  /* Staggered entrance: each row fades up in sequence, phase-set by --i.
     Replays on SPA navigations too, since the swap re-inserts the elements. */
  .room-item {
    border-top: 1px solid rgba(42, 42, 39, 0.16);
    animation: room-enter 480ms cubic-bezier(.2,.8,.2,1) backwards;
    animation-delay: calc(var(--i, 0) * 45ms);
  }
  .room-item:last-child {
    border-bottom: 1px solid rgba(42, 42, 39, 0.16);
  }

  @keyframes room-enter {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-item { animation: none; }
    .room-link { transition: none; }
  }

  .room-item:nth-child(odd) .room-link { padding-left: 2rem; }
  .room-item:nth-child(even) .room-link { padding-left: 0; padding-right: 2rem; text-align: right; }

  .room-link {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    align-items: baseline;
    padding: 1.6rem 0;
    color: inherit;
    text-decoration: none;
    transition: transform 280ms cubic-bezier(.2,.8,.2,1), color 200ms;
    position: relative;
  }

  .room-item:nth-child(even) .room-link {
    grid-template-columns: 1fr auto;
  }

  .room-item:nth-child(even) .room-number { order: 2; }
  .room-item:nth-child(even) .room-title,
  .room-item:nth-child(even) .room-summary { order: 1; }

  .room-link:hover,
  .room-link:focus-visible { transform: translateX(8px); }
  .room-item:nth-child(even) .room-link:hover,
  .room-item:nth-child(even) .room-link:focus-visible { transform: translateX(-8px); }

  .room-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Number and summary wake up when the row is engaged. */
  .room-link:hover .room-number,
  .room-link:focus-visible .room-number { opacity: 0.9; }
  .room-link:hover .room-summary,
  .room-link:focus-visible .room-summary { opacity: 0.85; }

  .room-number {
    font-size: 0.85rem;
    font-feature-settings: 'tnum';
    opacity: 0.5;
    align-self: baseline;
    transition: opacity 200ms;
  }

  .room-title {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  .room-summary {
    grid-column: 2;
    font-size: 0.95rem;
    font-style: italic;
    opacity: 0.65;
    margin-top: 0.4rem;
    transition: opacity 200ms;
  }

  .room-item:nth-child(even) .room-summary {
    grid-column: 1;
    text-align: right;
  }

  /* Narrow screens: the asymmetric zigzag needs width to read as intentional.
     Collapse EVERYTHING to left-aligned — link padding, grid order, number
     position, and summary alignment. Must stay LAST in this stylesheet: these
     overrides tie the even-row rules above on specificity, so they only win
     by source order. */
  @media (max-width: 600px) {
    .room-item:nth-child(odd) .room-link,
    .room-item:nth-child(even) .room-link {
      padding-left: 0; padding-right: 0; text-align: left;
      grid-template-columns: auto 1fr;
    }
    .room-item:nth-child(even) .room-number { order: 0; }
    .room-item:nth-child(even) .room-title,
    .room-item:nth-child(even) .room-summary { order: 0; }
    .room-item:nth-child(even) .room-summary { grid-column: 2; text-align: left; }
    .room-item:nth-child(even) .room-link:hover,
    .room-item:nth-child(even) .room-link:focus-visible { transform: translateX(8px); }
  }

  /* ---- peek: shared mat styling ---- */

  .peek-lens-mat, .peek-panel-mat {
    background: #ffffff;
    border: 1px solid rgba(42, 42, 39, 0.16);
    padding: 0.5rem;
    border-radius: 2px;
  }

  .peek-frame, .peek-panel-frame {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    position: relative;
    background: #f7f5ef;
  }
  .peek-frame[hidden] { display: none !important; }

  .peek-frame iframe, .peek-panel-frame iframe {
    width: 200%;
    height: 200%;
    border: 0;
    transform: scale(0.5);
    transform-origin: top left;
    pointer-events: none;
  }

  .live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2a2a27;
    margin-right: 0.4rem;
    vertical-align: 1px;
    animation: live-pulse 2.4s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 0.25; }
    50%      { opacity: 1; }
  }

  /* ---- desktop cursor lens ---- */

  .peek-lens {
    position: fixed;
    top: 0;
    left: 0;
    width: 21rem;
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-200vw, -200vh, 0);
    transition: opacity 220ms ease;
    will-change: transform;
  }
  .peek-lens.on { opacity: 1; }

  .peek-lens-caption {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    font-style: italic;
    letter-spacing: 0.06em;
    text-align: center;
    opacity: 0.6;
  }

  /* The lens only exists for hover devices with room to breathe. */
  @media (hover: none), (max-width: 719px) {
    .peek-lens { display: none; }
  }

  /* ---- touch / narrow peek chips ---- */

  .peek-zone { display: none; }

  @media (hover: none), (max-width: 719px) {
    .peek-zone { display: block; padding-bottom: 1.3rem; }
  }

  .peek-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 1.1rem;
    background: transparent;
    border: 1px solid rgba(42, 42, 39, 0.35);
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.82rem;
    font-style: italic;
    color: inherit;
    opacity: 0.75;
    cursor: pointer;
  }
  .peek-btn[aria-expanded="true"] { background: #2a2a27; color: #f0ece4; opacity: 1; }
  .peek-btn:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 2px;
  }

  .peek-panel { margin-top: 0.9rem; }
  .peek-panel[hidden] { display: none !important; }

  .peek-panel-hint {
    margin-top: 0.45rem;
    font-size: 0.78rem;
    font-style: italic;
    opacity: 0.55;
  }

  /* Chips sit on the row's text side while the zigzag is alive (601–719px). */
  .room-item:nth-child(odd) .peek-zone { padding-left: 2rem; }
  .room-item:nth-child(even) .peek-zone { padding-right: 2rem; text-align: right; }
  @media (max-width: 600px) {
    .room-item:nth-child(odd) .peek-zone,
    .room-item:nth-child(even) .peek-zone { padding-left: 0; padding-right: 0; text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; opacity: 0.8; }
    .peek-lens { transition: none; }
  }
</style>

<script>
  // Two peek systems, gated by capability:
  //  - hover devices >=720px: a live lens that trails the cursor over the list
  //  - touch / narrow: per-row "peek" chips expanding an inline live panel
  // iframes only receive a src the first time they're shown.
  let peekAbort: AbortController | null = null;

  const initPeek = () => {
    const list = document.querySelector<HTMLElement>('.room-list');
    if (!list) return;

    peekAbort?.abort();
    peekAbort = new AbortController();
    const { signal } = peekAbort;

    /* ---- touch / narrow chips (listeners always attached; CSS gates display) ---- */
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.peek-btn'));
    const closeAllPanels = () => {
      for (const b of buttons) {
        b.setAttribute('aria-expanded', 'false');
        b.textContent = 'peek';
        const p = document.getElementById('peek-' + (b.dataset.peek ?? ''));
        if (p) p.hidden = true;
      }
    };
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const panel = document.getElementById('peek-' + (btn.dataset.peek ?? ''));
        if (!panel) return;
        const wasOpen = !panel.hidden;
        closeAllPanels();
        if (!wasOpen) {
          panel.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
          btn.textContent = 'close peek';
          const ifr = panel.querySelector('iframe');
          if (ifr && !ifr.src) ifr.src = ifr.dataset.src ?? '';
        }
      }, { signal });
    }

    /* ---- desktop cursor lens ---- */
    if (!matchMedia('(hover: hover) and (min-width: 720px)').matches) return;
    const lens = document.querySelector<HTMLElement>('.peek-lens');
    if (!lens) return;

    const frames = Array.from(lens.querySelectorAll<HTMLElement>('.peek-frame'));
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let targetX = 0, targetY = 0, curX = 0, curY = 0;
    let raf: number | null = null;
    let lensOn = false;

    const lensSize = () => ({ w: lens.offsetWidth || 336, h: lens.offsetHeight || 280 });

    const clampPos = (x: number, y: number) => {
      const { w, h } = lensSize();
      const pad = 10;
      return {
        x: Math.min(Math.max(x, pad), window.innerWidth - w - pad),
        y: Math.min(Math.max(y, pad), window.innerHeight - h - pad),
      };
    };

    const aimAtCursor = (e: MouseEvent) => {
      const { w, h } = lensSize();
      // Prefer the right of the cursor; flip left when out of room.
      let x = e.clientX + 28;
      if (x + w > window.innerWidth - 10) x = e.clientX - 28 - w;
      const p = clampPos(x, e.clientY - h / 2);
      targetX = p.x; targetY = p.y;
    };

    const tick = () => {
      const ease = reduceMotion ? 1 : 0.16;
      curX += (targetX - curX) * ease;
      curY += (targetY - curY) * ease;
      lens.style.transform = `translate3d(${curX}px, ${curY}px, 0)`;
      raf = lensOn ? requestAnimationFrame(tick) : null;
    };

    const showLens = (id: string | undefined, snapTo?: { x: number; y: number }) => {
      if (!id) return;
      for (const f of frames) {
        const on = f.dataset.room === id;
        f.hidden = !on;
        if (on) {
          const ifr = f.querySelector('iframe');
          if (ifr && !ifr.src) ifr.src = ifr.dataset.src ?? '';
        }
      }
      if (snapTo) {
        const p = clampPos(snapTo.x, snapTo.y);
        targetX = p.x; targetY = p.y;
        if (!lensOn) { curX = p.x; curY = p.y; }
      }
      if (!lensOn) {
        lensOn = true;
        lens.classList.add('on');
        if (raf === null) raf = requestAnimationFrame(tick);
      }
    };

    const hideLens = () => {
      lensOn = false;
      lens.classList.remove('on');
    };

    const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('.room-link[data-room]'));
    for (const link of links) {
      link.addEventListener('mouseenter', (e) => {
        showLens(link.dataset.room, { x: (e as MouseEvent).clientX + 28, y: (e as MouseEvent).clientY - 140 });
      }, { signal });
      // Keyboard: anchor the lens beside the focused row.
      link.addEventListener('focusin', () => {
        const r = link.getBoundingClientRect();
        showLens(link.dataset.room, { x: r.right - 320, y: r.bottom + 12 });
      }, { signal });
      link.addEventListener('focusout', hideLens, { signal });
    }

    list.addEventListener('mousemove', (e) => { if (lensOn) aimAtCursor(e); }, { signal });
    list.addEventListener('mouseleave', hideLens, { signal });

    signal.addEventListener('abort', () => { if (raf !== null) cancelAnimationFrame(raf); });
  };

  document.addEventListener('astro:page-load', initPeek);
</script>
