---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const markdownRooms = await getCollection('rooms', ({ data, id }) => {
  return !data.draft && !id.startsWith('_');
});

// Interactive rooms — Astro pages under /src/pages/room/<slug>/ — aren't in
// the content collection, so list them by hand here. Each entry is a gallery
// placard: medium (the materials line), intent (the hypothesis), and note
// (the curator's aside — allowed to wander).
const interactiveRooms = [
  {
    id: 'ssb',
    title: 'SSB calculator.',
    date: new Date('2026-05-16'),
    href: '/room/ssb/',
    medium: 'financial calculator. typescript, tables, deliberate amnesia.',
    intent: 'hypothesis: a finance tool can respect you — no account, no tracking, no memory. test: a bond calculator that forgets you on purpose.',
    note: 'the only exhibit your financial advisor may visit.',
  },
  {
    id: 'domsday',
    title: 'domsday machine.',
    date: new Date('2026-05-08'),
    href: '/room/domsday/',
    medium: 'adaptive training coach. three-step intake, phased plans, a bookmark instead of a login.',
    intent: 'hypothesis: a plan that adapts beats a plan that’s perfect. test: a coach that rebuilds your protocol every time life happens.',
    note: 'the machine forgives missed sessions. mondays are non-negotiable.',
  },
  {
    id: 'mos',
    title: 'MOS.',
    date: new Date('2026-05-01'),
    href: '/room/mos/',
    medium: 'browser game. canvas, two buttons, one government department.',
    intent: 'hypothesis: the dumbest possible input — alternate L and R — can still carry real tension. test: walk silly. don’t fall. apply for funding.',
    note: 'after cleese & chapman, 1970. the ministry’s budget remains unapproved.',
  },
  {
    id: 'papercut',
    title: 'papercut.',
    date: new Date('2026-05-01'),
    href: '/room/papercut/',
    medium: 'desk-pet life sim. sprite sheets, localstorage, zero salary.',
    intent: 'hypothesis: “we pay in exposure” is a horror premise. test: make it adorable, then watch the burnout bar.',
    note: 'exposure remains fatal at altitude.',
  },
  {
    id: 'corporateladder',
    title: 'corporatelardder.',
    date: new Date('2026-05-01'),
    href: '/room/corporateladder/',
    medium: 'multiplayer workout tracker. redis, boss fights, shared accountability.',
    intent: 'hypothesis: gym consistency is a team sport. test: every workout deals damage. the boss is everyone’s excuses.',
    note: 'lard is a renewable resource.',
  },
  {
    id: 'cooked',
    title: 'cooked.',
    date: new Date('2026-04-30'),
    href: '/room/cooked/',
    medium: 'music-review guessing game. 90s big beat, live ai judge.',
    intent: 'hypothesis: music reviews are theatre. test: read the prose, guess the verdict, argue with a machine.',
    note: 'the chemical brothers were not consulted.',
  },
];

const monthYear = (d: Date | null) =>
  d ? d.toLocaleString('en-US', { month: 'long', year: 'numeric' }).toLowerCase() : null;

const rooms = [
  ...markdownRooms.map(r => ({
    id: r.id,
    title: r.data.title,
    date: r.data.date ? new Date(r.data.date) : null,
    href: `/room/${r.id}/`,
    medium: 'field note. words, mostly.',
    intent: r.data.summary ?? '',
    note: null as string | null,
  })),
  ...interactiveRooms,
];

rooms.sort((a, b) => {
  const da = a.date ? a.date.valueOf() : 0;
  const db = b.date ? b.date.valueOf() : 0;
  return db - da;
});
---

<Layout
  title="The Room — Mick Tan"
  description="a live gallery of working experiments by mick tan, creative strategist."
  themeColor="#f0ece4"
>
  <main class="inverse-page">
    <header class="page-head">
      <a href="/" class="home-link" data-astro-prefetch>&larr; home</a>
      <h1>the room</h1>
      <p class="sub">a live gallery of working experiments — by mick tan, creative strategist.</p>
      <p class="sub-hint" aria-hidden="true">hover a placard. the exhibits are alive.</p>
    </header>

    {rooms.length === 0 ? (
      <div class="empty">
        <p>nothing here yet.</p>
        <p class="empty-sub">mick is somewhere, building.</p>
      </div>
    ) : (
      <div class="gallery-grid">
        <ol class="room-list" role="list">
          {rooms.map((room, i) => (
            <li class="room-item" style={`--i: ${i}`}>
              <a href={room.href} class="room-link" data-room={room.id} data-astro-prefetch>
                <span class="room-number">{String(i + 1).padStart(2, '0')}</span>
                <span class="placard">
                  <span class="room-title">{room.title}</span>
                  <span class="room-medium">{room.medium} {monthYear(room.date) && <span class="room-date">observed {monthYear(room.date)}.</span>}</span>
                  {room.intent && <span class="room-intent">{room.intent}</span>}
                  {room.note && <span class="room-note">{room.note}</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>

        {/* Live exhibit window — decorative duplication of the placard links,
            hidden from assistive tech and from touch / narrow viewports.
            iframes stay src-less until first shown, so nothing loads unless
            a desktop visitor actually engages. */}
        <aside class="exhibit" aria-hidden="true">
          <div class="exhibit-sticky">
            <div class="exhibit-mat">
              {rooms.map((room) => (
                <div class="exhibit-frame" data-room={room.id} hidden>
                  <iframe data-src={room.href} loading="lazy" title={`live preview — ${room.title}`} tabindex="-1"></iframe>
                </div>
              ))}
            </div>
            <p class="exhibit-caption">
              <span class="live-dot"></span>
              now showing — <span class="now-showing" data-now-showing></span>
            </p>
            <p class="exhibit-hint">live exhibit. click its placard to step inside.</p>
          </div>
        </aside>
      </div>
    )}

    <p class="wall-note">collection of bugs and stuff, mostly buggy stuff.</p>
  </main>
</Layout>

<style>
  /* Inverse of the landing page: cream surface, dark ink. */
  html, body { background: #f0ece4; }

  .inverse-page {
    min-height: 100vh;
    background: #f0ece4;
    color: #2a2a27;
    font-family: 'Lora', Georgia, serif;
    padding: 4rem 2rem 6rem;
    overflow-x: hidden;
  }

  .page-head {
    max-width: 76rem;
    margin: 0 auto 4rem;
    position: relative;
  }

  /* Padded for a ~44px tap target; negative margin keeps the visual position. */
  .home-link {
    display: inline-block;
    color: #2a2a27;
    text-decoration: none;
    font-size: 0.85rem;
    opacity: 0.6;
    padding: 0.8rem;
    margin: -0.8rem -0.8rem 2.2rem;
    transition: opacity 200ms;
  }
  .home-link:hover { opacity: 0.95; }
  .home-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 2px;
    border-radius: 4px;
    opacity: 0.95;
  }

  .page-head h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #1a1812;
  }

  .page-head .sub {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-style: italic;
    opacity: 0.7;
    max-width: 34rem;
  }

  .sub-hint {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-style: italic;
    opacity: 0.45;
  }
  /* The hint only makes sense where the exhibit window exists. */
  @media (max-width: 959px), (hover: none) {
    .sub-hint { display: none; }
  }

  .empty {
    max-width: 76rem;
    margin: 0 auto;
    padding: 4rem 0;
    font-style: italic;
    opacity: 0.5;
  }
  .empty-sub { margin-top: 0.4rem; opacity: 0.7; }

  .gallery-grid {
    max-width: 76rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 30rem);
    gap: 0 4rem;
    align-items: start;
  }

  @media (max-width: 959px), (hover: none) {
    .gallery-grid { grid-template-columns: minmax(0, 1fr); }
    .exhibit { display: none; }
  }

  .room-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Staggered entrance: each placard fades up in sequence, phase-set by --i.
     Replays on SPA navigations too, since the swap re-inserts the elements. */
  .room-item {
    border-top: 1px solid rgba(42, 42, 39, 0.16);
    animation: room-enter 480ms cubic-bezier(.2,.8,.2,1) backwards;
    animation-delay: calc(var(--i, 0) * 45ms);
  }
  .room-item:last-child {
    border-bottom: 1px solid rgba(42, 42, 39, 0.16);
  }

  @keyframes room-enter {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .room-link {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.4rem;
    align-items: baseline;
    padding: 1.5rem 0.75rem 1.5rem 0;
    color: inherit;
    text-decoration: none;
    transition: transform 280ms cubic-bezier(.2,.8,.2,1), background-color 200ms;
    position: relative;
  }

  .room-link:hover,
  .room-link:focus-visible { transform: translateX(8px); }

  .room-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* The placard currently on display in the exhibit window. */
  .room-link.is-showing .room-number { opacity: 1; }

  .room-link:hover .room-number,
  .room-link:focus-visible .room-number { opacity: 0.9; }
  .room-link:hover .room-note,
  .room-link:focus-visible .room-note { opacity: 0.85; }

  .room-number {
    font-size: 0.85rem;
    font-feature-settings: 'tnum';
    opacity: 0.5;
    align-self: baseline;
    transition: opacity 200ms;
  }

  .placard {
    display: block;
    min-width: 0;
  }

  .room-title {
    display: block;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  .room-medium {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    opacity: 0.65;
  }
  .room-date { opacity: 0.8; }

  .room-intent {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.55;
    opacity: 0.85;
    max-width: 36rem;
  }

  .room-note {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-style: italic;
    opacity: 0.65;
    transition: opacity 200ms;
  }
  .room-note::before { content: '\2014 '; }

  /* ---- The exhibit window ---- */

  .exhibit-sticky {
    position: sticky;
    top: 3rem;
  }

  .exhibit-mat {
    background: #ffffff;
    border: 1px solid rgba(42, 42, 39, 0.16);
    padding: 0.6rem;
    border-radius: 2px;
  }

  .exhibit-frame {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    position: relative;
    background: #f7f5ef;
  }
  .exhibit-frame[hidden] { display: none; }

  .exhibit-frame iframe {
    width: 200%;
    height: 200%;
    border: 0;
    transform: scale(0.5);
    transform-origin: top left;
    pointer-events: none;
  }

  .exhibit-caption {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    text-align: center;
    opacity: 0.85;
  }

  .now-showing { font-style: italic; }

  .live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2a2a27;
    margin-right: 0.45rem;
    vertical-align: 2px;
    animation: live-pulse 2.4s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 0.25; }
    50%      { opacity: 1; }
  }

  .exhibit-hint {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-style: italic;
    text-align: center;
    opacity: 0.5;
  }

  .wall-note {
    max-width: 76rem;
    margin: 4rem auto 0;
    font-size: 0.85rem;
    font-style: italic;
    text-align: center;
    opacity: 0.5;
  }

  @media (max-width: 600px) {
    .inverse-page { padding: 3rem 1.25rem 4rem; }
    .page-head { margin-bottom: 3rem; }
    .room-link { column-gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-item { animation: none; }
    .room-link { transition: none; }
    .live-dot { animation: none; opacity: 0.8; }
  }
</style>

<script>
  // Live exhibit window: hovering (or keyboard-focusing) a placard shows that
  // room running live in the side panel. iframes only get a src the first
  // time they're shown, so touch and narrow-viewport visitors load nothing.
  let galleryAbort: AbortController | null = null;

  const initGallery = () => {
    const list = document.querySelector('.gallery-grid .room-list');
    if (!list) return;

    galleryAbort?.abort();
    galleryAbort = new AbortController();
    const { signal } = galleryAbort;

    if (!matchMedia('(min-width: 960px) and (hover: hover)').matches) return;

    const frames = Array.from(document.querySelectorAll<HTMLElement>('.exhibit-frame'));
    const caption = document.querySelector<HTMLElement>('[data-now-showing]');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.room-link[data-room]'));
    if (frames.length === 0 || links.length === 0) return;

    const show = (id: string | undefined, title: string) => {
      if (!id) return;
      for (const f of frames) {
        const on = f.dataset.room === id;
        f.hidden = !on;
        if (on) {
          const ifr = f.querySelector('iframe');
          if (ifr && !ifr.src) ifr.src = ifr.dataset.src ?? '';
        }
      }
      for (const l of links) l.classList.toggle('is-showing', l.dataset.room === id);
      if (caption) caption.textContent = title;
    };

    for (const link of links) {
      const title = link.querySelector('.room-title')?.textContent ?? '';
      link.addEventListener('mouseenter', () => show(link.dataset.room, title), { signal });
      link.addEventListener('focusin', () => show(link.dataset.room, title), { signal });
    }

    // Opening exhibit: the newest room, so the window is never blank.
    const first = links[0];
    show(first.dataset.room, first.querySelector('.room-title')?.textContent ?? '');
  };

  document.addEventListener('astro:page-load', initGallery);
</script>
