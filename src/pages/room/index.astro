---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const markdownRooms = await getCollection('rooms', ({ data, id }) => {
  return !data.draft && !id.startsWith('_');
});

// Interactive rooms — Astro pages under /src/pages/room/<slug>/ — aren't in
// the content collection, so list them by hand here. Add a new entry per
// interactive room as it ships.
const interactiveRooms = [
  {
    id: 'ssb',
    title: 'SSB calculator.',
    summary: 'work out SSB yields and payouts.',
    date: new Date('2026-05-16'),
    href: '/room/ssb/',
  },
  {
    id: 'domsday',
    title: 'domsday machine.',
    summary: 'no pain no gain.',
    date: new Date('2026-05-08'),
    href: '/room/domsday/',
  },
  {
    id: 'mos',
    title: 'MOS.',
    summary: 'ministry of silly. walk.',
    date: new Date('2026-05-01'),
    href: '/room/mos/',
  },
  {
    id: 'papercut',
    title: 'papercut.',
    summary: 'tamagotchi for creative worker. feed them exposure.',
    date: new Date('2026-05-01'),
    href: '/room/papercut/',
  },
  {
    id: 'corporateladder',
    title: 'corporatelardder.',
    summary: 'log workouts to climb the corporate lardder.',
    date: new Date('2026-05-01'),
    href: '/room/corporateladder/',
  },
  {
    id: 'cooked',
    title: 'cooked.',
    summary: '90s big beat song reviews.',
    date: new Date('2026-04-30'),
    href: '/room/cooked/',
  },
];

const rooms = [
  ...markdownRooms.map(r => ({
    id: r.id,
    title: r.data.title,
    summary: r.data.summary,
    date: r.data.date ? new Date(r.data.date) : null,
    href: `/room/${r.id}/`,
  })),
  ...interactiveRooms,
];

rooms.sort((a, b) => {
  const da = a.date ? a.date.valueOf() : 0;
  const db = b.date ? b.date.valueOf() : 0;
  return db - da;
});
---

<Layout title="The Room — Mick Tan" description="every room mick tan has built" themeColor="#f0ece4">
  <main class="inverse-page">
    <header class="page-head">
      <a href="/" class="home-link" data-astro-prefetch>&larr; home</a>
      <h1 aria-label="the room">
        {'the room'.split('').map((ch, i) => (
          <span class="h1-ch" aria-hidden="true" style={`--d: ${i * 55}ms`}>{ch === ' ' ? ' ' : ch}</span>
        ))}
      </h1>
      <p class="sub">
        <span class="sr-only">collection of bugs and stuff, mostly buggy stuff.</span>
        <span aria-hidden="true">
          {'collection of bugs and stuff, mostly buggy stuff.'.split(' ').map((word, wi, arr) => (
            <>
              <span class="sub-word">{word.split('').map((ch) => <span class="sub-ch">{ch}</span>)}</span>
              {wi < arr.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      </p>
    </header>

    {rooms.length === 0 ? (
      <div class="empty">
        <p>nothing here yet.</p>
        <p class="empty-sub">mick is somewhere, building.</p>
      </div>
    ) : (
      <ol class="room-list" role="list">
        {rooms.map((room, i) => (
          <li class="room-item" style={`--i: ${i}`}>
            <a href={room.href} class="room-link" data-astro-prefetch>
              <span class="room-number">{String(i + 1).padStart(2, '0')}</span>
              <span class="room-title">{room.title}</span>
              {room.summary && <span class="room-summary">{room.summary}</span>}
            </a>
          </li>
        ))}
      </ol>
    )}

    {/* Ink veil: entering a room inverts the page to the homepage's dark
        before navigation — the same cream/dark inversion the site is built on. */}
    <div class="ink-veil" aria-hidden="true"><p class="ink-veil-text"></p></div>
  </main>
</Layout>

<style>
  /* Inverse of the landing page: cream surface, dark ink. */
  html, body { background: #f0ece4; }

  .inverse-page {
    min-height: 100vh;
    background: #f0ece4;
    color: #2a2a27;
    font-family: 'Lora', Georgia, serif;
    padding: 4rem 2rem 6rem;
    overflow-x: hidden;
  }

  .page-head {
    max-width: 56rem;
    margin: 0 auto 5rem;
    position: relative;
  }

  /* Padded for a ~44px tap target; negative margin keeps the visual position. */
  .home-link {
    display: inline-block;
    color: #2a2a27;
    text-decoration: none;
    font-size: 0.85rem;
    opacity: 0.6;
    padding: 0.8rem;
    margin: -0.8rem -0.8rem 2.2rem;
    transition: opacity 200ms;
  }
  .home-link:hover { opacity: 0.95; }
  .home-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 2px;
    border-radius: 4px;
    opacity: 0.95;
  }

  .page-head h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #1a1812;
  }

  .page-head .sub {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-style: italic;
    opacity: 0.65;
    max-width: 30rem;
  }

  .empty {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4rem 0;
    font-style: italic;
    opacity: 0.5;
  }
  .empty-sub { margin-top: 0.4rem; opacity: 0.7; }

  .room-list {
    max-width: 56rem;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  /* Staggered entrance: each row fades up in sequence, phase-set by --i.
     Replays on SPA navigations too, since the swap re-inserts the elements. */
  .room-item {
    border-top: 1px solid rgba(42, 42, 39, 0.16);
    animation: room-enter 480ms cubic-bezier(.2,.8,.2,1) backwards;
    animation-delay: calc(var(--i, 0) * 45ms);
  }
  .room-item:last-child {
    border-bottom: 1px solid rgba(42, 42, 39, 0.16);
  }

  @keyframes room-enter {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-item { animation: none; }
    .room-link { transition: none; }
    .h1-ch { animation: none; opacity: 1; transform: none; }
    .sub-ch { transform: none; }
    .ink-veil { transition: opacity 200ms linear; }
  }

  /* Arrival: the title's letters settle into place with a little weight.
     The transform runs through --kx/--ky so the kinetic drift can keep
     steering letters even while the animation's fill state applies. */
  .h1-ch {
    display: inline-block;
    opacity: 0;
    transform: translate(var(--kx, 0px), calc(var(--ky, 0px) + 0.22em));
    animation: h1-settle 560ms cubic-bezier(.18,.9,.22,1.08) forwards;
    animation-delay: var(--d, 0ms);
    white-space: pre;
  }

  @keyframes h1-settle {
    to { opacity: 1; transform: translate(var(--kx, 0px), var(--ky, 0px)); }
  }

  .sub-word { display: inline-block; }
  .sub-ch {
    display: inline-block;
    transform: translate(var(--kx, 0px), var(--ky, 0px));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Scroll spotlight: the row nearest the viewport centre is awake —
     same engaged state as hover, driven by scroll so it works identically
     on touch. Set from JS via .lit on the <li>. */
  .room-item.lit .room-link { background: rgba(42, 42, 39, 0.04); transform: translateX(8px); }
  .room-item.lit:nth-child(even) .room-link { transform: translateX(-8px); }
  .room-item.lit .room-number { opacity: 0.9; }
  .room-item.lit .room-summary { opacity: 0.85; }
  .room-item.lit .room-title { color: #0f0e0b; }

  /* A mouse over the list suspends the spotlight: only the hovered row
     stays awake, so two rows never glow at once on desktop. */
  .room-list:hover .room-item.lit:not(:hover) .room-link { background: transparent; transform: none; }
  .room-list:hover .room-item.lit:not(:hover) .room-number { opacity: 0.5; }
  .room-list:hover .room-item.lit:not(:hover) .room-summary { opacity: 0.65; }
  .room-list:hover .room-item.lit:not(:hover) .room-title { color: inherit; }

  /* Ink veil: shown on room entry, dark with a single italic line. */
  .ink-veil {
    position: fixed;
    inset: 0;
    background: #2a2a27;
    opacity: 0;
    pointer-events: none;
    z-index: 100;
    transition: opacity 520ms cubic-bezier(.4, 0, .2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ink-veil.active { opacity: 1; pointer-events: auto; }
  .ink-veil-text {
    color: #f0ece4;
    font-style: italic;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    opacity: 0.85;
  }

  .room-item:nth-child(odd) .room-link { padding-left: 2rem; }
  .room-item:nth-child(even) .room-link { padding-left: 0; padding-right: 2rem; text-align: right; }

  .room-link {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    align-items: baseline;
    padding: 1.6rem 0;
    color: inherit;
    text-decoration: none;
    transition: transform 280ms cubic-bezier(.2,.8,.2,1), color 200ms, background-color 240ms;
    position: relative;
  }

  .room-item:nth-child(even) .room-link {
    grid-template-columns: 1fr auto;
  }

  .room-item:nth-child(even) .room-number { order: 2; }
  .room-item:nth-child(even) .room-title,
  .room-item:nth-child(even) .room-summary { order: 1; }

  .room-link:hover,
  .room-link:focus-visible { transform: translateX(8px); }
  .room-item:nth-child(even) .room-link:hover,
  .room-item:nth-child(even) .room-link:focus-visible { transform: translateX(-8px); }

  .room-link:focus-visible {
    outline: 2px dashed rgba(42, 42, 39, 0.55);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Number and summary wake up when the row is engaged. */
  .room-link:hover .room-number,
  .room-link:focus-visible .room-number { opacity: 0.9; }
  .room-link:hover .room-summary,
  .room-link:focus-visible .room-summary { opacity: 0.85; }

  .room-number {
    font-size: 0.85rem;
    font-feature-settings: 'tnum';
    opacity: 0.5;
    align-self: baseline;
    transition: opacity 200ms;
  }

  /* justify-self makes the title box hug its text instead of stretching
     across the grid column — the kinetic drift measures distance to the
     title's centre, which must be the centre of the visible words. */
  .room-title {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
    transition: color 240ms;
    justify-self: start;
  }
  .room-item:nth-child(even) .room-title { justify-self: end; }

  .room-summary {
    grid-column: 2;
    font-size: 0.95rem;
    font-style: italic;
    opacity: 0.65;
    margin-top: 0.4rem;
    transition: opacity 200ms;
  }

  .room-item:nth-child(even) .room-summary {
    grid-column: 1;
    text-align: right;
  }

  /* Narrow screens: the asymmetric zigzag needs width to read as intentional.
     Collapse EVERYTHING to left-aligned — link padding, grid order, number
     position, and summary alignment. Must stay LAST in this stylesheet: these
     overrides tie the even-row rules above on specificity, so they only win
     by source order. */
  @media (max-width: 600px) {
    .room-item:nth-child(odd) .room-link,
    .room-item:nth-child(even) .room-link {
      padding-left: 0; padding-right: 0; text-align: left;
      grid-template-columns: auto 1fr;
    }
    .room-item:nth-child(even) .room-number { order: 0; }
    .room-item:nth-child(even) .room-title,
    .room-item:nth-child(even) .room-summary { order: 0; }
    .room-item:nth-child(even) .room-summary { grid-column: 2; text-align: left; }
    .room-item:nth-child(even) .room-title { justify-self: start; }
    .room-item:nth-child(even) .room-link:hover,
    .room-item:nth-child(even) .room-link:focus-visible { transform: translateX(8px); }
    .room-item.lit .room-link,
    .room-item.lit:nth-child(even) .room-link { transform: translateX(8px); }
  }
</style>

<script>
  // The hall: scroll spotlight + ink-veil entry. Re-inits on SPA navigations;
  // AbortController prevents listener pile-up (see project gotchas).
  let hallAbort: AbortController | null = null;

  const initHall = () => {
    const list = document.querySelector<HTMLElement>('.inverse-page .room-list');
    if (!list) return;

    hallAbort?.abort();
    hallAbort = new AbortController();
    const { signal } = hallAbort;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hoverDevice = matchMedia('(hover: hover)').matches;
    const items = Array.from(list.querySelectorAll<HTMLElement>('.room-item'));
    const veil = document.querySelector<HTMLElement>('.ink-veil');
    const veilText = document.querySelector<HTMLElement>('.ink-veil-text');
    if (veil) veil.classList.remove('active');

    // Back/forward cache restores the page exactly as it was left — with the
    // veil still up. pageshow fires on those restores; astro:page-load doesn't.
    window.addEventListener('pageshow', () => veil?.classList.remove('active'), { signal });

    // Entry: flood the page with ink, then step through.
    if (veil) {
      for (const item of items) {
        const link = item.querySelector<HTMLAnchorElement>('.room-link');
        if (!link) continue;
        link.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
          e.preventDefault();
          const title = link.querySelector('.room-title')?.textContent?.trim() ?? '';
          if (veilText) veilText.textContent = title ? `stepping into ${title} …` : '…';
          veil.classList.add('active');
          setTimeout(() => { window.location.href = link.href; }, reduceMotion ? 250 : 600);
        }, { signal });
      }
    }

    if (reduceMotion) return;

    // Spotlight: wake the row nearest the focus point. On mouse devices the
    // focus follows the cursor (a tall window may never scroll, which left
    // the scroll-driven spotlight frozen on one arbitrary row). On touch it
    // follows a line that drifts from 35% to 75% of the viewport with scroll
    // progress, so the last rows of a short page can still reach it.
    let pointerX = -1;
    let pointerY = -1;
    let ticking = false;
    const spotlight = () => {
      ticking = false;
      let mid: number;
      if (hoverDevice && pointerY >= 0) {
        mid = pointerY;
      } else {
        const range = document.documentElement.scrollHeight - window.innerHeight;
        const progress = range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0.5;
        // Scrolled to the very bottom: the last room always gets its moment,
        // regardless of how the geometry happens to tie-break.
        if (range > 0 && progress >= 0.99) {
          const last = items[items.length - 1];
          for (const item of items) item.classList.toggle('lit', item === last);
          return;
        }
        mid = window.innerHeight * (0.35 + 0.4 * progress);
      }
      let best: HTMLElement | null = null;
      let bestD = Infinity;
      for (const item of items) {
        const r = item.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - mid);
        if (d < bestD) { bestD = d; best = item; }
      }
      for (const item of items) item.classList.toggle('lit', item === best);
    };
    let wakeKinetic: (() => void) | null = null;
    const queue = () => { if (!ticking) { ticking = true; requestAnimationFrame(spotlight); } };
    window.addEventListener('scroll', () => { queue(); wakeKinetic?.(); }, { passive: true, signal });
    window.addEventListener('resize', queue, { passive: true, signal });
    spotlight();

    // Kinetic type: row titles drift whole; the header and subheader react
    // per letter (tighter radius, so a small wave follows the cursor through
    // the words). Letters apply via --kx/--ky so the h1 settle animation's
    // fill state and the drift can share the same transform. The rAF loop
    // sleeps once everything has settled; mousemove wakes it.
    if (hoverDevice) {
      type Group = {
        els: HTMLElement[];
        cur: { x: number; y: number }[];
        radius: number;
        k: number;
        capX: number;
        capY: number;
        useVars: boolean;
      };
      const collect = (sel: string, root: ParentNode = document) =>
        Array.from(root.querySelectorAll<HTMLElement>(sel));
      const titleEls = items
        .map(it => it.querySelector<HTMLElement>('.room-title'))
        .filter((t): t is HTMLElement => t !== null);
      const letterEls = collect('.page-head .h1-ch, .page-head .sub-ch');
      const groups: Group[] = [
        { els: titleEls, cur: titleEls.map(() => ({ x: 0, y: 0 })), radius: 300, k: 0.07, capX: 6, capY: 3, useVars: false },
        { els: letterEls, cur: letterEls.map(() => ({ x: 0, y: 0 })), radius: 140, k: 0.06, capX: 4, capY: 3, useVars: true },
      ];
      let kRaf: number | null = null;

      const kTick = () => {
        kRaf = null;
        let busy = false;
        for (const g of groups) {
          for (let i = 0; i < g.els.length; i++) {
            const el = g.els[i];
            const c = g.cur[i];
            const r = el.getBoundingClientRect();
            const baseX = r.left + r.width / 2 - c.x;
            const baseY = r.top + r.height / 2 - c.y;
            let tx = 0, ty = 0;
            if (pointerY >= 0) {
              const vx = pointerX - baseX;
              const vy = pointerY - baseY;
              const dist = Math.hypot(vx, vy) || 1;
              const influence = Math.max(0, 1 - dist / g.radius);
              const pull = influence * influence;
              tx = Math.max(-g.capX, Math.min(g.capX, vx * g.k * pull));
              ty = Math.max(-g.capY, Math.min(g.capY, vy * g.k * pull));
            }
            c.x += (tx - c.x) * 0.11;
            c.y += (ty - c.y) * 0.11;
            if (Math.abs(c.x - tx) > 0.06 || Math.abs(c.y - ty) > 0.06) busy = true;
            if (g.useVars) {
              el.style.setProperty('--kx', `${c.x.toFixed(2)}px`);
              el.style.setProperty('--ky', `${c.y.toFixed(2)}px`);
            } else {
              el.style.transform = `translate(${c.x.toFixed(2)}px, ${c.y.toFixed(2)}px)`;
            }
          }
        }
        if (busy) kRaf = requestAnimationFrame(kTick);
      };
      wakeKinetic = () => { if (kRaf === null) kRaf = requestAnimationFrame(kTick); };

      window.addEventListener('mousemove', (e) => {
        pointerX = e.clientX;
        pointerY = e.clientY;
        queue();
        wakeKinetic?.();
      }, { passive: true, signal });

      document.documentElement.addEventListener('mouseleave', () => {
        pointerX = -1;
        pointerY = -1;
        queue();
        wakeKinetic?.();
      }, { signal });

      signal.addEventListener('abort', () => { if (kRaf !== null) cancelAnimationFrame(kRaf); });
    }
  };

  document.addEventListener('astro:page-load', initHall);
</script>
