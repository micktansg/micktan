---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="papercut. — Mick Tan" description="feed them exposure. the only way to win is to quit.">
  <main class="pc">
    <div class="topbar">
      <a class="back" href="/room/" data-astro-prefetch>&larr; the room</a>
      <button class="bgm-toggle" id="bgmToggle" type="button" aria-label="toggle ambient audio">
        <span id="bgmIcon">🔇</span>
        <span class="bgm-label" id="bgmLabel">audio off</span>
      </button>
    </div>

    <header class="head">
      <h1>papercut<span class="dot">.</span></h1>
      <p class="sub">feed them exposure. <span class="nowrap">the only way to win is to quit.</span></p>
    </header>

    {/* SVG defs: paper-cut filter, halftone pattern, newspaper-text pattern */}
    <svg width="0" height="0" aria-hidden="true" style="position:absolute;width:0;height:0">
      <defs>
        <filter id="papercut-edge" x="-3%" y="-3%" width="106%" height="106%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" />
        </filter>
        <pattern id="halftone-dots" width="6" height="6" patternUnits="userSpaceOnUse">
          <circle cx="3" cy="3" r="1.2" fill="#0a1f3a" />
        </pattern>
        <pattern id="newspaper" width="60" height="14" patternUnits="userSpaceOnUse">
          <rect width="60" height="14" fill="#fafaf5" />
          <text x="0" y="9" font-family="Georgia, serif" font-size="6" fill="#1a1a1a">die wollten,</text>
          <text x="0" y="13" font-family="Georgia, serif" font-size="3.5" fill="#2a2a2a">nicht aber sich nahen,</text>
        </pattern>
        <pattern id="newspaper-2" width="80" height="22" patternUnits="userSpaceOnUse">
          <rect width="80" height="22" fill="#f5f5ee" />
          <text x="0" y="6" font-family="Georgia, serif" font-size="4" fill="#1a1a1a">renselbe das in vorzeichen die</text>
          <text x="0" y="11" font-family="Georgia, serif" font-size="3.5" fill="#2a2a2a">aus rauschen sie wendet sich um</text>
          <text x="0" y="16" font-family="Georgia, serif" font-size="4.5" fill="#1a1a1a">ein wollen, sie als kalte zahlen</text>
          <text x="0" y="20" font-family="Georgia, serif" font-size="3" fill="#3a3a3a">ment ge,verg, kannte fra,</text>
        </pattern>
        <pattern id="grid-fine" width="4" height="4" patternUnits="userSpaceOnUse">
          <rect width="4" height="4" fill="#fafaf5" />
          <circle cx="0" cy="0" r="0.6" fill="#1a1a1a" />
        </pattern>
      </defs>
    </svg>

    <section class="game" id="game">
     <div class="capsule">
      {/* Stat bars at top */}
      <div class="device-stats">
        <div class="stat" title="how fed they are on exposure"><span class="lbl">fed</span><span class="bar"><span class="fill" id="fedFill"></span></span></div>
        <div class="stat" title="mood"><span class="lbl">mood</span><span class="bar"><span class="fill" id="moodFill"></span></span></div>
        <div class="stat burnout-stat" title="burnout — at high values, things catch fire"><span class="lbl">🔥</span><span class="bar"><span class="fill burnout-fill" id="burnoutFill"></span></span></div>
      </div>

      {/* The collage stage */}
      <div class="stage" id="stage">
        {/* Trophy wall — awards plastered across the back wall (his world, his decoration) */}
        <div class="trophy-wall" id="trophyWall" aria-hidden="true"></div>

        {/* The character — collage figure with newspaper-text body */}
        <svg class="character" id="character" viewBox="0 0 200 320" aria-label="creative worker" filter="url(#papercut-edge)">
          {/* Hair — three variants. Only the one matching the career stage shows. */}
          <path class="hair-full" d="M62,52 Q100,18 138,52 L138,90 Q124,75 100,72 Q76,75 62,90 Z" />
          <path class="hair-receding" d="M68,60 Q100,32 132,60 L132,82 Q120,72 100,72 Q80,72 68,82 Z" />
          <path class="hair-sides" d="M62,70 Q66,58 78,60 L78,90 Q70,82 62,90 Z M138,70 Q134,58 122,60 L122,90 Q130,82 138,90 Z" />
          {/* Head — skin-toned, slightly desaturated like a grayscale photo */}
          <ellipse class="head" cx="100" cy="78" rx="38" ry="42" />
          {/* Eye-bags (Senior+) */}
          <path class="bag bag-left" d="M75,86 Q86,88 96,86" />
          <path class="bag bag-right" d="M104,86 Q114,88 125,86" />
          {/* Eyes */}
          <circle class="eye eye-left" cx="86" cy="80" r="3" />
          <circle class="eye eye-right" cx="114" cy="80" r="3" />
          {/* Mouth */}
          <path class="mouth" id="mouth" d="M84,98 Q100,108 116,98" />
          {/* Glasses (CD+) */}
          <g class="glasses">
            <circle cx="86" cy="80" r="9" />
            <circle cx="114" cy="80" r="9" />
            <line x1="95" y1="80" x2="105" y2="80" />
          </g>
          {/* Neck */}
          <rect class="neck" x="90" y="115" width="20" height="18" />
          {/* Tie */}
          <path class="tie" d="M94,133 L106,133 L108,180 L92,180 Z" />
          {/* Body — newspaper-text dress */}
          <path class="body" d="M64,128 L136,128 Q145,150 142,200 L154,260 L46,260 L58,200 Q55,150 64,128 Z" />
          {/* Body shading (subtle stripes from a midline) */}
          <path class="body-fold" d="M100,128 L100,260" />
          {/* Lanyard / badge accent (Junior+) */}
          <path class="lanyard" d="M96,128 L104,128 L102,158 L98,158 Z" />
          <rect class="badge" x="92" y="156" width="16" height="11" rx="1" />
          {/* Legs (white pants under dress hem) */}
          <rect class="leg leg-left"  x="68" y="252" width="24" height="44" />
          <rect class="leg leg-right" x="108" y="252" width="24" height="44" />
          {/* Heels — silhouette black triangles */}
          <path class="heel heel-left"  d="M64,296 L94,296 L92,308 L74,310 Z" />
          <path class="heel heel-right" d="M106,296 L136,296 L132,310 L114,308 Z" />
        </svg>

        {/* Floating "+" indicators when buttons pressed */}
        <span class="floater" id="floater"></span>

        {/* Auto-promotion celebration banner — shows empty corporate praise on stage-up */}
        <div class="celebration" id="celebrationBanner" aria-live="polite"></div>

        {/* Fire layer */}
        <div class="fire-layer" id="fireLayer" aria-hidden="true"></div>
        <div class="smoke-layer" id="smokeLayer" aria-hidden="true"></div>

        {/* Confetti — only fires inside the stage; can never escape the gameplay window */}
        <div class="full-fanfare" id="fullFanfare" aria-hidden="true"></div>
      </div>

      {/* Career stage label */}
      <div class="career-label" id="careerLabel">— intern —</div>

      {/* Bottom button row — feed / raise / praise */}
      <div class="inputs">
        <button id="btnFeed" class="input-btn input-btn--feed" type="button">
          <span class="emo">📢</span><span class="lbl">feed exposure</span>
        </button>
        <button id="btnRaise" class="input-btn input-btn--raise" type="button">
          <span class="emo">💸</span><span class="lbl">give raise</span>
        </button>
        <button id="btnPraise" class="input-btn input-btn--praise" type="button">
          <span class="emo">👏</span><span class="lbl">praise</span>
        </button>
      </div>

      {/* Quit row — visually distinct, set apart so it doesn't get spam-clicked */}
      <div class="quit-row">
        <button id="btnQuit" class="quit-btn" type="button">
          <span class="emo">🚪</span><span>quit</span>
        </button>
      </div>

      {/* Trophy case */}
      <div class="trophy-case" id="trophyCase">
        <div class="trophy-empty">no awards yet. keep feeding.</div>
      </div>
     </div>
    </section>

    {/* Quit-attempt modal — the boss bribes you to stay every time you try to leave. */}
    <div class="modal promo-modal" id="promoModal" hidden>
      <div class="modal-card promo-card">
        <div class="promo-confetti" id="promoConfetti" aria-hidden="true"></div>
        <p class="modal-text" id="promoText">Really? You were such a rising star, we'll give you a promotion!</p>
        <p class="modal-sub" id="promoSub"></p>
        <div class="modal-actions">
          <button id="btnPromoAck" class="modal-btn modal-btn--accept" type="button">accept it</button>
          <button id="btnWalkAway" class="modal-btn modal-btn--walk" type="button">walk away</button>
        </div>
      </div>
    </div>

    {/* Fanfare overlay is now INSIDE the stage so confetti can't escape the gameplay window. */}

    {/* Ending overlay */}
    <div class="ending" id="ending" hidden>
      <div class="ending-card">
        <div class="sunrise"><div class="sun"></div></div>
        <h2>You escaped. Congrats.</h2>
        <p class="ending-sub">Now you get to do it all over again.</p>
        <dl class="end-stats" id="endStats"></dl>
        <button id="btnReset" class="ending-btn" type="button">start a new life</button>
      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --pc-cyan:        #1bb4e8;
    --pc-cyan-deep:   #0e8fbf;
    --pc-cyan-soft:   #6ed3ee;
    --pc-yellow:      #f5c842;
    --pc-pink:        #f15968;
    --pc-red:         #d83b4a;
    --pc-blue-deep:   #0a1f3a;
    --pc-paper:       #fafaf5;
    --pc-paper-warm:  #f0e8d4;
    --pc-ink:         #1a1a1a;
    --pc-ink-soft:    #4a4a4a;

    /* Stage colors */
    --stage-skin:    #e2c4a3;
    --stage-hair:    #4a3320;
    --stage-tie:     #1a4d8c;
    --stage-body:    url(#newspaper-2);
  }

  html, body {
    background: var(--pc-cyan);
    color: var(--pc-ink);
    font-family: 'Quicksand', system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      radial-gradient(circle at 12% 88%, rgba(255,255,255,0.10) 0%, transparent 35%),
      radial-gradient(circle at 88% 18%, rgba(10,31,58,0.08) 0%, transparent 40%);
  }

  .pc {
    max-width: 28rem;
    margin: 0 auto;
    padding: 1.2rem 1rem 6rem;
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 720px) {
    .pc { padding: 2rem 1rem 6rem; }
  }

  /* ===== The capsule — claustrophobic plastic shell around the whole game ===== */
  .capsule {
    background: var(--pc-paper);
    border: 4px solid var(--pc-blue-deep);
    border-radius: 28px 28px 24px 24px;
    padding: 0.9rem 0.9rem 1rem;
    box-shadow:
      inset 0 0 0 6px var(--pc-paper-warm),
      inset 0 0 0 8px rgba(10,31,58,0.25),
      8px 8px 0 var(--pc-yellow),
      14px 14px 0 var(--pc-blue-deep);
    position: relative;
  }
  .capsule::before {
    /* Top "speaker grille" — purely decorative, says 'this is a device' */
    content: '';
    position: absolute;
    top: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 7px;
    background:
      repeating-linear-gradient(90deg,
        var(--pc-blue-deep) 0 2px,
        transparent 2px 5px);
    border-radius: 0 0 4px 4px;
  }
  .capsule::after {
    /* Plastic glare on the screen */
    content: '';
    position: absolute;
    top: 14px;
    right: 18px;
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.6);
    border-radius: 50%;
    pointer-events: none;
  }

  /* Tighten everything inside the capsule */
  .capsule .device-stats {
    margin: 0.2rem 0 0.7rem;
    padding: 0.5rem;
    gap: 0.4rem;
    box-shadow: 3px 3px 0 var(--pc-blue-deep);
  }
  .capsule .device-stats .stat .lbl { font-size: 0.6rem; }
  .capsule .device-stats .stat .bar { height: 9px; }

  .capsule .stage {
    /* The "screen" — square, framed inside the capsule */
    aspect-ratio: 1 / 1;
    margin-bottom: 0.6rem;
    border-width: 3px;
    border-radius: 4px;
  }

  .capsule .career-label {
    font-size: 0.78rem;
    margin: 0.3rem 0 0.6rem;
    color: var(--pc-blue-deep);
    text-shadow: 1px 1px 0 var(--pc-yellow);
    letter-spacing: 0.08em;
  }

  .capsule .inputs {
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }
  .capsule .input-btn {
    padding: 0.55rem 0.4rem;
    font-size: 0.7rem;
    min-height: 48px;
    box-shadow: 2px 2px 0 var(--pc-blue-deep);
  }
  .capsule .input-btn:hover {
    box-shadow: 4px 4px 0 var(--pc-blue-deep);
  }
  .capsule .input-btn .emo { font-size: 1.05rem; }
  .capsule .input-btn .lbl { font-size: 0.6rem; }

  .capsule .quit-row {
    margin: 0.5rem 0 0.4rem;
  }
  .capsule .quit-btn {
    padding: 0.45rem 1rem;
    font-size: 0.7rem;
    color: var(--pc-blue-deep);
    border-color: var(--pc-blue-deep);
    text-shadow: none;
    min-height: 32px;
  }

  .capsule .trophy-case {
    padding: 0.45rem 0.55rem;
    min-height: 2.2rem;
    box-shadow: inset 0 1px 2px rgba(10,31,58,0.15);
    background: var(--pc-paper-warm);
    overflow-x: auto;
    flex-wrap: nowrap;
  }
  .capsule .trophy {
    flex: 0 0 auto;
    padding: 0.2rem 0.4rem;
    font-size: 0.6rem;
  }
  .capsule .trophy .te { font-size: 0.85rem; }
  .capsule .trophy-empty { font-size: 0.6rem; }

  /* Smaller character and props inside the squeezed screen */
  .capsule .character { width: 32%; }
  .capsule .prop.monitor   { font-size: 1.4rem; }
  .capsule .prop.mug       { font-size: 1rem; }
  .capsule .prop.plant     { font-size: 1.2rem; }
  .capsule .prop.books     { font-size: 1rem; }

  /* Trophy wall — awards plastered across the back wall, big enough to read */
  .trophy-wall {
    position: absolute;
    top: 5%;
    left: 6%;
    right: 6%;
    height: 38%;
    pointer-events: none;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 6%;
  }
  .wall-award {
    font-size: 1.6rem;
    line-height: 1;
    filter: drop-shadow(2px 2px 0 rgba(60,38,18,0.35));
    user-select: none;
  }
  .wall-award:nth-child(odd)  { transform: rotate(-4deg); }
  .wall-award:nth-child(even) { transform: rotate(3deg); }
  .wall-award:nth-child(3n)   { transform: rotate(-1deg); }
  .wall-award.fresh           { animation: trophy-pop 600ms cubic-bezier(.2,1.6,.4,1); }
  /* Slightly smaller inside the capsule (the screen is tighter) */
  .capsule .wall-award { font-size: 1.25rem; }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .back {
    color: var(--pc-paper);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    padding: 0.4rem 0;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    text-shadow: 1px 1px 0 var(--pc-cyan-deep);
  }
  .back:hover { color: var(--pc-yellow); }

  .bgm-toggle {
    background: rgba(255,255,255,0.92);
    border: 2px solid var(--pc-blue-deep);
    color: var(--pc-ink);
    padding: 0.5rem 0.8rem;
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    transition: all 200ms;
    box-shadow: 3px 3px 0 var(--pc-blue-deep);
    font-weight: 600;
  }
  .bgm-toggle:hover { background: var(--pc-yellow); }
  .bgm-toggle.on { background: var(--pc-yellow); }
  .bgm-label { font-size: 0.7rem; }
  @media (max-width: 480px) {
    .bgm-label { display: none; }
  }

  .head { margin: 1rem 0 1.5rem; }
  .head h1 {
    font-size: clamp(2.4rem, 9vw, 4rem);
    font-weight: 800;
    margin: 0;
    color: var(--pc-paper);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-shadow:
      3px 3px 0 var(--pc-blue-deep),
      6px 6px 0 var(--pc-yellow);
  }
  .head h1 .dot { color: var(--pc-yellow); }
  .head .sub {
    margin-top: 0.8rem;
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    color: var(--pc-paper);
    line-height: 1.5;
    font-weight: 600;
    text-shadow: 1px 1px 0 var(--pc-cyan-deep);
  }
  .head .sub .nowrap { white-space: nowrap; }

  /* ===== Stat bars ===== */
  .device-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.6rem;
    margin: 1.5rem 0 1rem;
    padding: 0.7rem;
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 6px;
    box-shadow: 4px 4px 0 var(--pc-blue-deep);
  }
  .stat {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.4rem;
  }
  .stat .lbl {
    font-size: 0.72rem;
    color: var(--pc-ink);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .stat .bar {
    background: #e6e6dc;
    border: 1.5px solid var(--pc-ink);
    border-radius: 8px;
    height: 12px;
    overflow: hidden;
    position: relative;
  }
  .stat .fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--pc-cyan), var(--pc-cyan-deep));
    transition: width 400ms cubic-bezier(.2,.8,.2,1);
  }
  .stat .fill.burnout-fill {
    background: linear-gradient(90deg, var(--pc-yellow), var(--pc-pink), var(--pc-red));
  }

  /* ===== The collage stage ===== */
  .stage {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 36rem;
    margin: 0 auto 1.2rem;
    overflow: hidden;
  }

  /* Connecting lines */
  .connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .connections path {
    fill: none;
    stroke: var(--pc-paper);
    stroke-width: 0.25;
    stroke-dasharray: 0.8 0.6;
    stroke-linecap: round;
    opacity: 0.85;
  }

  /* Decorative scatter — absolute positioned hand-placed */
  .scatter { position: absolute; pointer-events: none; z-index: 1; }
  .scatter-1 { top:  4%; left:  6%; }
  .scatter-2 { top:  6%; left: 28%; }
  .scatter-3 { top: 12%; left: 84%; }
  .scatter-4 { top: 38%; left:  2%; }
  .scatter-5 { top: 62%; left: 90%; }
  .scatter-6 { top: 84%; left:  8%; }
  .scatter-7 { top: 92%; left: 36%; }
  .scatter-8 { top: 80%; left: 76%; }

  .halftone-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--pc-paper) 60%, var(--pc-blue-deep) 60%);
    background:
      var(--pc-paper)
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='6' height='6'><circle cx='3' cy='3' r='1.1' fill='%230a1f3a'/></svg>")
      repeat;
    border: 2px solid var(--pc-blue-deep);
    box-shadow: 2px 2px 0 var(--pc-blue-deep);
  }
  .halftone-circle--small { width: 36px; height: 36px; }

  .dot-circle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--pc-blue-deep);
    border: 2px solid var(--pc-paper);
  }
  .dot-circle--blue { background: var(--pc-cyan-deep); }
  .dot-circle--dark { background: var(--pc-blue-deep); }

  .triangle {
    width: 0;
    height: 0;
    border-left: 22px solid transparent;
    border-right: 22px solid transparent;
    border-bottom: 36px solid var(--pc-yellow);
    filter: drop-shadow(2px 2px 0 var(--pc-blue-deep));
    transform: rotate(-12deg);
  }
  .triangle--yellow { border-bottom-color: var(--pc-yellow); transform: rotate(-150deg); }
  .triangle--pink   { border-bottom-color: var(--pc-pink);   transform: rotate(-22deg); border-left-width: 14px; border-right-width: 14px; border-bottom-width: 22px; }

  .dot-small {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--pc-paper);
  }
  .dot-small--yellow { background: var(--pc-yellow); }

  /* ===== Floating orbits (input buttons) ===== */
  .orbit {
    position: absolute;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-family: inherit;
  }
  .orbit:hover .photo-circle { transform: scale(1.06) rotate(-2deg); }
  .orbit:active .photo-circle { transform: scale(0.96) rotate(0); }
  .orbit:disabled { opacity: 0.5; cursor: not-allowed; }

  .orbit--feed   { top:  6%; left: 12%; }
  .orbit--raise  { top:  4%; right: 14%; }
  .orbit--praise { top: 50%; right:  4%; }
  @media (max-width: 480px) {
    .orbit--feed   { top: 2%; left: 4%; }
    .orbit--raise  { top: 0%; right: 4%; }
    .orbit--praise { top: 38%; right: 0%; }
  }

  .photo-circle {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: var(--pc-paper);
    border: 4px solid var(--pc-paper);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      4px 4px 0 var(--pc-blue-deep),
      inset 0 0 0 2px var(--pc-blue-deep);
    transition: transform 220ms cubic-bezier(.2,.8,.2,1);
    position: relative;
    overflow: hidden;
  }
  .photo-circle::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='3' height='3'><circle cx='1.5' cy='1.5' r='0.5' fill='%230a1f3a' opacity='0.18'/></svg>");
    background-size: 3px 3px;
    pointer-events: none;
  }
  .photo-circle .emo {
    font-size: 2.4rem;
    line-height: 1;
    filter: grayscale(0.3) contrast(1.05);
    z-index: 1;
    position: relative;
  }
  .photo-circle--feed   { background: linear-gradient(145deg, #fae3a8, #f5c842); }
  .photo-circle--raise  { background: linear-gradient(145deg, #c9efb8, #6ed384); }
  .photo-circle--praise { background: linear-gradient(145deg, #ffd0d0, #f15968); }
  @media (max-width: 480px) {
    .photo-circle { width: 64px; height: 64px; border-width: 3px; }
    .photo-circle .emo { font-size: 1.9rem; }
  }

  .orbit-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--pc-paper);
    background: var(--pc-blue-deep);
    padding: 0.18rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-transform: lowercase;
  }

  /* ===== Character ===== */
  .character {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 50%;
    max-width: 240px;
    height: auto;
    z-index: 2;
    animation: stop-motion-bob 1.4s steps(3) infinite;
  }
  @keyframes stop-motion-bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    33%      { transform: translateX(-50%) translateY(-3px); }
    66%      { transform: translateX(-50%) translateY(0); }
  }

  .character .head {
    fill: var(--stage-skin);
    stroke: var(--pc-ink);
    stroke-width: 1.2;
  }
  /* Hair — three variants. Only the one matching the career stage shows.
     Color greys out and the shape thins as he ages. */
  .character .hair-full,
  .character .hair-receding,
  .character .hair-sides {
    display: none;
    stroke: var(--pc-ink);
    stroke-width: 0.8;
  }
  .character .eye   { fill: var(--pc-ink); }
  .character .mouth { fill: none; stroke: var(--pc-ink); stroke-width: 2; stroke-linecap: round; transition: d 300ms; }
  .character .bag   { fill: none; stroke: rgba(0,0,0,0.45); stroke-width: 1.2; opacity: 0; }
  .character .glasses {
    fill: rgba(255,255,255,0.2);
    stroke: var(--pc-ink);
    stroke-width: 1.4;
    opacity: 0;
  }
  .character .neck { fill: var(--stage-skin); stroke: var(--pc-ink); stroke-width: 0.8; }
  .character .tie  { fill: var(--stage-tie); stroke: var(--pc-ink); stroke-width: 0.8; }
  .character .body {
    fill: url(#newspaper-2);
    stroke: var(--pc-ink);
    stroke-width: 1.5;
  }
  .character .body-fold {
    stroke: rgba(0,0,0,0.18);
    stroke-width: 0.8;
    fill: none;
  }
  .character .leg  { fill: url(#grid-fine); stroke: var(--pc-ink); stroke-width: 1; }
  .character .heel { fill: var(--pc-ink); }
  .character .lanyard { fill: var(--pc-red); opacity: 0; }
  .character .badge { fill: var(--pc-paper); stroke: var(--pc-ink); stroke-width: 0.5; opacity: 0; }

  /* Career-stage modifiers — set on .stage */
  .stage.stage-0 .character .tie { fill: var(--pc-cyan-deep); }
  .stage.stage-1 .character .lanyard { opacity: 1; }
  .stage.stage-1 .character .badge { opacity: 1; }
  .stage.stage-2 .character .bag { opacity: 0.8; }
  .stage.stage-2 .character .lanyard { opacity: 1; }
  .stage.stage-2 .character .badge { opacity: 1; }
  .stage.stage-3 .character .bag { opacity: 1; }
  .stage.stage-3 .character .tie { fill: var(--pc-red); }
  .stage.stage-4 .character .bag { opacity: 1; }
  .stage.stage-4 .character .glasses { opacity: 1; }
  .stage.stage-5 .character .bag { opacity: 1; }
  .stage.stage-5 .character .glasses { opacity: 1; }

  /* Hair progression per career stage */
  .stage.stage-0 .character .hair-full { display: block; fill: #3d2817; }
  .stage.stage-1 .character .hair-full { display: block; fill: #3d2817; }
  .stage.stage-2 .character .hair-full { display: block; fill: #5e4d3a; } /* graying */
  .stage.stage-3 .character .hair-receding { display: block; fill: #8a7a6a; } /* receding, gray */
  .stage.stage-4 .character .hair-sides { display: block; fill: #b8b0a0; } /* sides only, white-gray */
  .stage.stage-5 .character .hair-sides { display: block; fill: #e0dcd2; opacity: 0.85; } /* near-bald, white wisps */

  /* Fire & smoke (overlay on stage) */
  .fire-layer, .smoke-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }
  .flame {
    position: absolute;
    font-size: 1.8rem;
    line-height: 1;
    filter: drop-shadow(0 0 8px rgba(220, 80, 20, 0.7));
    animation: flame-flicker 0.36s steps(3) infinite;
  }
  @keyframes flame-flicker {
    0%, 100% { transform: scale(1) translateY(0); }
    33%      { transform: scale(1.18) translateY(-3px); }
    66%      { transform: scale(0.92) translateY(1px); }
  }
  .smoke {
    position: absolute;
    font-size: 1.3rem;
    line-height: 1;
    opacity: 0.6;
    animation: smoke-rise 3s linear infinite;
  }
  @keyframes smoke-rise {
    0%   { transform: translateY(0); opacity: 0.6; }
    100% { transform: translateY(-32px); opacity: 0; }
  }

  /* Floater */
  .floater {
    position: absolute;
    left: 50%;
    bottom: 60%;
    transform: translateX(-50%);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--pc-paper);
    background: var(--pc-blue-deep);
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    pointer-events: none;
    opacity: 0;
    z-index: 5;
    text-shadow: none;
  }
  .floater.fly { animation: float-up 900ms ease-out forwards; }
  @keyframes float-up {
    0%   { opacity: 0; transform: translateX(-50%) translateY(0); }
    20%  { opacity: 1; }
    100% { opacity: 0; transform: translateX(-50%) translateY(-50px); }
  }

  /* Career label */
  .career-label {
    text-align: center;
    font-size: 1rem;
    font-weight: 800;
    color: var(--pc-paper);
    letter-spacing: 0.12em;
    text-transform: lowercase;
    margin: 0.4rem 0 1rem;
    text-shadow: 2px 2px 0 var(--pc-blue-deep);
  }

  /* ===== Bottom button row — feed / raise / praise ===== */
  .inputs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin: 0 0 0.8rem;
  }
  @media (max-width: 480px) {
    .inputs { grid-template-columns: 1fr; }
  }
  .input-btn {
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    padding: 0.85rem 0.6rem;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--pc-ink);
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--pc-blue-deep);
    transition: transform 120ms, box-shadow 120ms, background 120ms;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-height: 56px;
    line-height: 1.1;
    text-align: center;
  }
  .input-btn .emo { font-size: 1.3rem; line-height: 1; }
  .input-btn .lbl { font-size: 0.7rem; letter-spacing: 0.02em; }
  .input-btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pc-blue-deep); }
  .input-btn:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--pc-blue-deep); }
  .input-btn--feed { background: var(--pc-yellow); }
  .input-btn--raise { background: var(--pc-cyan-soft); }
  .input-btn--praise { background: var(--pc-pink); color: var(--pc-paper); }
  .input-btn--feed:hover { background: #ffd55a; }

  /* Quit button — small, dashed, set apart from the input row */
  .quit-row {
    display: flex;
    justify-content: center;
    margin: 1.4rem 0 1.2rem;
  }
  .quit-btn {
    background: transparent;
    border: 2px dashed var(--pc-paper);
    color: var(--pc-paper);
    padding: 0.7rem 1.4rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    transition: all 400ms;
    text-shadow: 1px 1px 0 var(--pc-cyan-deep);
  }
  .quit-btn:hover {
    background: var(--pc-pink);
    color: var(--pc-paper);
    border-color: var(--pc-paper);
    border-style: solid;
  }
  .quit-btn.pulse {
    animation: quit-pulse 2.4s ease-in-out infinite;
  }
  @keyframes quit-pulse {
    0%, 100% { border-color: var(--pc-paper); color: var(--pc-paper); }
    50%      { border-color: var(--pc-yellow); color: var(--pc-yellow); }
  }
  .quit-btn .emo { font-size: 1rem; }

  /* Trophy case */
  .trophy-case {
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    padding: 0.7rem 0.9rem;
    min-height: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-content: flex-start;
    box-shadow: 4px 4px 0 var(--pc-blue-deep);
  }
  .trophy-empty {
    font-size: 0.78rem;
    color: var(--pc-ink-soft);
    font-style: italic;
    width: 100%;
    text-align: center;
  }
  .trophy {
    background: var(--pc-paper-warm);
    border: 1.5px solid var(--pc-blue-deep);
    border-radius: 2px;
    padding: 0.3rem 0.55rem;
    font-size: 0.74rem;
    color: var(--pc-ink);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    box-shadow: 2px 2px 0 var(--pc-blue-deep);
    font-weight: 600;
  }
  .trophy .te { font-size: 1rem; line-height: 1; }
  .trophy.new { animation: trophy-pop 600ms cubic-bezier(.2,1.6,.4,1); }
  @keyframes trophy-pop {
    0%   { transform: scale(0.5) rotate(-12deg); opacity: 0; }
    60%  { transform: scale(1.15) rotate(2deg); opacity: 1; }
    100% { transform: scale(1) rotate(0); opacity: 1; }
  }

  /* Quit confirmation modal */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(10, 31, 58, 0.72);
    backdrop-filter: blur(4px);
    z-index: 95;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: ending-fade 360ms ease forwards;
  }
  /* Critical: restore [hidden] semantic when CSS sets display:flex above */
  .modal[hidden],
  .ending[hidden],
  .full-fanfare[hidden] { display: none !important; }
  .modal-card {
    background: var(--pc-paper);
    border: 3px solid var(--pc-blue-deep);
    border-radius: 6px;
    padding: 2rem 1.6rem 1.6rem;
    max-width: 22rem;
    text-align: center;
    box-shadow: 8px 8px 0 var(--pc-yellow);
  }
  .modal-text {
    font-size: 1.05rem;
    color: var(--pc-ink);
    margin: 0 0 1.4rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .modal-actions { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }
  .modal-btn {
    padding: 0.7rem 1.2rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 3px;
    cursor: pointer;
    min-height: 42px;
    transition: transform 120ms;
  }
  .modal-btn:hover { transform: translate(-1px, -1px); }
  .modal-btn--ghost {
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    color: var(--pc-ink);
    box-shadow: 3px 3px 0 var(--pc-blue-deep);
  }
  .modal-btn--quit {
    background: var(--pc-blue-deep);
    border: 2px solid var(--pc-blue-deep);
    color: var(--pc-paper);
    box-shadow: 3px 3px 0 var(--pc-yellow);
  }

  /* Ending */
  .ending {
    position: fixed;
    inset: 0;
    background: rgba(10, 31, 58, 0.85);
    backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: ending-fade 1500ms ease forwards;
  }
  @keyframes ending-fade {
    0%   { opacity: 0; }
    100% { opacity: 1; }
  }
  .ending-card {
    background: var(--pc-paper);
    border: 3px solid var(--pc-blue-deep);
    border-radius: 6px;
    padding: 2rem 1.6rem;
    max-width: 26rem;
    text-align: center;
    box-shadow: 12px 12px 0 var(--pc-yellow), inset 0 0 0 6px rgba(245,200,66,0.35);
    position: relative;
    overflow: hidden;
  }
  .sunrise {
    height: 80px;
    position: relative;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--pc-cyan-soft) 0%, var(--pc-yellow) 100%);
    border: 2px solid var(--pc-blue-deep);
  }
  .sunrise .sun {
    position: absolute;
    bottom: -40%;
    left: 50%;
    width: 56%;
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--pc-yellow) 30%, var(--pc-pink) 75%);
    border-radius: 50%;
    transform: translateX(-50%);
    animation: sun-rise 2200ms cubic-bezier(.2,.8,.2,1) forwards;
    box-shadow: 0 0 30px rgba(241, 89, 104, 0.5);
  }
  @keyframes sun-rise {
    from { bottom: -55%; }
    to   { bottom: 8%; }
  }
  .ending-card h2 {
    font-size: 1.75rem;
    color: var(--pc-ink);
    margin: 0 0 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .end-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1rem;
    margin: 0 0 1.5rem;
    text-align: left;
    background: var(--pc-paper-warm);
    padding: 1rem 1.1rem;
    border-radius: 4px;
    font-size: 0.82rem;
    border: 1.5px solid var(--pc-blue-deep);
  }
  .end-stats dt { color: var(--pc-ink-soft); font-weight: 600; }
  .end-stats dd { margin: 0; color: var(--pc-ink); font-weight: 800; }
  .ending-btn {
    background: var(--pc-blue-deep);
    color: var(--pc-paper);
    border: 0;
    padding: 0.85rem 1.4rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    border-radius: 3px;
    box-shadow: 4px 4px 0 var(--pc-yellow);
    transition: transform 120ms;
  }
  .ending-btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pc-yellow); }

  /* ===== Promotion modal ===== */
  .modal-card.promo-card {
    background: var(--pc-yellow);
    border: 3px solid var(--pc-blue-deep);
    box-shadow: 6px 6px 0 var(--pc-pink), 10px 10px 0 var(--pc-blue-deep);
    position: relative;
    overflow: hidden;
  }
  .modal-card.promo-card .modal-text {
    color: var(--pc-blue-deep);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 0 0 0.6rem;
  }
  .modal-card.promo-card .modal-sub {
    color: var(--pc-blue-deep);
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 1.4rem;
    opacity: 0.85;
  }
  .modal-btn--accept {
    background: var(--pc-blue-deep);
    color: var(--pc-paper);
    border-color: var(--pc-blue-deep);
    box-shadow: 4px 4px 0 var(--pc-pink);
  }
  .modal-btn--accept:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pc-pink); }
  .modal-btn--walk {
    background: transparent;
    color: var(--pc-blue-deep);
    border: 2px dashed var(--pc-blue-deep);
    box-shadow: none;
    font-weight: 700;
  }
  .modal-btn--walk:hover { background: var(--pc-blue-deep); color: var(--pc-paper); border-style: solid; }

  /* ===== Auto-promotion celebration banner ===== */
  .celebration {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pc-yellow);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    padding: 0.5rem 0.7rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--pc-blue-deep);
    text-align: center;
    line-height: 1.3;
    max-width: 80%;
    z-index: 9;
    box-shadow: 3px 3px 0 var(--pc-blue-deep);
    opacity: 0;
    pointer-events: none;
    text-shadow: 1px 1px 0 rgba(255,255,255,0.4);
  }
  .celebration.show {
    animation: celebration-flash 4s ease-in-out forwards;
  }
  @keyframes celebration-flash {
    0%   { opacity: 0; transform: translateX(-50%) scale(0.7); }
    10%  { opacity: 1; transform: translateX(-50%) scale(1.05); }
    20%  { transform: translateX(-50%) scale(1); }
    80%  { opacity: 1; transform: translateX(-50%) scale(1); }
    100% { opacity: 0; transform: translateX(-50%) scale(0.95); }
  }

  .promo-confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .promo-confetti .conf {
    position: absolute;
    top: -10%;
    font-size: 1.1rem;
    animation: confetti-mini 1.6s ease-out forwards;
  }
  @keyframes confetti-mini {
    0%   { transform: translateY(0) rotate(0); opacity: 1; }
    100% { transform: translateY(420px) rotate(720deg); opacity: 0; }
  }

  /* Confetti shower — contained within the stage (the gameplay window) */
  .full-fanfare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 7;
    overflow: hidden;
  }
  .full-fanfare .piece {
    position: absolute;
    top: -8%;
    font-size: 0.9rem;
    animation: confetti-fall 1.6s cubic-bezier(.25,.46,.45,.94) forwards;
    filter: drop-shadow(1px 1px 0 rgba(0,0,0,0.15));
  }
  @keyframes confetti-fall {
    0%   { transform: translateY(0) translateX(0) rotate(0); opacity: 1; }
    100% { transform: translateY(120%) translateX(var(--xshift, 0)) rotate(720deg); opacity: 0; }
  }

  /* ===== Character reactions ===== */
  .character.react {
    animation: react-bounce 1.4s cubic-bezier(.2,1.4,.4,1) 1;
  }
  @keyframes react-bounce {
    0%   { transform: translateX(-50%) scale(1) translateY(0); }
    18%  { transform: translateX(-50%) scale(1.18) translateY(-14px); }
    40%  { transform: translateX(-50%) scale(0.94) translateY(2px); }
    60%  { transform: translateX(-50%) scale(1.08) translateY(-6px); }
    80%  { transform: translateX(-50%) scale(0.98) translateY(0); }
    100% { transform: translateX(-50%) scale(1) translateY(0); }
  }
  .character.react.intensity-high   { filter: brightness(1.4) saturate(1.6) drop-shadow(0 0 16px rgba(245,200,66,0.7)); }
  .character.react.intensity-mid    { filter: brightness(1.18) saturate(1.2); }
  .character.react.intensity-low    { filter: brightness(1.05); }

  /* ===== Disturbing behaviours — kept INSIDE the stage box ===== */
  .character.behavior-huddle {
    animation: behavior-huddle 9s steps(6) 1;
    transform-origin: center bottom;
  }
  @keyframes behavior-huddle {
    0%   { transform: translateX(-50%) translateY(0) scale(1) rotate(0); }
    20%  { transform: translateX(-110%) translateY(28px) scale(0.85) rotate(-8deg); }
    80%  { transform: translateX(-110%) translateY(28px) scale(0.85) rotate(-8deg); }
    100% { transform: translateX(-50%) translateY(0) scale(1) rotate(0); }
  }

  .character.behavior-pace {
    animation: behavior-pace 10s steps(20) 1;
  }
  @keyframes behavior-pace {
    0%, 100% { transform: translateX(-50%); }
    25%      { transform: translateX(-110%); }
    50%      { transform: translateX(10%); }
    75%      { transform: translateX(-110%); }
  }

  .character.behavior-stare {
    animation: behavior-stare 7s linear 1;
    filter: brightness(0.7) saturate(0.4);
  }
  @keyframes behavior-stare {
    0%, 100% { transform: translateX(-50%); }
    /* held still */
  }

  .character.behavior-mutter {
    animation: behavior-mutter 7s steps(8) 1;
  }
  @keyframes behavior-mutter {
    0%, 100% { transform: translateX(-50%) rotate(0); }
    20%      { transform: translateX(-50%) rotate(-2deg); }
    40%      { transform: translateX(-50%) rotate(1deg); }
    60%      { transform: translateX(-50%) rotate(-1deg); }
    80%      { transform: translateX(-50%) rotate(2deg); }
  }

  /* Speech bubble for mutter */
  .speech-bubble {
    position: absolute;
    top: 12%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 14px;
    padding: 0.5rem 0.9rem;
    font-size: 0.78rem;
    color: var(--pc-blue-deep);
    font-weight: 600;
    z-index: 8;
    pointer-events: none;
    box-shadow: 3px 3px 0 var(--pc-blue-deep);
    white-space: nowrap;
    max-width: 80%;
    animation: speech-fade 6.5s ease-out forwards;
  }
  .speech-bubble::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 10px solid var(--pc-blue-deep);
  }
  @keyframes speech-fade {
    0%   { opacity: 0; transform: translateX(-50%) translateY(-6px); }
    8%   { opacity: 1; transform: translateX(-50%) translateY(0); }
    90%  { opacity: 1; }
    100% { opacity: 0; }
  }

  .ending-sub {
    margin: -0.5rem 0 1.4rem;
    color: var(--pc-ink-soft);
    font-size: 1rem;
    font-weight: 600;
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .character, .flame, .smoke, .quit-btn { animation: none !important; }
    .character.react { animation: none !important; }
    .full-fanfare .piece { animation: none !important; opacity: 0; }
  }
</style>

<script>
  // ===== state model =====
  const STORAGE_KEY = 'papercut.state.v1';
  const STAGES = [
    { id: 0, name: 'intern',            xpAt: 0,    awardCadence: 50 },
    { id: 1, name: 'junior',            xpAt: 50,   awardCadence: 80 },
    { id: 2, name: 'senior',            xpAt: 150,  awardCadence: 120 },
    { id: 3, name: 'art director',      xpAt: 350,  awardCadence: 180 },
    { id: 4, name: 'creative director', xpAt: 700,  awardCadence: 250 },
    { id: 5, name: 'veteran',           xpAt: 1300, awardCadence: 320 },
  ];

  const AWARD_POOL = [
    { name: 'Spec Ad Champion',         emoji: '🏆' },
    { name: 'Best Headline (Bronze)',   emoji: '🥈' },
    { name: 'Lifetime Achievement (Trying)', emoji: '📜' },
    { name: 'D&AD Wood Pencil',         emoji: '🪵' },
    { name: 'Cannes Lion (Shortlist)',  emoji: '🦁' },
    { name: 'Effie Bronze',             emoji: '🥉' },
    { name: 'Adweek Top 50',            emoji: '📰' },
    { name: 'LBB Talent Spotter',       emoji: '✨' },
    { name: 'Industry Disruptor',       emoji: '🚀' },
    { name: 'Mentorship Honoured',      emoji: '🎖️' },
    { name: 'LinkedIn Thought Leader',  emoji: '💡' },
    { name: 'Industry Veteran',         emoji: '🦴' },
    { name: 'Founder Feature',          emoji: '📰' },
    { name: 'Pitch Deck Hall of Fame',  emoji: '📊' },
    { name: 'Most Posts About Process', emoji: '🧵' },
    { name: 'Beloved by Brand X',       emoji: '🤝' },
    { name: 'Scrappy Award Loser',      emoji: '😅' },
    { name: 'Headlines a Webinar',      emoji: '🎤' },
  ];

  const defaultState = () => ({
    fed: 70,
    mood: 70,
    burnout: 5,
    xp: 0,
    stage: 0,
    awards: [],
    startedAt: Date.now(),
    timeAlive: 0,
    nextAwardAt: STAGES[0].awardCadence,
    awardCount: 0,
    ended: false,
    endedAt: null,
    pendingPromotion: null,   // 'promotion' | 'award' | null
  });

  let state = loadState();

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return defaultState();
      const parsed = JSON.parse(raw);
      return { ...defaultState(), ...parsed };
    } catch { return defaultState(); }
  }
  function saveState() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
  }
  function resetState() { state = defaultState(); saveState(); }

  // ===== render =====
  function render() {
    document.getElementById('fedFill').style.width = state.fed + '%';
    document.getElementById('moodFill').style.width = state.mood + '%';
    document.getElementById('burnoutFill').style.width = state.burnout + '%';

    // Auto-stage-up on XP threshold (no modal). Just a celebration.
    document.getElementById('stage').className = 'stage stage-' + state.stage;
    document.getElementById('careerLabel').textContent = '— ' + STAGES[state.stage].name + ' —';

    const mouth = document.getElementById('mouth');
    if (state.mood >= 60)      mouth.setAttribute('d', 'M84,98 Q100,108 116,98');
    else if (state.mood >= 30) mouth.setAttribute('d', 'M84,100 L116,100');
    else                       mouth.setAttribute('d', 'M84,108 Q100,96 116,108');

    renderFire();
    renderSmoke();
    renderTrophies();

    const quitBtn = document.getElementById('btnQuit');
    if (state.burnout > 60 || state.timeAlive > 180) quitBtn.classList.add('pulse');
    else quitBtn.classList.remove('pulse');
  }

  function renderFire() {
    const layer = document.getElementById('fireLayer');
    layer.innerHTML = '';
    let count = 0;
    if (state.burnout >= 50) count = 1;
    if (state.burnout >= 70) count = 3;
    if (state.burnout >= 85) count = 6;
    if (state.burnout >= 95) count = 9;
    const spots = [
      { left: '40%', bottom: '8%' },
      { left: '20%', bottom: '12%' },
      { left: '60%', bottom: '14%' },
      { left: '12%', bottom: '32%' },
      { left: '78%', bottom: '28%' },
      { left: '50%', bottom: '24%' },
      { left: '6%',  bottom: '6%' },
      { left: '88%', bottom: '6%' },
      { left: '32%', bottom: '40%' },
    ];
    for (let i = 0; i < count; i++) {
      const flame = document.createElement('span');
      flame.className = 'flame';
      flame.textContent = '🔥';
      flame.style.left = spots[i].left;
      flame.style.bottom = spots[i].bottom;
      flame.style.animationDelay = (i * 80) + 'ms';
      layer.appendChild(flame);
    }
  }

  function renderSmoke() {
    const layer = document.getElementById('smokeLayer');
    layer.innerHTML = '';
    let count = 0;
    if (state.burnout >= 30) count = 1;
    if (state.burnout >= 60) count = 2;
    if (state.burnout >= 85) count = 4;
    const spots = [
      { left: '30%', top: '50%' },
      { left: '70%', top: '46%' },
      { left: '50%', top: '58%' },
      { left: '14%', top: '64%' },
    ];
    for (let i = 0; i < count; i++) {
      const sm = document.createElement('span');
      sm.className = 'smoke';
      sm.textContent = '💨';
      sm.style.left = spots[i].left;
      sm.style.top = spots[i].top;
      sm.style.animationDelay = (i * 700) + 'ms';
      layer.appendChild(sm);
    }
  }

  function renderTrophies() {
    const tc = document.getElementById('trophyCase');
    tc.innerHTML = '';
    if (state.awards.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'trophy-empty';
      empty.textContent = 'no awards yet. keep feeding.';
      tc.appendChild(empty);
    } else {
      state.awards.slice().reverse().forEach((a, i) => {
        const t = document.createElement('span');
        t.className = 'trophy';
        if (i === 0 && a._fresh) { t.classList.add('new'); }
        t.innerHTML = `<span class="te">${a.emoji}</span><span>${escapeHtml(a.name)}</span>`;
        tc.appendChild(t);
      });
      state.awards.forEach(a => delete a._fresh);
    }

    // Trophy WALL inside the diorama — large award emojis plastered on the back wall.
    const wall = document.getElementById('trophyWall');
    if (wall) {
      wall.innerHTML = '';
      // Latest 6 awards (most recent first → looks freshest on the wall)
      const recent = state.awards.slice(-6).reverse();
      recent.forEach((a, i) => {
        const w = document.createElement('span');
        w.className = 'wall-award' + ((i === 0 && a._fresh_wall) ? ' fresh' : '');
        w.textContent = a.emoji;
        w.title = a.name;
        wall.appendChild(w);
      });
    }
    // mark fresh state for the next paint
    state.awards.forEach(a => { if (a._fresh) { a._fresh_wall = true; } });
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  // ===== inputs =====
  function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
  function feedExposure() {
    if (state.ended) return;
    state.fed = clamp(state.fed + 22, 0, 100);
    state.burnout = clamp(state.burnout + 3, 0, 100);
    state.xp += 6;
    floatText('+exposure 📢');
    sfx.paper();
    renderAfter();
  }
  function giveRaise() {
    if (state.ended) return;
    state.mood = clamp(state.mood + 14, 0, 100);
    state.fed = clamp(state.fed + 4, 0, 100);
    state.xp += 4;
    floatText('+raise 💸');
    sfx.cha();
    renderAfter();
  }
  function givePraise() {
    if (state.ended) return;
    state.mood = clamp(state.mood + 6, 0, 100);
    state.xp += 2;
    floatText('+praise 👏');
    sfx.clap();
    renderAfter();
  }
  function quit() {
    if (state.ended) return;
    state.ended = true;
    state.endedAt = Date.now();
    saveState();
    showEnding();
  }
  function renderAfter() {
    saveState();
    render();
    applyAutoAdvancement();
    bumpIdle();
  }

  // ===== awards =====
  function grantAward(reason) {
    const pool = AWARD_POOL;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    const award = { ...pick, ts: Date.now(), reason, _fresh: true };
    state.awards.push(award);
    state.awardCount = (state.awardCount || 0) + 1;
    state.nextAwardAt = state.xp + STAGES[state.stage].awardCadence;
    saveState();
    return award;
  }

  // ===== auto-promotion (no modal) — just a celebration banner =====
  // Empty corporate praise indexed by the stage you just got promoted INTO.
  const PRAISE_PROMOTION = {
    junior:              "You're amazing! I can't wait to see what you can do!",
    senior:              "You're a star. We're so lucky to have you.",
    'art director':      "You're absolutely killing it. Future of this place.",
    'creative director': "You ARE this team. Without you, we're nothing.",
    veteran:             "Legend. We're naming a meeting room after you.",
  };
  const PRAISE_VETERAN_AWARD = [
    "Lifetime achievement vibes. We see you.",
    "Genuinely iconic. You're the standard now.",
    "We talk about you in pitches.",
    "Your portfolio is the brief now.",
    "You're not even in the running. You ARE the running.",
    "Master class. Give that talk again.",
    "Your name in their decks. Permanently.",
  ];

  // Idempotent: call from renderAfter — applies one stage-up OR one milestone award.
  function applyAutoAdvancement() {
    if (state.ended) return false;
    let stageIdx = 0;
    for (let i = STAGES.length - 1; i >= 0; i--) {
      if (state.xp >= STAGES[i].xpAt) { stageIdx = i; break; }
    }
    if (stageIdx > state.stage) {
      state.stage = stageIdx;
      grantAward('promotion');
      saveState();
      const nextName = STAGES[state.stage].name;
      showCelebration(PRAISE_PROMOTION[nextName] || "You're a star.");
      fullFanfare();
      reactCharacter();
      return true;
    }
    if (state.stage === STAGES.length - 1 && state.xp >= state.nextAwardAt) {
      grantAward('milestone');
      saveState();
      const line = PRAISE_VETERAN_AWARD[Math.floor(Math.random() * PRAISE_VETERAN_AWARD.length)];
      showCelebration(line);
      fullFanfare();
      reactCharacter();
      return true;
    }
    return false;
  }

  function showCelebration(text) {
    const banner = document.getElementById('celebrationBanner');
    if (!banner) return;
    banner.textContent = text;
    banner.classList.remove('show');
    void banner.offsetWidth;
    banner.classList.add('show');
  }

  // ===== quit-attempt dialog (the bribe) =====
  // Pressing the QUIT button summons the boss with a promotion offer.
  // 'accept it' → another promotion / award + celebration.
  // 'walk away' → ends the game (the only true win).
  function showQuitAttempt() {
    if (state.ended) return;
    const text = document.getElementById('promoText');
    const sub = document.getElementById('promoSub');
    const isMax = state.stage >= STAGES.length - 1;
    if (isMax) {
      text.textContent = "Really? You were such a rising star, we'll give you another award!";
      sub.textContent = "or… you could walk away.";
    } else {
      const nextName = STAGES[state.stage + 1].name;
      text.textContent = "Really? You were such a rising star, we'll give you a promotion!";
      sub.textContent = STAGES[state.stage].name + " → " + nextName + ". or… you could walk away.";
    }
    document.getElementById('promoModal').hidden = false;
    spawnPromoConfetti();
    sfx.cha();
  }

  function hidePromotionModal() {
    document.getElementById('promoModal').hidden = true;
    document.getElementById('promoConfetti').innerHTML = '';
  }

  function ackPromotion() {
    // The "accept it" path — the boss's bribe wins. Apply a promotion or award.
    if (state.stage < STAGES.length - 1) {
      state.stage += 1;
      grantAward('promotion');
      const nextName = STAGES[state.stage].name;
      showCelebration(PRAISE_PROMOTION[nextName] || "You're a star.");
    } else {
      grantAward('milestone');
      const line = PRAISE_VETERAN_AWARD[Math.floor(Math.random() * PRAISE_VETERAN_AWARD.length)];
      showCelebration(line);
    }
    saveState();
    hidePromotionModal();
    fullFanfare();
    reactCharacter();
    render();
  }

  function walkAway() {
    // The only true win: leave.
    hidePromotionModal();
    quit();
  }

  function spawnPromoConfetti() {
    const host = document.getElementById('promoConfetti');
    host.innerHTML = '';
    const emojis = ['🎉','✨','🟡','🟢','🔴','🩷','💛'];
    for (let i = 0; i < 18; i++) {
      const c = document.createElement('span');
      c.className = 'conf';
      c.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      c.style.left = (Math.random() * 100) + '%';
      c.style.animationDelay = (Math.random() * 0.6) + 's';
      c.style.animationDuration = (1.2 + Math.random() * 0.9) + 's';
      host.appendChild(c);
    }
  }

  function fullFanfare() {
    // Stage-scoped now (the .full-fanfare element lives inside the screen).
    // Smaller piece count + smaller sizes since it's a tiny window.
    const host = document.getElementById('fullFanfare');
    if (!host) return;
    host.innerHTML = '';
    const emojis = ['🎉','✨','🎊','🟡','🟢','🩷','💛','🔴','⭐','🟠'];
    for (let i = 0; i < 22; i++) {
      const p = document.createElement('span');
      p.className = 'piece';
      p.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      p.style.left = (Math.random() * 100) + '%';
      p.style.animationDelay = (Math.random() * 0.5) + 's';
      p.style.animationDuration = (1.2 + Math.random() * 0.8) + 's';
      p.style.fontSize = (0.7 + Math.random() * 0.8) + 'rem';
      p.style.setProperty('--xshift', ((Math.random() - 0.5) * 24) + 'px');
      host.appendChild(p);
    }
    setTimeout(() => { host.innerHTML = ''; }, 2200);
  }

  function reactCharacter() {
    const ch = document.getElementById('character');
    if (!ch) return;
    // Intensity tapers with seniority. Intern = high. Veteran = low.
    let intensity = 'high';
    if (state.stage >= 4) intensity = 'low';
    else if (state.stage >= 2) intensity = 'mid';
    ch.classList.remove('react', 'intensity-high', 'intensity-mid', 'intensity-low');
    void ch.offsetWidth;
    ch.classList.add('react', 'intensity-' + intensity);
    setTimeout(() => {
      ch.classList.remove('react', 'intensity-' + intensity);
    }, 1500);
  }

  // ===== floater =====
  function floatText(text) {
    const el = document.getElementById('floater');
    el.textContent = text;
    el.classList.remove('fly');
    void el.offsetWidth;
    el.classList.add('fly');
  }

  // ===== sound (Web Audio) =====
  const sfx = (() => {
    let ctx = null;
    let on = false;
    let humOsc = null, humNoise = null;
    const ensureCtx = () => {
      if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();
      return ctx;
    };
    const startHum = () => {
      if (!on) return;
      const c = ensureCtx();
      const humGain = c.createGain();
      humGain.gain.value = 0.012;
      humGain.connect(c.destination);
      humOsc = c.createOscillator();
      humOsc.type = 'sine';
      humOsc.frequency.value = 60;
      humOsc.connect(humGain);
      humOsc.start();
      const buf = c.createBuffer(1, c.sampleRate * 1.5, c.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * 0.5;
      humNoise = c.createBufferSource();
      humNoise.buffer = buf;
      humNoise.loop = true;
      const lp = c.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 380;
      const noiseGain = c.createGain();
      noiseGain.gain.value = 0.018;
      humNoise.connect(lp).connect(noiseGain).connect(c.destination);
      humNoise.start();
    };
    const stopHum = () => {
      try { humOsc?.stop(); } catch {}
      try { humNoise?.stop(); } catch {}
      humOsc = null; humNoise = null;
    };
    const beep = (freq, durMs, type='sine', gain=0.05) => {
      if (!on) return;
      const c = ensureCtx();
      const osc = c.createOscillator();
      osc.type = type;
      osc.frequency.value = freq;
      const g = c.createGain();
      const t = c.currentTime;
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(gain, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + durMs / 1000);
      osc.connect(g).connect(c.destination);
      osc.start(t);
      osc.stop(t + durMs / 1000);
    };
    const noiseBurst = (durMs, gain=0.04, lpFreq=2400) => {
      if (!on) return;
      const c = ensureCtx();
      const buf = c.createBuffer(1, c.sampleRate * (durMs / 1000), c.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
      const src = c.createBufferSource();
      src.buffer = buf;
      const lp = c.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = lpFreq;
      const g = c.createGain();
      const t = c.currentTime;
      g.gain.setValueAtTime(gain, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + durMs / 1000);
      src.connect(lp).connect(g).connect(c.destination);
      src.start(t);
    };
    return {
      isOn: () => on,
      enable: () => { on = true; startHum(); },
      disable: () => { on = false; stopHum(); },
      paper: () => noiseBurst(80, 0.06, 1800),
      clap:  () => noiseBurst(50, 0.05, 3200),
      cha:   () => { beep(880, 100, 'square', 0.04); setTimeout(() => beep(1320, 120, 'square', 0.035), 80); },
    };
  })();

  // ===== ending =====
  const ending = document.getElementById('ending');

  function showEnding() {
    const minutes = Math.max(1, Math.round(state.timeAlive / 60));
    const stage = STAGES[state.stage].name;
    const stats = document.getElementById('endStats');
    stats.innerHTML = `
      <dt>time spent feeding</dt><dd>${minutes} min</dd>
      <dt>stage at quit</dt><dd>${stage}</dd>
      <dt>awards collected</dt><dd>${state.awardCount}</dd>
      <dt>final mood</dt><dd>${Math.round(state.mood)} / 100</dd>
      <dt>final burnout</dt><dd>${Math.round(state.burnout)} / 100</dd>
      <dt>work-life balance</dt><dd>restored ✓</dd>
    `;
    ending.hidden = false;
    sfx.disable();
    document.getElementById('bgmToggle').classList.remove('on');
    document.getElementById('bgmIcon').textContent = '🔇';
    document.getElementById('bgmLabel').textContent = 'audio off';
  }
  function startNewLife() {
    resetState();
    ending.hidden = true;
    render();
  }

  // ===== ticker =====
  let lastTickAt = Date.now();
  setInterval(() => {
    if (state.ended) return;
    const now = Date.now();
    const dt = (now - lastTickAt) / 1000;
    lastTickAt = now;
    state.timeAlive += dt;
    state.fed     = clamp(state.fed     - 1.6, 0, 100);
    state.mood    = clamp(state.mood    - 0.7, 0, 100);
    state.burnout = clamp(state.burnout + 0.5, 0, 100);
    if (state.fed === 0) state.mood = clamp(state.mood - 1.4, 0, 100);
    saveState();
    render();
    maybeBehavior();
  }, 5000);

  // ===== disturbing behaviours =====
  // Triggered randomly when the player has been idle. Adds unease over time.
  const BEHAVIORS = ['huddle', 'pace', 'stare', 'mutter'];
  const MUTTERS = [
    'i think the deadline shifted again.',
    'is it bonus season yet.',
    'we used to print things.',
    'they hired another VP.',
    'the brief was only one slide this time.',
    'somebody scheduled a 6:30 sync.',
    'i forgot to log my hours.',
    'the wifi has a smell now.',
    'i used to be a person.',
    'we’re calling it a learning sprint.',
  ];
  let lastInputAt = Date.now();
  let behaviorActive = false;

  function bumpIdle() { lastInputAt = Date.now(); }

  function maybeBehavior() {
    if (state.ended) return;
    if (behaviorActive) return;
    const idleSecs = (Date.now() - lastInputAt) / 1000;
    // Higher chance once burnout is up. Always at least 25s of idle first.
    if (idleSecs < 25) return;
    const baseChance = 0.07 + (state.burnout / 100) * 0.18;
    if (Math.random() > baseChance) return;
    triggerBehavior();
  }

  function triggerBehavior() {
    const ch = document.getElementById('character');
    if (!ch) return;
    const id = BEHAVIORS[Math.floor(Math.random() * BEHAVIORS.length)];
    behaviorActive = true;
    ch.classList.add('behavior-' + id);
    if (id === 'mutter') spawnMutter();
    const dur = id === 'pace' ? 10000 : id === 'huddle' ? 9000 : id === 'stare' ? 7000 : 7000;
    setTimeout(() => {
      ch.classList.remove('behavior-' + id);
      behaviorActive = false;
    }, dur);
  }

  function spawnMutter() {
    const stage = document.getElementById('stage');
    const bubble = document.createElement('div');
    bubble.className = 'speech-bubble';
    bubble.textContent = MUTTERS[Math.floor(Math.random() * MUTTERS.length)];
    stage.appendChild(bubble);
    setTimeout(() => bubble.remove(), 6500);
  }

  // ===== wiring =====
  document.getElementById('btnFeed').addEventListener('click', feedExposure);
  document.getElementById('btnRaise').addEventListener('click', giveRaise);
  document.getElementById('btnPraise').addEventListener('click', givePraise);
  // QUIT now opens the bribe modal — the only path to actually quitting is the 'walk away' button inside it.
  document.getElementById('btnQuit').addEventListener('click', showQuitAttempt);
  document.getElementById('btnPromoAck').addEventListener('click', ackPromotion);
  document.getElementById('btnWalkAway').addEventListener('click', walkAway);
  document.getElementById('btnReset').addEventListener('click', startNewLife);

  const bgmBtn = document.getElementById('bgmToggle');
  const bgmIcon = document.getElementById('bgmIcon');
  const bgmLabel = document.getElementById('bgmLabel');
  bgmBtn.addEventListener('click', () => {
    if (sfx.isOn()) {
      sfx.disable();
      bgmBtn.classList.remove('on');
      bgmIcon.textContent = '🔇';
      bgmLabel.textContent = 'audio off';
    } else {
      sfx.enable();
      bgmBtn.classList.add('on');
      bgmIcon.textContent = '🔊';
      bgmLabel.textContent = 'audio on';
    }
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && sfx.isOn()) sfx.disable();
  });

  if (state.ended) {
    showEnding();
  } else {
    render();
    // Catch up on any auto-promotions that were owed from a stale session.
    applyAutoAdvancement();
  }
</script>
