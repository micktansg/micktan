---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="papercut. — Mick Tan"
  description="tamagotchi for creative worker. feed them exposure."
  themeColor="#5da3c4"
  ogImage="/og/papercut.png"
  ogAlt="papercut. — a pixel heart on a cyan field. tamagotchi for creative worker."
>
  <main class="pc">
    <div class="topbar">
      <a class="back" href="/room/" data-astro-prefetch data-veil-exit>&larr; the room</a>
      <button class="bgm-toggle" id="bgmToggle" type="button" aria-label="toggle ambient audio" aria-pressed="false">
        <span id="bgmIcon">🔇</span>
        <span class="bgm-label" id="bgmLabel">audio off</span>
      </button>
    </div>

    <header class="head">
      <h1>papercut<span class="dot">.</span></h1>
      <p class="sub">tamagotchi for creative worker. feed them exposure.</p>
    </header>

    <section class="game" id="game">
     <div class="capsule">
      {/* Stat bars at top */}
      <div class="device-stats">
        <div class="stat" title="how fed they are on exposure"><span class="lbl">fed</span><span class="bar"><span class="fill" id="fedFill"></span></span></div>
        <div class="stat" title="mood"><span class="lbl">mood</span><span class="bar"><span class="fill" id="moodFill"></span></span></div>
        <div class="stat burnout-stat" title="burnout — at high values, things catch fire"><span class="lbl">🔥</span><span class="bar"><span class="fill burnout-fill" id="burnoutFill"></span></span></div>
      </div>

      {/* Trophy shelf — 16 slots populated from sheet-b-trophies as awards earn. */}
      <div class="trophy-shelf" id="trophyShelf" aria-label="trophy shelf">
        {Array.from({ length: 16 }).map((_, i) => (
          <span class="shelf-slot" data-idx={i}></span>
        ))}
      </div>

      {/* The "screen" — sprite character cell + overlays */}
      <div class="stage" id="stage">
        <div class="sprite" id="sprite" data-sheet="a" data-col="0" data-row="0" aria-label="creative worker"></div>
        <span class="floater" id="floater"></span>
        <div class="celebration" id="celebrationBanner" aria-live="polite"></div>
        <div class="full-fanfare" id="fullFanfare" aria-hidden="true"></div>
      </div>

      {/* Career stage label */}
      <div class="career-label" id="careerLabel">— intern —</div>

      {/* Bottom button row — feed / raise / praise */}
      <div class="inputs">
        <button id="btnFeed" class="input-btn input-btn--feed" type="button">
          <span class="emo">📢</span><span class="lbl">feed exposure</span>
        </button>
        <button id="btnRaise" class="input-btn input-btn--raise" type="button">
          <span class="emo">💸</span><span class="lbl">give raise</span>
        </button>
        <button id="btnPraise" class="input-btn input-btn--praise" type="button">
          <span class="emo">👏</span><span class="lbl">praise</span>
        </button>
      </div>

      {/* Quit row — visually distinct, set apart so it doesn't get spam-clicked */}
      <div class="quit-row">
        <button id="btnQuit" class="quit-btn" type="button">
          <span class="emo">🚪</span><span>quit</span>
        </button>
      </div>

      {/* Textual award log — names of every trophy, separate from the visual shelf */}
      <div class="trophy-case" id="trophyCase">
        <div class="trophy-empty">no awards yet. keep feeding.</div>
      </div>
     </div>

     <p class="next-room"><a href="/room/corporateladder/" data-veil-exit="#0a0e23" data-astro-prefetch>next room — corporatelardder. &rarr;</a></p>
    </section>

    {/* Quit-attempt modal — the boss bribes you to stay every time you try to leave. */}
    <div class="modal promo-modal" id="promoModal" hidden>
      <div class="modal-card promo-card">
        <div class="promo-confetti" id="promoConfetti" aria-hidden="true"></div>
        <p class="modal-text" id="promoText">Really? You were such a rising star, we'll give you a promotion!</p>
        <p class="modal-sub" id="promoSub"></p>
        <div class="modal-actions">
          <button id="btnPromoAck" class="modal-btn modal-btn--accept" type="button">accept it</button>
          <button id="btnWalkAway" class="modal-btn modal-btn--walk" type="button">walk away</button>
        </div>
      </div>
    </div>

    {/* Ending overlay — touch grass moment */}
    <div class="ending" id="ending" hidden>
      <div class="ending-card">
        <div class="touch-grass" aria-hidden="true">
          <svg viewBox="0 0 80 20" preserveAspectRatio="none" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
            {/* Sky */}
            <rect x="0" y="0" width="80" height="14" fill="#bcdaee"/>

            {/* Drifting cloud */}
            <g class="cloud-drift">
              <rect x="0" y="3" width="10" height="2" fill="#ffffff"/>
              <rect x="2" y="2" width="8"  height="1" fill="#ffffff"/>
              <rect x="1" y="5" width="3"  height="1" fill="#e0e9f2"/>
              <rect x="6" y="5" width="3"  height="1" fill="#e0e9f2"/>
            </g>

            {/* Tall grass blades (gaps left for flowers at x=20 and x=43) */}
            <rect x="2"  y="10" width="1" height="4" fill="#3f7e3f"/>
            <rect x="5"  y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="8"  y="9"  width="1" height="5" fill="#3f7e3f"/>
            <rect x="11" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="14" y="10" width="1" height="4" fill="#3f7e3f"/>
            <rect x="17" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="25" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="28" y="9"  width="1" height="5" fill="#3f7e3f"/>
            <rect x="31" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="34" y="10" width="1" height="4" fill="#3f7e3f"/>
            <rect x="37" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="40" y="10" width="1" height="4" fill="#3f7e3f"/>
            <rect x="48" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="51" y="9"  width="1" height="5" fill="#3f7e3f"/>
            <rect x="54" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="57" y="10" width="1" height="4" fill="#3f7e3f"/>
            <rect x="60" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="63" y="9"  width="1" height="5" fill="#3f7e3f"/>
            <rect x="67" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="71" y="10" width="1" height="4" fill="#3f7e3f"/>
            <rect x="74" y="11" width="1" height="3" fill="#5fb35a"/>
            <rect x="77" y="9"  width="1" height="5" fill="#3f7e3f"/>

            {/* Bright tip row across the meadow */}
            <rect x="0" y="13" width="80" height="1" fill="#95d96e"/>
            {/* Main grass body */}
            <rect x="0" y="14" width="80" height="3" fill="#5fb35a"/>
            {/* Mid ground (darker) */}
            <rect x="0" y="17" width="80" height="2" fill="#438c44"/>
            {/* Deep ground (darkest) */}
            <rect x="0" y="19" width="80" height="1" fill="#2f6b35"/>

            {/* White daisy */}
            <rect x="20" y="11" width="1" height="3" fill="#3f7e3f"/>
            <rect x="19" y="10" width="1" height="1" fill="#ffffff"/>
            <rect x="21" y="10" width="1" height="1" fill="#ffffff"/>
            <rect x="20" y="9"  width="1" height="1" fill="#ffffff"/>
            <rect x="20" y="10" width="1" height="1" fill="#ffd84a"/>

            {/* Pink flower */}
            <rect x="43" y="11" width="1" height="3" fill="#3f7e3f"/>
            <rect x="42" y="10" width="1" height="1" fill="#f15968"/>
            <rect x="44" y="10" width="1" height="1" fill="#f15968"/>
            <rect x="43" y="9"  width="1" height="1" fill="#f15968"/>
            <rect x="43" y="10" width="1" height="1" fill="#ffd84a"/>
          </svg>
        </div>
        <h2>You escaped. Congrats.</h2>
        <p class="ending-sub">Now you get to do it all over again.</p>
        <dl class="end-stats" id="endStats"></dl>
        <button id="btnReset" class="ending-btn" type="button">start a new life</button>
      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --pc-cyan:        #5da3c4;
    --pc-cyan-deep:   #2e6f8f;
    --pc-cyan-soft:   #bcdaee;
    --pc-yellow:      #f3e09b;
    --pc-yellow-deep: #d6bb5f;
    --pc-pink:        #f15968;
    --pc-red:         #d83b4a;
    --pc-blue-deep:   #1a3a6b;
    --pc-paper:       #f8f3e3;
    --pc-paper-warm:  #efe6c9;
    --pc-ink:         #1a1a1a;
    --pc-ink-soft:    #4a4a4a;
  }

  html, body {
    background: var(--pc-cyan);
    color: var(--pc-ink);
    font-family: 'Quicksand', system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      radial-gradient(circle at 12% 88%, rgba(255,255,255,0.10) 0%, transparent 35%),
      radial-gradient(circle at 88% 18%, rgba(26,58,107,0.10) 0%, transparent 40%);
  }

  .pc {
    max-width: 28rem;
    margin: 0 auto;
    padding: 1.2rem 1rem 2rem;
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 720px) {
    .pc { padding: 2rem 1rem 4rem; }
  }

  /* ===== topbar ===== */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .back {
    color: var(--pc-paper);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    padding: 0.4rem 0;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    text-shadow: 1px 1px 0 var(--pc-cyan-deep);
    touch-action: manipulation;
  }
  .back:hover { color: var(--pc-yellow); }

  .bgm-toggle {
    background: rgba(255,255,255,0.92);
    border: 2px solid var(--pc-blue-deep);
    color: var(--pc-ink);
    padding: 0.5rem 0.8rem;
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    transition: all 200ms;
    box-shadow: 3px 3px 0 var(--pc-blue-deep);
    font-weight: 600;
    touch-action: manipulation;
  }
  .bgm-toggle:hover { background: var(--pc-yellow); }
  .bgm-toggle.on { background: var(--pc-yellow); }
  .bgm-label { font-size: 0.7rem; }
  @media (max-width: 480px) {
    .bgm-label { display: none; }
  }

  /* ===== header ===== */
  .head { margin: 1rem 0 1.5rem; }
  .head h1 {
    font-size: clamp(2.4rem, 9vw, 4rem);
    font-weight: 800;
    margin: 0;
    color: var(--pc-paper);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-shadow:
      3px 3px 0 var(--pc-blue-deep),
      6px 6px 0 var(--pc-yellow);
  }
  .head h1 .dot { color: var(--pc-yellow); }
  .head .sub {
    margin-top: 0.8rem;
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    color: var(--pc-paper);
    line-height: 1.5;
    font-weight: 600;
    text-shadow: 1px 1px 0 var(--pc-cyan-deep);
  }

  /* ===== capsule (the device frame) ===== */
  .capsule {
    background: var(--pc-paper);
    border: 4px solid var(--pc-blue-deep);
    border-radius: 28px 28px 24px 24px;
    padding: 0.9rem 0.9rem 1rem;
    box-shadow:
      inset 0 0 0 6px var(--pc-paper-warm),
      inset 0 0 0 8px rgba(26,58,107,0.25),
      8px 8px 0 var(--pc-yellow),
      14px 14px 0 var(--pc-blue-deep);
    position: relative;
  }
  .capsule::before {
    /* Top "speaker grille" — purely decorative, says 'this is a device' */
    content: '';
    position: absolute;
    top: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 7px;
    background:
      repeating-linear-gradient(90deg,
        var(--pc-blue-deep) 0 2px,
        transparent 2px 5px);
    border-radius: 0 0 4px 4px;
  }
  .capsule::after {
    /* Plastic glare on the screen */
    content: '';
    position: absolute;
    top: 14px;
    right: 18px;
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.6);
    border-radius: 50%;
    pointer-events: none;
  }

  /* ===== Stat bars ===== */
  .device-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.4rem;
    margin: 0.2rem 0 0.7rem;
    padding: 0.5rem;
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 6px;
    box-shadow: 3px 3px 0 var(--pc-blue-deep);
  }
  .stat {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.4rem;
  }
  .stat .lbl {
    font-size: 0.6rem;
    color: var(--pc-ink);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .stat .bar {
    background: #e6e6dc;
    border: 1.5px solid var(--pc-ink);
    border-radius: 8px;
    height: 9px;
    overflow: hidden;
    position: relative;
  }
  .stat .fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--pc-cyan), var(--pc-cyan-deep));
    transition: width 400ms cubic-bezier(.2,.8,.2,1);
  }
  .stat .fill.burnout-fill {
    background: linear-gradient(90deg, var(--pc-yellow), var(--pc-pink), var(--pc-red));
  }

  /* ===== Trophy shelf — sits ABOVE the character, no overlap ===== */
  .trophy-shelf {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.18rem;
    padding: 0.35rem 0.4rem;
    margin-bottom: 0.55rem;
    background: linear-gradient(180deg, #b48b5a 0%, #8e6a3f 100%);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    box-shadow: 2px 2px 0 var(--pc-blue-deep), inset 0 -3px 0 rgba(0,0,0,0.18);
  }
  .shelf-slot {
    aspect-ratio: 1 / 1;
    background-color: rgba(0,0,0,0.18);
    background-image: none;
    background-repeat: no-repeat;
    /* bg-size + bg-position set per-slot in JS (sheet-b cells aren't on
       a clean 1/4 grid; see SHEET_LAYOUTS). */
    border-radius: 2px;
    box-shadow: inset 0 1px 1px rgba(0,0,0,0.4);
    image-rendering: pixelated;
    position: relative;
    transition: transform 240ms cubic-bezier(.2,1.6,.4,1);
  }
  .shelf-slot.filled {
    background-image: url('/room/papercut/sheet-b-trophies.png');
    background-color: rgba(255,255,255,0.06);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12), 0 1px 0 rgba(0,0,0,0.25);
  }
  .shelf-slot.fresh { animation: trophy-pop 600ms cubic-bezier(.2,1.6,.4,1); }
  @keyframes trophy-pop {
    0%   { transform: scale(0.4) rotate(-12deg); }
    60%  { transform: scale(1.2) rotate(2deg); }
    100% { transform: scale(1) rotate(0); }
  }

  /* ===== The screen — sprite character cell ===== */
  .stage {
    position: relative;
    aspect-ratio: 1 / 1;
    margin-bottom: 0.6rem;
    border: 3px solid var(--pc-blue-deep);
    border-radius: 4px;
    overflow: hidden;
    background: var(--pc-cyan-soft);
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.4);
  }

  .sprite {
    position: absolute;
    inset: 0;
    background-image: url('/room/papercut/sheet-a-core.png');
    background-repeat: no-repeat;
    /* bg-size + bg-position set per-render in JS to handle each sheet's
       measured cell coordinates (cells aren't on a clean 1/4 grid). */
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    animation: sprite-bob 2.4s ease-in-out infinite;
    transition: background-position 0ms;
  }
  /* gentle "breathing" bob so the static frame feels alive but not bouncy */
  @keyframes sprite-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }
  /* Sprite "react" — brief flash on celebration / promotion */
  .sprite.react {
    animation: sprite-bob 2.4s ease-in-out infinite, sprite-pop 700ms cubic-bezier(.2,1.6,.4,1);
  }
  @keyframes sprite-pop {
    0%   { filter: brightness(1.4) saturate(1.4) drop-shadow(0 0 12px rgba(245,200,66,0.8)); }
    100% { filter: brightness(1) saturate(1); }
  }

  /* Floater — "+exposure 📢" etc */
  .floater {
    position: absolute;
    left: 50%;
    bottom: 60%;
    transform: translateX(-50%);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--pc-paper);
    background: var(--pc-blue-deep);
    padding: 0.22rem 0.5rem;
    border-radius: 2px;
    pointer-events: none;
    opacity: 0;
    z-index: 5;
    text-shadow: none;
    white-space: nowrap;
  }
  .floater.fly { animation: float-up 900ms ease-out forwards; }
  @keyframes float-up {
    0%   { opacity: 0; transform: translateX(-50%) translateY(0); }
    20%  { opacity: 1; }
    100% { opacity: 0; transform: translateX(-50%) translateY(-50px); }
  }

  /* Speech bubble for mutter behaviour */
  .speech-bubble {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 12px;
    padding: 0.4rem 0.7rem;
    font-size: 0.7rem;
    color: var(--pc-blue-deep);
    font-weight: 600;
    z-index: 8;
    pointer-events: none;
    box-shadow: 2px 2px 0 var(--pc-blue-deep);
    max-width: 80%;
    text-align: center;
    line-height: 1.2;
    animation: speech-fade 6s ease-out forwards;
  }
  .speech-bubble::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 8px solid var(--pc-blue-deep);
  }
  @keyframes speech-fade {
    0%   { opacity: 0; transform: translateX(-50%) translateY(-4px); }
    8%   { opacity: 1; transform: translateX(-50%) translateY(0); }
    90%  { opacity: 1; }
    100% { opacity: 0; }
  }

  /* Celebration banner inside the screen */
  .celebration {
    position: absolute;
    top: 6%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pc-yellow);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--pc-blue-deep);
    text-align: center;
    line-height: 1.25;
    max-width: 86%;
    z-index: 9;
    box-shadow: 2px 2px 0 var(--pc-blue-deep);
    opacity: 0;
    pointer-events: none;
  }
  .celebration.show {
    animation: celebration-flash 4s ease-in-out forwards;
  }
  @keyframes celebration-flash {
    0%   { opacity: 0; transform: translateX(-50%) scale(0.7); }
    10%  { opacity: 1; transform: translateX(-50%) scale(1.05); }
    20%  { transform: translateX(-50%) scale(1); }
    80%  { opacity: 1; transform: translateX(-50%) scale(1); }
    100% { opacity: 0; transform: translateX(-50%) scale(0.95); }
  }

  /* ===== Pixel confetti — small coloured squares falling ===== */
  .full-fanfare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 7;
    overflow: hidden;
  }
  /* :global because particles are created at runtime via createElement —
     they don't pick up Astro's data-astro-cid scoping. */
  :global(.full-fanfare .pxconf) {
    position: absolute;
    top: -10%;
    width: 6px;
    height: 6px;
    image-rendering: pixelated;
    animation: pxconf-fall 1.6s cubic-bezier(.25,.46,.45,.94) forwards;
  }
  @keyframes pxconf-fall {
    0%   { transform: translateY(0) translateX(0) rotate(0); opacity: 1; }
    100% { transform: translateY(120%) translateX(var(--xshift, 0)) rotate(540deg); opacity: 0; }
  }

  /* ===== Career label ===== */
  .career-label {
    text-align: center;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--pc-blue-deep);
    letter-spacing: 0.08em;
    text-transform: lowercase;
    margin: 0.3rem 0 0.6rem;
    text-shadow: 1px 1px 0 var(--pc-yellow);
  }

  /* ===== Bottom button row — feed / raise / praise ===== */
  .inputs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
    margin: 0 0 0.4rem;
  }
  /* inputs stay 3-across on all screen sizes — stacking vertically makes
     the page too tall on phones and forces unwanted scrolling */
  .input-btn {
    background: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    padding: 0.55rem 0.4rem;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--pc-ink);
    cursor: pointer;
    box-shadow: 2px 2px 0 var(--pc-blue-deep);
    transition: transform 120ms, box-shadow 120ms, background 120ms;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-height: 48px;
    line-height: 1.1;
    text-align: center;
    touch-action: manipulation;
  }
  .input-btn .emo { font-size: 1.05rem; line-height: 1; }
  .input-btn .lbl { font-size: 0.6rem; letter-spacing: 0.02em; }
  .input-btn:hover { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--pc-blue-deep); }
  .input-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--pc-blue-deep); }
  .input-btn--feed { background: var(--pc-yellow); }
  .input-btn--raise { background: var(--pc-cyan-soft); }
  .input-btn--praise { background: var(--pc-pink); color: var(--pc-paper); }
  .input-btn--feed:hover { background: var(--pc-yellow-deep); }

  /* ===== Quit button — small, dashed, set apart from input row ===== */
  .quit-row {
    display: flex;
    justify-content: center;
    margin: 0.5rem 0 0.4rem;
  }
  .quit-btn {
    background: transparent;
    border: 2px dashed var(--pc-blue-deep);
    color: var(--pc-blue-deep);
    padding: 0.45rem 1rem;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
    transition: all 400ms;
    touch-action: manipulation;
  }
  .quit-btn:hover {
    background: var(--pc-pink);
    color: var(--pc-paper);
    border-color: var(--pc-pink);
    border-style: solid;
  }
  .quit-btn.pulse {
    animation: quit-pulse 2.4s ease-in-out infinite;
  }
  @keyframes quit-pulse {
    0%, 100% { border-color: var(--pc-blue-deep); color: var(--pc-blue-deep); }
    50%      { border-color: var(--pc-pink); color: var(--pc-pink); }
  }
  .quit-btn .emo { font-size: 0.95rem; }

  /* ===== Trophy case (text log of award names) ===== */
  .trophy-case {
    background: var(--pc-paper-warm);
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    padding: 0.45rem 0.55rem;
    min-height: 2.2rem;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 0.4rem;
    align-content: flex-start;
    box-shadow: inset 0 1px 2px rgba(26,58,107,0.15);
  }
  .trophy-empty {
    font-size: 0.6rem;
    color: var(--pc-ink-soft);
    font-style: italic;
    width: 100%;
    text-align: center;
  }
  /* :global because trophies are created via createElement */
  :global(.trophy-case .trophy) {
    flex: 0 0 auto;
    background: var(--pc-paper);
    border: 1.5px solid var(--pc-blue-deep);
    border-radius: 2px;
    padding: 0.2rem 0.4rem;
    font-size: 0.6rem;
    color: var(--pc-ink);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    box-shadow: 1px 1px 0 var(--pc-blue-deep);
    font-weight: 600;
    white-space: nowrap;
  }
  :global(.trophy-case .trophy .te) { font-size: 0.85rem; line-height: 1; }
  :global(.trophy-case .trophy.new) { animation: trophy-pop 600ms cubic-bezier(.2,1.6,.4,1); }

  /* ===== Modals ===== */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(26, 58, 107, 0.72);
    backdrop-filter: blur(4px);
    z-index: 95;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: ending-fade 360ms ease forwards;
  }
  /* Critical: restore [hidden] when CSS sets display:flex above */
  .modal[hidden],
  .ending[hidden],
  .full-fanfare[hidden] { display: none !important; }
  .modal-card {
    background: var(--pc-paper);
    border: 3px solid var(--pc-blue-deep);
    border-radius: 6px;
    padding: 2rem 1.6rem 1.6rem;
    max-width: 22rem;
    text-align: center;
    box-shadow: 8px 8px 0 var(--pc-yellow);
  }
  .modal-text {
    font-size: 1.05rem;
    color: var(--pc-ink);
    margin: 0 0 1.4rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .modal-actions { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }
  .modal-btn {
    padding: 0.7rem 1.2rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 3px;
    cursor: pointer;
    min-height: 42px;
    transition: transform 120ms;
    touch-action: manipulation;
  }
  .modal-btn:hover { transform: translate(-1px, -1px); }

  /* ===== Promotion (bribe) modal ===== */
  .modal-card.promo-card {
    background: var(--pc-yellow);
    border: 3px solid var(--pc-blue-deep);
    box-shadow: 6px 6px 0 var(--pc-pink), 10px 10px 0 var(--pc-blue-deep);
    position: relative;
    overflow: hidden;
  }
  .modal-card.promo-card .modal-text {
    color: var(--pc-blue-deep);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 0 0 0.6rem;
  }
  .modal-card.promo-card .modal-sub {
    color: var(--pc-blue-deep);
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 1.4rem;
    opacity: 0.85;
  }
  .modal-btn--accept {
    background: var(--pc-blue-deep);
    color: var(--pc-paper);
    border: 2px solid var(--pc-blue-deep);
    box-shadow: 4px 4px 0 var(--pc-pink);
  }
  .modal-btn--accept:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pc-pink); }
  .modal-btn--walk {
    background: transparent;
    color: var(--pc-blue-deep);
    border: 2px dashed var(--pc-blue-deep);
    box-shadow: none;
    font-weight: 700;
  }
  .modal-btn--walk:hover { background: var(--pc-blue-deep); color: var(--pc-paper); border-style: solid; }

  .promo-confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  :global(.promo-confetti .pxconf) {
    position: absolute;
    top: -10%;
    width: 6px;
    height: 6px;
    image-rendering: pixelated;
    animation: pxconf-fall 1.6s cubic-bezier(.25,.46,.45,.94) forwards;
  }

  /* ===== Ending overlay ===== */
  .ending {
    position: fixed;
    inset: 0;
    background: rgba(26, 58, 107, 0.85);
    backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: ending-fade 1500ms ease forwards;
  }
  @keyframes ending-fade {
    0%   { opacity: 0; }
    100% { opacity: 1; }
  }
  .ending-card {
    background: var(--pc-paper);
    border: 3px solid var(--pc-blue-deep);
    border-radius: 6px;
    padding: 2rem 1.6rem;
    max-width: 26rem;
    text-align: center;
    box-shadow: 12px 12px 0 var(--pc-yellow), inset 0 0 0 6px rgba(243,224,155,0.35);
    position: relative;
    overflow: hidden;
  }
  /* Touch-grass scene — pixel-art meadow, replaces the old sunrise.
     The joke is the visual itself; "(touch grass)" is what you say to
     someone who needs to log off. The worker has, finally, escaped. */
  .touch-grass {
    height: 88px;
    margin-bottom: 1rem;
    border: 2px solid var(--pc-blue-deep);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    background: var(--pc-cyan-soft);
    animation: grass-rise 1800ms cubic-bezier(.2,.8,.2,1) forwards;
  }
  .touch-grass svg {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
  @keyframes grass-rise {
    0%   { transform: translateY(20px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  /* Cloud drifts gently across the sky — uses SVG-native units
     (viewBox is 80 wide, cloud is 10 wide → drift across once per 22s). */
  .touch-grass .cloud-drift {
    transform-box: fill-box;
    transform-origin: 0 0;
    animation: cloud-drift 22s linear infinite;
  }
  @keyframes cloud-drift {
    0%   { transform: translateX(-12px); }
    100% { transform: translateX(82px); }
  }
  .ending-card h2 {
    font-size: 1.75rem;
    color: var(--pc-ink);
    margin: 0 0 0.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .ending-sub {
    margin: 0 0 1.4rem;
    color: var(--pc-ink-soft);
    font-size: 1rem;
    font-weight: 600;
    font-style: italic;
  }
  .end-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1rem;
    margin: 0 0 1.5rem;
    text-align: left;
    background: var(--pc-paper-warm);
    padding: 1rem 1.1rem;
    border-radius: 4px;
    font-size: 0.82rem;
    border: 1.5px solid var(--pc-blue-deep);
  }
  .end-stats dt { color: var(--pc-ink-soft); font-weight: 600; }
  .end-stats dd { margin: 0; color: var(--pc-ink); font-weight: 800; }
  .ending-btn {
    background: var(--pc-blue-deep);
    color: var(--pc-paper);
    border: 0;
    padding: 0.85rem 1.4rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    border-radius: 3px;
    box-shadow: 4px 4px 0 var(--pc-yellow);
    transition: transform 120ms;
    touch-action: manipulation;
  }
  .ending-btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pc-yellow); }

  .next-room {
    margin-top: 1.8rem;
    text-align: center;
    font-size: 0.85rem;
  }
  .next-room a { color: #f7f0dc; opacity: 0.6; text-decoration: none; padding: 0.6rem; display: inline-block; }
  .next-room a:hover { opacity: 1; }
  .next-room a:focus-visible { outline: 3px solid var(--pc-yellow, #f3e09b); outline-offset: 3px; }

  /* Keyboard focus — yellow reads on the cyan field and every button face. */
  .input-btn:focus-visible,
  .quit-btn:focus-visible,
  .bgm-toggle:focus-visible,
  .back:focus-visible,
  .ending-btn:focus-visible,
  .modal-actions button:focus-visible {
    outline: 3px solid var(--pc-yellow, #f3e09b);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sprite, .quit-btn { animation: none !important; }
    :global(.full-fanfare .pxconf),
    :global(.promo-confetti .pxconf) { animation: none !important; opacity: 0; }
  }
</style>

<script>
  // ============================================================================
  // papercut. — tamagotchi for creative worker
  // Sprite-based reskin: state → cell mapping on a 4×4 sheet.
  // ============================================================================

  // Lifecycle: the whole game initialises inside initPapercut so ClientRouter
  // SPA navigations re-bind cleanly. The AbortController detaches listeners
  // and the ticker handle stops the 5s heartbeat when the page is left —
  // previously the interval ran forever once started.
  let papercutAbort: AbortController | null = null;
  let papercutTicker: number | null = null;

  const initPapercut = () => {
  if (!document.querySelector('main.pc')) return;
  papercutAbort?.abort();
  papercutAbort = new AbortController();
  const { signal } = papercutAbort;
  if (papercutTicker !== null) { clearInterval(papercutTicker); papercutTicker = null; }

  const STORAGE_KEY = 'papercut.state.v2'; // v2 — sprite reskin (old v1 state intentionally orphaned)

  type Stage = { id: number; name: string; xpAt: number; awardCadence: number };
  const STAGES: Stage[] = [
    { id: 0, name: 'intern',            xpAt: 0,    awardCadence: 50 },
    { id: 1, name: 'junior',            xpAt: 50,   awardCadence: 80 },
    { id: 2, name: 'senior',            xpAt: 150,  awardCadence: 120 },
    { id: 3, name: 'art director',      xpAt: 350,  awardCadence: 180 },
    { id: 4, name: 'creative director', xpAt: 700,  awardCadence: 250 },
    { id: 5, name: 'veteran',           xpAt: 1300, awardCadence: 320 },
  ];

  // Each award maps to a trophy sprite in sheet-b-trophies.png (16-cell 4×4).
  // spriteIdx: 0–15. col = idx%4, row = floor(idx/4).
  type AwardDef = { name: string; emoji: string; spriteIdx: number };
  const AWARD_POOL: AwardDef[] = [
    { name: 'Spec Ad Champion',              emoji: '🏆', spriteIdx: 0  },
    { name: 'Best Headline (Bronze)',        emoji: '🥈', spriteIdx: 1  },
    { name: 'Lifetime Achievement (Trying)', emoji: '📜', spriteIdx: 2  },
    { name: 'D&AD Wood Pencil',              emoji: '🪵', spriteIdx: 3  },
    { name: 'Cannes Lion (Shortlist)',       emoji: '🦁', spriteIdx: 4  },
    { name: 'Effie Bronze',                  emoji: '🥉', spriteIdx: 5  },
    { name: 'Adweek Top 50',                 emoji: '📰', spriteIdx: 6  },
    { name: 'LBB Talent Spotter',            emoji: '✨', spriteIdx: 7  },
    { name: 'Industry Disruptor',            emoji: '🚀', spriteIdx: 8  },
    { name: 'Mentorship Honoured',           emoji: '🎖️', spriteIdx: 9  },
    { name: 'LinkedIn Thought Leader',       emoji: '💡', spriteIdx: 10 },
    { name: 'Industry Veteran',              emoji: '🦴', spriteIdx: 11 },
    { name: 'Founder Feature',               emoji: '📰', spriteIdx: 12 },
    { name: 'Pitch Deck Hall of Fame',       emoji: '📊', spriteIdx: 13 },
    { name: 'Most Posts About Process',      emoji: '🧵', spriteIdx: 14 },
    { name: 'Beloved by Brand X',            emoji: '🤝', spriteIdx: 15 },
    { name: 'Scrappy Award Loser',           emoji: '😅', spriteIdx: 0  },
    { name: 'Headlines a Webinar',           emoji: '🎤', spriteIdx: 9  },
  ];

  type AwardInstance = AwardDef & { ts: number; reason: string; _fresh?: boolean };
  type State = {
    fed: number; mood: number; burnout: number;
    xp: number; stage: number;
    awards: AwardInstance[];
    startedAt: number; timeAlive: number;
    nextAwardAt: number; awardCount: number;
    ended: boolean; endedAt: number | null;
    _tuneFix?: boolean;       // first burnout migration (see loadState)
    _reliefFix?: boolean;     // second migration after adding burnout relief
  };

  const defaultState = (): State => ({
    fed: 70, mood: 70, burnout: 5,
    xp: 0, stage: 0,
    awards: [],
    startedAt: Date.now(), timeAlive: 0,
    nextAwardAt: STAGES[0].awardCadence,
    awardCount: 0,
    ended: false, endedAt: null,
    _tuneFix: true,
    _reliefFix: true,
  });

  let state: State = loadState();

  function loadState(): State {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return defaultState();
      const parsed = JSON.parse(raw);
      const merged: State = { ...defaultState(), ...parsed };
      // First burnout migration: the initial v2 build had burnout climb
      // fast and the BURNOUT sprite trigger at 75. Saves commonly pinned
      // burnout at ~100. Cap once.
      if (!parsed._tuneFix) {
        if (merged.burnout > 60) merged.burnout = 60;
        merged._tuneFix = true;
      }
      // Second migration: actions now relieve burnout, but existing saves
      // still have burnout that climbed under the old "no relief" rules.
      // Give them a workable starting point so the new mechanics can
      // actually take effect without grinding clicks. Career preserved.
      if (!parsed._reliefFix) {
        if (merged.burnout > 50) merged.burnout = 50;
        merged._reliefFix = true;
      }
      return merged;
    } catch { return defaultState(); }
  }
  function saveState() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
  }
  function resetState() { state = defaultState(); saveState(); }

  // ===== sprite state mapping =====
  // Sheet A columns: 0=WORKING, 1=JOY, 2=DESPAIR, 3=BURNOUT
  // Sheet C columns: 0=IDLE, 1=HUNGRY, 2=CRYING, 3=ZOMBIE
  // Rows = age tier from career stage:
  //   stages 0+1 → row 0 (age 25)
  //   stage 2    → row 1 (age 38)
  //   stages 3+4 → row 2 (age 52)
  //   stage 5    → row 3 (age 65)

  type SpriteKey = { sheet: 'a' | 'c'; col: number };
  let reactUntil = 0;

  // Burnout recovery hysteresis. Once burnout crosses the SLEEP threshold
  // we lock into the BURNOUT sprite + fast recovery until we drop back
  // below the WAKE threshold. This produces a visible "sleep then wake"
  // beat instead of the sprite flickering on/off as burnout oscillates
  // around 92.
  const BURNOUT_SLEEP_AT = 92;
  const BURNOUT_WAKE_AT  = 60;
  let inRecovery = false;

  // Sprite atlas geometry — measured per sheet because ChatGPT generated
  // each independently. Sheet C cells are noticeably shorter (~285 px)
  // than Sheet A/B (~297 px), so a single fixed window shows different
  // amounts of gutter per sheet. cellW/cellH are now per-sheet so each
  // cell crops at its actual extent — visually consistent across sheets.
  type SheetLayout = {
    col: [number, number, number, number];
    row: [number, number, number, number];
    cellW: number;
    cellH: number;
  };
  const SHEET_LAYOUTS: Record<'a' | 'b' | 'c', SheetLayout> = {
    a: { col: [15, 324, 638, 948], row: [14, 326, 637, 945], cellW: 293, cellH: 297 },
    b: { col: [15, 327, 636, 944], row: [14, 329, 641, 944], cellW: 295, cellH: 297 },
    c: { col: [16, 323, 631, 940], row: [13, 312, 611, 906], cellW: 292, cellH: 285 },
  };
  const SHEET_DIM = 1254;

  function bgForCell(sheet: 'a' | 'b' | 'c', col: number, row: number): { size: string; pos: string } {
    const l = SHEET_LAYOUTS[sheet];
    const sizeX = (SHEET_DIM / l.cellW) * 100;
    const sizeY = (SHEET_DIM / l.cellH) * 100;
    const posX = (l.col[col] / (SHEET_DIM - l.cellW)) * 100;
    const posY = (l.row[row] / (SHEET_DIM - l.cellH)) * 100;
    return {
      size: `${sizeX.toFixed(3)}% ${sizeY.toFixed(3)}%`,
      pos: `${posX.toFixed(3)}% ${posY.toFixed(3)}%`,
    };
  }

  function ageRow(stage: number): number {
    if (stage <= 1) return 0;
    if (stage === 2) return 1;
    if (stage <= 4) return 2;
    return 3;
  }

  function spriteForState(s: State, now: number): SpriteKey {
    // WORKING is the dominant state — these are the *exception* conditions.
    // Tightened thresholds so the worker is at the laptop most of the time;
    // the other moods are brief reactions to extremes, not steady states.

    // 1. JOY — temporary on celebration (hold extended downstream)
    if (now < reactUntil) return { sheet: 'a', col: 1 };
    // 2. BURNOUT — sleeping it off. Holds through the recovery phase
    //    (driven by the inRecovery hysteresis flag in the ticker) so the
    //    sleep beat is visible for ~25-30s instead of one frame.
    if (inRecovery || s.burnout >= BURNOUT_SLEEP_AT) return { sheet: 'a', col: 3 };
    // 3. CRYING — desperately low mood
    if (s.mood < 12) return { sheet: 'c', col: 2 };
    // 4. DESPAIR — low mood, especially compounded with high burnout
    if (s.mood < 22 || (s.mood < 32 && s.burnout > 75)) return { sheet: 'a', col: 2 };
    // 5. HUNGRY — starving for exposure
    if (s.fed < 12) return { sheet: 'c', col: 1 };
    // 6. ZOMBIE — burnt out AND unhappy (rare combo)
    if (s.burnout > 80 && s.mood < 32) return { sheet: 'c', col: 3 };
    // 7. IDLE — only on near-perfect mood (rare moment of daydream)
    if (s.mood >= 88) return { sheet: 'c', col: 0 };
    // 8. WORKING — default, dominant
    return { sheet: 'a', col: 0 };
  }

  function applySprite() {
    const sprite = document.getElementById('sprite');
    if (!sprite) return;
    const now = Date.now();
    const key = spriteForState(state, now);
    const row = ageRow(state.stage);
    const col = key.col;
    sprite.dataset.sheet = key.sheet;
    sprite.dataset.col = String(col);
    sprite.dataset.row = String(row);
    sprite.style.backgroundImage = `url('/room/papercut/sheet-${key.sheet}-${key.sheet === 'a' ? 'core' : 'secondary'}.png')`;
    const bg = bgForCell(key.sheet, col, row);
    sprite.style.backgroundSize = bg.size;
    sprite.style.backgroundPosition = bg.pos;
  }

  // ===== render =====
  function render() {
    (document.getElementById('fedFill') as HTMLElement).style.width = state.fed + '%';
    (document.getElementById('moodFill') as HTMLElement).style.width = state.mood + '%';
    (document.getElementById('burnoutFill') as HTMLElement).style.width = state.burnout + '%';

    document.getElementById('careerLabel')!.textContent = '— ' + STAGES[state.stage].name + ' —';

    applySprite();
    renderShelf();
    renderTrophyCase();

    const quitBtn = document.getElementById('btnQuit')!;
    if (state.burnout > 60 || state.timeAlive > 180) quitBtn.classList.add('pulse');
    else quitBtn.classList.remove('pulse');
  }

  function renderShelf() {
    const slots = document.querySelectorAll<HTMLElement>('.shelf-slot');
    slots.forEach((slot, i) => {
      const award = state.awards[i];
      if (!award) {
        slot.classList.remove('filled', 'fresh');
        slot.style.backgroundPosition = '';
        slot.style.backgroundSize = '';
        return;
      }
      const col = award.spriteIdx % 4;
      const row = Math.floor(award.spriteIdx / 4);
      slot.classList.add('filled');
      const bg = bgForCell('b', col, row);
      slot.style.backgroundSize = bg.size;
      slot.style.backgroundPosition = bg.pos;
      if (award._fresh && i === state.awards.length - 1) {
        slot.classList.add('fresh');
        window.setTimeout(() => slot.classList.remove('fresh'), 700);
      }
    });
  }

  function renderTrophyCase() {
    const tc = document.getElementById('trophyCase')!;
    tc.innerHTML = '';
    if (state.awards.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'trophy-empty';
      empty.textContent = 'no awards yet. keep feeding.';
      tc.appendChild(empty);
      return;
    }
    state.awards.slice().reverse().forEach((a, i) => {
      const t = document.createElement('span');
      t.className = 'trophy';
      if (i === 0 && a._fresh) t.classList.add('new');
      t.innerHTML = `<span class="te">${a.emoji}</span><span>${escapeHtml(a.name)}</span>`;
      tc.appendChild(t);
    });
    state.awards.forEach(a => delete a._fresh);
  }

  function escapeHtml(s: string): string {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    } as Record<string, string>)[c]);
  }

  // ===== inputs =====
  function clamp(n: number, lo: number, hi: number) { return Math.max(lo, Math.min(hi, n)); }

  // Each corporate dopamine hit relieves burnout a little — but never
  // enough to hold the line forever. The natural ticker climbs faster
  // than active feeding can offset, so even a spamming worker hits
  // burnout eventually. Once asleep, recovery is fast (see ticker)
  // so the worker is back at the desk in ~25s. Endless loop.
  function feedExposure() {
    if (state.ended) return;
    state.fed = clamp(state.fed + 22, 0, 100);
    state.burnout = clamp(state.burnout - 0.6, 0, 100);
    state.xp += 6;
    floatText('+exposure 📢');
    sfx.paper();
    renderAfter();
  }
  function giveRaise() {
    if (state.ended) return;
    state.mood = clamp(state.mood + 14, 0, 100);
    state.fed = clamp(state.fed + 4, 0, 100);
    state.burnout = clamp(state.burnout - 2, 0, 100);
    state.xp += 4;
    floatText('+raise 💸');
    sfx.cha();
    renderAfter();
  }
  function givePraise() {
    if (state.ended) return;
    state.mood = clamp(state.mood + 6, 0, 100);
    state.burnout = clamp(state.burnout - 1, 0, 100);
    state.xp += 2;
    floatText('+praise 👏');
    sfx.clap();
    renderAfter();
  }
  function quit() {
    if (state.ended) return;
    state.ended = true;
    state.endedAt = Date.now();
    saveState();
    showEnding();
  }
  function renderAfter() {
    saveState();
    render();
    applyAutoAdvancement();
    bumpIdle();
  }

  // ===== awards =====
  function grantAward(reason: string) {
    const pick = AWARD_POOL[Math.floor(Math.random() * AWARD_POOL.length)];
    const award: AwardInstance = { ...pick, ts: Date.now(), reason, _fresh: true };
    state.awards.push(award);
    state.awardCount = (state.awardCount || 0) + 1;
    state.nextAwardAt = state.xp + STAGES[state.stage].awardCadence;
    // Awards are recognition — meaningful relief from burnout but not
    // a full reset.
    state.burnout = clamp(state.burnout - 6, 0, 100);
    state.mood = clamp(state.mood + 8, 0, 100);
    saveState();
    return award;
  }

  // ===== auto-promotion (no modal) — celebration banner only =====
  const PRAISE_PROMOTION: Record<string, string> = {
    junior:              "You're amazing! I can't wait to see what you can do!",
    senior:              "You're a star. We're so lucky to have you.",
    'art director':      "You're absolutely killing it. Future of this place.",
    'creative director': "You ARE this team. Without you, we're nothing.",
    veteran:             "Legend. We're naming a meeting room after you.",
  };
  const PRAISE_VETERAN_AWARD = [
    "Lifetime achievement vibes. We see you.",
    "Genuinely iconic. You're the standard now.",
    "We talk about you in pitches.",
    "Your portfolio is the brief now.",
    "You're not even in the running. You ARE the running.",
    "Master class. Give that talk again.",
    "Your name in their decks. Permanently.",
  ];

  function applyAutoAdvancement(): boolean {
    if (state.ended) return false;
    let stageIdx = 0;
    for (let i = STAGES.length - 1; i >= 0; i--) {
      if (state.xp >= STAGES[i].xpAt) { stageIdx = i; break; }
    }
    if (stageIdx > state.stage) {
      state.stage = stageIdx;
      // Promotion is the big reset — a real surge of "this was worth it"
      // before the new role's pressures kick in. Combined with the award
      // grant below (-12 burnout), a promotion erases ~42 burnout total.
      state.burnout = clamp(state.burnout - 22, 0, 100);
      state.mood = clamp(state.mood + 18, 0, 100);
      grantAward('promotion');
      saveState();
      const nextName = STAGES[state.stage].name;
      showCelebration(PRAISE_PROMOTION[nextName] || "You're a star.");
      pixelFanfare();
      reactCharacter();
      render();
      return true;
    }
    if (state.stage === STAGES.length - 1 && state.xp >= state.nextAwardAt) {
      grantAward('milestone');
      saveState();
      const line = PRAISE_VETERAN_AWARD[Math.floor(Math.random() * PRAISE_VETERAN_AWARD.length)];
      showCelebration(line);
      pixelFanfare();
      reactCharacter();
      render();
      return true;
    }
    return false;
  }

  function showCelebration(text: string) {
    const banner = document.getElementById('celebrationBanner')!;
    banner.textContent = text;
    banner.classList.remove('show');
    void banner.offsetWidth;
    banner.classList.add('show');
  }

  // ===== quit-attempt dialog (the bribe) =====
  function showQuitAttempt() {
    if (state.ended) return;
    const text = document.getElementById('promoText')!;
    const sub = document.getElementById('promoSub')!;
    const isMax = state.stage >= STAGES.length - 1;
    if (isMax) {
      text.textContent = "Really? You were such a rising star, we'll give you another award!";
      sub.textContent = '';
    } else {
      const nextName = STAGES[state.stage + 1].name;
      text.textContent = "Really? You were such a rising star, we'll give you a promotion!";
      sub.textContent = STAGES[state.stage].name + " → " + nextName + ".";
    }
    document.getElementById('promoModal')!.hidden = false;
    (document.getElementById('btnPromoAck') as HTMLElement | null)?.focus();
    spawnPromoConfetti();
    sfx.cha();
  }

  function hidePromotionModal() {
    document.getElementById('promoModal')!.hidden = true;
    document.getElementById('promoConfetti')!.innerHTML = '';
    (document.getElementById('btnQuit') as HTMLElement | null)?.focus();
  }

  function ackPromotion() {
    if (state.stage < STAGES.length - 1) {
      state.stage += 1;
      // Same big reset as the auto-promotion path.
      state.burnout = clamp(state.burnout - 22, 0, 100);
      state.mood = clamp(state.mood + 18, 0, 100);
      grantAward('promotion');
      const nextName = STAGES[state.stage].name;
      showCelebration(PRAISE_PROMOTION[nextName] || "You're a star.");
    } else {
      grantAward('milestone');
      const line = PRAISE_VETERAN_AWARD[Math.floor(Math.random() * PRAISE_VETERAN_AWARD.length)];
      showCelebration(line);
    }
    saveState();
    hidePromotionModal();
    pixelFanfare();
    reactCharacter();
    render();
  }

  function walkAway() {
    hidePromotionModal();
    quit();
  }

  // ===== pixel confetti — small coloured squares falling =====
  const CONFETTI_PALETTE = [
    '#f3e09b', // pastel yellow
    '#f15968', // pink
    '#5da3c4', // cyan
    '#bcdaee', // sky blue
    '#1a3a6b', // deep navy
    '#e8c547', // gold
    '#ffffff',
  ];

  function spawnPxConfetti(host: HTMLElement, count: number, durationMs: number) {
    if (!host) return;
    host.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const p = document.createElement('span');
      p.className = 'pxconf';
      p.style.left = (Math.random() * 100) + '%';
      p.style.background = CONFETTI_PALETTE[Math.floor(Math.random() * CONFETTI_PALETTE.length)];
      p.style.animationDelay = (Math.random() * 0.4) + 's';
      p.style.animationDuration = (1.0 + Math.random() * 0.9) + 's';
      const size = 4 + Math.floor(Math.random() * 5);
      p.style.width = size + 'px';
      p.style.height = size + 'px';
      p.style.setProperty('--xshift', ((Math.random() - 0.5) * 60) + 'px');
      host.appendChild(p);
    }
    window.setTimeout(() => { host.innerHTML = ''; }, durationMs);
  }

  function pixelFanfare() {
    // More particles, longer fall — celebration registers as a real moment.
    spawnPxConfetti(document.getElementById('fullFanfare')!, 56, 3800);
  }
  function spawnPromoConfetti() {
    spawnPxConfetti(document.getElementById('promoConfetti')!, 28, 2800);
  }

  function reactCharacter() {
    // Hold the JOY pose for ~3.6s — long enough to register and savour.
    // Aging is already in the sprite itself; here we just gloat.
    const HOLD_MS = 3600;
    reactUntil = Date.now() + HOLD_MS;
    applySprite();
    const sprite = document.getElementById('sprite');
    if (sprite) {
      sprite.classList.remove('react');
      void sprite.offsetWidth;
      sprite.classList.add('react');
      window.setTimeout(() => sprite.classList.remove('react'), HOLD_MS);
    }
    // Snap back to current mood once the JOY window expires.
    window.setTimeout(() => { applySprite(); }, HOLD_MS + 50);
    // 8-bit "you won!" fanfare layered over the BGM
    sfx.fanfare();
  }

  // ===== floater =====
  function floatText(text: string) {
    const el = document.getElementById('floater')!;
    el.textContent = text;
    el.classList.remove('fly');
    void el.offsetWidth;
    el.classList.add('fly');
  }

  // ===== sound (Web Audio) =====
  // 8-bit chiptune background loop in A minor — square-wave melody over a
  // triangle-wave bass. Designed to feel like office hold music: cheerful
  // on the surface, repetitive enough to feel like dread. Plus action
  // SFX (paper / clap / cha-ching) and a winning fanfare.
  const sfx = (() => {
    let ctx: AudioContext | null = null;
    let on = false;
    const ensureCtx = () => {
      if (!ctx) {
        const C = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        ctx = new C();
      }
      return ctx!;
    };

    // ----- chiptune note scheduler -----
    // Schedules a single note with a quick attack, decay, sustain, release
    // envelope so it sounds like a NES-era voice rather than a flat tone.
    const playNoteAt = (
      freq: number, startTime: number, dur: number,
      type: OscillatorType, gain: number,
    ) => {
      if (freq <= 0 || !ctx) return;
      const c = ctx;
      const osc = c.createOscillator();
      osc.type = type;
      osc.frequency.value = freq;
      const g = c.createGain();
      const a = 0.005, d = 0.04, sLevel = 0.65, r = 0.04;
      g.gain.setValueAtTime(0, startTime);
      g.gain.linearRampToValueAtTime(gain, startTime + a);
      g.gain.linearRampToValueAtTime(gain * sLevel, startTime + a + d);
      const releaseStart = Math.max(startTime + a + d, startTime + dur - r);
      g.gain.setValueAtTime(gain * sLevel, releaseStart);
      g.gain.linearRampToValueAtTime(0, startTime + dur);
      osc.connect(g).connect(c.destination);
      osc.start(startTime);
      osc.stop(startTime + dur);
    };

    // ----- bgm loop (A minor pentatonic, 110 BPM, 8-beat phrase) -----
    const BPM = 110;
    const BEAT = 60 / BPM;
    // Frequencies (Hz)
    const Fr = {
      E2: 82.41, F2: 87.31, G2: 98.00, A2: 110.00,
      G4: 392.00, A4: 440.00, B4: 493.88,
      C5: 523.25, D5: 587.33, E5: 659.25,
    };
    // Each entry: [freq, beats]. freq=0 means rest.
    type Step = [number, number];
    const MELODY: Step[] = [
      [Fr.A4, 0.5], [Fr.C5, 0.5],
      [Fr.E5, 1.0],
      [Fr.D5, 0.5], [Fr.C5, 0.5],
      [Fr.A4, 1.0],
      [Fr.G4, 0.5], [Fr.A4, 0.5],
      [Fr.C5, 1.0],
      [Fr.B4, 0.5], [Fr.A4, 0.5],
      [0,      1.0],
    ];
    const BASS: Step[] = [
      [Fr.A2, 1], [Fr.A2, 1],
      [Fr.F2, 1], [Fr.F2, 1],
      [Fr.G2, 1], [Fr.G2, 1],
      [Fr.A2, 1], [Fr.E2, 1],
    ];

    let bgmStop = false;
    let bgmTimer: number | null = null;
    let bgmNextLoopAt = 0;

    const scheduleOneLoop = (startTime: number): number => {
      let t = startTime;
      for (const [f, beats] of MELODY) {
        if (f > 0) playNoteAt(f, t, beats * BEAT * 0.92, 'square', 0.024);
        t += beats * BEAT;
      }
      let bt = startTime;
      for (const [f, beats] of BASS) {
        if (f > 0) playNoteAt(f, bt, beats * BEAT * 0.92, 'triangle', 0.034);
        bt += beats * BEAT;
      }
      return t - startTime;
    };

    const loopBgm = () => {
      if (bgmStop || !on) return;
      const c = ensureCtx();
      const len = scheduleOneLoop(bgmNextLoopAt);
      bgmNextLoopAt += len;
      // schedule next iteration ~0.4s before this one ends so playback
      // stays continuous even if the timer slips
      const msUntilNext = (bgmNextLoopAt - c.currentTime - 0.4) * 1000;
      bgmTimer = window.setTimeout(loopBgm, Math.max(50, msUntilNext));
    };

    const startBgm = () => {
      if (!on) return;
      bgmStop = false;
      const c = ensureCtx();
      // Browsers suspend the AudioContext until a user gesture — toggling
      // BGM on counts. resume() is a no-op if already running.
      if (c.state === 'suspended') c.resume();
      bgmNextLoopAt = c.currentTime + 0.05;
      loopBgm();
    };

    const stopBgm = () => {
      bgmStop = true;
      if (bgmTimer !== null) {
        window.clearTimeout(bgmTimer);
        bgmTimer = null;
      }
    };

    // ----- one-shot SFX -----
    const beep = (freq: number, durMs: number, type: OscillatorType = 'sine', gain = 0.05) => {
      if (!on) return;
      const c = ensureCtx();
      const osc = c.createOscillator();
      osc.type = type;
      osc.frequency.value = freq;
      const g = c.createGain();
      const t = c.currentTime;
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(gain, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + durMs / 1000);
      osc.connect(g).connect(c.destination);
      osc.start(t);
      osc.stop(t + durMs / 1000);
    };
    const noiseBurst = (durMs: number, gain = 0.04, lpFreq = 2400) => {
      if (!on) return;
      const c = ensureCtx();
      const buf = c.createBuffer(1, c.sampleRate * (durMs / 1000), c.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
      const src = c.createBufferSource();
      src.buffer = buf;
      const lp = c.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = lpFreq;
      const g = c.createGain();
      const t = c.currentTime;
      g.gain.setValueAtTime(gain, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + durMs / 1000);
      src.connect(lp).connect(g).connect(c.destination);
      src.start(t);
    };

    // ----- celebratory fanfare on awards / promotions -----
    // 8-bit "you won!" — rising arpeggio resolving on a held high tonic.
    const fanfare = () => {
      if (!on) return;
      const c = ensureCtx();
      const t = c.currentTime;
      type FanfareNote = { f: number; at: number; dur: number; harm?: number };
      const seq: FanfareNote[] = [
        { f: 523.25, at: 0.00, dur: 0.10 }, // C5
        { f: 659.25, at: 0.10, dur: 0.10 }, // E5
        { f: 783.99, at: 0.20, dur: 0.10 }, // G5
        { f: 1046.5, at: 0.30, dur: 0.10 }, // C6
        { f: 783.99, at: 0.40, dur: 0.10 }, // G5
        { f: 1046.5, at: 0.50, dur: 0.55, harm: 1318.5 }, // C6 held with E6 harmony
      ];
      for (const n of seq) {
        playNoteAt(n.f, t + n.at, n.dur * 0.92, 'square', 0.07);
        if (n.harm) playNoteAt(n.harm, t + n.at, n.dur * 0.92, 'triangle', 0.05);
      }
      // Tonic underneath the held note
      playNoteAt(261.63, t + 0.5, 0.55 * 0.92, 'triangle', 0.045);
    };

    return {
      isOn: () => on,
      enable: () => { on = true; startBgm(); },
      disable: () => { on = false; stopBgm(); },
      resume: () => { if (ctx && ctx.state === 'suspended') ctx.resume(); },
      paper: () => noiseBurst(80, 0.06, 1800),
      clap:  () => noiseBurst(50, 0.05, 3200),
      cha:   () => { beep(880, 100, 'square', 0.04); window.setTimeout(() => beep(1320, 120, 'square', 0.035), 80); },
      fanfare,
    };
  })();

  // ===== ending =====
  const endingEl = document.getElementById('ending')!;

  function showEnding() {
    const minutes = Math.max(1, Math.round(state.timeAlive / 60));
    const stage = STAGES[state.stage].name;
    const stats = document.getElementById('endStats')!;
    stats.innerHTML = `
      <dt>time spent feeding</dt><dd>${minutes} min</dd>
      <dt>stage at quit</dt><dd>${stage}</dd>
      <dt>awards collected</dt><dd>${state.awardCount}</dd>
      <dt>final mood</dt><dd>${Math.round(state.mood)} / 100</dd>
      <dt>final burnout</dt><dd>${Math.round(state.burnout)} / 100</dd>
      <dt>work-life balance</dt><dd>restored ✓</dd>
    `;
    endingEl.hidden = false;
    sfx.disable();
    setBgmUi(false);
    (document.getElementById('btnReset') as HTMLElement | null)?.focus();
  }
  function startNewLife() {
    resetState();
    endingEl.hidden = true;
    render();
  }

  // ===== ticker =====
  let lastTickAt = Date.now();
  papercutTicker = window.setInterval(() => {
    if (state.ended) return;
    const now = Date.now();
    const dt = (now - lastTickAt) / 1000;
    lastTickAt = now;
    state.timeAlive += dt;
    state.fed  = clamp(state.fed  - 1.6, 0, 100);
    state.mood = clamp(state.mood - 0.7, 0, 100);
    if (state.fed === 0) state.mood = clamp(state.mood - 1.4, 0, 100);

    // Burnout: enter recovery on hitting SLEEP threshold; exit when
    // dropped to WAKE. Recovery is fast (~25-30s of asleep sprite),
    // climb is slow but unstoppable (~3-4 min from rested → asleep
    // again). Endless loop, theme intact.
    if (state.burnout >= BURNOUT_SLEEP_AT) inRecovery = true;
    else if (state.burnout <= BURNOUT_WAKE_AT) inRecovery = false;
    if (inRecovery) {
      state.burnout = clamp(state.burnout - 6, 0, 100);
      // mood ticks back up while sleeping it off — body resets
      state.mood = clamp(state.mood + 1.5, 0, 100);
    } else {
      state.burnout = clamp(state.burnout + 1.0, 0, 100);
    }
    saveState();
    render();
    maybeMutter();
  }, 5000);

  // ===== mutter speech bubbles =====
  // The body animations from the SVG era are gone (the sprite is the mood now),
  // but mutter remains — quiet bursts of ad-agency intrusive thoughts.
  const MUTTERS = [
    'i think the deadline shifted again.',
    'is it bonus season yet.',
    'we used to print things.',
    'they hired another VP.',
    'the brief was only one slide this time.',
    'somebody scheduled a 6:30 sync.',
    'i forgot to log my hours.',
    'the wifi has a smell now.',
    'i used to be a person.',
    "we're calling it a learning sprint.",
  ];
  let lastInputAt = Date.now();
  let mutterActive = false;

  function bumpIdle() { lastInputAt = Date.now(); }

  function maybeMutter() {
    if (state.ended || mutterActive) return;
    const idleSecs = (Date.now() - lastInputAt) / 1000;
    if (idleSecs < 25) return;
    const baseChance = 0.07 + (state.burnout / 100) * 0.18;
    if (Math.random() > baseChance) return;
    spawnMutter();
  }

  function spawnMutter() {
    const stage = document.getElementById('stage');
    if (!stage) return;
    mutterActive = true;
    const bubble = document.createElement('div');
    bubble.className = 'speech-bubble';
    bubble.textContent = MUTTERS[Math.floor(Math.random() * MUTTERS.length)];
    stage.appendChild(bubble);
    window.setTimeout(() => {
      bubble.remove();
      mutterActive = false;
    }, 6000);
  }

  // ===== wiring =====
  document.getElementById('btnFeed')!.addEventListener('click', feedExposure, { signal });
  document.getElementById('btnRaise')!.addEventListener('click', giveRaise, { signal });
  document.getElementById('btnPraise')!.addEventListener('click', givePraise, { signal });
  document.getElementById('btnQuit')!.addEventListener('click', showQuitAttempt, { signal });
  document.getElementById('btnPromoAck')!.addEventListener('click', ackPromotion, { signal });
  document.getElementById('btnWalkAway')!.addEventListener('click', walkAway, { signal });
  document.getElementById('btnReset')!.addEventListener('click', startNewLife, { signal });

  const AUDIO_KEY = 'papercut.audio';
  const bgmBtn = document.getElementById('bgmToggle')!;
  const bgmIcon = document.getElementById('bgmIcon')!;
  const bgmLabel = document.getElementById('bgmLabel')!;
  function setBgmUi(on: boolean) {
    bgmBtn.classList.toggle('on', on);
    bgmBtn.setAttribute('aria-pressed', String(on));
    bgmIcon.textContent = on ? '🔊' : '🔇';
    bgmLabel.textContent = on ? 'audio on' : 'audio off';
  }
  bgmBtn.addEventListener('click', () => {
    const next = !sfx.isOn();
    if (next) sfx.enable(); else sfx.disable();
    setBgmUi(next);
    try { sessionStorage.setItem(AUDIO_KEY, next ? '1' : '0'); } catch {}
  }, { signal });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && sfx.isOn()) { sfx.disable(); setBgmUi(false); }
  }, { signal });

  if (state.ended) {
    showEnding();
  } else {
    render();
    applyAutoAdvancement();
  }

  // Restore this session's audio preference. The context may start suspended
  // (autoplay policy) — the first real tap resumes it.
  try {
    if (!state.ended && sessionStorage.getItem(AUDIO_KEY) === '1') {
      sfx.enable();
      setBgmUi(true);
      window.addEventListener('pointerdown', () => sfx.resume(), { once: true, signal });
    }
  } catch {}

  // bfcache restores can come back with the bribe modal mid-air or stale UI.
  window.addEventListener('pageshow', (e) => {
    if (!(e as PageTransitionEvent).persisted) return;
    hidePromotionModal();
    if (state.ended) showEnding(); else render();
  }, { signal });
  };

  document.addEventListener('astro:page-load', initPapercut);
  document.addEventListener('astro:before-swap', () => {
    papercutAbort?.abort();
    if (papercutTicker !== null) { clearInterval(papercutTicker); papercutTicker = null; }
  });
</script>
