---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="papercut. — Mick Tan" description="feed them exposure. the only way to win is to quit.">
  <main class="pc">
    <div class="topbar">
      <a class="back" href="/room/" data-astro-prefetch>&larr; the room</a>
      <button class="bgm-toggle" id="bgmToggle" type="button" aria-label="toggle ambient audio">
        <span id="bgmIcon">🔇</span>
        <span class="bgm-label" id="bgmLabel">audio off</span>
      </button>
    </div>

    <header class="head">
      <h1>papercut<span class="dot">.</span></h1>
      <p class="sub">feed them exposure. <span class="nowrap">the only way to win is to quit.</span></p>
    </header>

    {/* Inline SVG paper-texture filter — gives every paper element a wobbly hand-cut edge. */}
    <svg width="0" height="0" aria-hidden="true" style="position:absolute;width:0;height:0">
      <defs>
        <filter id="papercut-edge" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="2" seed="3" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.6" />
        </filter>
        <filter id="paper-grain" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="5" />
          <feColorMatrix values="0 0 0 0 0.30  0 0 0 0 0.22  0 0 0 0 0.12  0 0 0 0.08 0" />
          <feComposite in2="SourceGraphic" operator="in" />
          <feMerge>
            <feMergeNode in="SourceGraphic" />
            <feMergeNode />
          </feMerge>
        </filter>
      </defs>
    </svg>

    <section class="game" id="game">
      {/* The "tamagotchi" — a paper construction with the diorama inside */}
      <div class="device">
        <div class="device-stats">
          <div class="stat" title="how fed they are on exposure"><span class="lbl">fed</span><span class="bar"><span class="fill" id="fedFill"></span></span></div>
          <div class="stat" title="mood"><span class="lbl">mood</span><span class="bar"><span class="fill" id="moodFill"></span></span></div>
          <div class="stat burnout-stat" title="burnout — at high values, things catch fire"><span class="lbl">🔥</span><span class="bar"><span class="fill burnout-fill" id="burnoutFill"></span></span></div>
        </div>

        <div class="diorama" id="diorama">
          <div class="window"><div class="sky" id="sky"></div></div>
          <div class="wall"></div>
          <div class="floor"></div>

          {/* Office props (papercut emoji) */}
          <span class="prop monitor" aria-hidden="true">💻</span>
          <span class="prop mug" aria-hidden="true">☕</span>
          <span class="prop plant" aria-hidden="true">🪴</span>
          <span class="prop books" aria-hidden="true">📚</span>
          <span class="prop trophy-shelf" id="trophyShelf" aria-hidden="true"></span>

          {/* Character — built from SVG paths so we can re-color per career stage */}
          <svg class="character" id="character" viewBox="0 0 100 140" aria-label="creative worker">
            <g filter="url(#papercut-edge)">
              {/* Body */}
              <path class="body" d="M28,68 L72,68 L74,140 L26,140 Z" />
              {/* Arms */}
              <path class="arm arm-left" d="M28,68 L18,108 L24,110 L34,72 Z" />
              <path class="arm arm-right" d="M72,68 L82,108 L76,110 L66,72 Z" />
              {/* Lanyard (only Junior+) */}
              <path class="lanyard" d="M48,68 L52,68 L51,90 L49,90 Z" />
              <rect class="badge" x="46" y="86" width="8" height="6" rx="0.6" />
              {/* Neck */}
              <path class="neck" d="M44,55 L56,55 L56,68 L44,68 Z" />
              {/* Head */}
              <ellipse class="head" cx="50" cy="36" rx="20" ry="24" />
              {/* Hair */}
              <path class="hair" d="M28,28 Q50,8 72,28 L72,38 Q66,28 50,26 Q34,28 28,38 Z" />
              {/* Eye bags (Senior+) */}
              <path class="bag bag-left" d="M37,42 Q42,44 47,42" />
              <path class="bag bag-right" d="M53,42 Q58,44 63,42" />
              {/* Eyes */}
              <circle class="eye eye-left" cx="42" cy="38" r="1.8" />
              <circle class="eye eye-right" cx="58" cy="38" r="1.8" />
              {/* Mouth (changes per mood) */}
              <path class="mouth" id="mouth" d="M42,48 Q50,53 58,48" />
              {/* Glasses (Director+) */}
              <g class="glasses">
                <circle cx="42" cy="38" r="5" />
                <circle cx="58" cy="38" r="5" />
                <line x1="47" y1="38" x2="53" y2="38" />
              </g>
            </g>
          </svg>

          {/* Floating "+" indicators when buttons pressed */}
          <span class="floater" id="floater"></span>

          {/* Fire layer — burnout-driven flames */}
          <div class="fire-layer" id="fireLayer" aria-hidden="true"></div>

          {/* Smoke layer */}
          <div class="smoke-layer" id="smokeLayer" aria-hidden="true"></div>
        </div>

        {/* Career stage label */}
        <div class="career-label" id="careerLabel">— intern —</div>

        {/* Inputs */}
        <div class="inputs">
          <button id="btnFeed" class="input-btn primary" type="button">
            <span class="emo">📢</span><span>feed exposure</span>
          </button>
          <button id="btnRaise" class="input-btn" type="button">
            <span class="emo">💸</span><span>give raise</span>
          </button>
          <button id="btnPraise" class="input-btn" type="button">
            <span class="emo">👏</span><span>praise</span>
          </button>
          <button id="btnQuit" class="input-btn quiet" type="button">
            <span class="emo">🚪</span><span>quit</span>
          </button>
        </div>

        {/* Trophy case */}
        <div class="trophy-case" id="trophyCase">
          <div class="trophy-empty">no awards yet. keep feeding.</div>
        </div>
      </div>
    </section>

    {/* Ending overlay */}
    <div class="ending" id="ending" hidden>
      <div class="ending-card" id="endingCard">
        <div class="sunrise"><div class="sun"></div></div>
        <h2>you escaped.</h2>
        <p class="ending-quote">the only way to win was to leave.<br/>work-life balance: restored.</p>
        <dl class="end-stats" id="endStats"></dl>
        <button id="btnReset" class="input-btn primary" type="button">start a new life</button>
      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --pc-paper:        #f3e8d4;   /* main kraft */
    --pc-paper-2:      #e8d8b9;   /* darker kraft */
    --pc-paper-3:      #d8c298;   /* deepest kraft */
    --pc-ink:          #2a1f12;
    --pc-ink-soft:     #6b5a45;
    --pc-orange:       #d97a1a;
    --pc-burgundy:     #8e2c2c;
    --pc-shadow:       rgba(60, 38, 18, 0.18);
    --pc-shadow-deep:  rgba(60, 38, 18, 0.32);

    /* Career-stage colors (suit / accent) */
    --stage-suit:   #e8881f;
    --stage-skin:   #e6c4a3;
    --stage-hair:   #3d2817;
  }

  html, body {
    background: #ddc5a3;
    background-image:
      radial-gradient(circle at 20% 10%, rgba(255,240,210,0.6) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(150,110,70,0.18) 0%, transparent 60%);
    color: var(--pc-ink);
    font-family: 'Quicksand', system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow-x: hidden;
  }

  .pc {
    max-width: 38rem;
    margin: 0 auto;
    padding: 1.5rem 1.2rem 6rem;
    min-height: 100vh;
    position: relative;
  }
  @media (min-width: 720px) {
    .pc { padding: 2.5rem 1.5rem 6rem; }
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .back {
    color: var(--pc-ink-soft);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    padding: 0.4rem 0;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
  }
  .back:hover { color: var(--pc-ink); }

  .bgm-toggle {
    background: rgba(255,255,255,0.5);
    border: 2px solid var(--pc-paper-3);
    color: var(--pc-ink-soft);
    padding: 0.5rem 0.8rem;
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    transition: all 200ms;
  }
  .bgm-toggle:hover { border-color: var(--pc-orange); color: var(--pc-orange); }
  .bgm-toggle.on { border-color: var(--pc-burgundy); color: var(--pc-burgundy); }
  .bgm-label { font-size: 0.7rem; }
  @media (max-width: 480px) {
    .bgm-label { display: none; }
  }

  .head { margin: 1.5rem 0 2rem; }
  .head h1 {
    font-size: clamp(2.2rem, 8vw, 3.4rem);
    font-weight: 700;
    margin: 0;
    color: var(--pc-ink);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .head h1 .dot { color: var(--pc-orange); }
  .head .sub {
    margin-top: 0.8rem;
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    color: var(--pc-ink-soft);
    font-style: italic;
    line-height: 1.5;
  }
  .head .sub .nowrap { white-space: nowrap; }

  /* ===== The "tamagotchi" device ===== */
  .device {
    background: var(--pc-paper);
    background-image:
      repeating-linear-gradient(
        45deg,
        rgba(180, 130, 70, 0.04) 0,
        rgba(180, 130, 70, 0.04) 2px,
        transparent 2px,
        transparent 4px
      );
    border: 3px solid var(--pc-paper-3);
    border-radius: 22px;
    padding: 1.2rem;
    box-shadow:
      inset 0 0 0 6px var(--pc-paper-2),
      0 14px 32px var(--pc-shadow-deep),
      0 6px 0 rgba(0,0,0,0.08);
    position: relative;
  }
  .device::before {
    /* Subtle paper grain overlay */
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 30% 20%, rgba(180,130,70,0.06) 0%, transparent 40%),
      radial-gradient(circle at 70% 80%, rgba(80,50,20,0.05) 0%, transparent 50%);
    border-radius: 22px;
  }

  /* Stat bars */
  .device-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
    padding: 0.4rem 0.2rem;
  }
  .stat {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.4rem;
  }
  .stat .lbl {
    font-size: 0.7rem;
    color: var(--pc-ink-soft);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .stat .bar {
    background: var(--pc-paper-2);
    border: 1.5px solid var(--pc-paper-3);
    border-radius: 8px;
    height: 12px;
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 1px 2px rgba(60,38,18,0.15);
  }
  .stat .fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #d97a1a, #e8a04a);
    transition: width 400ms cubic-bezier(.2,.8,.2,1);
  }
  .stat .fill.burnout-fill {
    background: linear-gradient(90deg, #b8a05c, #d97a1a, #c93636);
    transition: width 400ms cubic-bezier(.2,.8,.2,1);
  }

  /* ===== Diorama ===== */
  .diorama {
    position: relative;
    aspect-ratio: 1 / 1;
    background: linear-gradient(180deg, var(--pc-paper) 0%, var(--pc-paper-2) 60%, var(--pc-paper-3) 100%);
    border: 2px solid var(--pc-paper-3);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      inset 0 4px 12px rgba(60,38,18,0.15),
      inset 0 -2px 0 rgba(255,240,210,0.4);
    margin-bottom: 1rem;
  }

  .wall {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 65%;
    background: linear-gradient(180deg, #f0dfba 0%, #e6d2a4 100%);
    border-bottom: 1px dashed rgba(60,38,18,0.18);
  }
  .floor {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 35%;
    background: linear-gradient(180deg, #c9a672 0%, #b18d57 100%);
    box-shadow: inset 0 2px 6px rgba(60,38,18,0.25);
  }
  .window {
    position: absolute;
    top: 8%;
    left: 8%;
    width: 30%;
    aspect-ratio: 1.2 / 1;
    background: var(--pc-paper);
    border: 3px solid #8a6b3e;
    border-radius: 4px;
    box-shadow: inset 0 0 0 2px rgba(255,240,210,0.6), 2px 2px 0 rgba(60,38,18,0.2);
    overflow: hidden;
  }
  .sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #e8edf2 0%, #c8d3e0 100%);
    transition: background 1500ms ease;
  }

  .prop {
    position: absolute;
    font-size: 1.8rem;
    line-height: 1;
    filter: drop-shadow(2px 2px 0 var(--pc-shadow));
    user-select: none;
    z-index: 2;
  }
  .prop.monitor   { right: 22%; bottom: 32%; font-size: 2rem; transform: rotate(-3deg); }
  .prop.mug       { right: 14%; bottom: 28%; font-size: 1.3rem; transform: rotate(4deg); }
  .prop.plant     { right: 6%;  bottom: 20%; font-size: 1.6rem; }
  .prop.books     { left: 4%;   bottom: 30%; font-size: 1.4rem; transform: rotate(-2deg); }
  .prop.trophy-shelf {
    position: absolute;
    left: 6%;
    top: 8%;
    width: 28%;
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-align: left;
    transform: rotate(-1deg);
  }

  /* Character */
  .character {
    position: absolute;
    bottom: 12%;
    left: 50%;
    transform: translateX(-50%);
    width: 38%;
    height: auto;
    z-index: 3;
    animation: stop-motion-bob 1.2s steps(3) infinite;
  }
  @keyframes stop-motion-bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    33%      { transform: translateX(-50%) translateY(-2px); }
    66%      { transform: translateX(-50%) translateY(0); }
  }

  .character .body, .character .arm   { fill: var(--stage-suit); stroke: rgba(60,38,18,0.4); stroke-width: 0.5; }
  .character .neck                    { fill: var(--stage-skin); stroke: rgba(60,38,18,0.4); stroke-width: 0.5; }
  .character .head                    { fill: var(--stage-skin); stroke: rgba(60,38,18,0.5); stroke-width: 0.6; }
  .character .hair                    { fill: var(--stage-hair); stroke: rgba(60,38,18,0.4); stroke-width: 0.4; }
  .character .eye                     { fill: var(--pc-ink); }
  .character .mouth                   { fill: none; stroke: var(--pc-ink); stroke-width: 1.4; stroke-linecap: round; transition: d 300ms; }
  .character .bag                     { fill: none; stroke: rgba(60,38,18,0.4); stroke-width: 0.7; opacity: 0; }
  .character .lanyard                 { fill: #6b3838; opacity: 0; }
  .character .badge                   { fill: #f0dfba; stroke: rgba(60,38,18,0.5); stroke-width: 0.4; opacity: 0; }
  .character .glasses                 {
    stroke: var(--pc-ink);
    stroke-width: 0.8;
    fill: rgba(255,255,255,0.15);
    opacity: 0;
  }

  /* Career-stage modifiers — set on .diorama */
  .diorama.stage-0 { --stage-suit: #e8881f; --stage-skin: #e6c4a3; --stage-hair: #3d2817; }
  .diorama.stage-1 { --stage-suit: #d6701a; --stage-skin: #d8b896; --stage-hair: #3d2817; }
  .diorama.stage-1 .character .lanyard { opacity: 1; }
  .diorama.stage-1 .character .badge { opacity: 1; }
  .diorama.stage-2 { --stage-suit: #a04a2a; --stage-skin: #c9aa88; --stage-hair: #2e1f10; }
  .diorama.stage-2 .character .bag { opacity: 0.8; }
  .diorama.stage-2 .character .lanyard { opacity: 1; }
  .diorama.stage-2 .character .badge { opacity: 1; }
  .diorama.stage-3 { --stage-suit: #7c2c2c; --stage-skin: #b89a78; --stage-hair: #1f1408; }
  .diorama.stage-3 .character .bag { opacity: 1; }
  .diorama.stage-4 { --stage-suit: #4a5664; --stage-skin: #b8a892; --stage-hair: #5a5040; }
  .diorama.stage-4 .character .bag { opacity: 1; }
  .diorama.stage-4 .character .glasses { opacity: 1; }
  .diorama.stage-5 { --stage-suit: #6e6e64; --stage-skin: #c4b8a4; --stage-hair: #d4d0c8; }
  .diorama.stage-5 .character .bag { opacity: 1; }
  .diorama.stage-5 .character .glasses { opacity: 1; }

  /* Floater "+exposure" indicator */
  .floater {
    position: absolute;
    left: 50%;
    bottom: 60%;
    transform: translateX(-50%);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--pc-orange);
    pointer-events: none;
    opacity: 0;
    text-shadow: 1px 1px 0 var(--pc-paper);
    z-index: 5;
  }
  .floater.fly {
    animation: float-up 900ms ease-out forwards;
  }
  @keyframes float-up {
    0%   { opacity: 0; transform: translateX(-50%) translateY(0); }
    20%  { opacity: 1; }
    100% { opacity: 0; transform: translateX(-50%) translateY(-40px); }
  }

  /* Fire / smoke */
  .fire-layer, .smoke-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }
  .flame {
    position: absolute;
    font-size: 1.4rem;
    line-height: 1;
    filter: drop-shadow(0 0 6px rgba(220, 80, 20, 0.6));
    animation: flame-flicker 0.36s steps(3) infinite;
  }
  @keyframes flame-flicker {
    0%, 100% { transform: scale(1) translateY(0); }
    33%      { transform: scale(1.18) translateY(-2px); }
    66%      { transform: scale(0.92) translateY(1px); }
  }
  .smoke {
    position: absolute;
    font-size: 1.2rem;
    line-height: 1;
    opacity: 0.55;
    animation: smoke-rise 3s linear infinite;
  }
  @keyframes smoke-rise {
    0%   { transform: translateY(0); opacity: 0.6; }
    100% { transform: translateY(-30px); opacity: 0; }
  }

  /* Career label */
  .career-label {
    text-align: center;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--pc-orange);
    letter-spacing: 0.08em;
    text-transform: lowercase;
    margin: 0.4rem 0 1rem;
    transition: color 600ms ease;
  }

  /* Inputs */
  .inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .input-btn {
    background: var(--pc-paper);
    border: 2px solid var(--pc-paper-3);
    border-radius: 6px;
    padding: 0.85rem 0.7rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--pc-ink);
    cursor: pointer;
    box-shadow: 3px 3px 0 var(--pc-shadow);
    transition: transform 120ms, box-shadow 120ms;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
  }
  .input-btn .emo { font-size: 1.1rem; line-height: 1; }
  .input-btn:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--pc-shadow); }
  .input-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--pc-shadow); }
  .input-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: 2px 2px 0 var(--pc-shadow); }
  .input-btn.primary {
    background: var(--pc-orange);
    color: #fff;
    border-color: var(--pc-burgundy);
  }
  .input-btn.primary:hover { background: #c66a14; }
  .input-btn.quiet {
    grid-column: 1 / -1;
    background: transparent;
    border-style: dashed;
    color: var(--pc-ink-soft);
    font-size: 0.78rem;
    box-shadow: none;
    min-height: 38px;
    transition: color 400ms, border-color 400ms;
  }
  .input-btn.quiet:hover { color: var(--pc-burgundy); border-color: var(--pc-burgundy); }
  .input-btn.quiet.pulse {
    animation: quit-pulse 2.4s ease-in-out infinite;
  }
  @keyframes quit-pulse {
    0%, 100% { color: var(--pc-ink-soft); border-color: var(--pc-paper-3); }
    50%      { color: var(--pc-burgundy); border-color: var(--pc-burgundy); }
  }

  /* Trophy case */
  .trophy-case {
    background: var(--pc-paper-2);
    border: 1.5px solid var(--pc-paper-3);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    min-height: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-content: flex-start;
    box-shadow: inset 0 2px 4px rgba(60,38,18,0.1);
  }
  .trophy-empty {
    font-size: 0.78rem;
    color: var(--pc-ink-soft);
    font-style: italic;
    width: 100%;
    text-align: center;
  }
  .trophy {
    background: var(--pc-paper);
    border: 1px solid var(--pc-paper-3);
    border-radius: 4px;
    padding: 0.3rem 0.55rem;
    font-size: 0.74rem;
    color: var(--pc-ink);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    box-shadow: 1px 1px 0 var(--pc-shadow);
  }
  .trophy .te { font-size: 1rem; line-height: 1; }
  .trophy.new { animation: trophy-pop 600ms cubic-bezier(.2,1.6,.4,1); }
  @keyframes trophy-pop {
    0%   { transform: scale(0.5) rotate(-12deg); opacity: 0; }
    60%  { transform: scale(1.15) rotate(2deg); opacity: 1; }
    100% { transform: scale(1) rotate(0); opacity: 1; }
  }

  /* Ending */
  .ending {
    position: fixed;
    inset: 0;
    background: rgba(40, 28, 14, 0.7);
    backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: ending-fade 1500ms ease forwards;
  }
  @keyframes ending-fade {
    0%   { opacity: 0; }
    100% { opacity: 1; }
  }
  .ending-card {
    background: var(--pc-paper);
    border: 3px solid var(--pc-paper-3);
    border-radius: 14px;
    padding: 2rem 1.6rem;
    max-width: 26rem;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.4), inset 0 0 0 6px var(--pc-paper-2);
    position: relative;
    overflow: hidden;
  }
  .sunrise {
    height: 90px;
    position: relative;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: 8px;
    background: linear-gradient(180deg, #f0d2a4 0%, #f8e5b8 100%);
  }
  .sunrise .sun {
    position: absolute;
    bottom: -50%;
    left: 50%;
    width: 50%;
    aspect-ratio: 1;
    background: radial-gradient(circle, #f5a94a 30%, #e8881f 70%);
    border-radius: 50%;
    transform: translateX(-50%);
    animation: sun-rise 2200ms cubic-bezier(.2,.8,.2,1) forwards;
    box-shadow: 0 0 30px rgba(245, 169, 74, 0.6);
  }
  @keyframes sun-rise {
    from { bottom: -60%; }
    to   { bottom: 10%; }
  }
  .ending-card h2 {
    font-size: 1.6rem;
    color: var(--pc-ink);
    margin: 0 0 0.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .ending-quote {
    font-size: 0.9rem;
    color: var(--pc-ink-soft);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 1.4rem;
  }
  .end-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1rem;
    margin: 0 0 1.5rem;
    text-align: left;
    background: var(--pc-paper-2);
    padding: 1rem 1.1rem;
    border-radius: 6px;
    font-size: 0.82rem;
  }
  .end-stats dt { color: var(--pc-ink-soft); font-weight: 600; }
  .end-stats dd { margin: 0; color: var(--pc-ink); font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .character, .flame, .smoke, .input-btn.quiet { animation: none !important; }
  }
</style>

<script>
  // ===== state model =====
  const STORAGE_KEY = 'papercut.state.v1';
  const STAGES = [
    { id: 0, name: 'intern',            xpAt: 0,    awardCadence: 50 },
    { id: 1, name: 'junior',            xpAt: 50,   awardCadence: 80 },
    { id: 2, name: 'senior',            xpAt: 150,  awardCadence: 120 },
    { id: 3, name: 'art director',      xpAt: 350,  awardCadence: 180 },
    { id: 4, name: 'creative director', xpAt: 700,  awardCadence: 250 },
    { id: 5, name: 'veteran',           xpAt: 1300, awardCadence: 320 },
  ];

  const AWARD_POOL = [
    { name: 'Spec Ad Champion',         emoji: '🏆' },
    { name: 'Best Headline (Bronze)',   emoji: '🥈' },
    { name: 'Lifetime Achievement (Trying)', emoji: '📜' },
    { name: 'D&AD Wood Pencil',         emoji: '🪵' },
    { name: 'Cannes Lion (Shortlist)',  emoji: '🦁' },
    { name: 'Effie Bronze',             emoji: '🥉' },
    { name: 'Adweek Top 50',            emoji: '📰' },
    { name: 'LBB Talent Spotter',       emoji: '✨' },
    { name: 'Industry Disruptor',       emoji: '🚀' },
    { name: 'Mentorship Honoured',      emoji: '🎖️' },
    { name: 'LinkedIn Thought Leader',  emoji: '💡' },
    { name: 'Industry Veteran',         emoji: '🦴' },
    { name: 'Founder Feature',          emoji: '📰' },
    { name: 'Pitch Deck Hall of Fame',  emoji: '📊' },
    { name: 'Most Posts About Process', emoji: '🧵' },
    { name: 'Beloved by Brand X',       emoji: '🤝' },
    { name: 'Scrappy Award Loser',      emoji: '😅' },
    { name: 'Headlines a Webinar',      emoji: '🎤' },
  ];

  const defaultState = () => ({
    fed: 70,
    mood: 70,
    burnout: 5,
    xp: 0,
    stage: 0,
    awards: [],
    startedAt: Date.now(),
    timeAlive: 0,
    nextAwardAt: STAGES[0].awardCadence,
    awardCount: 0,
    ended: false,
    endedAt: null,
  });

  let state = loadState();

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return defaultState();
      const parsed = JSON.parse(raw);
      return { ...defaultState(), ...parsed };
    } catch {
      return defaultState();
    }
  }
  function saveState() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
  }
  function resetState() {
    state = defaultState();
    saveState();
  }

  // ===== render =====
  function render() {
    document.getElementById('fedFill').style.width = state.fed + '%';
    document.getElementById('moodFill').style.width = state.mood + '%';
    document.getElementById('burnoutFill').style.width = state.burnout + '%';

    // Career stage — climb if xp passes thresholds
    let stageIdx = 0;
    for (let i = STAGES.length - 1; i >= 0; i--) {
      if (state.xp >= STAGES[i].xpAt) { stageIdx = i; break; }
    }
    if (stageIdx !== state.stage) {
      state.stage = stageIdx;
      grantAward('promotion');
      saveState();
    }
    const diorama = document.getElementById('diorama');
    diorama.className = 'diorama stage-' + state.stage;

    document.getElementById('careerLabel').textContent = '— ' + STAGES[state.stage].name + ' —';

    // Mouth shape based on mood
    const mouth = document.getElementById('mouth');
    if (state.mood >= 60)      mouth.setAttribute('d', 'M42,48 Q50,54 58,48'); // happy
    else if (state.mood >= 30) mouth.setAttribute('d', 'M42,49 L58,49');       // flat
    else                       mouth.setAttribute('d', 'M42,52 Q50,46 58,52'); // sad

    // Sky based on burnout
    const sky = document.getElementById('sky');
    if (state.burnout < 50) {
      sky.style.background = 'linear-gradient(180deg, #e8edf2 0%, #c8d3e0 100%)';
    } else if (state.burnout < 80) {
      sky.style.background = 'linear-gradient(180deg, #e8b97a 0%, #d68c3d 100%)';
    } else {
      sky.style.background = 'linear-gradient(180deg, #c8541a 0%, #6b1818 100%)';
    }

    // Fire & smoke
    renderFire();
    renderSmoke();

    // Trophies
    renderTrophies();

    // Quit button starts pulsing when burnout > 60 OR after ~3 min played
    const quitBtn = document.getElementById('btnQuit');
    if (state.burnout > 60 || state.timeAlive > 180) quitBtn.classList.add('pulse');
    else quitBtn.classList.remove('pulse');
  }

  function renderFire() {
    const layer = document.getElementById('fireLayer');
    layer.innerHTML = '';
    // Fire spawns at thresholds: 50 (1 flame), 70 (3), 85 (6), 100 (8 + screen tint)
    let count = 0;
    if (state.burnout >= 50) count = 1;
    if (state.burnout >= 70) count = 3;
    if (state.burnout >= 85) count = 6;
    if (state.burnout >= 95) count = 9;
    const spots = [
      { left: '20%', bottom: '38%' },
      { left: '70%', bottom: '36%' },
      { left: '40%', bottom: '20%' },
      { left: '85%', bottom: '20%' },
      { left: '8%',  bottom: '22%' },
      { left: '55%', bottom: '40%' },
      { left: '30%', bottom: '50%' },
      { left: '78%', bottom: '52%' },
      { left: '50%', bottom: '60%' },
    ];
    for (let i = 0; i < count; i++) {
      const flame = document.createElement('span');
      flame.className = 'flame';
      flame.textContent = '🔥';
      flame.style.left = spots[i].left;
      flame.style.bottom = spots[i].bottom;
      flame.style.animationDelay = (i * 80) + 'ms';
      layer.appendChild(flame);
    }
  }

  function renderSmoke() {
    const layer = document.getElementById('smokeLayer');
    layer.innerHTML = '';
    let count = 0;
    if (state.burnout >= 30) count = 1;
    if (state.burnout >= 60) count = 2;
    if (state.burnout >= 85) count = 4;
    const spots = [
      { left: '22%', top: '12%' },
      { left: '70%', top: '8%' },
      { left: '50%', top: '14%' },
      { left: '88%', top: '20%' },
    ];
    for (let i = 0; i < count; i++) {
      const sm = document.createElement('span');
      sm.className = 'smoke';
      sm.textContent = '💨';
      sm.style.left = spots[i].left;
      sm.style.top = spots[i].top;
      sm.style.animationDelay = (i * 700) + 'ms';
      layer.appendChild(sm);
    }
  }

  function renderTrophies() {
    const tc = document.getElementById('trophyCase');
    tc.innerHTML = '';
    if (state.awards.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'trophy-empty';
      empty.textContent = 'no awards yet. keep feeding.';
      tc.appendChild(empty);
      return;
    }
    state.awards.slice().reverse().forEach((a, i) => {
      const t = document.createElement('span');
      t.className = 'trophy';
      if (i === 0 && a._fresh) { t.classList.add('new'); }
      t.innerHTML = `<span class="te">${a.emoji}</span><span>${escapeHtml(a.name)}</span>`;
      tc.appendChild(t);
    });
    // Clear fresh flags after first paint
    state.awards.forEach(a => delete a._fresh);

    // Trophy shelf inside the diorama mirrors the latest 3 awards
    const shelf = document.getElementById('trophyShelf');
    shelf.textContent = state.awards.slice(-3).map(a => a.emoji).join(' ');
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  // ===== inputs =====
  function feedExposure() {
    if (state.ended) return;
    state.fed = clamp(state.fed + 22, 0, 100);
    state.burnout = clamp(state.burnout + 3, 0, 100);
    state.xp += 6;
    floatText('+exposure 📢', '#d97a1a');
    sfx.paper();
    renderAfter();
  }
  function giveRaise() {
    if (state.ended) return;
    state.mood = clamp(state.mood + 14, 0, 100);
    state.fed = clamp(state.fed + 4, 0, 100); // little fed bump for the dopamine
    state.xp += 4;
    floatText('+raise 💸', '#3a8a4a');
    sfx.cha();
    renderAfter();
  }
  function givePraise() {
    if (state.ended) return;
    state.mood = clamp(state.mood + 6, 0, 100);
    state.xp += 2;
    floatText('+praise 👏', '#3a6a8a');
    sfx.clap();
    renderAfter();
  }
  function quit() {
    if (state.ended) return;
    state.ended = true;
    state.endedAt = Date.now();
    saveState();
    showEnding();
  }
  function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }

  function renderAfter() {
    checkAwards();
    saveState();
    render();
  }

  // ===== awards =====
  function grantAward(reason) {
    const pool = AWARD_POOL;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    const award = { ...pick, ts: Date.now(), reason, _fresh: true };
    state.awards.push(award);
    state.awardCount = (state.awardCount || 0) + 1;
    state.nextAwardAt = state.xp + STAGES[state.stage].awardCadence;
    saveState();
  }
  function checkAwards() {
    while (state.xp >= state.nextAwardAt) {
      grantAward('milestone');
    }
  }

  // ===== floater =====
  function floatText(text, color) {
    const el = document.getElementById('floater');
    el.textContent = text;
    el.style.color = color || '#d97a1a';
    el.classList.remove('fly');
    void el.offsetWidth; // restart animation
    el.classList.add('fly');
  }

  // ===== sound (Web Audio, generated; toggle in topbar) =====
  const sfx = (() => {
    let ctx = null;
    let on = false;
    let humOsc = null, humGain = null, humNoise = null;

    const ensureCtx = () => {
      if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();
      return ctx;
    };

    const startHum = () => {
      if (!on) return;
      const c = ensureCtx();
      humGain = c.createGain();
      humGain.gain.value = 0.012;
      humGain.connect(c.destination);
      // Office hum: very low oscillator + filtered noise
      humOsc = c.createOscillator();
      humOsc.type = 'sine';
      humOsc.frequency.value = 60;
      humOsc.connect(humGain);
      humOsc.start();
      // Noise: short noise buffer looped through low-pass
      const buf = c.createBuffer(1, c.sampleRate * 1.5, c.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * 0.5;
      humNoise = c.createBufferSource();
      humNoise.buffer = buf;
      humNoise.loop = true;
      const lp = c.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 380;
      const noiseGain = c.createGain();
      noiseGain.gain.value = 0.018;
      humNoise.connect(lp).connect(noiseGain).connect(c.destination);
      humNoise.start();
    };
    const stopHum = () => {
      try { humOsc?.stop(); } catch {}
      try { humNoise?.stop(); } catch {}
      humOsc = null; humNoise = null; humGain = null;
    };

    const beep = (freq, durMs, type='sine', gain=0.05, attack=0.01) => {
      if (!on) return;
      const c = ensureCtx();
      const osc = c.createOscillator();
      osc.type = type;
      osc.frequency.value = freq;
      const g = c.createGain();
      const t = c.currentTime;
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(gain, t + attack);
      g.gain.exponentialRampToValueAtTime(0.0001, t + durMs / 1000);
      osc.connect(g).connect(c.destination);
      osc.start(t);
      osc.stop(t + durMs / 1000);
    };

    const noiseBurst = (durMs, gain=0.04, lpFreq=2400) => {
      if (!on) return;
      const c = ensureCtx();
      const buf = c.createBuffer(1, c.sampleRate * (durMs / 1000), c.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
      const src = c.createBufferSource();
      src.buffer = buf;
      const lp = c.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = lpFreq;
      const g = c.createGain();
      const t = c.currentTime;
      g.gain.setValueAtTime(gain, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + durMs / 1000);
      src.connect(lp).connect(g).connect(c.destination);
      src.start(t);
    };

    return {
      isOn: () => on,
      enable: () => { on = true; startHum(); },
      disable: () => { on = false; stopHum(); },
      paper: () => noiseBurst(80, 0.06, 1800), // crinkle
      clap:  () => noiseBurst(50, 0.05, 3200), // soft crack
      cha:   () => { beep(880, 100, 'square', 0.04); setTimeout(() => beep(1320, 120, 'square', 0.035), 80); },
    };
  })();

  // ===== ending =====
  function showEnding() {
    const minutes = Math.max(1, Math.round(state.timeAlive / 60));
    const stage = STAGES[state.stage].name;
    const stats = document.getElementById('endStats');
    stats.innerHTML = `
      <dt>time spent feeding</dt><dd>${minutes} min</dd>
      <dt>stage at quit</dt><dd>${stage}</dd>
      <dt>awards collected</dt><dd>${state.awardCount}</dd>
      <dt>final mood</dt><dd>${Math.round(state.mood)} / 100</dd>
      <dt>final burnout</dt><dd>${Math.round(state.burnout)} / 100</dd>
      <dt>work-life balance</dt><dd>restored ✓</dd>
    `;
    const ending = document.getElementById('ending');
    ending.hidden = false;
    sfx.disable(); // silence on quit
    document.getElementById('bgmToggle').classList.remove('on');
    document.getElementById('bgmIcon').textContent = '🔇';
    document.getElementById('bgmLabel').textContent = 'audio off';
  }
  function startNewLife() {
    resetState();
    document.getElementById('ending').hidden = true;
    render();
  }

  // ===== ticker =====
  let lastTickAt = Date.now();
  setInterval(() => {
    if (state.ended) return;
    const now = Date.now();
    const dt = (now - lastTickAt) / 1000;
    lastTickAt = now;
    state.timeAlive += dt;
    state.fed     = clamp(state.fed     - 1.6, 0, 100);
    state.mood    = clamp(state.mood    - 0.7, 0, 100);
    state.burnout = clamp(state.burnout + 0.5, 0, 100);
    if (state.fed === 0) state.mood = clamp(state.mood - 1.4, 0, 100);
    saveState();
    render();
  }, 5000);

  // ===== wiring =====
  document.getElementById('btnFeed').addEventListener('click', feedExposure);
  document.getElementById('btnRaise').addEventListener('click', giveRaise);
  document.getElementById('btnPraise').addEventListener('click', givePraise);
  document.getElementById('btnQuit').addEventListener('click', () => {
    if (confirm('quit? this is the only way to win, but the game truly ends.')) quit();
  });
  document.getElementById('btnReset').addEventListener('click', startNewLife);

  // BGM toggle
  const bgmBtn = document.getElementById('bgmToggle');
  const bgmIcon = document.getElementById('bgmIcon');
  const bgmLabel = document.getElementById('bgmLabel');
  bgmBtn.addEventListener('click', () => {
    if (sfx.isOn()) {
      sfx.disable();
      bgmBtn.classList.remove('on');
      bgmIcon.textContent = '🔇';
      bgmLabel.textContent = 'audio off';
    } else {
      sfx.enable();
      bgmBtn.classList.add('on');
      bgmIcon.textContent = '🔊';
      bgmLabel.textContent = 'audio on';
    }
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && sfx.isOn()) sfx.disable();
  });

  // ===== boot =====
  if (state.ended) {
    showEnding();
  } else {
    render();
  }
</script>
