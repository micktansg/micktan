      font-size: 0.88rem;
    }
    .dm-btn-send { justify-self: end; padding: 0.55rem 1.1rem; }
    .dm-chat[data-thinking="true"] .dm-btn-send { opacity: 0.6; pointer-events: none; }

    /* tips */
    :global(.dm-tips) {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-direction: column; gap: 0.55rem;
    }
    :global(.dm-tip) {
      padding: 0.75rem 0.9rem;
      background: var(--dm-bg-2);
      border: 1px solid var(--dm-border);
      border-radius: 10px;
      transition: border-color 160ms;
    }
    :global(.dm-tip:hover) { border-color: var(--dm-border-strong); }
    :global(.dm-tip-line) {
      font-size: 0.9rem; color: var(--dm-text);
      margin: 0 0 0.3rem; font-weight: 500;
    }
    :global(.dm-tip-why) {
