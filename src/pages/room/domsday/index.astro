    }

    /* citations */
    .dm-cite-count {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem; color: var(--dm-orange-strong);
      padding: 0.2rem 0.55rem;
      border: 1px solid #fed7aa;
      background: var(--dm-orange-soft);
      border-radius: 5px;
    }
    :global(.dm-cites) {
      list-style: none; margin: 0; padding: 0;
      display: grid; gap: 0.45rem; grid-template-columns: 1fr;
    }
    @media (min-width: 720px) { :global(.dm-cites) { grid-template-columns: 1fr 1fr; } }
    :global(.dm-cite) {
      display: block;
      padding: 0.6rem 0.75rem;
      background: var(--dm-surface);
      border: 1px solid var(--dm-border);
      border-radius: 8px;
      text-decoration: none;
