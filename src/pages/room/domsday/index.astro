    :global(.dm-session-status.dm-st-done) { background: var(--dm-green-soft); color: var(--dm-green); }
    :global(.dm-session-status.dm-st-modified) { background: var(--dm-blue-soft); color: var(--dm-blue); }
    :global(.dm-session-status.dm-st-skipped) { background: var(--dm-amber-soft); color: var(--dm-amber); }
