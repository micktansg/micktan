    :global(.dm-status-btn:hover) { border-color: var(--dm-border-strong); }
    :global(.dm-status-btn[data-status="done"][aria-pressed="true"]) {
      background: var(--dm-green-soft); border-color: var(--dm-green); color: var(--dm-green);
    }
    :global(.dm-status-btn[data-status="modified"][aria-pressed="true"]) {
