---
// /room/domsday/ — DOMSDAY MACHINE
// Light, energizing performance training coach. UUID-bookmark auth.
// Phase 1+2: intake → cited plan → Coach voice + tracking + chat refine.
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="DOMSDAY MACHINE — Mick Tan" description="performance training coach. evidence-based, adaptive.">
  <main class="dm-root" data-view="loading">

    <!-- Top nav -->
    <header class="dm-nav">
      <a class="dm-back" href="/room/" data-astro-prefetch>&larr; the room</a>
      <div class="dm-brand">
        <span class="dm-orb dm-orb-sm" aria-hidden="true"><span class="dm-orb-ball"></span></span>
        <span class="dm-brand-name">DOMSDAY MACHINE</span>
        <span class="dm-brand-sub">v0.2 · experimental</span>
      </div>
      <button class="dm-bookmark" type="button" data-action="bookmark">
        <span class="dm-bookmark-label">bookmark this</span>
        <span class="dm-bookmark-id" data-bind="user-id-short"></span>
      </button>
    </header>

    <!-- Disclaimer -->
    <aside class="dm-disclaim" role="note">
      <span class="dm-disclaim-tag">heads up</span>
      <span>not medical advice. experimental. your data lives at this URL — bookmark it. flagged conditions get conservative defaults; clear with a clinician before training.</span>
    </aside>

    <!-- LOADING -->
    <section class="dm-view" data-view-target="loading">
      <div class="dm-center">
        <div class="dm-orb dm-orb-lg" aria-hidden="true"><span class="dm-orb-ball"></span></div>
        <p class="dm-helper">booting…</p>
      </div>
    </section>

    <!-- INTAKE -->
    <section class="dm-view dm-view-intake" data-view-target="intake" hidden>
      <div class="dm-intake-shell">
        <div class="dm-intake-head">
          <p class="dm-eyebrow">intake — step <span data-bind="step-current">1</span> / 3</p>
          <h1 class="dm-h1">Coach needs a read on you.</h1>
          <p class="dm-lede">Three short steps. Your answers stay on this URL. Skip what you don't have.</p>
        </div>
        <div class="dm-progress" aria-hidden="true">
          <div class="dm-progress-bar" data-bind="progress-bar"></div>
        </div>
        <form class="dm-intake" data-bind="intake-form" novalidate>
          <!-- STEP 1 -->
          <fieldset class="dm-step" data-step="1">
            <legend class="dm-step-title">what are you actually after?</legend>

            <div class="dm-field">
              <label class="dm-label">pick what fits — multi-select</label>
              <div class="dm-chips" data-bind="goal-tags">
                <button type="button" class="dm-chip" data-tag="strength">strength</button>
                <button type="button" class="dm-chip" data-tag="hypertrophy">muscle / hypertrophy</button>
                <button type="button" class="dm-chip" data-tag="endurance">endurance</button>
                <button type="button" class="dm-chip" data-tag="fat-loss">fat loss</button>
                <button type="button" class="dm-chip" data-tag="mobility">mobility</button>
                <button type="button" class="dm-chip" data-tag="longevity">longevity / general health</button>
                <button type="button" class="dm-chip" data-tag="sport">sport-specific</button>
              </div>
            </div>

            <div class="dm-field">
              <label class="dm-label" for="dm-narrative">in your own words — what's the goal?</label>
              <textarea id="dm-narrative" class="dm-input dm-textarea" rows="3"
                placeholder="e.g. drop 5kg by July, run a half-marathon under 2hr, deadlift 1.5x bodyweight…"
                data-bind="goalNarrative" maxlength="600"></textarea>
            </div>

            <div class="dm-field">
              <label class="dm-label">experience</label>
              <div class="dm-chips" data-bind="experience" data-single>
                <button type="button" class="dm-chip" data-tag="beginner">beginner</button>
                <button type="button" class="dm-chip" data-tag="intermediate">intermediate</button>
                <button type="button" class="dm-chip" data-tag="advanced">advanced</button>
              </div>
            </div>
          </fieldset>

          <!-- STEP 2 -->
          <fieldset class="dm-step" data-step="2" hidden>
            <legend class="dm-step-title">time, body, conditions.</legend>

            <div class="dm-grid-2">
              <div class="dm-field">
                <label class="dm-label" for="dm-days">days / week</label>
                <div class="dm-slider-row">
                  <input id="dm-days" type="range" class="dm-slider" min="1" max="7" step="1" value="3" data-bind="daysPerWeek" />
                  <output class="dm-slider-out" data-bind-out="daysPerWeek">3</output>
                </div>
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-minutes">minutes / session</label>
                <div class="dm-slider-row">
                  <input id="dm-minutes" type="range" class="dm-slider" min="15" max="120" step="5" value="45" data-bind="minutesPerSession" />
                  <output class="dm-slider-out" data-bind-out="minutesPerSession">45</output>
                </div>
              </div>
            </div>

            <div class="dm-field">
              <label class="dm-label" for="dm-restrict">restrictions / injuries</label>
              <textarea id="dm-restrict" class="dm-input dm-textarea" rows="2"
                placeholder="e.g. left knee tweaky on deep squats, shoulder mobility limited, lower back sensitive…"
                data-bind="restrictions" maxlength="800"></textarea>
            </div>

            <div class="dm-field">
              <label class="dm-label">health flags — check anything that applies</label>
              <div class="dm-flags" data-bind="healthFlags">
                <label class="dm-flag"><input type="checkbox" data-flag="cardiovascular" /><span>cardiovascular condition</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="pregnancy" /><span>pregnant / postpartum</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="post-surgical" /><span>post-surgical / rehab</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="medication" /><span>on meds affecting exercise</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="eating-history" /><span>eating disorder history</span></label>
              </div>
              <p class="dm-helper" data-bind="flag-helper" hidden>Coach will lean conservative on intensity and recommend clinician sign-off.</p>
            </div>

            <div class="dm-field">
              <label class="dm-label" for="dm-current">what does a typical week of activity look like right now?</label>
              <textarea id="dm-current" class="dm-input dm-textarea" rows="2"
                placeholder="e.g. 2x gym (push/pull), 1x easy run, daily walk to work…"
                data-bind="currentActivity" maxlength="600"></textarea>
            </div>
          </fieldset>

          <!-- STEP 3 -->
          <fieldset class="dm-step" data-step="3" hidden>
            <legend class="dm-step-title">metrics — all optional, skip what you don't know.</legend>

            <div class="dm-grid-2">
              <div class="dm-field">
                <label class="dm-label" for="dm-age">age</label>
                <input id="dm-age" type="number" class="dm-input" min="12" max="110" placeholder="e.g. 32" data-bind="age" />
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-weight">weight (kg)</label>
                <input id="dm-weight" type="number" class="dm-input" min="25" max="350" step="0.1" placeholder="e.g. 72.5" data-bind="weightKg" />
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-height">height (cm)</label>
                <input id="dm-height" type="number" class="dm-input" min="100" max="250" placeholder="e.g. 178" data-bind="heightCm" />
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-rhr">resting HR (bpm)</label>
                <input id="dm-rhr" type="number" class="dm-input" min="30" max="200" placeholder="if you know it" data-bind="restingHr" />
              </div>
              <div class="dm-field dm-grid-2-span">
                <label class="dm-label" for="dm-sleep">avg sleep (hours)</label>
                <input id="dm-sleep" type="number" class="dm-input" min="0" max="16" step="0.5" placeholder="e.g. 7.5" data-bind="sleepHours" />
              </div>
            </div>

            <div class="dm-final-disclaim">
              <strong>before you submit:</strong> Coach is an LLM-generated voice. recommendations are grounded in web search results — not a doctor. don't follow anything that conflicts with medical advice.
            </div>
          </fieldset>

          <div class="dm-actions">
            <button type="button" class="dm-btn dm-btn-ghost" data-action="back" hidden>back</button>
            <button type="button" class="dm-btn dm-btn-primary" data-action="next">next →</button>
            <button type="button" class="dm-btn dm-btn-primary dm-btn-submit" data-action="submit" hidden>generate protocol →</button>
          </div>
        </form>
      </div>
    </section>

    <!-- GENERATING -->
    <section class="dm-view" data-view-target="generating" hidden>
      <div class="dm-center">
        <div class="dm-orb dm-orb-lg" aria-hidden="true"><span class="dm-orb-ball"></span></div>
        <p class="dm-eyebrow">Coach is reading your file</p>
        <h2 class="dm-h2" data-bind="generating-status">cross-referencing the literature…</h2>
        <p class="dm-helper">first generation can take 20–40s with grounded search. don't refresh.</p>
      </div>
    </section>

    <!-- DASHBOARD -->
    <section class="dm-view dm-view-dashboard" data-view-target="dashboard" hidden>

      <div class="dm-hero">
        <div class="dm-hero-meta">
          <p class="dm-eyebrow">your protocol</p>
          <h1 class="dm-h1" data-bind="plan-title">—</h1>
          <p class="dm-summary" data-bind="plan-summary">—</p>
          <div class="dm-hero-stats" data-bind="hero-stats"></div>
        </div>
        <div class="dm-hero-actions">
          <button class="dm-btn dm-btn-ghost dm-btn-sm" type="button" data-action="regen">regenerate</button>
          <button class="dm-btn dm-btn-ghost dm-btn-sm" type="button" data-action="reset">start over</button>
        </div>
      </div>

      <div class="dm-grid">

        <!-- ROADMAP -->
        <section class="dm-panel dm-panel-roadmap">
          <header class="dm-panel-head">
            <h3 class="dm-panel-title">roadmap</h3>
            <div class="dm-week-tabs" data-bind="week-tabs"></div>
          </header>
          <div class="dm-week-focus" data-bind="week-focus"></div>
          <div class="dm-sessions" data-bind="sessions"></div>
        </section>

        <!-- COACH -->
        <aside class="dm-panel dm-panel-coach">
          <header class="dm-panel-head">
            <div class="dm-coach-id">
              <div class="dm-orb dm-orb-md" aria-hidden="true"><span class="dm-orb-ball"></span></div>
              <div>
                <div class="dm-coach-name">Coach</div>
                <div class="dm-coach-sub">listening</div>
              </div>
            </div>
          </header>
          <div class="dm-coach-log" data-bind="coach-log"></div>
          <form class="dm-chat" data-bind="chat-form">
            <textarea class="dm-input dm-chat-input" rows="2"
              placeholder="tell Coach what to change, ask a question, or talk through it…"
              data-bind="chat-input" maxlength="1000"></textarea>
            <button type="submit" class="dm-btn dm-btn-primary dm-btn-send" data-action="send">send →</button>
          </form>
        </aside>

        <!-- TIPS -->
        <section class="dm-panel dm-panel-tips">
          <header class="dm-panel-head"><h3 class="dm-panel-title">diet</h3></header>
          <ul class="dm-tips" data-bind="diet-tips"></ul>
        </section>

        <section class="dm-panel dm-panel-tips">
          <header class="dm-panel-head"><h3 class="dm-panel-title">lifestyle</h3></header>
          <ul class="dm-tips" data-bind="lifestyle-tips"></ul>
        </section>

        <!-- CITATIONS -->
        <section class="dm-panel dm-panel-cites">
          <header class="dm-panel-head">
            <h3 class="dm-panel-title">sources</h3>
            <span class="dm-cite-count" data-bind="cite-count">0</span>
          </header>
          <ul class="dm-cites" data-bind="citations"></ul>
        </section>

      </div>
    </section>

    <!-- ERROR -->
    <section class="dm-view" data-view-target="error" hidden>
      <div class="dm-center">
        <p class="dm-eyebrow">protocol failure</p>
        <h2 class="dm-h2" data-bind="error-message">something went sideways.</h2>
        <button class="dm-btn dm-btn-primary" type="button" data-action="reset">start over</button>
      </div>
    </section>

  </main>

  <style>
    /* ---- root + reset ---- */
    :global(html), :global(body) { background: #fefdf8; }

    .dm-root {
      --dm-bg: #fefdf8;
      --dm-bg-2: #fbf9f1;
      --dm-surface: #ffffff;
      --dm-surface-2: #faf8f1;
      --dm-border: #ece7d6;
      --dm-border-strong: #d8d2bc;
      --dm-text: #1a1814;
      --dm-text-2: #4d4a40;
      --dm-text-3: #8a8576;
      --dm-orange: #f97316;
      --dm-orange-soft: #ffedd5;
      --dm-orange-strong: #ea580c;
      --dm-green: #16a34a;
      --dm-green-soft: #dcfce7;
      --dm-blue: #0284c7;
      --dm-blue-soft: #e0f2fe;
      --dm-amber: #d97706;
      --dm-amber-soft: #fef3c7;
      --dm-red: #dc2626;

      min-height: 100vh;
      background:
        radial-gradient(900px 500px at 90% -10%, rgba(249,115,22,0.10), transparent 65%),
        radial-gradient(700px 400px at -10% 10%, rgba(2,132,199,0.06), transparent 60%),
        var(--dm-bg);
      color: var(--dm-text);
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      padding: 1.5rem clamp(1rem, 4vw, 2rem) 6rem;
      line-height: 1.5;
      position: relative;
    }

    /* ---- glowing orb ---- */
    .dm-orb {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px;
    }
    :global(.dm-orb-ball) {
      width: 14px; height: 14px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 28%, #ffedd5 0%, #fdba74 38%, #fb923c 70%, #ea580c 100%);
      box-shadow:
        0 0 12px rgba(251, 146, 60, 0.55),
        0 0 26px rgba(251, 146, 60, 0.28);
      animation: dmOrb 4.2s ease-in-out infinite;
      will-change: transform, box-shadow;
    }
    @keyframes dmOrb {
      0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 12px rgba(251,146,60,0.50), 0 0 26px rgba(251,146,60,0.22);
        filter: brightness(1);
      }
      50% {
        transform: scale(1.10);
        box-shadow: 0 0 20px rgba(251,146,60,0.72), 0 0 40px rgba(251,146,60,0.42);
        filter: brightness(1.08);
      }
    }
    .dm-orb-sm { width: 18px; height: 18px; }
    :global(.dm-orb-sm > .dm-orb-ball) { width: 9px; height: 9px; }
    .dm-orb-md { width: 44px; height: 44px; }
    :global(.dm-orb-md > .dm-orb-ball) { width: 22px; height: 22px; }
    .dm-orb-lg { width: 88px; height: 88px; }
    :global(.dm-orb-lg > .dm-orb-ball) {
      width: 44px; height: 44px;
      box-shadow: 0 0 24px rgba(251,146,60,0.55), 0 0 60px rgba(251,146,60,0.35);
    }

    /* ---- nav ---- */
    .dm-nav {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; padding: 0.6rem 0.2rem 1rem; flex-wrap: wrap;
    }
    .dm-back {
      color: var(--dm-text-3);
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 180ms;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .dm-back:hover { color: var(--dm-text); }
    .dm-brand {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .dm-brand-name {
      font-size: 0.95rem; font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--dm-text);
    }
    .dm-brand-sub {
      font-size: 0.7rem; color: var(--dm-text-3);
      letter-spacing: 0.04em;
    }
    .dm-bookmark {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--dm-surface);
      border: 1px solid var(--dm-border);
      color: var(--dm-text-2);
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.72rem;
      padding: 0.45rem 0.7rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 180ms;
    }
    .dm-bookmark:hover {
      border-color: var(--dm-orange);
      color: var(--dm-orange-strong);
      box-shadow: 0 4px 12px -4px rgba(249,115,22,0.25);
    }
    .dm-bookmark.dm-copied { border-color: var(--dm-green); color: var(--dm-green); }
    .dm-bookmark-id { color: var(--dm-orange-strong); }

    /* ---- disclaimer ---- */
    .dm-disclaim {
      display: flex; gap: 0.7rem; align-items: flex-start;
      padding: 0.7rem 1rem;
      background: var(--dm-amber-soft);
      border: 1px solid #f3e1a8;
      border-radius: 10px;
      font-size: 0.82rem;
      color: #5a3d05;
      margin-bottom: 1.5rem;
    }
    .dm-disclaim-tag {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem; color: var(--dm-amber);
      letter-spacing: 0.08em; text-transform: uppercase;
      padding-top: 0.05rem; flex-shrink: 0;
    }

    /* ---- views ---- */
    .dm-view { max-width: 78rem; margin: 0 auto; }
    .dm-view[hidden] { display: none !important; }

    /* ---- typography ---- */
    .dm-eyebrow {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--dm-orange-strong); margin: 0 0 0.6rem;
    }
    .dm-h1 {
      font-size: clamp(1.7rem, 3.8vw, 2.6rem);
      font-weight: 600; letter-spacing: -0.015em;
      line-height: 1.1; margin: 0;
      color: var(--dm-text);
    }
    .dm-h2 { font-size: clamp(1.2rem, 2.6vw, 1.6rem); font-weight: 600; margin: 0 0 0.4rem; }
    .dm-lede { margin-top: 0.8rem; color: var(--dm-text-2); font-size: 1rem; }
    .dm-summary { margin-top: 0.6rem; color: var(--dm-text-2); font-size: 0.95rem; }
    .dm-helper { font-size: 0.78rem; color: var(--dm-text-3); margin: 0.5rem 0 0; }

    .dm-center {
      display: flex; flex-direction: column; align-items: center;
      gap: 1rem; padding: 5rem 1rem; text-align: center; color: var(--dm-text-2);
    }

    /* ---- intake ---- */
    .dm-intake-shell { max-width: 42rem; margin: 1rem auto 0; }
    .dm-progress {
      height: 3px; background: var(--dm-border); border-radius: 2px;
      overflow: hidden; margin: 1.6rem 0 1.8rem;
    }
    .dm-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--dm-orange) 0%, #fbbf24 100%);
      width: 33%; transition: width 380ms cubic-bezier(.2,.8,.2,1);
    }
    .dm-step { border: none; padding: 0; margin: 0; }
    .dm-step[hidden] { display: none; }
    .dm-step-title {
      font-size: 1.2rem; font-weight: 600; color: var(--dm-text);
      padding: 0; margin: 0 0 1.4rem;
    }
    .dm-field { margin-bottom: 1.4rem; }
    .dm-label {
      display: block;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--dm-text-3); margin-bottom: 0.5rem;
    }

    .dm-input {
      width: 100%; box-sizing: border-box;
      background: var(--dm-surface);
      border: 1px solid var(--dm-border);
      border-radius: 8px; color: var(--dm-text);
      font-family: inherit; font-size: 0.95rem;
      padding: 0.72rem 0.9rem;
      transition: border-color 160ms, box-shadow 160ms;
    }
    .dm-input:focus {
      outline: none;
      border-color: var(--dm-orange);
      box-shadow: 0 0 0 3px rgba(249,115,22,0.18);
    }
    .dm-textarea { resize: vertical; min-height: 3rem; line-height: 1.5; }

    /* chips */
    .dm-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
    .dm-chip {
      background: var(--dm-surface);
      border: 1px solid var(--dm-border);
      color: var(--dm-text-2);
      font-family: inherit; font-size: 0.85rem;
      padding: 0.45rem 0.95rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 160ms;
    }
    .dm-chip:hover {
      border-color: var(--dm-orange);
      color: var(--dm-orange-strong);
    }
    .dm-chip[aria-pressed="true"] {
      border-color: var(--dm-orange);
      background: var(--dm-orange-soft);
      color: var(--dm-orange-strong);
    }

    /* sliders (global so JS-injected mini-sliders inherit) */
    .dm-slider-row { display: flex; align-items: center; gap: 0.9rem; }
    :global(.dm-slider) {
      flex: 1; -webkit-appearance: none; appearance: none;
      height: 4px; background: #ece7d6; border-radius: 2px; outline: none;
    }
    :global(.dm-slider::-webkit-slider-thumb) {
      -webkit-appearance: none;
      width: 18px; height: 18px;
      border-radius: 50%; background: #f97316;
      cursor: pointer;
      box-shadow: 0 0 0 4px rgba(249,115,22,0.18);
      transition: box-shadow 160ms;
    }
    :global(.dm-slider::-webkit-slider-thumb:hover) {
      box-shadow: 0 0 0 6px rgba(249,115,22,0.28);
    }
    :global(.dm-slider::-moz-range-thumb) {
      width: 18px; height: 18px; border: none; border-radius: 50%;
      background: #f97316; cursor: pointer;
    }
    .dm-slider-out {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.95rem; color: var(--dm-orange-strong);
      min-width: 2.4rem; text-align: right;
    }

    /* flags */
    .dm-flags { display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
    @media (min-width: 600px) { .dm-flags { grid-template-columns: 1fr 1fr; } }
    .dm-flag {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.6rem 0.85rem;
      background: var(--dm-surface);
      border: 1px solid var(--dm-border);
      border-radius: 8px; cursor: pointer;
      font-size: 0.88rem; color: var(--dm-text-2);
      transition: border-color 160ms, background 160ms;
    }
    .dm-flag:hover { border-color: var(--dm-amber); background: var(--dm-amber-soft); }
    .dm-flag input { accent-color: var(--dm-amber); }
    .dm-flag input:checked + span { color: var(--dm-amber); font-weight: 500; }

    .dm-grid-2 { display: grid; gap: 1rem; grid-template-columns: 1fr; }
    @media (min-width: 600px) { .dm-grid-2 { grid-template-columns: 1fr 1fr; } }
