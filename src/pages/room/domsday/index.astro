    :global(.dm-pill-strength) { color: #b45309; border-color: #fde6b3; background: #fffaeb; }
    :global(.dm-pill-cardio) { color: #c2410c; border-color: #fed7aa; background: #fff5ec; }
    :global(.dm-pill-mobility) { color: #0369a1; border-color: #bae6fd; background: #f0f9ff; }
    :global(.dm-pill-rest), :global(.dm-pill-recovery) { color: var(--dm-text-3); }
    :global(.dm-pill-skill) { color: #7e22ce; border-color: #e9d5ff; background: #faf5ff; }

