  </style>

  <script>
    type Intake = {
      goalTags: string[]; goalNarrative: string;
      experience: 'beginner' | 'intermediate' | 'advanced';
      daysPerWeek: number; minutesPerSession: number;
      restrictions: string; healthFlags: string[];
      age: number | null; weightKg: number | null;
      heightCm: number | null; restingHr: number | null;
      sleepHours: number | null; currentActivity: string;
    };
    type Session = { day: string; type: string; title: string; duration: number; intensity: string; details: string };
    type Week = { weekNum: number; focus: string; sessions: Session[] };
    type Tip = { tip: string; rationale: string };
    type Citation = { title: string; url: string; domain: string };
    type Plan = { title: string; summary: string; weeks: Week[]; diet_tips: Tip[]; lifestyle_tips: Tip[]; citations: Citation[] };
    type CoachMsg = { ts: number; kind: string; body: string };
    type SessionLog = { weekNum: number; day: string; ts: number; status: 'done' | 'skipped' | 'modified'; rpe: number | null; energy: number | null; soreness: number | null; notes: string };
    type State = { userId: string; createdAt: number; updatedAt: number; intake: Intake; plan: Plan | null; coachLog: CoachMsg[]; history: any[]; sessionLogs: SessionLog[] };

    type View = 'loading' | 'intake' | 'generating' | 'dashboard' | 'error';

    const DAY_ORDER = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];

    const initDomsday = () => {
      const root = document.querySelector<HTMLElement>('.dm-root');
      if (!root) return;
      const ac = new AbortController();
      const sig = ac.signal;

      const app: {
        view: View;
        userId: string;
        state: State | null;
        intakeStep: 1 | 2 | 3;
        intake: Partial<Intake>;
        selectedWeek: number;
        selectedDay: string | null;
        logDraft: { status: SessionLog['status']; rpe: number | null; energy: number | null; soreness: number | null; notes: string };
      } = {
        view: 'loading', userId: '', state: null,
        intakeStep: 1,
        intake: {
          goalTags: [], goalNarrative: '', experience: 'beginner',
          daysPerWeek: 3, minutesPerSession: 45,
          restrictions: '', healthFlags: [],
          age: null, weightKg: null, heightCm: null, restingHr: null, sleepHours: null,
          currentActivity: '',
        },
        selectedWeek: 0,
        selectedDay: null,
        logDraft: { status: 'done', rpe: 7, energy: 3, soreness: 2, notes: '' },
      };

      const $ = <T extends Element = HTMLElement>(sel: string): T | null => root.querySelector<T>(sel);
      const $$ = <T extends Element = HTMLElement>(sel: string): T[] => Array.from(root.querySelectorAll<T>(sel));

      const setView = (v: View) => {
        app.view = v;
        root.dataset.view = v;
        $$('[data-view-target]').forEach((el) => {
          el.toggleAttribute('hidden', el.getAttribute('data-view-target') !== v);
        });
        if (v === 'intake') renderIntake();
        if (v === 'dashboard') renderDashboard();
      };

      const showError = (msg: string) => {
        const el = $('[data-bind="error-message"]');
        if (el) el.textContent = msg;
        setView('error');
      };

      // ---- userId ----
      const getOrCreateUserId = (): string => {
        const url = new URL(window.location.href);
        let id = url.searchParams.get('id') || '';
        if (!/^[a-z0-9-]{8,40}$/i.test(id)) {
          try { id = localStorage.getItem('domsday:userId') || ''; } catch {}
        }
        if (!/^[a-z0-9-]{8,40}$/i.test(id)) {
          id = (window.crypto?.randomUUID?.() || `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`).slice(0, 36);
        }
        try { localStorage.setItem('domsday:userId', id); } catch {}
        if (url.searchParams.get('id') !== id) {
          url.searchParams.set('id', id);
          window.history.replaceState(null, '', url.toString());
        }
        return id;
      };

      const renderUserIdShort = () => {
        const el = $('[data-bind="user-id-short"]');
        if (el) el.textContent = app.userId.slice(0, 6);
      };

      const bindBookmark = () => {
        const btn = $('[data-action="bookmark"]') as HTMLButtonElement | null;
        if (!btn) return;
        btn.addEventListener('click', async () => {
          const url = window.location.href;
          try {
            await navigator.clipboard.writeText(url);
            const lab = btn.querySelector('.dm-bookmark-label');
            if (lab) lab.textContent = 'copied';
            btn.classList.add('dm-copied');
            setTimeout(() => {
              btn.classList.remove('dm-copied');
              if (lab) lab.textContent = 'bookmark';
            }, 1600);
          } catch {
            window.prompt('Copy this URL — your plan lives at it:', url);
          }
        }, { signal: sig });
      };

      // ---- intake ----
      const renderIntake = () => {
        const cur = $('[data-bind="step-current"]');
        if (cur) cur.textContent = String(app.intakeStep);
        const bar = $('[data-bind="progress-bar"]') as HTMLElement | null;
        if (bar) bar.style.width = `${(app.intakeStep / 3) * 100}%`;
        $$('.dm-step').forEach((el) => {
          el.toggleAttribute('hidden', el.getAttribute('data-step') !== String(app.intakeStep));
        });
        ($('[data-action="back"]') as HTMLElement | null)?.toggleAttribute('hidden', app.intakeStep === 1);
        ($('[data-action="next"]') as HTMLElement | null)?.toggleAttribute('hidden', app.intakeStep === 3);
        ($('[data-action="submit"]') as HTMLElement | null)?.toggleAttribute('hidden', app.intakeStep !== 3);
      };

      const bindIntakeOnce = () => {
        $$('[data-bind="goal-tags"] .dm-chip').forEach((chip) => {
          chip.addEventListener('click', () => {
            const tag = chip.getAttribute('data-tag') || '';
            const tags = app.intake.goalTags || [];
            const has = tags.includes(tag);
            app.intake.goalTags = has ? tags.filter((t) => t !== tag) : [...tags, tag];
            chip.setAttribute('aria-pressed', has ? 'false' : 'true');
          }, { signal: sig });
        });

        $$('[data-bind="experience"] .dm-chip').forEach((chip) => {
          chip.addEventListener('click', () => {
            const tag = chip.getAttribute('data-tag') || 'beginner';
            app.intake.experience = tag as Intake['experience'];
            $$('[data-bind="experience"] .dm-chip').forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
          }, { signal: sig });
        });
        const initExp = $('[data-bind="experience"] .dm-chip[data-tag="beginner"]');
        if (initExp) initExp.setAttribute('aria-pressed', 'true');

        const textFields: Array<keyof Intake> = ['goalNarrative', 'restrictions', 'currentActivity'];
        textFields.forEach((name) => {
          const el = $(`[data-bind="${name}"]`) as HTMLTextAreaElement | null;
          if (!el) return;
          el.addEventListener('input', () => { (app.intake as any)[name] = el.value; }, { signal: sig });
        });

        const sliderFields: Array<{ name: keyof Intake; out: string }> = [
          { name: 'daysPerWeek', out: 'daysPerWeek' },
          { name: 'minutesPerSession', out: 'minutesPerSession' },
        ];
        sliderFields.forEach(({ name, out }) => {
          const el = $(`[data-bind="${name}"]`) as HTMLInputElement | null;
          const o = $(`[data-bind-out="${out}"]`);
          if (!el) return;
          const update = () => {
            const v = Number(el.value);
            (app.intake as any)[name] = v;
            if (o) o.textContent = String(v);
          };
          el.addEventListener('input', update, { signal: sig });
          update();
        });

        const numFields: Array<keyof Intake> = ['age', 'weightKg', 'heightCm', 'restingHr', 'sleepHours'];
        numFields.forEach((name) => {
          const el = $(`[data-bind="${name}"]`) as HTMLInputElement | null;
          if (!el) return;
          el.addEventListener('input', () => {
            const v = el.value.trim() === '' ? null : Number(el.value);
            (app.intake as any)[name] = (v === null || !Number.isFinite(v)) ? null : v;
          }, { signal: sig });
        });

        $$('[data-bind="healthFlags"] input[type="checkbox"]').forEach((cb) => {
          cb.addEventListener('change', () => {
            const flags = $$('[data-bind="healthFlags"] input[type="checkbox"]:checked')
              .map((x) => x.getAttribute('data-flag') || '').filter(Boolean);
            app.intake.healthFlags = flags;
            const helper = $('[data-bind="flag-helper"]');
            if (helper) helper.toggleAttribute('hidden', flags.length === 0);
          }, { signal: sig });
        });

        $('[data-action="next"]')?.addEventListener('click', () => {
          if (app.intakeStep === 1) {
            if (!(app.intake.goalTags && app.intake.goalTags.length) && !app.intake.goalNarrative) {
              alert('Pick at least one goal tag, or write a sentence about what you\'re after.');
              return;
            }
          }
          app.intakeStep = (app.intakeStep + 1) as 1 | 2 | 3;
          if (app.intakeStep > 3) app.intakeStep = 3;
          renderIntake();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, { signal: sig });

        $('[data-action="back"]')?.addEventListener('click', () => {
          app.intakeStep = (app.intakeStep - 1) as 1 | 2 | 3;
          if (app.intakeStep < 1) app.intakeStep = 1;
          renderIntake();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, { signal: sig });

        $('[data-action="submit"]')?.addEventListener('click', () => {
          submitIntake();
        }, { signal: sig });
      };

      // ---- generate ----
      let genTimer: any = null;
      const rotateGeneratingStatus = () => {
        const lines = [
          'Cross-referencing the literature…',
          'Mapping intensity to your time…',
          'Sanity-checking volume against recovery…',
          'Pulling sources from peer review…',
          'Composing Coach\'s opening…',
        ];
        let i = 0;
        const el = $('[data-bind="generating-status"]');
        if (genTimer) clearInterval(genTimer);
        genTimer = setInterval(() => {
          i = (i + 1) % lines.length;
          if (el) el.textContent = lines[i];
        }, 3500);
        sig.addEventListener('abort', () => { if (genTimer) clearInterval(genTimer); }, { once: true });
      };

      const submitIntake = async () => {
        setView('generating');
        rotateGeneratingStatus();
        try {
          const r = await fetch('/api/domsday?action=plan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: app.userId, intake: app.intake }),
          });
          if (!r.ok) {
            const err = await r.json().catch(() => ({}));
            showError((err as any).error || `Request failed (${r.status})`);
            return;
          }
          const data = await r.json();
          if (!data?.state?.plan) { showError('Coach returned an empty plan. Try again.'); return; }
          app.state = data.state as State;
          app.selectedWeek = 0;
          app.selectedDay = null;
          setView('dashboard');
        } catch {
          showError('Network failure. Try again.');
        }
      };

      // ---- dashboard render ----
      const findLog = (weekNum: number, day: string): SessionLog | undefined =>
        (app.state?.sessionLogs || []).find(l => l.weekNum === weekNum && l.day === day);

      const trainingTotalForWeek = (w: Week) => w.sessions.filter(s => s.type !== 'rest').length;

      const doneCountForWeek = (w: Week) =>
        (app.state?.sessionLogs || []).filter(l =>
          l.weekNum === w.weekNum && l.status === 'done' &&
          w.sessions.some(s => s.day === l.day && s.type !== 'rest')
        ).length;

      const renderDashboard = () => {
        if (!app.state || !app.state.plan) { setView('intake'); return; }
        const plan = app.state.plan;
        const logs = app.state.sessionLogs || [];

        // hero
        const titleEl = $('[data-bind="plan-title"]');
        if (titleEl) titleEl.textContent = plan.title || 'Your protocol';
        const sumEl = $('[data-bind="plan-summary"]');
        if (sumEl) sumEl.textContent = plan.summary || '';

        const totalSessions = plan.weeks.reduce((n, w) => n + trainingTotalForWeek(w), 0);
        const done = logs.filter(l => l.status === 'done').length;
        const skipped = logs.filter(l => l.status === 'skipped').length;
        const modified = logs.filter(l => l.status === 'modified').length;
        const pct = totalSessions > 0 ? Math.round(((done + modified) / totalSessions) * 100) : 0;

        const lab = $('[data-bind="progress-label"]');
        if (lab) lab.textContent = `${done + modified} of ${totalSessions} sessions complete`;
        const pctEl = $('[data-bind="progress-pct"]');
        if (pctEl) pctEl.textContent = `${pct}%`;
        const fillEl = $('[data-bind="progress-fill"]') as HTMLElement | null;
        if (fillEl) fillEl.style.width = `${pct}%`;

        const metaEl = $('[data-bind="progress-meta"]');
        if (metaEl) {
          const items: Array<[string, number | string, string]> = [
            ['weeks', plan.weeks.length, ''],
            ['done', done, ''],
            ...(modified ? [['modified', modified, ''] as [string, number, string]] : []),
            ...(skipped ? [['skipped', skipped, ''] as [string, number, string]] : []),
            ['sources', plan.citations.length, ''],
          ];
          metaEl.innerHTML = '';
          items.forEach(([label, val]) => {
            const span = document.createElement('span');
            span.className = 'dm-progress-meta-item';
            span.innerHTML = `<span class="dm-progress-meta-num">${escape(String(val))}</span><span>${escape(label)}</span>`;
            metaEl.appendChild(span);
          });
        }

        // week label
        const wk = plan.weeks[app.selectedWeek] || plan.weeks[0];
        const wkLabel = $('[data-bind="week-label"]');
        if (wkLabel) wkLabel.textContent = `Week ${wk.weekNum} of ${plan.weeks.length}`;
        const wkFocus = $('[data-bind="week-focus"]');
        if (wkFocus) wkFocus.textContent = wk.focus || '';

        // week pages (dot indicator)
        const pagesEl = $('[data-bind="week-pages"]');
        if (pagesEl) {
          pagesEl.innerHTML = '';
          plan.weeks.forEach((w, i) => {
            const total = trainingTotalForWeek(w);
            const doneN = doneCountForWeek(w);
            const cls = doneN === 0 ? '' : doneN >= total ? ' dm-progress-full' : ' dm-progress-some';
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'dm-week-page' + (i === app.selectedWeek ? ' dm-active' : '') + cls;
            dot.title = `Week ${w.weekNum}${total ? ` · ${doneN}/${total} done` : ''}`;
            dot.addEventListener('click', () => {
              app.selectedWeek = i;
              app.selectedDay = null;
              renderDashboard();
            }, { signal: sig });
            pagesEl.appendChild(dot);
          });
        }
        const prevBtn = $('[data-action="prev-week"]') as HTMLButtonElement | null;
        const nextBtn = $('[data-action="next-week"]') as HTMLButtonElement | null;
        if (prevBtn) prevBtn.disabled = app.selectedWeek === 0;
        if (nextBtn) nextBtn.disabled = app.selectedWeek >= plan.weeks.length - 1;

        // calendar
        const calEl = $('[data-bind="calendar"]');
        if (calEl) {
          calEl.innerHTML = '';
          DAY_ORDER.forEach((day) => {
            const s = wk.sessions.find(x => x.day === day);
            const log = findLog(wk.weekNum, day);
            const isRest = !s || s.type === 'rest';
            const status = log?.status || 'pending';
            const cell = document.createElement('button');
            cell.type = 'button';
            cell.className = 'dm-cell'
              + (isRest ? ' dm-cell-rest' : ` dm-cell-${escape(s!.type)}`)
              + (status !== 'pending' ? ` dm-state-${status}` : '')
              + (app.selectedDay === day ? ' dm-cell-active' : '');
            cell.dataset.day = day;
            const statusIcon = status === 'done' ? '✓'
              : status === 'modified' ? '~'
              : status === 'skipped' ? '×' : '';
            cell.innerHTML = isRest ? `
              <span class="dm-cell-day">${escape(day)}</span>
              <span class="dm-cell-title">Rest</span>
              <span class="dm-cell-foot">
                <span class="dm-cell-type">recovery</span>
              </span>
            ` : `
              <span class="dm-cell-day">${escape(day)}</span>
              <span class="dm-cell-title">${escape(s!.title)}</span>
              <span class="dm-cell-foot">
                <span class="dm-cell-type">${escape(s!.type)}</span>
                <span class="dm-cell-dur-wrap">
                  ${s!.duration ? `<span class="dm-cell-dur">${s!.duration}m</span>` : ''}
                  ${statusIcon ? `<span class="dm-cell-status dm-status-${status}">${statusIcon}</span>` : ''}
                </span>
              </span>
            `;
            if (!isRest) {
              cell.addEventListener('click', () => {
                app.selectedDay = (app.selectedDay === day) ? null : day;
                if (app.selectedDay === day) {
                  const existing = findLog(wk.weekNum, day);
                  app.logDraft = existing
                    ? { status: existing.status, rpe: existing.rpe, energy: existing.energy, soreness: existing.soreness, notes: existing.notes }
                    : { status: 'done', rpe: 7, energy: 3, soreness: 2, notes: '' };
                }
                renderDashboard();
              }, { signal: sig });
            }
            calEl.appendChild(cell);
          });
        }

        // session detail
        const detailEl = $('[data-bind="session-detail"]') as HTMLElement | null;
        if (detailEl) {
          if (!app.selectedDay) {
            detailEl.hidden = true;
            detailEl.innerHTML = '';
          } else {
            const s = wk.sessions.find(x => x.day === app.selectedDay);
            if (!s) { detailEl.hidden = true; }
            else {
              detailEl.hidden = false;
              detailEl.innerHTML = renderDetail(wk.weekNum, s);
              bindDetail(detailEl, wk.weekNum, s.day);
            }
          }
        }

        // coach log
        const logEl = $('[data-bind="coach-log"]');
        if (logEl) {
          logEl.innerHTML = '';
          const messages = [...(app.state.coachLog || [])].reverse(); // chronological for chat-style
          if (!messages.length) {
            const div = document.createElement('div');
            div.className = 'dm-msg dm-msg-coach';
            div.textContent = 'Coach has nothing to add yet.';
            logEl.appendChild(div);
          } else {
            messages.forEach((m) => {
              const div = document.createElement('div');
              const cls = m.kind === 'user' ? 'dm-msg-user'
                : m.kind === 'regen' ? 'dm-msg-regen'
                : 'dm-msg-coach';
              div.className = `dm-msg ${cls}`;
              div.innerHTML = `<span class="dm-msg-meta">${m.kind === 'user' ? 'you' : 'coach'} · ${formatTime(m.ts)}</span>${escape(m.body)}`;
              logEl.appendChild(div);
            });
            // scroll to bottom (newest)
            logEl.scrollTop = logEl.scrollHeight;
          }
        }

        // tips
        const dietEl = $$('[data-bind="diet-tips"]')[0];
        const lifeEl = $$('[data-bind="lifestyle-tips"]')[0];
        if (dietEl) renderTips(dietEl, plan.diet_tips || []);
        if (lifeEl) renderTips(lifeEl, plan.lifestyle_tips || []);

        // citations
        const citEl = $('[data-bind="citations"]');
        const citCount = $('[data-bind="cite-count"]');
        const cites = plan.citations || [];
        if (citCount) citCount.textContent = `${cites.length} ${cites.length === 1 ? 'source' : 'sources'}`;
        if (citEl) {
          citEl.innerHTML = '';
          if (!cites.length) {
            citEl.innerHTML = '<li class="dm-cite-empty">No sources captured yet (stub mode or grounding empty).</li>';
          } else {
            cites.forEach((c) => {
              const a = document.createElement('a');
              a.className = 'dm-cite';
              a.href = c.url;
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              a.innerHTML = `<span class="dm-cite-title">${escape(c.title)}</span><span class="dm-cite-domain">${escape(c.domain || c.url)}</span>`;
              (citEl as HTMLElement).appendChild(a);
            });
          }
        }
      };

      const renderDetail = (weekNum: number, s: Session): string => {
        const showSliders = app.logDraft.status !== 'skipped';
        return `
          <div class="dm-detail-head">
            <div class="dm-detail-head-left">
              <span class="dm-cell-day">${escape(s.day)}</span>
              <h3 class="dm-detail-title">${escape(s.title)}</h3>
              <div class="dm-detail-meta">
                <span class="dm-detail-tag dm-detail-tag-${escape(s.type)}">${escape(s.type)}</span>
                ${s.duration ? `<span>${s.duration} min</span>` : ''}
                <span>· intensity: ${escape(s.intensity)}</span>
              </div>
            </div>
            <button type="button" class="dm-detail-close" data-action="close-detail" aria-label="Close">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 4 8 8M12 4l-8 8"/></svg>
            </button>
          </div>
          <p class="dm-detail-text">${escape(s.details)}</p>

          <div class="dm-status-row">
            <button type="button" class="dm-status-btn" data-status="done" aria-pressed="${app.logDraft.status === 'done'}">Done</button>
            <button type="button" class="dm-status-btn" data-status="modified" aria-pressed="${app.logDraft.status === 'modified'}">Modified</button>
            <button type="button" class="dm-status-btn" data-status="skipped" aria-pressed="${app.logDraft.status === 'skipped'}">Skipped</button>
          </div>
          ${showSliders ? `
            <div class="dm-slider-trio">
              <div class="dm-mini-slider">
                <div class="dm-mini-slider-head"><span>RPE</span><span class="dm-mini-slider-val" data-mini-val="rpe">${app.logDraft.rpe ?? 7}</span></div>
                <input type="range" class="dm-slider" min="1" max="10" step="1" value="${app.logDraft.rpe ?? 7}" data-mini="rpe" />
              </div>
              <div class="dm-mini-slider">
                <div class="dm-mini-slider-head"><span>Energy</span><span class="dm-mini-slider-val" data-mini-val="energy">${app.logDraft.energy ?? 3}/5</span></div>
                <input type="range" class="dm-slider" min="1" max="5" step="1" value="${app.logDraft.energy ?? 3}" data-mini="energy" />
              </div>
              <div class="dm-mini-slider">
                <div class="dm-mini-slider-head"><span>Soreness</span><span class="dm-mini-slider-val" data-mini-val="soreness">${app.logDraft.soreness ?? 2}/5</span></div>
                <input type="range" class="dm-slider" min="1" max="5" step="1" value="${app.logDraft.soreness ?? 2}" data-mini="soreness" />
              </div>
            </div>
          ` : ''}
          <textarea class="dm-log-notes" rows="2" placeholder="${app.logDraft.status === 'skipped' ? 'why? (optional)' : 'Notes — anything Coach should know'}" data-bind="log-notes" maxlength="400">${escape(app.logDraft.notes)}</textarea>
          <div class="dm-log-actions">
            <button type="button" class="dm-btn dm-btn-ghost dm-btn-sm" data-action="cancel-log">Cancel</button>
            <button type="button" class="dm-btn dm-btn-primary dm-btn-sm" data-action="save-log">Save log</button>
          </div>
        `;
      };

      const bindDetail = (wrap: HTMLElement, weekNum: number, day: string) => {
        wrap.querySelectorAll('[data-status]').forEach((b) => {
          b.addEventListener('click', () => {
            app.logDraft.status = (b as HTMLElement).getAttribute('data-status') as SessionLog['status'];
            renderDashboard();
          }, { signal: sig });
        });

        wrap.querySelectorAll('[data-mini]').forEach((s) => {
          const slider = s as HTMLInputElement;
          const key = slider.getAttribute('data-mini') as 'rpe' | 'energy' | 'soreness';
          if (app.logDraft[key] === null) (app.logDraft as any)[key] = Number(slider.value);
          slider.addEventListener('input', () => {
            (app.logDraft as any)[key] = Number(slider.value);
            const out = wrap.querySelector(`[data-mini-val="${key}"]`);
            if (out) out.textContent = key === 'rpe' ? String(slider.value) : `${slider.value}/5`;
          }, { signal: sig });
        });

        const notes = wrap.querySelector('[data-bind="log-notes"]') as HTMLTextAreaElement | null;
        if (notes) {
          notes.addEventListener('input', () => { app.logDraft.notes = notes.value; }, { signal: sig });
        }

        wrap.querySelector('[data-action="cancel-log"]')?.addEventListener('click', () => {
          app.selectedDay = null;
          renderDashboard();
        }, { signal: sig });

        wrap.querySelector('[data-action="close-detail"]')?.addEventListener('click', () => {
          app.selectedDay = null;
          renderDashboard();
        }, { signal: sig });

        wrap.querySelector('[data-action="save-log"]')?.addEventListener('click', () => {
          saveLog(weekNum, day);
        }, { signal: sig });
      };

      const saveLog = async (weekNum: number, day: string) => {
        const payload = {
          userId: app.userId,
          log: {
            weekNum, day,
            status: app.logDraft.status,
            rpe: app.logDraft.status === 'skipped' ? null : app.logDraft.rpe,
            energy: app.logDraft.status === 'skipped' ? null : app.logDraft.energy,
            soreness: app.logDraft.status === 'skipped' ? null : app.logDraft.soreness,
            notes: app.logDraft.notes,
          },
        };
        try {
          const r = await fetch('/api/domsday?action=log', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!r.ok) { alert('log failed'); return; }
          const data = await r.json();
          if (data?.state) app.state = data.state as State;
          app.selectedDay = null;
          renderDashboard();
        } catch { alert('log failed (network)'); }
      };

      // ---- chat ----
      const bindChatOnce = () => {
        const form = $('[data-bind="chat-form"]') as HTMLFormElement | null;
        const ta = $('[data-bind="chat-input"]') as HTMLTextAreaElement | null;
        if (!form || !ta) return;

        // submit on Enter, newline on Shift+Enter
        ta.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            form.requestSubmit();
          }
        }, { signal: sig });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const message = ta.value.trim();
          if (!message) return;

          if (app.state) {
            app.state.coachLog = [
              { ts: Date.now(), kind: 'user', body: message },
              ...(app.state.coachLog || []),
            ];
            renderDashboard();
          }

          form.dataset.thinking = 'true';
          ta.value = '';
          ta.disabled = true;

          try {
            const r = await fetch('/api/domsday?action=refine', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ userId: app.userId, message }),
            });
            if (!r.ok) {
              const err = await r.json().catch(() => ({}));
              alert(`coach failed: ${(err as any).error || r.status}`);
              return;
            }
            const data = await r.json();
            if (data?.state) {
              app.state = data.state as State;
              renderDashboard();
            }
          } catch {
            alert('coach failed (network)');
          } finally {
            form.dataset.thinking = 'false';
            ta.disabled = false;
            ta.focus();
          }
        }, { signal: sig });
      };

      // ---- tips ----
      const renderTips = (el: HTMLElement, tips: Tip[]) => {
        el.innerHTML = '';
        if (!tips.length) {
          el.innerHTML = '<li class="dm-tip"><p class="dm-tip-line">—</p></li>';
          return;
        }
        tips.forEach((t) => {
          const li = document.createElement('li');
          li.className = 'dm-tip';
          li.innerHTML = `<p class="dm-tip-line">${escape(t.tip)}</p><p class="dm-tip-why">${escape(t.rationale)}</p>`;
          el.appendChild(li);
        });
      };

      const escape = (s: string): string => String(s ?? '')
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      const formatTime = (ts: number): string => {
        try {
          const d = new Date(ts);
          return d.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
        } catch { return ''; }
      };

      // ---- dashboard actions ----
      const bindDashboardActionsOnce = () => {
        $('[data-action="regen"]')?.addEventListener('click', () => {
          if (!confirm('Regenerate from your existing intake? Your current plan moves to history. Logs reset.')) return;
          submitIntake();
        }, { signal: sig });
        $('[data-action="reset"]')?.addEventListener('click', () => {
          if (!confirm('Wipe local id and start over? Your old plan stays in storage but you\'ll need the bookmark URL to find it again.')) return;
          try { localStorage.removeItem('domsday:userId'); } catch {}
          const url = new URL(window.location.href);
          url.searchParams.delete('id');
          window.location.href = url.toString();
        }, { signal: sig });

        $('[data-action="prev-week"]')?.addEventListener('click', () => {
          if (app.selectedWeek > 0) {
            app.selectedWeek--;
            app.selectedDay = null;
            renderDashboard();
          }
        }, { signal: sig });

        $('[data-action="next-week"]')?.addEventListener('click', () => {
          if (app.state?.plan && app.selectedWeek < app.state.plan.weeks.length - 1) {
            app.selectedWeek++;
            app.selectedDay = null;
            renderDashboard();
          }
        }, { signal: sig });
      };

      // ---- boot ----
      const boot = async () => {
        app.userId = getOrCreateUserId();
        renderUserIdShort();
        bindBookmark();
        bindIntakeOnce();
        bindDashboardActionsOnce();
        bindChatOnce();

        try {
          const r = await fetch('/api/domsday?action=load', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: app.userId }),
          });
          if (r.ok) {
            const data = await r.json();
            if (data?.state?.plan) {
              app.state = data.state as State;
              setView('dashboard');
              return;
            }
          }
        } catch { /* fallthrough */ }

        setView('intake');
      };

      document.addEventListener('astro:before-preparation', () => ac.abort(), { once: true });

      boot();
    };

    document.addEventListener('astro:page-load', initDomsday);
  </script>
</Layout>
