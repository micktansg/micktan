    :global(.dm-slider-trio) {
      display: grid; grid-template-columns: 1fr; gap: 0.6rem; margin-bottom: 0.7rem;
    }
    @media (min-width: 600px) { :global(.dm-slider-trio) { grid-template-columns: 1fr 1fr 1fr; } }
    :global(.dm-mini-slider) {
      display: flex; flex-direction: column; gap: 0.25rem;
    }
    :global(.dm-mini-slider-head) {
      display: flex; justify-content: space-between; align-items: baseline;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
