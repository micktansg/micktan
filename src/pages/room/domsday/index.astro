    :global(.dm-mini-slider-val) { color: var(--dm-orange-strong); font-weight: 600; }

    :global(.dm-log-notes) {
      width: 100%; box-sizing: border-box;
      background: var(--dm-surface); border: 1px solid var(--dm-border);
