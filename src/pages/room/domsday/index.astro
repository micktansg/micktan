---
// /room/domsday/ — DOMSDAY MACHINE
// Personal training coach with Dr DOMs as the voice.
// Phase 1: intake → cited plan → coach voice + bookmark-as-auth.
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="DOMSDAY MACHINE — Mick Tan" description="evidence-based training coach. Dr DOMs presiding.">
  <main class="dm-root" data-view="loading">

    <!-- Top nav -->
    <header class="dm-nav">
      <a class="dm-back" href="/room/" data-astro-prefetch>&larr; the room</a>
      <div class="dm-brand">
        <span class="dm-brand-dot"></span>
        <span class="dm-brand-name">DOMSDAY MACHINE</span>
        <span class="dm-brand-sub">v0.1 — experimental</span>
      </div>
      <button class="dm-bookmark" type="button" data-action="bookmark">
        <span class="dm-bookmark-label">bookmark this</span>
        <span class="dm-bookmark-id" data-bind="user-id-short"></span>
      </button>
    </header>

    <!-- Persistent disclaimer -->
    <aside class="dm-disclaim" role="note">
      <span class="dm-disclaim-tag">disclaimer</span>
      <span>not medical advice. experimental. your data lives at this URL — bookmark it. flagged conditions get conservative defaults; clear with a clinician before training.</span>
    </aside>

    <!-- LOADING -->
    <section class="dm-view dm-view-loading" data-view-target="loading">
      <div class="dm-loader">
        <div class="dm-loader-ring"></div>
        <p>booting protocol…</p>
      </div>
    </section>

    <!-- INTAKE -->
    <section class="dm-view dm-view-intake" data-view-target="intake" hidden>
      <div class="dm-intake-shell">
        <div class="dm-intake-head">
          <p class="dm-eyebrow">intake — step <span data-bind="step-current">1</span> / 3</p>
          <h1 class="dm-h1">Dr DOMs needs a read on you.</h1>
          <p class="dm-lede">Three short steps. Your answers stay on this URL. Skip what you don't have.</p>
        </div>
        <div class="dm-progress" aria-hidden="true">
          <div class="dm-progress-bar" data-bind="progress-bar"></div>
        </div>
        <form class="dm-intake" data-bind="intake-form" novalidate>
          <!-- STEP 1 -->
          <fieldset class="dm-step" data-step="1">
            <legend class="dm-step-title">what are you actually after?</legend>

            <div class="dm-field">
              <label class="dm-label">pick what fits — multi-select</label>
              <div class="dm-chips" data-bind="goal-tags">
                <button type="button" class="dm-chip" data-tag="strength">strength</button>
                <button type="button" class="dm-chip" data-tag="hypertrophy">muscle / hypertrophy</button>
                <button type="button" class="dm-chip" data-tag="endurance">endurance</button>
                <button type="button" class="dm-chip" data-tag="fat-loss">fat loss</button>
                <button type="button" class="dm-chip" data-tag="mobility">mobility</button>
                <button type="button" class="dm-chip" data-tag="longevity">longevity / general health</button>
                <button type="button" class="dm-chip" data-tag="sport">sport-specific</button>
              </div>
            </div>

            <div class="dm-field">
              <label class="dm-label" for="dm-narrative">in your own words — what's the goal?</label>
              <textarea id="dm-narrative" class="dm-input dm-textarea" rows="3"
                placeholder="e.g. drop 5kg by July, run a half-marathon under 2hr, deadlift 1.5x bodyweight…"
                data-bind="goalNarrative" maxlength="600"></textarea>
            </div>

            <div class="dm-field">
              <label class="dm-label">experience</label>
              <div class="dm-chips" data-bind="experience" data-single>
                <button type="button" class="dm-chip" data-tag="beginner">beginner</button>
                <button type="button" class="dm-chip" data-tag="intermediate">intermediate</button>
                <button type="button" class="dm-chip" data-tag="advanced">advanced</button>
              </div>
            </div>
          </fieldset>

          <!-- STEP 2 -->
          <fieldset class="dm-step" data-step="2" hidden>
            <legend class="dm-step-title">time, body, conditions.</legend>

            <div class="dm-grid-2">
              <div class="dm-field">
                <label class="dm-label" for="dm-days">days / week</label>
                <div class="dm-slider-row">
                  <input id="dm-days" type="range" class="dm-slider" min="1" max="7" step="1" value="3" data-bind="daysPerWeek" />
                  <output class="dm-slider-out" data-bind-out="daysPerWeek">3</output>
                </div>
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-minutes">minutes / session</label>
                <div class="dm-slider-row">
                  <input id="dm-minutes" type="range" class="dm-slider" min="15" max="120" step="5" value="45" data-bind="minutesPerSession" />
                  <output class="dm-slider-out" data-bind-out="minutesPerSession">45</output>
                </div>
              </div>
            </div>

            <div class="dm-field">
              <label class="dm-label" for="dm-restrict">restrictions / injuries</label>
              <textarea id="dm-restrict" class="dm-input dm-textarea" rows="2"
                placeholder="e.g. left knee tweaky on deep squats, shoulder mobility limited, lower back sensitive…"
                data-bind="restrictions" maxlength="800"></textarea>
            </div>

            <div class="dm-field">
              <label class="dm-label">health flags — check anything that applies</label>
              <div class="dm-flags" data-bind="healthFlags">
                <label class="dm-flag"><input type="checkbox" data-flag="cardiovascular" /><span>cardiovascular condition</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="pregnancy" /><span>pregnant / postpartum</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="post-surgical" /><span>post-surgical / rehab</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="medication" /><span>on meds affecting exercise</span></label>
                <label class="dm-flag"><input type="checkbox" data-flag="eating-history" /><span>eating disorder history</span></label>
              </div>
              <p class="dm-helper" data-bind="flag-helper" hidden>Dr DOMs will lean conservative on intensity and recommend clinician sign-off.</p>
            </div>

            <div class="dm-field">
              <label class="dm-label" for="dm-current">what does a typical week of activity look like right now?</label>
              <textarea id="dm-current" class="dm-input dm-textarea" rows="2"
                placeholder="e.g. 2x gym (push/pull), 1x easy run, daily walk to work…"
                data-bind="currentActivity" maxlength="600"></textarea>
            </div>
          </fieldset>

          <!-- STEP 3 -->
          <fieldset class="dm-step" data-step="3" hidden>
            <legend class="dm-step-title">metrics — all optional, skip what you don't know.</legend>

            <div class="dm-grid-2">
              <div class="dm-field">
                <label class="dm-label" for="dm-age">age</label>
                <input id="dm-age" type="number" class="dm-input" min="12" max="110" placeholder="e.g. 32" data-bind="age" />
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-weight">weight (kg)</label>
                <input id="dm-weight" type="number" class="dm-input" min="25" max="350" step="0.1" placeholder="e.g. 72.5" data-bind="weightKg" />
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-height">height (cm)</label>
                <input id="dm-height" type="number" class="dm-input" min="100" max="250" placeholder="e.g. 178" data-bind="heightCm" />
              </div>
              <div class="dm-field">
                <label class="dm-label" for="dm-rhr">resting HR (bpm)</label>
                <input id="dm-rhr" type="number" class="dm-input" min="30" max="200" placeholder="if you know it" data-bind="restingHr" />
              </div>
              <div class="dm-field dm-grid-2-span">
                <label class="dm-label" for="dm-sleep">avg sleep (hours)</label>
                <input id="dm-sleep" type="number" class="dm-input" min="0" max="16" step="0.5" placeholder="e.g. 7.5" data-bind="sleepHours" />
              </div>
            </div>

            <div class="dm-final-disclaim">
              <strong>before you submit:</strong> Dr DOMs is a coaching persona generated by an LLM. recommendations are grounded in web search results — not a doctor. don't follow anything that conflicts with medical advice.
            </div>
          </fieldset>

          <div class="dm-actions">
            <button type="button" class="dm-btn dm-btn-ghost" data-action="back" hidden>back</button>
            <button type="button" class="dm-btn dm-btn-primary" data-action="next">next →</button>
            <button type="button" class="dm-btn dm-btn-primary dm-btn-submit" data-action="submit" hidden>generate protocol →</button>
          </div>
        </form>
      </div>
    </section>

    <!-- GENERATING -->
    <section class="dm-view dm-view-generating" data-view-target="generating" hidden>
      <div class="dm-generating">
        <div class="dm-avatar dm-avatar-lg" aria-hidden="true">
          <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="dmHoodLg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#0d2018"/>
                <stop offset="1" stop-color="#04100b"/>
              </linearGradient>
              <linearGradient id="dmPlateLg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#3a4250"/>
                <stop offset="1" stop-color="#1a1f29"/>
              </linearGradient>
              <radialGradient id="dmGlowLg">
                <stop offset="0" stop-color="#4ade80" stop-opacity="0.55"/>
                <stop offset="1" stop-color="#4ade80" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <circle cx="32" cy="32" r="32" fill="#0a0f14"/>
            <circle cx="32" cy="32" r="30" fill="url(#dmGlowLg)"/>
            <path d="M32 8 L54 28 L54 64 L10 64 L10 28 Z" fill="url(#dmHoodLg)"/>
            <path d="M22 24 L42 24 L40 50 L24 50 Z" fill="url(#dmPlateLg)"/>
            <path d="M22 24 L42 24 L41 27 L23 27 Z" fill="#252b36"/>
            <rect x="24.5" y="32" width="6" height="2.2" fill="#4ade80"/>
            <rect x="33.5" y="32" width="6" height="2.2" fill="#4ade80"/>
            <rect x="28" y="42" width="8" height="1.2" fill="#1f2530"/>
          </svg>
        </div>
        <p class="dm-eyebrow">Dr DOMs is reading your file</p>
        <h2 class="dm-h2" data-bind="generating-status">cross-referencing the literature…</h2>
        <div class="dm-loader-ring"></div>
        <p class="dm-helper">first-time generation can take 20–40 seconds with grounded search. don't refresh.</p>
      </div>
    </section>

    <!-- DASHBOARD -->
    <section class="dm-view dm-view-dashboard" data-view-target="dashboard" hidden>

      <div class="dm-hero">
        <div class="dm-hero-meta">
          <p class="dm-eyebrow">your protocol</p>
          <h1 class="dm-h1" data-bind="plan-title">—</h1>
          <p class="dm-summary" data-bind="plan-summary">—</p>
        </div>
        <div class="dm-hero-actions">
          <button class="dm-btn dm-btn-ghost dm-btn-sm" type="button" data-action="regen">regenerate</button>
          <button class="dm-btn dm-btn-ghost dm-btn-sm" type="button" data-action="reset">start over</button>
        </div>
      </div>

      <div class="dm-grid">

        <!-- ROADMAP -->
        <section class="dm-panel dm-panel-roadmap">
          <header class="dm-panel-head">
            <h3 class="dm-panel-title">roadmap</h3>
            <div class="dm-week-tabs" data-bind="week-tabs"></div>
          </header>
          <div class="dm-week-focus" data-bind="week-focus"></div>
          <div class="dm-sessions" data-bind="sessions"></div>
        </section>

        <!-- COACH -->
        <aside class="dm-panel dm-panel-coach">
          <header class="dm-panel-head">
            <div class="dm-coach-id">
              <div class="dm-avatar dm-avatar-md" aria-hidden="true">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="dmHoodMd" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#0d2018"/>
                      <stop offset="1" stop-color="#04100b"/>
                    </linearGradient>
                    <linearGradient id="dmPlateMd" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#3a4250"/>
                      <stop offset="1" stop-color="#1a1f29"/>
                    </linearGradient>
                  </defs>
                  <circle cx="32" cy="32" r="32" fill="#0a0f14"/>
                  <path d="M32 8 L54 28 L54 64 L10 64 L10 28 Z" fill="url(#dmHoodMd)"/>
                  <path d="M22 24 L42 24 L40 50 L24 50 Z" fill="url(#dmPlateMd)"/>
                  <path d="M22 24 L42 24 L41 27 L23 27 Z" fill="#252b36"/>
                  <rect x="24.5" y="32" width="6" height="2.2" fill="#4ade80"/>
                  <rect x="33.5" y="32" width="6" height="2.2" fill="#4ade80"/>
                </svg>
              </div>
              <div>
                <div class="dm-coach-name">Dr DOMs</div>
                <div class="dm-coach-sub">presiding</div>
              </div>
            </div>
          </header>
          <div class="dm-coach-log" data-bind="coach-log"></div>
        </aside>

        <!-- TIPS -->
        <section class="dm-panel dm-panel-tips">
          <header class="dm-panel-head"><h3 class="dm-panel-title">diet</h3></header>
          <ul class="dm-tips" data-bind="diet-tips"></ul>
        </section>

        <section class="dm-panel dm-panel-tips">
          <header class="dm-panel-head"><h3 class="dm-panel-title">lifestyle</h3></header>
          <ul class="dm-tips" data-bind="lifestyle-tips"></ul>
        </section>

        <!-- CITATIONS -->
        <section class="dm-panel dm-panel-cites">
          <header class="dm-panel-head">
            <h3 class="dm-panel-title">sources</h3>
            <span class="dm-cite-count" data-bind="cite-count">0</span>
          </header>
          <ul class="dm-cites" data-bind="citations"></ul>
        </section>

      </div>
    </section>

    <!-- ERROR -->
    <section class="dm-view dm-view-error" data-view-target="error" hidden>
      <div class="dm-loader">
        <p class="dm-eyebrow">protocol failure</p>
        <h2 class="dm-h2" data-bind="error-message">something went sideways.</h2>
        <button class="dm-btn dm-btn-primary" type="button" data-action="reset">start over</button>
      </div>
    </section>

  </main>

  <style>
    /* ---- root + reset for this room ---- */
    :global(html), :global(body) { background: #07090b; }

    .dm-root {
      min-height: 100vh;
      background:
        radial-gradient(1200px 600px at 80% -10%, rgba(74,222,128,0.06), transparent 60%),
        radial-gradient(1000px 500px at -10% 20%, rgba(34,211,238,0.04), transparent 60%),
        #07090b;
      color: #e5e9ee;
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      padding: 1.5rem clamp(1rem, 4vw, 2rem) 6rem;
      line-height: 1.5;
    }

    /* faint grid backdrop */
    .dm-root::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(229,233,238,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(229,233,238,0.025) 1px, transparent 1px);
      background-size: 64px 64px;
      pointer-events: none;
      z-index: 0;
    }

    .dm-root > * { position: relative; z-index: 1; }

    /* ---- nav ---- */
    .dm-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.6rem 0.2rem 1rem;
      flex-wrap: wrap;
    }
    .dm-back {
      color: #6b7280;
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 180ms;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .dm-back:hover { color: #e5e9ee; }
    .dm-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .dm-brand-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #4ade80;
      box-shadow: 0 0 10px #4ade80, 0 0 18px rgba(74,222,128,0.5);
      animation: dmpulse 2.4s ease-in-out infinite;
    }
    .dm-brand-name {
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.08em;
    }
    .dm-brand-sub {
      font-size: 0.7rem;
      color: #6b7280;
      letter-spacing: 0.06em;
    }
    @keyframes dmpulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.45; }
    }

    .dm-bookmark {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      border: 1px solid #1f2530;
      color: #9ca3af;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.72rem;
      padding: 0.45rem 0.7rem;
      border-radius: 6px;
      cursor: pointer;
      transition: border-color 180ms, color 180ms;
    }
    .dm-bookmark:hover { border-color: #4ade80; color: #4ade80; }
    .dm-bookmark.dm-copied { border-color: #4ade80; color: #4ade80; }
    .dm-bookmark-id { color: #4ade80; }

    /* ---- disclaimer ---- */
    .dm-disclaim {
      display: flex;
      gap: 0.7rem;
      align-items: flex-start;
      padding: 0.65rem 0.9rem;
      border: 1px solid #251c0a;
      background: rgba(251,191,36,0.04);
      border-radius: 8px;
      font-size: 0.8rem;
      color: #d1d5db;
      margin-bottom: 1.5rem;
    }
    .dm-disclaim-tag {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem;
      color: #fbbf24;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding-top: 0.05rem;
    }

    /* ---- views ---- */
    .dm-view { max-width: 78rem; margin: 0 auto; }
    .dm-view[hidden] { display: none !important; }

    /* ---- typography ---- */
    .dm-eyebrow {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #4ade80;
      margin: 0 0 0.6rem;
    }
    .dm-h1 {
      font-size: clamp(1.6rem, 3.6vw, 2.6rem);
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.1;
      margin: 0;
    }
    .dm-h2 {
      font-size: clamp(1.2rem, 2.6vw, 1.6rem);
      font-weight: 600;
      margin: 0 0 0.4rem;
    }
    .dm-lede {
      margin-top: 0.8rem;
      color: #9ca3af;
      font-size: 1rem;
    }
    .dm-summary {
      margin-top: 0.6rem;
      color: #9ca3af;
      font-size: 0.95rem;
    }
    .dm-helper {
      font-size: 0.78rem;
      color: #6b7280;
      margin: 0.5rem 0 0;
    }

    /* ---- loader ---- */
    .dm-loader {
      display: flex; flex-direction: column; align-items: center; gap: 1rem;
      padding: 6rem 1rem;
      color: #9ca3af;
      text-align: center;
    }
    .dm-loader-ring {
      width: 36px; height: 36px;
      border: 2px solid #1f2530;
      border-top-color: #4ade80;
      border-radius: 50%;
      animation: dmspin 0.9s linear infinite;
    }
    @keyframes dmspin { to { transform: rotate(360deg); } }

    /* ---- intake ---- */
    .dm-intake-shell {
      max-width: 42rem;
      margin: 1rem auto 0;
    }
    .dm-progress {
      height: 2px;
      background: #1a1f29;
      border-radius: 2px;
      overflow: hidden;
      margin: 1.6rem 0 1.8rem;
    }
    .dm-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, #4ade80, #22d3ee);
      width: 33%;
      transition: width 380ms cubic-bezier(.2,.8,.2,1);
    }
    .dm-step {
      border: none;
      padding: 0;
      margin: 0;
    }
    .dm-step[hidden] { display: none; }
    .dm-step-title {
      font-size: 1.15rem;
      font-weight: 600;
      color: #e5e9ee;
      padding: 0;
      margin: 0 0 1.4rem;
    }
    .dm-field { margin-bottom: 1.4rem; }
    .dm-label {
      display: block;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #9ca3af;
      margin-bottom: 0.5rem;
    }

    .dm-input {
      width: 100%;
      box-sizing: border-box;
      background: #0e1115;
      border: 1px solid #1f2530;
      border-radius: 8px;
      color: #e5e9ee;
      font-family: inherit;
      font-size: 0.95rem;
      padding: 0.7rem 0.85rem;
      transition: border-color 160ms, box-shadow 160ms;
    }
    .dm-input:focus {
      outline: none;
      border-color: #4ade80;
      box-shadow: 0 0 0 3px rgba(74,222,128,0.15);
    }
    .dm-textarea { resize: vertical; min-height: 3rem; line-height: 1.5; }

    /* ---- chips ---- */
    .dm-chips {
      display: flex; flex-wrap: wrap; gap: 0.45rem;
    }
    .dm-chip {
      background: #0e1115;
      border: 1px solid #1f2530;
      color: #d1d5db;
      font-family: inherit;
      font-size: 0.85rem;
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 160ms;
    }
    .dm-chip:hover { border-color: #4ade80; color: #e5e9ee; }
    .dm-chip[aria-pressed="true"] {
      border-color: #4ade80;
      background: rgba(74,222,128,0.1);
      color: #4ade80;
    }

    /* ---- sliders ---- */
    .dm-slider-row {
      display: flex; align-items: center; gap: 0.9rem;
    }
    .dm-slider {
      flex: 1;
      -webkit-appearance: none;
      appearance: none;
      height: 4px;
      background: #1f2530;
      border-radius: 2px;
      outline: none;
    }
    .dm-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: #4ade80;
      cursor: pointer;
      box-shadow: 0 0 0 4px rgba(74,222,128,0.15);
      transition: box-shadow 160ms;
    }
    .dm-slider::-webkit-slider-thumb:hover {
      box-shadow: 0 0 0 6px rgba(74,222,128,0.25);
    }
    .dm-slider::-moz-range-thumb {
      width: 18px; height: 18px; border: none;
      border-radius: 50%;
      background: #4ade80;
      cursor: pointer;
    }
    .dm-slider-out {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.95rem;
      color: #4ade80;
      min-width: 2.4rem;
      text-align: right;
    }

    /* ---- flags ---- */
    .dm-flags { display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
    @media (min-width: 600px) { .dm-flags { grid-template-columns: 1fr 1fr; } }
    .dm-flag {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.6rem 0.8rem;
      border: 1px solid #1f2530;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.88rem;
      color: #d1d5db;
      transition: border-color 160ms, background 160ms;
      background: #0e1115;
    }
    .dm-flag:hover { border-color: #fbbf24; }
    .dm-flag input { accent-color: #fbbf24; }
    .dm-flag input:checked + span { color: #fbbf24; }

    .dm-grid-2 {
      display: grid; gap: 1rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 600px) { .dm-grid-2 { grid-template-columns: 1fr 1fr; } }
    .dm-grid-2-span { grid-column: 1 / -1; }

    .dm-final-disclaim {
      margin-top: 1.4rem;
      padding: 0.8rem 1rem;
      background: rgba(251,191,36,0.05);
      border: 1px solid #251c0a;
      border-radius: 8px;
      font-size: 0.85rem;
      color: #d1d5db;
    }

    /* ---- buttons ---- */
    .dm-actions {
      display: flex; justify-content: space-between; align-items: center;
      gap: 0.6rem; margin-top: 1.6rem;
    }
    .dm-btn {
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 500;
      padding: 0.7rem 1.4rem;
      border-radius: 8px;
      border: 1px solid transparent;
      cursor: pointer;
      transition: all 180ms;
    }
    .dm-btn-primary {
      background: #4ade80;
      color: #04100b;
      border-color: #4ade80;
    }
    .dm-btn-primary:hover {
      background: #6ee7a4;
      border-color: #6ee7a4;
      box-shadow: 0 6px 24px -8px rgba(74,222,128,0.55);
      transform: translateY(-1px);
    }
    .dm-btn-ghost {
      background: transparent;
      color: #9ca3af;
      border-color: #1f2530;
    }
    .dm-btn-ghost:hover { color: #e5e9ee; border-color: #2c3340; }
    .dm-btn-sm { padding: 0.5rem 0.9rem; font-size: 0.82rem; }
    .dm-btn[hidden] { display: none !important; }

    /* ---- generating ---- */
    .dm-generating {
      display: flex; flex-direction: column; align-items: center;
      text-align: center; padding: 4rem 1rem;
      gap: 1rem;
    }
    .dm-avatar { width: 72px; height: 72px; border-radius: 50%; overflow: hidden; }
    .dm-avatar svg { width: 100%; height: 100%; display: block; }
    .dm-avatar-lg { width: 96px; height: 96px; }
    .dm-avatar-md { width: 44px; height: 44px; }

    /* ---- dashboard ---- */
    .dm-hero {
      display: flex; justify-content: space-between; align-items: flex-end;
      gap: 1rem; flex-wrap: wrap;
      margin-bottom: 1.6rem;
    }
    .dm-hero-actions { display: flex; gap: 0.5rem; }

    .dm-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 960px) {
      .dm-grid {
        grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
        grid-template-areas:
          "roadmap coach"
          "diet coach"
          "lifestyle coach"
          "cites cites";
      }
      .dm-panel-roadmap { grid-area: roadmap; }
      .dm-panel-coach { grid-area: coach; }
      .dm-panel-tips:nth-of-type(3) { grid-area: diet; }
      .dm-panel-tips:nth-of-type(4) { grid-area: lifestyle; }
      .dm-panel-cites { grid-area: cites; }
    }

    .dm-panel {
      background: #0e1115;
      border: 1px solid #1a1f29;
      border-radius: 12px;
      padding: 1.1rem 1.1rem 1.2rem;
      transition: border-color 220ms;
    }
    .dm-panel:hover { border-color: #232a36; }
    .dm-panel-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.6rem; flex-wrap: wrap;
      margin-bottom: 0.9rem;
    }
    .dm-panel-title {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #9ca3af;
      margin: 0;
      font-weight: 500;
    }

    /* ---- weeks ---- */
    .dm-week-tabs { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    :global(.dm-week-tab) {
      background: transparent;
      border: 1px solid #1f2530;
      color: #9ca3af;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.72rem;
      padding: 0.32rem 0.55rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 160ms;
    }
    :global(.dm-week-tab:hover) { color: #e5e9ee; border-color: #2c3340; }
    :global(.dm-week-tab.dm-active) {
      background: rgba(74,222,128,0.1);
      border-color: #4ade80;
      color: #4ade80;
    }
    :global(.dm-week-focus) {
      font-size: 0.92rem;
      color: #d1d5db;
      padding: 0.6rem 0.85rem;
      background: #07090b;
      border: 1px solid #1a1f29;
      border-radius: 8px;
      margin-bottom: 0.9rem;
    }

    :global(.dm-sessions) {
      display: grid;
      gap: 0.5rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 720px) {
      :global(.dm-sessions) { grid-template-columns: 1fr 1fr; }
    }
    :global(.dm-session) {
      display: grid;
      grid-template-columns: 44px 1fr auto;
      gap: 0.7rem;
      align-items: center;
      padding: 0.7rem 0.85rem;
      background: #07090b;
      border: 1px solid #1a1f29;
      border-radius: 8px;
      transition: border-color 160ms, transform 160ms;
    }
    :global(.dm-session:hover) {
      border-color: #2c3340;
      transform: translateY(-1px);
    }
    :global(.dm-session-day) {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #6b7280;
    }
    :global(.dm-session-body) {
      min-width: 0;
    }
    :global(.dm-session-title) {
      font-size: 0.92rem;
      font-weight: 500;
      color: #e5e9ee;
      margin: 0 0 0.2rem;
      line-height: 1.3;
    }
    :global(.dm-session-details) {
      font-size: 0.8rem;
      color: #9ca3af;
      margin: 0;
      line-height: 1.4;
    }
    :global(.dm-session-meta) {
      display: flex; flex-direction: column; align-items: flex-end; gap: 0.2rem;
    }
    :global(.dm-session-pill) {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.65rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.18rem 0.45rem;
      border-radius: 4px;
      border: 1px solid #1f2530;
      color: #9ca3af;
    }
    :global(.dm-session-pill.dm-pill-strength) { color: #fbbf24; border-color: rgba(251,191,36,0.3); }
    :global(.dm-session-pill.dm-pill-cardio) { color: #f87171; border-color: rgba(248,113,113,0.3); }
    :global(.dm-session-pill.dm-pill-mobility) { color: #22d3ee; border-color: rgba(34,211,238,0.3); }
    :global(.dm-session-pill.dm-pill-rest), :global(.dm-session-pill.dm-pill-recovery) { color: #6b7280; }
    :global(.dm-session-pill.dm-pill-skill) { color: #c084fc; border-color: rgba(192,132,252,0.3); }
    :global(.dm-session-dur) {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem;
      color: #6b7280;
    }

    /* ---- coach ---- */
    .dm-coach-id {
      display: flex; align-items: center; gap: 0.7rem;
    }
    .dm-coach-name {
      font-size: 0.95rem;
      font-weight: 600;
      color: #e5e9ee;
    }
    .dm-coach-sub {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem;
      color: #4ade80;
      letter-spacing: 0.08em;
    }
    :global(.dm-coach-log) {
      display: flex; flex-direction: column; gap: 0.7rem;
      max-height: 580px;
      overflow-y: auto;
      padding-right: 0.2rem;
    }
    :global(.dm-coach-msg) {
      padding: 0.85rem 0.95rem;
      background: #07090b;
      border: 1px solid #1a1f29;
      border-left: 2px solid #4ade80;
      border-radius: 8px;
      font-size: 0.9rem;
      color: #d1d5db;
      line-height: 1.55;
      white-space: pre-wrap;
    }
    :global(.dm-coach-msg-meta) {
      display: block;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #6b7280;
      margin-bottom: 0.4rem;
    }

    /* ---- tips ---- */
    :global(.dm-tips) {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-direction: column; gap: 0.7rem;
    }
    :global(.dm-tip) {
      padding: 0.7rem 0.85rem;
      background: #07090b;
      border: 1px solid #1a1f29;
      border-radius: 8px;
    }
    :global(.dm-tip-line) {
      font-size: 0.9rem;
      color: #e5e9ee;
      margin: 0 0 0.3rem;
      font-weight: 500;
    }
    :global(.dm-tip-why) {
      font-size: 0.8rem;
      color: #9ca3af;
      margin: 0;
      line-height: 1.45;
    }

    /* ---- citations ---- */
    .dm-cite-count {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem;
      color: #4ade80;
      padding: 0.18rem 0.45rem;
      border: 1px solid rgba(74,222,128,0.3);
      border-radius: 4px;
    }
    :global(.dm-cites) {
      list-style: none; margin: 0; padding: 0;
      display: grid; gap: 0.4rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 720px) { :global(.dm-cites) { grid-template-columns: 1fr 1fr; } }
    :global(.dm-cite) {
      display: block;
      padding: 0.55rem 0.7rem;
      background: #07090b;
      border: 1px solid #1a1f29;
      border-radius: 6px;
      text-decoration: none;
      transition: border-color 160ms;
    }
    :global(.dm-cite:hover) { border-color: #4ade80; }
    :global(.dm-cite-title) {
      display: block;
      font-size: 0.82rem;
      color: #d1d5db;
      line-height: 1.35;
      margin-bottom: 0.2rem;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    :global(.dm-cite-domain) {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.68rem;
      color: #4ade80;
      letter-spacing: 0.04em;
    }
    :global(.dm-cite-empty) {
      grid-column: 1 / -1;
      padding: 0.8rem;
      color: #6b7280;
      font-size: 0.85rem;
      font-style: italic;
      text-align: center;
    }
  </style>

  <script>
    type Intake = {
      goalTags: string[];
      goalNarrative: string;
      experience: 'beginner' | 'intermediate' | 'advanced';
      daysPerWeek: number;
      minutesPerSession: number;
      restrictions: string;
      healthFlags: string[];
      age: number | null;
      weightKg: number | null;
      heightCm: number | null;
      restingHr: number | null;
      sleepHours: number | null;
      currentActivity: string;
    };
    type Session = { day: string; type: string; title: string; duration: number; intensity: string; details: string; status?: string };
    type Week = { weekNum: number; focus: string; sessions: Session[] };
    type Tip = { tip: string; rationale: string };
    type Citation = { title: string; url: string; domain: string };
    type Plan = { title: string; summary: string; weeks: Week[]; diet_tips: Tip[]; lifestyle_tips: Tip[]; citations: Citation[] };
    type CoachMsg = { ts: number; kind: string; body: string };
    type State = { userId: string; createdAt: number; updatedAt: number; intake: Intake; plan: Plan | null; coachLog: CoachMsg[]; history: any[] };

    type View = 'loading' | 'intake' | 'generating' | 'dashboard' | 'error';

    const DAY_ORDER = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];

    const initDomsday = () => {
      const root = document.querySelector<HTMLElement>('.dm-root');
      if (!root) return;
      const ac = new AbortController();
      const sig = ac.signal;

      // ---- state ----
      const app: {
        view: View;
        userId: string;
        state: State | null;
        intakeStep: 1 | 2 | 3;
        intake: Partial<Intake>;
        selectedWeek: number;
      } = {
        view: 'loading',
        userId: '',
        state: null,
        intakeStep: 1,
        intake: {
          goalTags: [],
          goalNarrative: '',
          experience: 'beginner',
          daysPerWeek: 3,
          minutesPerSession: 45,
          restrictions: '',
          healthFlags: [],
          age: null, weightKg: null, heightCm: null, restingHr: null, sleepHours: null,
          currentActivity: '',
        },
        selectedWeek: 0,
      };

      // ---- helpers ----
      const $ = <T extends Element = HTMLElement>(sel: string): T | null => root.querySelector<T>(sel);
      const $$ = <T extends Element = HTMLElement>(sel: string): T[] => Array.from(root.querySelectorAll<T>(sel));

      const setView = (v: View) => {
        app.view = v;
        root.dataset.view = v;
        $$('[data-view-target]').forEach((el) => {
          el.toggleAttribute('hidden', el.getAttribute('data-view-target') !== v);
        });
        if (v === 'intake') renderIntake();
        if (v === 'dashboard') renderDashboard();
      };

      const showError = (msg: string) => {
        const el = $('[data-bind="error-message"]');
        if (el) el.textContent = msg;
        setView('error');
      };

      // ---- userId ----
      const getOrCreateUserId = (): string => {
        const url = new URL(window.location.href);
        let id = url.searchParams.get('id') || '';
        if (!/^[a-z0-9-]{8,40}$/i.test(id)) {
          try { id = localStorage.getItem('domsday:userId') || ''; } catch {}
        }
        if (!/^[a-z0-9-]{8,40}$/i.test(id)) {
          id = (window.crypto?.randomUUID?.() || `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`).slice(0, 36);
        }
        try { localStorage.setItem('domsday:userId', id); } catch {}
        if (url.searchParams.get('id') !== id) {
          url.searchParams.set('id', id);
          window.history.replaceState(null, '', url.toString());
        }
        return id;
      };

      const renderUserIdShort = () => {
        const el = $('[data-bind="user-id-short"]');
        if (el) el.textContent = app.userId.slice(0, 8);
      };

      // ---- bookmark button ----
      const bindBookmark = () => {
        const btn = $('[data-action="bookmark"]') as HTMLButtonElement | null;
        if (!btn) return;
        btn.addEventListener('click', async () => {
          const url = window.location.href;
          try {
            await navigator.clipboard.writeText(url);
            const lab = btn.querySelector('.dm-bookmark-label');
            if (lab) lab.textContent = 'copied!';
            btn.classList.add('dm-copied');
            setTimeout(() => {
              btn.classList.remove('dm-copied');
              if (lab) lab.textContent = 'bookmark this';
            }, 1600);
          } catch {
            window.prompt('Copy this URL — your plan lives at it:', url);
          }
        }, { signal: sig });
      };

      // ---- intake binding ----
      const renderIntake = () => {
        const cur = $('[data-bind="step-current"]');
        if (cur) cur.textContent = String(app.intakeStep);
        const bar = $('[data-bind="progress-bar"]') as HTMLElement | null;
        if (bar) bar.style.width = `${(app.intakeStep / 3) * 100}%`;
        $$('.dm-step').forEach((el) => {
          el.toggleAttribute('hidden', el.getAttribute('data-step') !== String(app.intakeStep));
        });
        ($('[data-action="back"]') as HTMLElement | null)?.toggleAttribute('hidden', app.intakeStep === 1);
        ($('[data-action="next"]') as HTMLElement | null)?.toggleAttribute('hidden', app.intakeStep === 3);
        ($('[data-action="submit"]') as HTMLElement | null)?.toggleAttribute('hidden', app.intakeStep !== 3);
      };

      const bindIntakeOnce = () => {
        // multi-chip: goalTags
        $$('[data-bind="goal-tags"] .dm-chip').forEach((chip) => {
          chip.addEventListener('click', () => {
            const tag = chip.getAttribute('data-tag') || '';
            const tags = app.intake.goalTags || [];
            const has = tags.includes(tag);
            app.intake.goalTags = has ? tags.filter((t) => t !== tag) : [...tags, tag];
            chip.setAttribute('aria-pressed', has ? 'false' : 'true');
          }, { signal: sig });
        });

        // single-chip: experience
        $$('[data-bind="experience"] .dm-chip').forEach((chip) => {
          chip.addEventListener('click', () => {
            const tag = chip.getAttribute('data-tag') || 'beginner';
            app.intake.experience = tag as Intake['experience'];
            $$('[data-bind="experience"] .dm-chip').forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
          }, { signal: sig });
        });
        // initial selected
        const initExp = $('[data-bind="experience"] .dm-chip[data-tag="beginner"]');
        if (initExp) initExp.setAttribute('aria-pressed', 'true');

        // text fields
        const textFields: Array<keyof Intake> = ['goalNarrative', 'restrictions', 'currentActivity'];
        textFields.forEach((name) => {
          const el = $(`[data-bind="${name}"]`) as HTMLTextAreaElement | null;
          if (!el) return;
          el.addEventListener('input', () => { (app.intake as any)[name] = el.value; }, { signal: sig });
        });

        // sliders
        const sliderFields: Array<{ name: keyof Intake; out: string }> = [
          { name: 'daysPerWeek', out: 'daysPerWeek' },
          { name: 'minutesPerSession', out: 'minutesPerSession' },
        ];
        sliderFields.forEach(({ name, out }) => {
          const el = $(`[data-bind="${name}"]`) as HTMLInputElement | null;
          const o = $(`[data-bind-out="${out}"]`);
          if (!el) return;
          const update = () => {
            const v = Number(el.value);
            (app.intake as any)[name] = v;
            if (o) o.textContent = String(v);
          };
          el.addEventListener('input', update, { signal: sig });
          update();
        });

        // numeric fields
        const numFields: Array<keyof Intake> = ['age', 'weightKg', 'heightCm', 'restingHr', 'sleepHours'];
        numFields.forEach((name) => {
          const el = $(`[data-bind="${name}"]`) as HTMLInputElement | null;
          if (!el) return;
          el.addEventListener('input', () => {
            const v = el.value.trim() === '' ? null : Number(el.value);
            (app.intake as any)[name] = (v === null || !Number.isFinite(v)) ? null : v;
          }, { signal: sig });
        });

        // health flags
        $$('[data-bind="healthFlags"] input[type="checkbox"]').forEach((cb) => {
          cb.addEventListener('change', () => {
            const flags = $$('[data-bind="healthFlags"] input[type="checkbox"]:checked')
              .map((x) => x.getAttribute('data-flag') || '').filter(Boolean);
            app.intake.healthFlags = flags;
            const helper = $('[data-bind="flag-helper"]');
            if (helper) helper.toggleAttribute('hidden', flags.length === 0);
          }, { signal: sig });
        });

        // step nav
        $('[data-action="next"]')?.addEventListener('click', () => {
          if (app.intakeStep === 1) {
            if (!(app.intake.goalTags && app.intake.goalTags.length) && !app.intake.goalNarrative) {
              alert('Pick at least one goal tag, or write a sentence about what you\'re after.');
              return;
            }
          }
          app.intakeStep = (app.intakeStep + 1) as 1 | 2 | 3;
          if (app.intakeStep > 3) app.intakeStep = 3;
          renderIntake();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, { signal: sig });

        $('[data-action="back"]')?.addEventListener('click', () => {
          app.intakeStep = (app.intakeStep - 1) as 1 | 2 | 3;
          if (app.intakeStep < 1) app.intakeStep = 1;
          renderIntake();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, { signal: sig });

        $('[data-action="submit"]')?.addEventListener('click', () => {
          submitIntake();
        }, { signal: sig });
      };

      // ---- submit ----
      const submitIntake = async () => {
        setView('generating');
        rotateGeneratingStatus();
        try {
          const r = await fetch('/api/domsday?action=plan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: app.userId, intake: app.intake }),
          });
          if (!r.ok) {
            const err = await r.json().catch(() => ({}));
            showError((err as any).error || `request failed (${r.status})`);
            return;
          }
          const data = await r.json();
          if (!data?.state?.plan) {
            showError('coach returned an empty plan. try again.');
            return;
          }
          app.state = data.state as State;
          app.selectedWeek = 0;
          setView('dashboard');
        } catch (e) {
          showError('network failure. try again.');
        }
      };

      // generating ticker
      let genTimer: any = null;
      const rotateGeneratingStatus = () => {
        const lines = [
          'cross-referencing the literature…',
          'mapping intensity to your time…',
          'sanity-checking volume against recovery…',
          'pulling sources from peer review…',
          'composing Dr DOMs\' opening statement…',
        ];
        let i = 0;
        const el = $('[data-bind="generating-status"]');
        if (genTimer) clearInterval(genTimer);
        genTimer = setInterval(() => {
          i = (i + 1) % lines.length;
          if (el) el.textContent = lines[i];
        }, 3500);
        sig.addEventListener('abort', () => { if (genTimer) clearInterval(genTimer); }, { once: true });
      };

      // ---- dashboard render ----
      const renderDashboard = () => {
        if (!app.state || !app.state.plan) { setView('intake'); return; }
        const plan = app.state.plan;

        const titleEl = $('[data-bind="plan-title"]');
        if (titleEl) titleEl.textContent = plan.title || 'your protocol';
        const sumEl = $('[data-bind="plan-summary"]');
        if (sumEl) sumEl.textContent = plan.summary || '';

        // week tabs
        const tabs = $('[data-bind="week-tabs"]');
        if (tabs) {
          tabs.innerHTML = '';
          plan.weeks.forEach((w, idx) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'dm-week-tab' + (idx === app.selectedWeek ? ' dm-active' : '');
            b.textContent = `week ${w.weekNum}`;
            b.addEventListener('click', () => {
              app.selectedWeek = idx;
              renderDashboard();
            }, { signal: sig });
            tabs.appendChild(b);
          });
        }

        const wk = plan.weeks[app.selectedWeek];
        const focus = $('[data-bind="week-focus"]');
        if (focus) focus.textContent = wk?.focus || '';

        // sessions
        const sessionsEl = $('[data-bind="sessions"]');
        if (sessionsEl) {
          sessionsEl.innerHTML = '';
          const sorted = [...(wk?.sessions || [])].sort((a, b) =>
            DAY_ORDER.indexOf(a.day) - DAY_ORDER.indexOf(b.day));
          sorted.forEach((s) => {
            const card = document.createElement('div');
            card.className = 'dm-session';
            card.innerHTML = `
              <div class="dm-session-day">${escape(s.day)}</div>
              <div class="dm-session-body">
                <p class="dm-session-title">${escape(s.title)}</p>
                <p class="dm-session-details">${escape(s.details)}</p>
              </div>
              <div class="dm-session-meta">
                <span class="dm-session-pill dm-pill-${escape(s.type)}">${escape(s.type)}</span>
                ${s.duration ? `<span class="dm-session-dur">${s.duration}m</span>` : ''}
              </div>
            `;
            sessionsEl.appendChild(card);
          });
        }

        // coach log
        const logEl = $('[data-bind="coach-log"]');
        if (logEl) {
          logEl.innerHTML = '';
          (app.state.coachLog || []).forEach((m) => {
            const div = document.createElement('div');
            div.className = 'dm-coach-msg';
            div.innerHTML = `<span class="dm-coach-msg-meta">${escape(m.kind)} · ${formatTime(m.ts)}</span>${escape(m.body)}`;
            logEl.appendChild(div);
          });
          if (!(app.state.coachLog || []).length) {
            logEl.innerHTML = '<div class="dm-coach-msg"><span class="dm-coach-msg-meta">silent</span>Dr DOMs has nothing to add yet.</div>';
          }
        }

        // tips
        const dietEl = $$('[data-bind="diet-tips"]')[0];
        const lifeEl = $$('[data-bind="lifestyle-tips"]')[0];
        if (dietEl) renderTips(dietEl, plan.diet_tips || []);
        if (lifeEl) renderTips(lifeEl, plan.lifestyle_tips || []);

        // citations
        const citEl = $('[data-bind="citations"]');
        const citCount = $('[data-bind="cite-count"]');
        const cites = plan.citations || [];
        if (citCount) citCount.textContent = String(cites.length);
        if (citEl) {
          citEl.innerHTML = '';
          if (!cites.length) {
            citEl.innerHTML = '<li class="dm-cite-empty">no sources captured (live search may not have run — stub mode or grounding empty)</li>';
          } else {
            cites.forEach((c) => {
              const a = document.createElement('a');
              a.className = 'dm-cite';
              a.href = c.url;
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              a.innerHTML = `<span class="dm-cite-title">${escape(c.title)}</span><span class="dm-cite-domain">${escape(c.domain || c.url)}</span>`;
              (citEl as HTMLElement).appendChild(a);
            });
          }
        }
      };

      const renderTips = (el: HTMLElement, tips: Tip[]) => {
        el.innerHTML = '';
        if (!tips.length) {
          el.innerHTML = '<li class="dm-tip"><p class="dm-tip-line">—</p></li>';
          return;
        }
        tips.forEach((t) => {
          const li = document.createElement('li');
          li.className = 'dm-tip';
          li.innerHTML = `<p class="dm-tip-line">${escape(t.tip)}</p><p class="dm-tip-why">${escape(t.rationale)}</p>`;
          el.appendChild(li);
        });
      };

      // util
      const escape = (s: string): string => String(s ?? '')
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      const formatTime = (ts: number): string => {
        try {
          const d = new Date(ts);
          return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
        } catch { return ''; }
      };

      // ---- dashboard actions ----
      const bindDashboardActionsOnce = () => {
        $('[data-action="regen"]')?.addEventListener('click', () => {
          if (!confirm('Regenerate from your existing intake? Your current plan moves to history.')) return;
          submitIntake();
        }, { signal: sig });
        $('[data-action="reset"]')?.addEventListener('click', () => {
          if (!confirm('Wipe local id and start over? Your old plan stays in storage but you\'ll need the bookmark URL to find it again.')) return;
          try { localStorage.removeItem('domsday:userId'); } catch {}
          const url = new URL(window.location.href);
          url.searchParams.delete('id');
          window.location.href = url.toString();
        }, { signal: sig });
      };

      // ---- boot ----
      const boot = async () => {
        app.userId = getOrCreateUserId();
        renderUserIdShort();
        bindBookmark();
        bindIntakeOnce();
        bindDashboardActionsOnce();

        try {
          const r = await fetch('/api/domsday?action=load', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: app.userId }),
          });
          if (r.ok) {
            const data = await r.json();
            if (data?.state?.plan) {
              app.state = data.state as State;
              setView('dashboard');
              return;
            }
          }
        } catch { /* fallthrough to intake */ }

        setView('intake');
      };

      // cleanup on SPA navigation
      document.addEventListener('astro:before-preparation', () => ac.abort(), { once: true });

      boot();
    };

    document.addEventListener('astro:page-load', initDomsday);
  </script>
</Layout>
