---
import Layout from '../../../layouts/Layout.astro';
import { nextRoom } from '../../../data/rooms.mjs';
import data from './data.json';

const { paths, exercises, bosses } = data;
const next = nextRoom('corporateladder');
---

<Layout
  title="corporatelardder. — Mick Tan"
  description="log workouts to climb the corporate lardder."
  themeColor="#0a0e23"
  ogImage="/og/corporateladder.png"
  ogAlt="corporatelardder. — neon arcade type and a pixel ladder climbing a dark field."
>
  <main class="cl">
    <div class="topbar">
      <a class="back" href="/room/" data-astro-prefetch data-veil-exit>&larr; the room</a>
      <button class="bgm-toggle" id="bgmToggle" type="button" aria-label="toggle background music" aria-pressed="false">
        <span id="bgmIcon">🔇</span>
        <span class="bgm-label" id="bgmLabel">music off</span>
      </button>
    </div>

    <header class="head">
      <h1>corporatelardder<span class="dot">.</span></h1>
      <p class="sub">log workouts to climb the corporate lardder.</p>
    </header>

    {/* Onboarding view: no team yet, OR team in URL but user hasn't joined yet */}
    <section class="onboard" id="onboard">
      <div class="card-block" id="newTeamCard">
        <h2>start a team</h2>
        <p>create a new team and share the URL with anyone you want to climb with. solo also works (team of 1).</p>
        <button id="createTeamBtn" class="primary-btn">+ start a team</button>
      </div>

      <div class="card-block" id="joinTeamCard" hidden>
        <h2>you've been invited</h2>
        <p>pick a handle and a path. you can change your path later.</p>
        <form id="joinForm">
          <label>
            <span>handle</span>
            <input id="joinHandle" name="handle" type="text" maxlength="24" required placeholder="what they call you" />
          </label>
          <label>
            <span>path</span>
            <select id="joinPath" name="path" required>
              {paths.map(p => (
                <option value={p.id}>{p.icon} {p.label} — {p.tagline}</option>
              ))}
            </select>
          </label>
          <button type="submit" class="primary-btn">join the team</button>
        </form>
        <p class="onboard-status" id="onboardStatus" aria-live="polite"></p>
      </div>
    </section>

    {/* Game view */}
    <section class="game" id="game" hidden>
      <div class="game-grid">
        {/* Boss column */}
        <div class="boss-col">
          <div class="boss-card">
            <div class="boss-portrait" id="bossPortrait">👤</div>
            <div class="boss-meta">
              <div class="boss-tier" id="bossTier">??? Tier</div>
              <div class="boss-name" id="bossName">???</div>
              <div class="boss-tagline" id="bossTagline">connecting…</div>
            </div>
            <div class="hp-bar" aria-label="boss health">
              <div class="hp-fill" id="hpFill"></div>
              <div class="hp-label" id="hpLabel">— / —</div>
            </div>
            <div class="boss-weakness" id="bossWeakness"></div>
            <div class="boss-quip" id="bossQuip">&nbsp;</div>
          </div>

          <details class="strategy" open>
            <summary>📋 recommended weekly workout</summary>
            <p class="strategy-note" id="strategyNote">a daily share to clear this boss in 7 days, by class.</p>
            <ol class="strategy-list" id="strategyList"></ol>
          </details>

          <details class="log-feed">
            <summary>battle log</summary>
            <ol id="logFeed"></ol>
          </details>
        </div>

        {/* Right column: ladder + actions */}
        <div class="side-col">
          <div class="ladder-block" aria-label="the ladder">
            <h3>the ladder</h3>
            <ol class="ladder">
              {bosses.slice().reverse().map((b, i) => {
                const trueIdx = bosses.length - 1 - i;
                return (
                  <li class="rung" data-rung-idx={trueIdx}>
                    <span class="rung-num">{String(trueIdx + 1).padStart(2, '0')}</span>
                    <span class="rung-icon">{b.avatar}</span>
                    <span class="rung-name">{b.name.toLowerCase()}</span>
                  </li>
                );
              })}
            </ol>
          </div>

          <div class="party-block">
            <h3>the party</h3>
            <ol id="partyList"></ol>
            <button id="copyJoinBtn" class="ghost-btn" type="button">📋 copy invite link</button>
          </div>

          <form class="log-form" id="logForm">
            <h3>log a workout</h3>
            <label>
              <span>exercise</span>
              <select id="logExercise" required>
                {['strength', 'cardio', 'endurance', 'mobility'].map(group => (
                  <optgroup label={group}>
                    {exercises.filter(e => e.group === group).map(e => (
                      <option value={e.id}>
                        {e.icon} {e.label} ({e.damagePerUnit}/{e.unit})
                      </option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </label>
            <label>
              <span>amount</span>
              <input id="logAmount" type="number" min="1" max="1000" step="1" required placeholder="e.g. 30" />
            </label>
            <button type="submit" class="primary-btn" id="logBtn">deal damage</button>
            <p class="log-status" id="logStatus" aria-live="polite"></p>
          </form>

          <div class="path-switcher">
            <h3>your path</h3>
            <select id="pathSelect">
              {paths.map(p => (
                <option value={p.id}>{p.icon} {p.label}</option>
              ))}
            </select>
            <button id="stepOutBtn" type="button" class="ghost-btn" style="margin-top: 0.7rem; width: 100%;">
              💤 step out (boss HP shrinks to your share)
            </button>
          </div>
        </div>
      </div>

      {/* Win state — covers everything when ladder is fully cleared */}
      <div class="win" id="winOverlay" hidden>
        <div class="win-card">
          <div class="win-emoji">🪜</div>
          <h2>you're at the top.</h2>
          <p>the corner office is yours. the company is on fire. the board has questions.</p>
          <p class="win-quiet">but at least you've done <span id="winDamage">0</span> dmg of pure squats and stretches getting here.</p>
          <button class="primary-btn" id="winRestart">descend back to the lobby</button>
        </div>
      </div>
    </section>

    <p class="next-room"><a href={next.href} data-veil-exit={next.bg} data-astro-prefetch>next room — {next.title} &rarr;</a></p>
  </main>
</Layout>

<style>
  /* ===== 8-bit arcade aesthetic ===== */
  :root {
    --cl-bg: #0a0e23;
    --cl-bg-2: #1a1144;
    --cl-fg: #f6e7ff;
    --cl-dim: #c0aee6; /* was #a48fcc — brightened to clear AA on the dark bg */
    --cl-accent: #ffea3a;
    --cl-pink: #ff4ad9;
    --cl-cyan: #4af1ff;
    --cl-green: #6dff6d;
    --cl-red: #ff5e7e;
    --cl-orange: #ffa340;
    --cl-card: rgba(255, 255, 255, 0.04);
    --cl-card-border: rgba(74, 241, 255, 0.25);
  }

  /* Background comes from Layout's --page-bg (via themeColor). */
  html, body {
    color: var(--cl-fg);
    font-family: 'Press Start 2P', system-ui, monospace;
    overflow-x: hidden;
  }

  /* Scanlines + chunky CRT vignette */
  .cl::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background:
      repeating-linear-gradient(
        0deg,
        rgba(255,255,255,0.025) 0px,
        rgba(255,255,255,0.025) 1px,
        transparent 1px,
        transparent 3px
      );
    mix-blend-mode: screen;
  }
  .cl::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.4) 100%);
  }

  .cl {
    max-width: 80rem;
    margin: 0 auto;
    padding: 1.5rem 1.2rem 6rem;
    background:
      radial-gradient(ellipse at top right, rgba(255, 74, 217, 0.15) 0%, transparent 55%),
      radial-gradient(ellipse at bottom left, rgba(74, 241, 255, 0.1) 0%, transparent 55%);
    min-height: 100vh;
    position: relative;
    z-index: 3;
  }
  @media (min-width: 720px) {
    .cl { padding: 2.5rem 1.5rem 6rem; }
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .back {
    color: var(--cl-dim);
    text-decoration: none;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 0.6rem 0.6rem 0.6rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .back:hover { color: var(--cl-cyan); }

  /* Keyboard focus — neon, like everything else here. */
  .back:focus-visible,
  .primary-btn:focus-visible,
  .ghost-btn:focus-visible,
  .bgm-toggle:focus-visible,
  summary:focus-visible,
  select:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--cl-cyan);
    outline-offset: 3px;
  }

  .head { margin: 2rem 0 2.5rem; }
  .bgm-toggle {
    background: rgba(0,0,0,0.5);
    border: 2px solid var(--cl-card-border);
    color: var(--cl-fg);
    padding: 0.5rem 0.8rem;
    font-family: inherit;
    font-size: 0.6rem;
    cursor: pointer;
    border-radius: 2px;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    transition: border-color 200ms, color 200ms;
    flex-shrink: 0;
  }
  .bgm-toggle:hover { border-color: var(--cl-accent); color: var(--cl-accent); }
  .bgm-toggle.on { border-color: var(--cl-green); color: var(--cl-green); }
  .bgm-label { font-size: 0.55rem; }
  @media (max-width: 480px) {
    .bgm-label { display: none; }
    .bgm-toggle { padding: 0.5rem 0.7rem; }
  }
  .head h1 {
    font-size: clamp(1.5rem, 7vw, 3.4rem);
    line-height: 1.05;
    margin: 0;
    color: var(--cl-accent);
    text-shadow:
      2px 0 var(--cl-pink),
      -2px 0 var(--cl-cyan);
    letter-spacing: -0.02em;
    word-break: break-word;
  }
  @media (min-width: 720px) {
    .head h1 {
      text-shadow:
        3px 0 var(--cl-pink),
        -3px 0 var(--cl-cyan);
    }
  }
  .head h1 .dot { color: var(--cl-pink); }
  .head .sub {
    margin-top: 1.2rem;
    font-size: 0.7rem;
    color: var(--cl-dim);
    line-height: 1.7;
    max-width: 38rem;
  }
  .head .sub .nowrap { white-space: nowrap; }

  /* ===== Onboarding ===== */
  .onboard { display: flex; flex-direction: column; gap: 1.5rem; max-width: 38rem; }
  .card-block {
    background: var(--cl-card);
    border: 2px solid var(--cl-card-border);
    border-radius: 4px;
    padding: 1.5rem 1.5rem 1.8rem;
    box-shadow: 0 0 0 4px rgba(255, 234, 58, 0.08), 0 0 24px rgba(74, 241, 255, 0.1);
  }
  .card-block h2 {
    font-size: 0.95rem;
    color: var(--cl-accent);
    margin: 0 0 0.8rem;
    letter-spacing: 0.04em;
  }
  .card-block p {
    font-size: 0.7rem;
    color: var(--cl-dim);
    line-height: 1.7;
    margin: 0 0 1.4rem;
  }
  .card-block label {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.7rem;
  }
  .card-block label span {
    display: block;
    color: var(--cl-cyan);
    margin-bottom: 0.4rem;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
  }
  .card-block input[type="text"],
  .card-block select {
    width: 100%;
    padding: 0.85rem 0.75rem;
    background: rgba(0,0,0,0.4);
    border: 2px solid var(--cl-card-border);
    color: var(--cl-fg);
    font-family: inherit;
    font-size: 16px; /* prevent iOS zoom on focus */
    border-radius: 2px;
    min-height: 44px;
  }
  .card-block input:focus,
  .card-block select:focus {
    outline: none;
    border-color: var(--cl-accent);
  }

  .primary-btn {
    background: var(--cl-pink);
    color: var(--cl-bg);
    border: 0;
    padding: 0.95rem 1.4rem;
    font-family: inherit;
    font-size: 0.7rem;
    cursor: pointer;
    border-radius: 2px;
    letter-spacing: 0.04em;
    box-shadow: 4px 4px 0 var(--cl-cyan);
    transition: transform 120ms, box-shadow 120ms;
    min-height: 44px;
  }
  .primary-btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--cl-cyan); }
  .primary-btn:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--cl-cyan); }
  .primary-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: 4px 4px 0 var(--cl-cyan); }

  .ghost-btn {
    background: transparent;
    color: var(--cl-dim);
    border: 2px solid var(--cl-card-border);
    padding: 0.7rem 0.9rem;
    font-family: inherit;
    font-size: 0.6rem;
    cursor: pointer;
    border-radius: 2px;
    letter-spacing: 0.04em;
    transition: color 200ms, border-color 200ms;
    min-height: 40px;
  }
  .ghost-btn:hover { color: var(--cl-accent); border-color: var(--cl-accent); }

  .onboard-status { font-size: 0.65rem; margin-top: 0.6rem; min-height: 1em; color: var(--cl-red); }
  .onboard-status.ok { color: var(--cl-green); }

  /* ===== Game grid ===== */
  .game-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .game-grid { grid-template-columns: 1fr; gap: 1.2rem; }
  }

  .boss-col, .side-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Boss card */
  .next-room {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }
  .next-room a { color: var(--cl-dim); text-decoration: none; padding: 0.6rem; display: inline-block; }
  .next-room a:hover { color: var(--cl-cyan); }

  /* Damage juice: floating hit numbers + a two-step flash on the boss card.
     :global() because the float is created at runtime by JS. */
  :global(.cl .dmg-float) {
    position: absolute;
    right: 1.2rem;
    top: 28%;
    font-family: inherit;
    font-size: 1.3rem;
    color: var(--cl-accent);
    text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.65);
    pointer-events: none;
    animation: dmg-rise 900ms ease-out forwards;
    z-index: 4;
  }
  @keyframes dmg-rise {
    from { transform: translateY(0); opacity: 1; }
    to   { transform: translateY(-72px); opacity: 0; }
  }
  :global(.cl .boss-card.hit) { animation: boss-hit 280ms steps(2, jump-none); }
  @keyframes boss-hit {
    50% { filter: brightness(1.7) saturate(1.4); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cl .dmg-float) { animation: none; opacity: 0; }
    :global(.cl .boss-card.hit) { animation: none; }
  }

  .boss-card {
    position: relative;
    background: linear-gradient(180deg, rgba(255, 74, 217, 0.12), rgba(0,0,0,0.4));
    border: 2px solid var(--cl-pink);
    border-radius: 4px;
    padding: 1.6rem 1.6rem 1.8rem;
    box-shadow:
      inset 0 0 0 4px rgba(0,0,0,0.35),
      0 0 32px rgba(255, 74, 217, 0.25);
    text-align: center;
  }
  .boss-portrait {
    font-size: clamp(4rem, 14vw, 7rem);
    line-height: 1;
    margin: 0.5rem 0 1rem;
    filter: drop-shadow(4px 4px 0 var(--cl-pink));
    animation: bossBob 3.4s ease-in-out infinite;
  }
  @keyframes bossBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .boss-tier {
    color: var(--cl-cyan);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .boss-name {
    font-size: clamp(1.1rem, 3.5vw, 1.6rem);
    color: var(--cl-accent);
    margin-bottom: 0.6rem;
    letter-spacing: 0.02em;
  }
  .boss-tagline {
    font-size: 0.65rem;
    color: var(--cl-dim);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }

  .hp-bar {
    position: relative;
    height: 22px;
    background: #1a0a1f;
    border: 2px solid var(--cl-fg);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.8rem;
  }
  .hp-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--cl-red) 0%, var(--cl-orange) 50%, var(--cl-green) 100%);
    transform-origin: left center;
    transition: transform 700ms cubic-bezier(.25, .8, .25, 1);
    background-size: 200% 100%;
  }
  .hp-fill.shake { animation: hpShake 280ms ease-out; }
  @keyframes hpShake {
    0%, 100% { transform: scaleX(var(--hp-pct, 1)) translateX(0); }
    25% { transform: scaleX(var(--hp-pct, 1)) translateX(-3px); }
    50% { transform: scaleX(var(--hp-pct, 1)) translateX(3px); }
    75% { transform: scaleX(var(--hp-pct, 1)) translateX(-2px); }
  }
  .hp-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    color: var(--cl-fg);
    text-shadow: 1px 1px 0 #000;
    z-index: 2;
  }

  .boss-weakness {
    font-size: 0.55rem;
    color: var(--cl-cyan);
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
    min-height: 1em;
  }
  .boss-quip {
    font-size: 0.65rem;
    color: var(--cl-fg);
    background: rgba(0,0,0,0.4);
    border: 1px dashed var(--cl-card-border);
    padding: 0.7rem 0.9rem;
    border-radius: 2px;
    line-height: 1.6;
    min-height: 2.5em;
    font-style: italic;
  }

  /* Strategy / Recommended workout */
  .strategy {
    background: var(--cl-card);
    border: 2px solid var(--cl-card-border);
    border-radius: 4px;
    padding: 0.9rem 1.1rem 1rem;
  }
  .strategy summary {
    cursor: pointer;
    font-size: 0.7rem;
    color: var(--cl-accent);
    letter-spacing: 0.04em;
    list-style: none;
  }
  .strategy summary::-webkit-details-marker { display: none; }
  .strategy[open] summary { margin-bottom: 0.7rem; }
  .strategy-note {
    font-size: 0.6rem;
    color: var(--cl-dim);
    margin: 0 0 0.8rem;
    line-height: 1.6;
  }
  .strategy-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .strategy-row {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 0.7rem;
    align-items: center;
    padding: 0.5rem 0.7rem;
    background: rgba(0,0,0,0.25);
    border-left: 3px solid var(--cl-cyan);
    border-radius: 2px;
    font-size: 0.62rem;
    line-height: 1.4;
  }
  .strategy-row.weak { border-left-color: var(--cl-pink); background: rgba(255, 74, 217, 0.08); }
  .strategy-row .sr-icon { font-size: 1rem; line-height: 1; }
  .strategy-row .sr-class { color: var(--cl-fg); font-size: 0.6rem; }
  .strategy-row.weak .sr-class { color: var(--cl-pink); }
  .strategy-row .sr-rec { color: var(--cl-dim); margin-top: 0.15rem; font-size: 0.58rem; }
  .strategy-row .sr-dmg { color: var(--cl-green); font-size: 0.58rem; white-space: nowrap; }

  .party-member.inactive {
    opacity: 0.45;
    border-left-color: var(--cl-dim);
  }
  .party-member.inactive .pm-tag::after { content: ' · 💤 stepped out'; color: var(--cl-orange); }

  /* Battle log */
  .log-feed {
    background: var(--cl-card);
    border: 2px solid var(--cl-card-border);
    border-radius: 4px;
    padding: 0.8rem 1rem;
  }
  .log-feed summary {
    cursor: pointer;
    font-size: 0.65rem;
    color: var(--cl-cyan);
    letter-spacing: 0.05em;
  }
  .log-feed ol {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    max-height: 18rem;
    overflow-y: auto;
    font-size: 0.62rem;
    line-height: 1.6;
  }
  .log-feed li {
    padding: 0.4rem 0;
    border-top: 1px dashed rgba(255,255,255,0.06);
    color: var(--cl-dim);
  }
  .log-feed li:first-child { border-top: 0; }
  .log-feed .who { color: var(--cl-accent); }
  .log-feed .dmg { color: var(--cl-pink); }
  .log-feed .killshot { color: var(--cl-green); font-weight: bold; }

  /* Ladder */
  .ladder-block, .party-block, .log-form, .path-switcher {
    background: var(--cl-card);
    border: 2px solid var(--cl-card-border);
    border-radius: 4px;
    padding: 1rem 1.1rem 1.2rem;
  }
  .ladder-block h3, .party-block h3, .log-form h3, .path-switcher h3 {
    font-size: 0.7rem;
    color: var(--cl-accent);
    margin: 0 0 1rem;
    letter-spacing: 0.05em;
  }
  .ladder {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rung {
    display: grid;
    grid-template-columns: 32px 32px 1fr;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-left: 4px solid var(--cl-card-border);
    font-size: 0.6rem;
    color: var(--cl-dim);
    transition: all 220ms;
  }
  .rung-num { color: var(--cl-cyan); font-size: 0.55rem; }
  .rung-icon { font-size: 1.1rem; line-height: 1; }
  .rung-name { letter-spacing: 0.04em; }
  .rung.defeated {
    border-left-color: var(--cl-green);
    color: rgba(109, 255, 109, 0.5);
  }
  .rung.defeated .rung-icon { filter: grayscale(1) opacity(0.4); }
  .rung.defeated .rung-name { text-decoration: line-through; }
  .rung.active {
    border-left-color: var(--cl-pink);
    color: var(--cl-fg);
    background: rgba(255, 74, 217, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 74, 217, 0.4);
    animation: rungPulse 1.6s ease-in-out infinite;
  }
  @keyframes rungPulse {
    0%, 100% { background: rgba(255, 74, 217, 0.08); }
    50% { background: rgba(255, 74, 217, 0.18); }
  }

  /* Party */
  .party-block ol {
    list-style: none;
    padding: 0;
    margin: 0 0 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .party-member {
    display: grid;
    grid-template-columns: 1.3rem 1fr auto;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.6rem;
    background: rgba(0,0,0,0.25);
    border-radius: 2px;
    font-size: 0.62rem;
    border-left: 3px solid var(--cl-cyan);
  }
  .party-member.you { border-left-color: var(--cl-accent); background: rgba(255, 234, 58, 0.06); }
  .party-member .pm-icon { font-size: 0.9rem; line-height: 1; }
  .party-member .pm-handle { color: var(--cl-fg); letter-spacing: 0.02em; }
  .party-member .pm-handle .pm-tag { color: var(--cl-dim); margin-left: 0.4em; }
  .party-member .pm-dmg { color: var(--cl-pink); font-size: 0.6rem; white-space: nowrap; }

  /* Log form */
  .log-form label {
    display: block;
    margin-bottom: 0.8rem;
    font-size: 0.65rem;
  }
  .log-form label span {
    display: block;
    color: var(--cl-cyan);
    margin-bottom: 0.3rem;
    font-size: 0.55rem;
    letter-spacing: 0.06em;
  }
  .log-form select,
  .log-form input[type="number"] {
    width: 100%;
    padding: 0.7rem 0.65rem;
    background: rgba(0,0,0,0.5);
    border: 2px solid var(--cl-card-border);
    color: var(--cl-fg);
    font-family: inherit;
    font-size: 16px; /* prevent iOS zoom on focus */
    border-radius: 2px;
    min-height: 44px;
  }
  .log-form select:focus,
  .log-form input:focus {
    outline: none;
    border-color: var(--cl-accent);
  }
  .log-form .primary-btn {
    width: 100%;
    margin-top: 0.4rem;
  }
  .log-status { font-size: 0.6rem; margin: 0.6rem 0 0; min-height: 1em; color: var(--cl-dim); }
  .log-status.ok { color: var(--cl-green); }
  .log-status.err { color: var(--cl-red); }

  .path-switcher select {
    width: 100%;
    padding: 0.7rem 0.65rem;
    background: rgba(0,0,0,0.5);
    border: 2px solid var(--cl-card-border);
    color: var(--cl-fg);
    font-family: inherit;
    font-size: 16px; /* prevent iOS zoom on focus */
    border-radius: 2px;
    min-height: 44px;
  }
  .path-switcher select:focus { outline: none; border-color: var(--cl-accent); }

  /* Win overlay */
  .win {
    position: fixed;
    inset: 0;
    background: rgba(10, 14, 35, 0.92);
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    backdrop-filter: blur(8px);
  }
  .win-card {
    background: var(--cl-bg-2);
    border: 2px solid var(--cl-accent);
    box-shadow: 0 0 40px rgba(255, 234, 58, 0.4);
    padding: 2.5rem 2rem;
    max-width: 28rem;
    text-align: center;
    border-radius: 4px;
  }
  .win-emoji { font-size: 4rem; margin-bottom: 1rem; }
  .win-card h2 {
    font-size: 1.2rem;
    color: var(--cl-accent);
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }
  .win-card p {
    font-size: 0.7rem;
    color: var(--cl-fg);
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .win-card .win-quiet { color: var(--cl-dim); margin-bottom: 1.6rem; }

  @media (prefers-reduced-motion: reduce) {
    .boss-portrait, .rung.active { animation: none; }
    .hp-fill { transition: transform 0ms; }
  }

  /* Press Start 2P retro font — load once here, scoped to this page only via the page-level :root override above. */
</style>

{/* Load Press Start 2P just for this page */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{/* Non-blocking load (see Layout.astro) — monospace fallback paints first.
    No <noscript> fallback here: the room needs JS anyway, and a root-level
    <noscript> stops Astro from hoisting the room script below. */}
<link
  href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>

<script type="application/json" id="clData" is:inline set:html={JSON.stringify(data)}></script>
<script>
  // Standard room lifecycle (same pattern as cooked/ssb): init on
  // astro:page-load so SPA navigations re-wire the room, AbortController for
  // document/window listeners, and a teardown that stops polling + BGM.
  // The old define:vars script ran once at parse time — dead controls after
  // a ClientRouter swap, and no way to clean up.
  let clAbort: AbortController | null = null;
  let clTeardown: (() => void) | null = null;

  const initLadder = () => {
  const dataEl = document.getElementById('clData');
  if (!dataEl) return; // some other page's astro:page-load

  clTeardown?.();
  clAbort?.abort();
  clAbort = new AbortController();
  const { signal } = clAbort;

  const DATA = JSON.parse(dataEl.textContent || '{}');
  const PATHS = DATA.paths;
  const EXERCISES = DATA.exercises;
  const BOSSES = DATA.bosses;

  const state = {
    teamId: null,
    handle: null,
    path: null,
    team: null,
    pollHandle: null,
  };

  // ===== identity persistence (per-team) =====
  const meKey = (teamId) => `cl.me.${teamId}`;
  const saveMe = (teamId, handle, path) => {
    try { localStorage.setItem(meKey(teamId), JSON.stringify({ handle, path })); } catch {}
  };
  const loadMe = (teamId) => {
    try { return JSON.parse(localStorage.getItem(meKey(teamId)) || 'null'); } catch { return null; }
  };

  // ===== URL helpers =====
  const getTeamId = () => new URLSearchParams(location.search).get('team');
  const setTeamUrl = (teamId) => {
    const u = new URL(location.href);
    u.searchParams.set('team', teamId);
    history.replaceState({}, '', u.toString());
  };

  // ===== API =====
  const api = async (action, body) => {
    const r = await fetch(`/api/ladder?action=${action}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body || {}),
    });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || `request failed (${r.status})`);
    return j;
  };

  // ===== rendering =====
  const findBoss = (idx) => BOSSES[idx];
  const findPath = (id) => PATHS.find(p => p.id === id);
  const findExercise = (id) => EXERCISES.find(e => e.id === id);

  const renderBoss = () => {
    const t = state.team;
    if (!t) return;
    const boss = findBoss(t.currentBossIdx);
    if (!boss) return;
    document.getElementById('bossPortrait').textContent = boss.avatar;
    document.getElementById('bossTier').textContent = `${boss.tier.toUpperCase()} TIER · rung ${t.currentBossIdx + 1} / ${BOSSES.length}`;
    document.getElementById('bossName').textContent = boss.name;
    document.getElementById('bossTagline').textContent = boss.tagline;

    const pct = Math.max(0, t.currentBossHp / boss.hp);
    const fill = document.getElementById('hpFill');
    fill.style.setProperty('--hp-pct', String(pct));
    fill.style.transform = `scaleX(${pct})`;
    document.getElementById('hpLabel').textContent = `${Math.max(0, t.currentBossHp).toLocaleString()} / ${boss.hp.toLocaleString()}`;

    const wEl = document.getElementById('bossWeakness');
    if (boss.weakness) {
      const p = findPath(boss.weakness);
      wEl.textContent = `WEAK TO: ${p ? `${p.icon} ${p.label}` : boss.weakness} (1.5×)`;
    } else {
      wEl.textContent = boss.tier === 'exec' && t.currentBossIdx === BOSSES.length - 1
        ? 'NO WEAKNESS — endgame, full team commitment'
        : 'NO SPECIFIC WEAKNESS';
    }
  };

  const renderLadder = () => {
    const t = state.team;
    if (!t) return;
    document.querySelectorAll('.rung').forEach(li => {
      const idx = parseInt(li.dataset.rungIdx, 10);
      li.classList.remove('active', 'defeated');
      if (idx < t.currentBossIdx) li.classList.add('defeated');
      else if (idx === t.currentBossIdx) li.classList.add('active');
    });
  };

  const activeMemberCount = (t) => t.members.filter(m => m.active !== false).length || 1;

  const renderParty = () => {
    const t = state.team;
    if (!t) return;
    const ol = document.getElementById('partyList');
    ol.innerHTML = '';
    const sorted = [...t.members].sort((a, b) => b.totalDamage - a.totalDamage);
    sorted.forEach(m => {
      const li = document.createElement('li');
      const isYou = m.handle === state.handle;
      const isInactive = m.active === false;
      li.className = 'party-member' + (isYou ? ' you' : '') + (isInactive ? ' inactive' : '');
      const path = findPath(m.path);
      li.innerHTML = `
        <span class="pm-icon">${path ? path.icon : '👤'}</span>
        <span class="pm-handle">${escapeHtml(m.handle)}<span class="pm-tag">${path ? path.label.toLowerCase() : ''}</span></span>
        <span class="pm-dmg">${m.totalDamage.toLocaleString()} dmg</span>
      `;
      ol.appendChild(li);
    });
    // Update step-out button label
    const me = t.members.find(m => m.handle === state.handle);
    const btn = document.getElementById('stepOutBtn');
    if (me && btn) {
      if (me.active === false) {
        btn.textContent = '↩️ step back in (boss HP scales up)';
      } else {
        btn.textContent = '💤 step out (boss HP shrinks)';
      }
    }
  };

  // Recommended workouts: per class, propose a daily routine to clear in 7 days.
  const renderStrategy = () => {
    const t = state.team;
    if (!t) return;
    const boss = findBoss(t.currentBossIdx);
    if (!boss) return;
    const N = activeMemberCount(t);
    const weeklyShare = boss.hp; // solo per-week share = full solo HP per person
    const dailyShare = Math.ceil(weeklyShare / 7);

    const list = document.getElementById('strategyList');
    list.innerHTML = '';

    // Pick a primary recommended exercise per class — one matching the class's bonusType,
    // chosen to be the most "convenient" common exercise.
    const primary = {
      Lifter:    EXERCISES.find(e => e.id === 'push-up'),
      Runner:    EXERCISES.find(e => e.id === 'run'),
      Grinder:   EXERCISES.find(e => e.id === 'hiit'),
      Flow:      EXERCISES.find(e => e.id === 'yoga'),
      Generalist: EXERCISES.find(e => e.id === 'walk'),
    };

    PATHS.forEach(p => {
      const ex = primary[p.id];
      if (!ex) return;
      // Effective damage per unit:
      let mult = 1;
      if (p.bonusType === 'all' && p.flatMultiplier) mult = p.flatMultiplier;
      else if (p.bonusType === ex.type) mult = 1.5;
      if (boss.weakness === p.id) mult *= 1.5;
      const dmgPerUnit = ex.damagePerUnit * mult;
      const unitsNeeded = Math.max(1, Math.ceil(dailyShare / dmgPerUnit));
      const totalDmg = Math.round(unitsNeeded * dmgPerUnit);
      const isWeak = boss.weakness === p.id;
      const li = document.createElement('li');
      li.className = 'strategy-row' + (isWeak ? ' weak' : '');
      li.innerHTML = `
        <span class="sr-icon">${p.icon}</span>
        <span>
          <span class="sr-class">${p.label}${isWeak ? ' ⭐ (boss weakness)' : ''}</span>
          <div class="sr-rec">${unitsNeeded} ${ex.unit}${unitsNeeded > 1 ? 's' : ''} of ${ex.label.toLowerCase()} / day</div>
        </span>
        <span class="sr-dmg">${totalDmg.toLocaleString()} dmg/day</span>
      `;
      list.appendChild(li);
    });

    // Note about team scaling
    const note = document.getElementById('strategyNote');
    note.textContent = N === 1
      ? 'solo player. these numbers clear the boss in ~7 days.'
      : `team of ${N} active. each member's daily share — clear in ~7 days.`;
  };

  const renderLog = () => {
    const t = state.team;
    if (!t) return;
    const ol = document.getElementById('logFeed');
    ol.innerHTML = '';
    t.log.slice(0, 30).forEach(entry => {
      const li = document.createElement('li');
      const ex = findExercise(entry.exerciseId);
      const exName = ex ? ex.label.toLowerCase() : entry.exerciseId;
      const action = entry.defeated
        ? `<span class="killshot">KO'd ${escapeHtml(entry.bossName)}</span>`
        : `${entry.amount} ${ex ? ex.unit : ''} ${exName} → <span class="dmg">${entry.damage} dmg</span>`;
      li.innerHTML = `<span class="who">${escapeHtml(entry.handle)}</span>: ${action}`;
      ol.appendChild(li);
    });
  };

  const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));

  const renderAll = () => {
    renderBoss();
    renderLadder();
    renderParty();
    renderLog();
    renderStrategy();
    checkWin();
  };

  const checkWin = () => {
    const t = state.team;
    if (!t) return;
    const isLastBossDead = t.currentBossIdx === BOSSES.length - 1 && t.currentBossHp <= 0;
    if (isLastBossDead) {
      const me = t.members.find(m => m.handle === state.handle);
      document.getElementById('winDamage').textContent = me ? me.totalDamage.toLocaleString() : '0';
      document.getElementById('winOverlay').hidden = false;
    } else {
      document.getElementById('winOverlay').hidden = true;
    }
  };

  // ===== flow =====
  const showOnboard = (mode) => {
    document.getElementById('onboard').hidden = false;
    document.getElementById('game').hidden = true;
    document.getElementById('newTeamCard').hidden = mode !== 'new';
    document.getElementById('joinTeamCard').hidden = mode !== 'join';
  };
  const showGame = () => {
    document.getElementById('onboard').hidden = true;
    document.getElementById('game').hidden = false;
    renderAll();
  };

  const refresh = async () => {
    if (!state.teamId) return;
    try {
      const { team } = await api('get', { teamId: state.teamId });
      state.team = team;
      renderAll();
    } catch (e) {
      console.warn('refresh failed', e);
    }
  };

  const startPolling = () => {
    if (state.pollHandle) clearInterval(state.pollHandle);
    state.pollHandle = setInterval(refresh, 8000);
  };

  // ===== boot =====
  const boot = async () => {
    const teamId = getTeamId();
    if (!teamId) { showOnboard('new'); return; }

    state.teamId = teamId;
    let team;
    try {
      ({ team } = await api('get', { teamId }));
    } catch (e) {
      showOnboard('new');
      return;
    }
    state.team = team;

    // Already joined?
    const me = loadMe(teamId);
    if (me && team.members.find(m => m.handle === me.handle)) {
      state.handle = me.handle;
      state.path = me.path;
      document.getElementById('pathSelect').value = me.path;
      showGame();
      startPolling();
      return;
    }

    showOnboard('join');
  };

  // ===== event wiring =====
  document.getElementById('createTeamBtn').addEventListener('click', async () => {
    const btn = document.getElementById('createTeamBtn');
    btn.disabled = true;
    btn.textContent = 'creating…';
    try {
      const { teamId } = await api('create');
      setTeamUrl(teamId);
      state.teamId = teamId;
      const { team } = await api('get', { teamId });
      state.team = team;
      showOnboard('join');
    } catch (e) {
      btn.disabled = false;
      btn.textContent = '+ start a team';
      alert(e.message || 'failed');
    }
  });

  document.getElementById('joinForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const handle = document.getElementById('joinHandle').value.trim();
    const path = document.getElementById('joinPath').value;
    const status = document.getElementById('onboardStatus');
    status.className = 'onboard-status';
    status.textContent = '';
    if (!handle) { status.textContent = 'handle required'; return; }
    try {
      const { team } = await api('join', { teamId: state.teamId, handle, path });
      state.team = team;
      state.handle = handle;
      state.path = path;
      saveMe(state.teamId, handle, path);
      document.getElementById('pathSelect').value = path;
      showGame();
      startPolling();
    } catch (err) {
      status.className = 'onboard-status';
      status.textContent = err.message || 'failed to join';
    }
  });

  document.getElementById('logForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const exerciseId = document.getElementById('logExercise').value;
    const amount = parseInt(document.getElementById('logAmount').value, 10);
    const status = document.getElementById('logStatus');
    status.className = 'log-status';
    status.textContent = '';
    if (!Number.isFinite(amount) || amount <= 0) {
      status.className = 'log-status err';
      status.textContent = 'amount must be a positive number';
      return;
    }
    const btn = document.getElementById('logBtn');
    btn.disabled = true;
    btn.textContent = 'dealing…';
    try {
      const { team, dealt, calc, hitLine, defeated, advancedBoss } = await api('log', {
        teamId: state.teamId, handle: state.handle, exerciseId, amount,
      });
      state.team = team;
      // Fire HP shake animation
      const hpFill = document.getElementById('hpFill');
      hpFill.classList.remove('shake');
      void hpFill.offsetWidth; // restart
      hpFill.classList.add('shake');
      // Damage juice: floating hit number + boss flash
      if (dealt > 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const card = document.querySelector('.boss-card');
        if (card) {
          const float = document.createElement('span');
          float.className = 'dmg-float';
          float.textContent = `-${dealt}`;
          card.appendChild(float);
          card.classList.remove('hit');
          void card.offsetWidth;
          card.classList.add('hit');
          setTimeout(() => { float.remove(); card.classList.remove('hit'); }, 950);
        }
      }
      // Quip
      document.getElementById('bossQuip').textContent = defeated
        ? (team.log[0]?.bossName ? `${team.log[0].bossName} defeated!` : 'defeated!')
        : (hitLine || '...');
      const multiNote = (calc.classMult > 1 || calc.bossMult > 1)
        ? ` (×${(calc.classMult * calc.bossMult).toFixed(2)} multiplier)`
        : '';
      status.className = 'log-status ok';
      status.textContent = defeated
        ? `${dealt} dmg — boss down! climbing…`
        : `${dealt} dmg dealt${multiNote}`;
      renderAll();
      document.getElementById('logAmount').value = '';
    } catch (err) {
      status.className = 'log-status err';
      status.textContent = err.message || 'log failed';
    } finally {
      btn.disabled = false;
      btn.textContent = 'deal damage';
    }
  });

  document.getElementById('pathSelect').addEventListener('change', async (e) => {
    const newPath = e.target.value;
    if (!state.teamId || !state.handle) return;
    try {
      const { team } = await api('join', { teamId: state.teamId, handle: state.handle, path: newPath });
      state.team = team;
      state.path = newPath;
      saveMe(state.teamId, state.handle, newPath);
      renderAll();
    } catch (err) {
      console.warn('path switch failed', err);
    }
  });

  document.getElementById('copyJoinBtn').addEventListener('click', async () => {
    const url = location.href;
    try {
      await navigator.clipboard.writeText(url);
      const b = document.getElementById('copyJoinBtn');
      const orig = b.textContent;
      b.textContent = 'copied ✓';
      setTimeout(() => { b.textContent = orig; }, 1500);
    } catch {
      prompt('copy this URL:', url);
    }
  });

  document.getElementById('winRestart').addEventListener('click', () => {
    document.getElementById('winOverlay').hidden = true;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Step out / step back in toggle.
  document.getElementById('stepOutBtn').addEventListener('click', async () => {
    if (!state.handle) return;
    const me = state.team?.members.find(m => m.handle === state.handle);
    const action = me?.active === false ? 'step_in' : 'step_out';
    const btn = document.getElementById('stepOutBtn');
    btn.disabled = true;
    try {
      const { team } = await api(action, { teamId: state.teamId, handle: state.handle });
      state.team = team;
      renderAll();
    } catch (e) {
      console.warn('step toggle failed', e);
    } finally {
      btn.disabled = false;
    }
  });

  // ===== 8-bit BGM (Web Audio, square+triangle, looping cheerful melody) =====
  const bgm = (() => {
    let ctx = null;
    let masterGain = null;
    let timer = null;
    let started = false;
    let stepIdx = 0;

    // 4-bar cheerful loop in C major (I-IV-V-I), 16 sixteenth-note steps per bar.
    // Lead pattern (frequencies in Hz, 0 = rest):
    const C5=523.25, D5=587.33, E5=659.25, F5=698.46, G5=783.99, A5=880.00, B5=987.77, C6=1046.50, D6=1174.66;
    const lead = [
      // bar 1: C major arp + neighbour
      C5, E5, G5, C6,  G5, E5, C5, E5,  G5, E5, C5, E5,  G5, A5, G5, E5,
      // bar 2: F major
      F5, A5, C6, F5,  C6, A5, F5, A5,  G5, F5, E5, F5,  A5, G5, F5, D5,
      // bar 3: G major
      G5, B5, D6, G5,  D6, B5, G5, B5,  A5, G5, F5, E5,  D5, E5, F5, G5,
      // bar 4: back to C
      C5, E5, G5, C6,  G5, E5, C5, E5,  G5, E5, D5, E5,  G5, E5, C5, 0
    ];
    // Bass: root notes per bar
    const C3=130.81, F3=174.61, G3=196.00;
    const bass = [
      C3, 0, C3, 0,  C3, 0, C3, 0,  C3, 0, C3, 0,  C3, 0, C3, 0,
      F3, 0, F3, 0,  F3, 0, F3, 0,  F3, 0, F3, 0,  F3, 0, F3, 0,
      G3, 0, G3, 0,  G3, 0, G3, 0,  G3, 0, G3, 0,  G3, 0, G3, 0,
      C3, 0, C3, 0,  C3, 0, C3, 0,  C3, 0, C3, 0,  C3, 0, C3, 0,
    ];

    const STEP_MS = 130; // ~115 BPM

    const playNote = (freq, type, gain, durMs) => {
      if (!freq || !ctx || !masterGain) return;
      const osc = ctx.createOscillator();
      osc.type = type;
      osc.frequency.value = freq;
      const g = ctx.createGain();
      const now = ctx.currentTime;
      g.gain.setValueAtTime(gain, now);
      // Chiptune-y AR envelope: short release
      g.gain.linearRampToValueAtTime(0, now + durMs / 1000 * 0.95);
      osc.connect(g).connect(masterGain);
      osc.start(now);
      osc.stop(now + durMs / 1000);
    };

    const tick = () => {
      const leadFreq = lead[stepIdx % lead.length];
      const bassFreq = bass[stepIdx % bass.length];
      playNote(leadFreq, 'square', 0.08, STEP_MS);
      playNote(bassFreq, 'triangle', 0.18, STEP_MS * 1.4);
      stepIdx = (stepIdx + 1) % lead.length;
    };

    const start = () => {
      if (started) return;
      ctx = new (window.AudioContext || window.webkitAudioContext)();
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.18;
      masterGain.connect(ctx.destination);
      started = true;
      stepIdx = 0;
      tick();
      timer = setInterval(tick, STEP_MS);
    };

    const stop = () => {
      if (!started) return;
      clearInterval(timer);
      timer = null;
      try { ctx.close(); } catch {}
      ctx = null;
      masterGain = null;
      started = false;
    };

    const isOn = () => started;

    return { start, stop, isOn };
  })();

  // BGM toggle wiring
  const bgmBtn = document.getElementById('bgmToggle');
  const bgmIcon = document.getElementById('bgmIcon');
  const bgmLabel = document.getElementById('bgmLabel');

  // Restore preference
  const BGM_KEY = 'cl.bgm';
  const setBgmUI = (on) => {
    bgmBtn.classList.toggle('on', on);
    bgmBtn.setAttribute('aria-pressed', String(on));
    bgmIcon.textContent = on ? '🔊' : '🔇';
    bgmLabel.textContent = on ? 'music on' : 'music off';
  };

  bgmBtn.addEventListener('click', () => {
    if (bgm.isOn()) {
      bgm.stop();
      try { localStorage.setItem(BGM_KEY, '0'); } catch {}
      setBgmUI(false);
    } else {
      bgm.start();
      try { localStorage.setItem(BGM_KEY, '1'); } catch {}
      setBgmUI(true);
    }
  });

  // Auto-pause when tab is hidden, resume on focus if previously on.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && bgm.isOn()) {
      bgm.stop();
      // mark as "want on" so we resume; UI keeps 'on' state
    } else if (!document.hidden && bgmBtn.classList.contains('on') && !bgm.isOn()) {
      bgm.start();
    }
  }, { signal });

  // Initial UI: restore the saved preference visually; actual playback waits
  // for the first tap (browsers block autoplay), same pattern as papercut.
  setBgmUI(false);
  try {
    if (localStorage.getItem(BGM_KEY) === '1') {
      setBgmUI(true);
      window.addEventListener('pointerdown', () => {
        if (bgmBtn.classList.contains('on') && !bgm.isOn()) bgm.start();
      }, { once: true, signal });
    }
  } catch {}

  // bfcache restores can come back with a stale win overlay or stale team
  // state — hide the overlay and pull fresh state.
  window.addEventListener('pageshow', (e) => {
    if (!(e as PageTransitionEvent).persisted) return;
    const overlay = document.getElementById('winOverlay');
    if (overlay) overlay.hidden = true;
    refresh();
  }, { signal });

  clTeardown = () => {
    if (state.pollHandle) clearInterval(state.pollHandle);
    bgm.stop();
    clTeardown = null;
  };

  boot();
  };

  document.addEventListener('astro:page-load', initLadder);
  document.addEventListener('astro:before-swap', () => {
    clTeardown?.();
    clAbort?.abort();
  });
</script>
