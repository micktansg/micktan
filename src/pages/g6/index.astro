---
// /g6 — private in-car page for Mick's XPeng G6 Pro. Not in the hall, not in
// the circuit, noindex. One glanceable panel (temperature, feels-like,
// humidity, 2-hour forecast, next 6 hours, PSI + PM2.5 for where the car is,
// one card — a joke / word / quote) and two big buttons: an in-page forecast
// sheet (rain radar, 24 h, 4 days) and the LTA checkpoint cameras.
//
// Design rules: zero taps needed while moving, big type that still fits one
// screen without scrolling, auto day/night, refreshes itself every minute.
// Location comes from the car browser's GPS (confirmed working 1 Nov 2026);
// if that's refused, the API falls back to a coarse IP fix.
//
// Look: borrowed from XPeng's own screens (and xp.leung.xin) — Inter, deep
// navy, three slow-drifting colour fields in the logo's teal / violet / amber.
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="g6."
  description="private in-car panel."
  themeColor="#0a0e17"
  bg="#0a0e17"
  noindex
  noBob
>
  {/* Inter isn't in the site-wide Layout (Lora everywhere else). Body-level
      stylesheet links are valid HTML; the preconnects are already in <head>. */}
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet"
  />

  <main class="g6" id="g6" data-theme="night">
    <div class="sky" aria-hidden="true">
      <i class="blob b1"></i>
      <i class="blob b2"></i>
      <i class="blob b3"></i>
    </div>

    {/* Top-right: re-fix GPS + refetch everything + deal a new card. */}
    <button class="pill refresh-all" id="refreshAll" type="button" aria-label="refresh location and weather">
      <span aria-hidden="true">↻</span>
    </button>

    <section class="now" aria-live="polite" aria-atomic="true">
      <div class="col col-a">
        <p class="where"><span id="area">locating</span><span class="dot" id="locdot" aria-hidden="true"></span></p>
        <p class="forecast" id="forecast">&nbsp;</p>

        <p class="temp"><span id="temp">--</span><span class="unit">°</span></p>
        <p class="feels">
          <span>feels <strong id="feels">--</strong>°</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>humidity <strong id="hum">--</strong>%</span>
        </p>

        <ol class="hours" id="hours" aria-label="next 6 hours"></ol>
      </div>

      <div class="col col-b">
        <div class="air" id="air" data-band="">
          <p class="air-num"><strong id="psi">--</strong> <span class="air-lbl">PSI</span></p>
          <p class="air-band" id="psiband">&nbsp;</p>
          <p class="air-sub">PM2.5 <strong id="pm25">--</strong> µg/m³ · <span id="pm25band">&nbsp;</span> · <span id="region">&nbsp;</span></p>
        </div>

        <div class="card" id="card" data-kind="">
          <p class="card-kind" id="cardKind">&nbsp;</p>
          <p class="card-body" id="cardBody">&nbsp;</p>
          <p class="card-by" id="cardBy"></p>
        </div>
      </div>
    </section>

    <div class="actions">
      <button class="big" id="openForecast" type="button">
        <span>forecast</span>
        <span class="arrow" aria-hidden="true">→</span>
      </button>
      <button class="big" id="openCauseway" type="button">
        <span>causeway cam</span>
        <span class="arrow" aria-hidden="true">→</span>
      </button>
    </div>

    <footer class="foot">
      <button class="diag-toggle" id="diagToggle" type="button" aria-expanded="false" aria-controls="diag">
        <span id="status">starting</span>
      </button>
      <pre class="diag" id="diag" hidden></pre>
    </footer>

    {/* ── forecast sheet: rain radar + 24 h + 4 days, all from the same feed ── */}
    <div class="sheet" id="fsheet" hidden role="dialog" aria-modal="true" aria-label="Forecast">
      <div class="sheet-bar">
        <p class="sheet-title">forecast <span class="sheet-ts" id="fcTs"></span></p>
        <div class="sheet-actions">
          <button class="back refresh" id="refreshFc" type="button" aria-label="refresh forecast">
            <span aria-hidden="true">↻</span>
          </button>
          <button class="back" id="closeForecast" type="button" aria-label="back">
            <span aria-hidden="true">←</span>
          </button>
        </div>
      </div>
      <div class="fc">
        <figure class="radar">
          <div class="radar-box">
            <img class="radar-base" src="https://www.weather.gov.sg/wp-content/themes/wiptheme/assets/img/base-853.png" alt="" width="853" height="479" decoding="async" />
            <img class="radar-rain" id="radarImg" alt="rain radar overlay" width="853" height="479" decoding="async" />
            <span class="radar-you" id="radarYou" hidden aria-hidden="true"></span>
          </div>
          <figcaption>rain radar <span id="radarTs">—</span> · 50 km · <span class="legend">light <i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> heavy</span><span id="radarNote"></span></figcaption>
        </figure>
        <div class="fc-text">
          <section class="fc-24">
            <h2 id="fc24Head">next 24 hours</h2>
            <div class="fc-head">
              <span class="fc-glyph" id="fc24Glyph" aria-hidden="true"></span>
              <p class="fc-big" id="fc24Text">—</p>
              <p class="fc-range" id="fc24Range"></p>
            </div>
            <ol class="fc-tiles" id="fcPeriods" aria-label="forecast by period"></ol>
            <dl class="fc-chips" id="fcChips"></dl>
          </section>
          <section class="fc-4">
            <h2>next 4 days</h2>
            <ol class="fc-days" id="fcDays"></ol>
          </section>
        </div>
      </div>
      <p class="sheet-more">
        NEA / MSS data via data.gov.sg. Full maps:
        <a href="https://www.weather.gov.sg/weather-rain-area-50km/" target="_blank" rel="noopener">rain areas</a> ·
        <a href="https://www.weather.gov.sg/weather-forecast-24hrforecast/" target="_blank" rel="noopener">24 h</a> ·
        <a href="https://www.weather.gov.sg/weather-forecast-4dayoutlook/" target="_blank" rel="noopener">4 days</a>
      </p>
    </div>

    {/* ── checkpoint cams sheet ── */}
    <div class="sheet" id="sheet" hidden role="dialog" aria-modal="true" aria-label="Checkpoint cameras">
      <div class="sheet-bar">
        <p class="sheet-title">checkpoint cams <span class="sheet-ts" id="camTs"></span></p>
        <div class="sheet-actions">
          <button class="back refresh" id="refreshCams" type="button" aria-label="refresh cameras">
            <span aria-hidden="true">↻</span>
          </button>
          <button class="back" id="closeCauseway" type="button" aria-label="back">
            <span aria-hidden="true">←</span>
          </button>
        </div>
      </div>
      <div class="cams" id="cams"></div>
      <p class="sheet-more">
        JB side + wait charts: <a href="https://www.checkpoint.sg/" target="_blank" rel="noopener">checkpoint.sg</a>
        · LTA cameras via data.gov.sg, refreshed every minute while open.
      </p>
    </div>
  </main>

  <style>
    .g6 {
      /* night: XPeng's deep navy rather than flat black */
      --bg: #0a0e17;
      --ink: #eef1f6;
      --mute: rgba(238, 241, 246, 0.55);
      --line: rgba(238, 241, 246, 0.14);
      --band: var(--mute);
      --sky: 0.55;
      --teal: #2fd3a6;
      --violet: #7c6cf2;
      --amber: #e8a24a;

      position: relative;
      isolation: isolate;
      min-height: 100vh;
      min-height: 100dvh;
      display: grid;
      grid-template-rows: 1fr auto auto;
      gap: 2vh;
      padding: 3vh 5vw 1.5vh;
      background: var(--bg);
      color: var(--ink);
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      font-weight: 400;
      font-feature-settings: 'tnum' 1, 'cv11' 1;
      letter-spacing: -0.005em;
      transition: background 600ms ease, color 600ms ease;
    }
    .g6[data-theme='day'] {
      --bg: #f3f4f7;
      --ink: #121722;
      --mute: rgba(18, 23, 34, 0.55);
      --line: rgba(18, 23, 34, 0.12);
      --sky: 0.42;
    }

    /* Breathing background: three soft colour fields drifting on long,
       out-of-phase loops. Transform-only animation (GPU) — no blur filter,
       the gradients are already soft, so the car's chip isn't asked to
       re-rasterise 80px blurs sixty times a second. */
    .sky {
      position: absolute; inset: 0; z-index: -1; overflow: hidden;
      pointer-events: none; opacity: var(--sky);
      transition: opacity 600ms ease;
    }
    .blob {
      position: absolute; display: block; border-radius: 50%;
      width: 90vmax; height: 90vmax;
      will-change: transform, opacity;
      animation: drift 22s ease-in-out infinite alternate, breathe 9s ease-in-out infinite;
    }
    .b1 {
      left: -35vmax; top: -30vmax;
      background: radial-gradient(circle at center, var(--teal) 0%, rgba(47, 211, 166, 0) 60%);
    }
    .b2 {
      right: -40vmax; top: 10vmax;
      background: radial-gradient(circle at center, var(--violet) 0%, rgba(124, 108, 242, 0) 60%);
      animation-duration: 29s, 11s; animation-delay: -12s, -4s;
    }
    .b3 {
      left: -10vmax; bottom: -45vmax;
      background: radial-gradient(circle at center, var(--amber) 0%, rgba(232, 162, 74, 0) 60%);
      animation-duration: 37s, 13s; animation-delay: -23s, -7s;
    }
    @keyframes drift {
      0%   { transform: translate3d(0, 0, 0) scale(1); }
      33%  { transform: translate3d(18vmax, 10vmax, 0) scale(1.2); }
      66%  { transform: translate3d(-10vmax, 20vmax, 0) scale(0.85); }
      100% { transform: translate3d(22vmax, -12vmax, 0) scale(1.15); }
    }
    @keyframes breathe {
      0%, 100% { opacity: 0.7; }
      50%      { opacity: 1; }
    }

    /* Round pill buttons (refresh / back) — 72px tall, car-finger sized. */
    .pill, .back {
      appearance: none; border: 1px solid var(--line); background: rgba(127, 127, 127, 0.06); color: var(--ink);
      min-width: 88px; height: 72px; padding: 0 1.4rem; border-radius: 999px;
      font: inherit; font-size: 2.2rem; font-weight: 300; line-height: 1; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    }
    .pill:active, .back:active { background: var(--line); }
    .refresh-all { position: absolute; top: 3vh; right: 5vw; z-index: 2; }
    .refresh span, .refresh-all span { display: inline-block; }
    .refresh.busy span, .refresh-all.busy span { animation: spin 900ms linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── the Now panel ───────────────────────────────────────────────── */
    .now { display: flex; flex-direction: column; justify-content: center; gap: 3vh; }
    .col-a { padding-right: 100px; } /* keep the location line clear of the ↻ */
    .where {
      display: flex; align-items: center; gap: 0.6rem;
      font-size: clamp(1.2rem, 3.2vmin, 2.2rem);
      font-weight: 500; letter-spacing: -0.01em;
    }
    .dot {
      width: 0.5em; height: 0.5em; border-radius: 50%;
      background: var(--mute); opacity: 0.5;
    }
    .dot[data-src='gps'] { background: var(--teal); opacity: 1; }
    .dot[data-src='ip'] { background: var(--amber); opacity: 1; }
    .forecast {
      font-size: clamp(1.1rem, 3vmin, 2rem);
      font-weight: 300; color: var(--mute); margin-top: 0.2em;
    }
    .temp {
      margin-top: 1vh;
      font-size: clamp(4.5rem, 20vmin, 13rem);
      line-height: 0.92; font-weight: 300; letter-spacing: -0.05em;
    }
    .unit { font-size: 0.42em; vertical-align: top; margin-left: 0.04em; opacity: 0.55; font-weight: 300; }
    .feels {
      margin-top: 1vh;
      font-size: clamp(1.15rem, 3.3vmin, 2.2rem);
      font-weight: 300; color: var(--mute);
      display: flex; flex-wrap: wrap; gap: 0 0.6em;
    }
    .feels strong { color: var(--ink); font-weight: 400; }

    /* 6-hour strip: one column per hour, glyph / temp / rain chance. */
    .hours {
      list-style: none; margin-top: 2.5vh;
      /* Columns size to their content and huddle left, instead of being
         spread across the full width. */
      display: grid; grid-template-columns: repeat(6, minmax(0, 4.2em)); gap: 0.35em;
      justify-content: start;
      font-size: clamp(0.95rem, 2.6vmin, 1.6rem); font-weight: 300; color: var(--mute);
      text-align: center; font-variant-numeric: tabular-nums;
    }
    :global(.hours li) { display: grid; gap: 0.2em; min-width: 0; }
    :global(.hours .h-t) { font-size: 0.85em; letter-spacing: 0.02em; }
    :global(.hours .h-g) { font-size: 1.5em; line-height: 1.2; }
    :global(.hours .h-c) { color: var(--ink); font-weight: 400; }
    :global(.hours .h-p) { font-size: 0.85em; opacity: 0.6; }
    :global(.hours .h-p.wet) { color: #6aa9ef; opacity: 1; }
    :global(.hours li.now-ish .h-t) { color: var(--ink); }

    .air { padding-top: 2.5vh; border-top: 1px solid var(--line); }
    .air-num {
      font-size: clamp(2.6rem, 9vmin, 6rem);
      line-height: 1; font-weight: 300; letter-spacing: -0.04em;
    }
    .air-num strong { font-weight: 300; }
    .air-lbl { font-size: 0.3em; letter-spacing: 0.14em; opacity: 0.55; font-weight: 400; }
    .air-band {
      font-size: clamp(1.25rem, 3.8vmin, 2.5rem);
      font-weight: 400; color: var(--band); margin-top: 0.15em; letter-spacing: -0.01em;
    }
    .air-sub { margin-top: 0.5em; font-size: clamp(1rem, 2.7vmin, 1.6rem); font-weight: 300; color: var(--mute); }
    .air-sub strong { color: var(--ink); font-weight: 400; }
    /* NEA colour language, tuned to the palette. */
    .air[data-band='good'] { --band: var(--teal); }
    .air[data-band='moderate'] { --band: #6aa9ef; }
    .air[data-band='unhealthy'] { --band: var(--amber); }
    .air[data-band='very unhealthy'] { --band: #ef7a52; }
    .air[data-band='hazardous'] { --band: #e04a4a; }

    /* The card: one joke / word / quote per load or manual refresh. */
    .card {
      margin-top: 3vh; padding-top: 2.5vh; border-top: 1px solid var(--line);
      font-size: clamp(1.05rem, 3vmin, 1.9rem); font-weight: 300; line-height: 1.35;
      max-width: 34em;
      /* Swaps every 15 min on the clock behind a slow cross-fade — nothing
         that would pull a glance. */
      transition: opacity 1500ms ease;
    }
    .card.fading { opacity: 0; }
    .card-kind { font-size: 0.7em; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute); margin-bottom: 0.5em; }
    .card-body { color: var(--ink); }
    :global(.card-body .w) { font-weight: 500; }
    :global(.card-body .pos) { color: var(--mute); font-style: italic; margin: 0 0.3em; }
    :global(.card-body .punch) { display: block; color: var(--mute); margin-top: 0.3em; }
    .card-by { color: var(--mute); margin-top: 0.45em; font-size: 0.82em; }
    .card-by:empty { display: none; }

    /* ── the two big buttons ─────────────────────────────────────────── */
    .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .big {
      appearance: none; border: 1px solid var(--line); background: rgba(127, 127, 127, 0.06);
      color: var(--ink); font: inherit; cursor: pointer;
      min-height: 64px; padding: 1.8vh 4vw; border-radius: 1.4rem;
      display: flex; justify-content: space-between; align-items: center; gap: 0.5em;
      font-size: clamp(1.25rem, 3.8vmin, 2.6rem); font-weight: 400; letter-spacing: -0.01em;
      -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
      transition: background 160ms ease;
    }
    .big:active { background: var(--line); }
    .arrow { opacity: 0.55; font-weight: 300; }

    .foot { display: flex; flex-direction: column; gap: 0.6rem; }
    .diag-toggle {
      appearance: none; border: 0; background: transparent; color: var(--mute);
      font: inherit; font-weight: 300; font-size: clamp(0.9rem, 2.2vmin, 1.3rem); text-align: left;
      min-height: 44px; padding: 0.4rem 0; cursor: pointer;
    }
    .diag {
      font: 0.85rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--mute); white-space: pre-wrap; word-break: break-all;
      padding: 0.8rem; border: 1px solid var(--line); border-radius: 0.6rem;
    }

    /* Landscape (the car's screen): two columns so nothing needs scrolling. */
    @media (orientation: landscape) and (min-width: 720px) {
      .now { display: grid; grid-template-columns: 1.15fr 1fr; column-gap: 6vw; align-items: center; }
      .col-a { padding-right: 0; }
      .col-b { padding-right: 100px; }
      .air { padding-top: 0; border-top: 0; }
    }
    @media (orientation: landscape) and (max-width: 719px) {
      .temp { font-size: clamp(3.5rem, 18vmin, 8rem); }
    }

    /* ── sheets ─────────────────────────────────────────────────────── */
    .sheet {
      position: fixed; inset: 0; z-index: 50;
      background: var(--bg); color: var(--ink);
      display: flex; flex-direction: column;
      padding: 2vh 4vw 3vh; overflow-y: auto;
    }
    .sheet[hidden] { display: none !important; }
    .sheet-bar { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; margin-bottom: 1.5vh; }
    .sheet-title { font-size: clamp(1.4rem, 4vmin, 2.6rem); font-weight: 400; letter-spacing: -0.01em; }
    .sheet-ts { font-size: 0.6em; color: var(--mute); margin-left: 0.6em; font-weight: 300; }
    .sheet-actions { display: flex; gap: 0.8rem; flex-shrink: 0; }
    .sheet-more { margin-top: 2vh; font-size: clamp(0.95rem, 2.6vmin, 1.5rem); font-weight: 300; color: var(--mute); }
    .sheet-more a { color: var(--ink); }

    /* forecast sheet */
    .fc { display: grid; gap: 3vh; }
    .radar { margin: 0; }
    .radar-box {
      position: relative; width: 100%; aspect-ratio: 853 / 479;
      border-radius: 1rem; overflow: hidden; background: #dfe6ea;
    }
    .radar-box img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .radar-rain { opacity: 0.7; }
    .g6[data-theme='night'] .radar-base { filter: brightness(0.82); }
    /* "You are here": hot pink — the one colour neither the radar (blue →
       red) nor the grey base map uses — white ring, dark halo, radiating
       rings. No label (Mick, 1 Nov: the rings say it). Sized against the
       map so it stays visible on the car's big screen. */
    .radar-you {
      --pin: #ff2d95;
      position: absolute; width: 2.2%; aspect-ratio: 1; min-width: 14px;
      transform: translate(-50%, -50%); border-radius: 50%;
      background: var(--pin); border: 2px solid #fff;
      box-shadow: 0 0 0 1.5px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 0, 0, 0.45);
    }
    .radar-you::before, .radar-you::after {
      content: ''; position: absolute; inset: -2px; border-radius: 50%;
      border: 2.5px solid var(--pin); opacity: 0;
      animation: ping 2.6s ease-out infinite;
    }
    .radar-you::after { animation-delay: -1.3s; }
    @keyframes ping {
      0%   { transform: scale(1); opacity: 0.9; }
      100% { transform: scale(4); opacity: 0; }
    }
    .radar figcaption { margin-top: 0.6rem; font-size: clamp(0.95rem, 2.6vmin, 1.5rem); font-weight: 300; color: var(--mute); }
    .legend i { display: inline-block; width: 1em; height: 0.6em; margin: 0 1px; vertical-align: middle; border-radius: 2px; }
    .legend .l1 { background: #5ac8fa; } .legend .l2 { background: #2fbf5a; } .legend .l3 { background: #f2d43b; } .legend .l4 { background: #e04a4a; }

    .fc-text { display: grid; gap: 3vh; align-content: start; }
    .fc h2 { font-size: clamp(0.95rem, 2.6vmin, 1.5rem); font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); margin-bottom: 0.6em; }
    /* Headline: glyph · forecast · temperature range — same grammar as the
       main page (picture, then number, then word). */
    .fc-head { display: flex; align-items: center; gap: 0.3em 0.6em; flex-wrap: wrap; }
    .fc-glyph { font-size: clamp(2.2rem, 7vmin, 4.6rem); line-height: 1; color: var(--mute); }
    .fc-big { flex: 1 1 auto; font-size: clamp(1.8rem, 6vmin, 4rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.1; }
    .fc-range { font-size: clamp(1.8rem, 6vmin, 4rem); font-weight: 300; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    /* Three period tiles (night / morning / afternoon), the current one lit. */
    .fc-tiles {
      list-style: none; margin-top: 1.5vh;
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem;
    }
    :global(.fc-tiles li) {
      border: 1px solid var(--line); border-radius: 1rem; padding: 1.2vh 0.5em;
      text-align: center; color: var(--mute); font-weight: 300;
      font-size: clamp(1rem, 2.8vmin, 1.7rem); min-width: 0;
    }
    :global(.fc-tiles li.on) { color: var(--ink); border-color: var(--ink); background: rgba(127, 127, 127, 0.07); }
    :global(.fc-tiles .t-name) { display: block; font-weight: 500; font-size: 0.85em; }
    :global(.fc-tiles .t-when) { display: block; font-size: 0.72em; opacity: 0.75; margin-top: 0.1em; }
    :global(.fc-tiles .t-g) { display: block; font-size: 2.2em; line-height: 1.15; margin: 0.1em 0; }
    :global(.fc-tiles .t-text) { display: block; line-height: 1.2; }
    /* Small facts as label-over-number chips, like the PM2.5 line. */
    .fc-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; margin-top: 1.5vh; }
    :global(.fc-chips dt) { font-size: clamp(0.75rem, 2vmin, 1.1rem); letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); }
    :global(.fc-chips dd) { font-size: clamp(1.1rem, 3.2vmin, 2rem); font-weight: 300; margin-top: 0.15em; white-space: nowrap; }
    .fc-days { list-style: none; margin-top: 1.2vh; }
    :global(.fc-days li) {
      display: grid; grid-template-columns: 3.2em 1.6em 1fr auto; gap: 0.8em; align-items: center;
      padding: 0.5em 0; border-top: 1px solid var(--line);
      font-size: clamp(1.1rem, 3.2vmin, 2rem); font-weight: 300;
    }
    :global(.fc-days .d-day) { color: var(--mute); font-size: 0.85em; }
    :global(.fc-days .d-g) { font-size: 1.4em; line-height: 1; color: var(--mute); text-align: center; }
    :global(.fc-days .d-text) { color: var(--ink); }
    :global(.fc-days .d-t) { color: var(--mute); font-variant-numeric: tabular-nums; }
    @media (orientation: landscape) and (min-width: 900px) {
      /* radar + 4 days on the left, the 24-hour block on the right — one
         screen, no scrolling. */
      .fc { grid-template-columns: 1fr 1.1fr; grid-template-rows: auto 1fr; column-gap: 4vw; row-gap: 2vh; }
      .fc-text { display: contents; }
      .radar { grid-column: 1; grid-row: 1; }
      .fc-4 { grid-column: 1; grid-row: 2; }
      .fc-24 { grid-column: 2; grid-row: 1 / span 2; }
      /* Cap the radar at 40% of the height so four day rows fit beneath. */
      .radar { max-width: calc(40vh * 853 / 479); }
      :global(.fc-days li) { padding: 0.35em 0; font-size: clamp(1rem, 2.7vmin, 1.7rem); }
    }

    /* cams sheet */
    .cams.busy { opacity: 0.45; transition: opacity 200ms ease; }
    .cams { transition: opacity 300ms ease; }
    .cams { display: grid; gap: 2vh; }
    /* Cam figures are created by JS → need :global (see project gotchas). */
    :global(.cam) { display: block; }
    :global(.cam img) {
      display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
      border-radius: 1rem; background: var(--line);
    }
    :global(.cam figcaption) { margin-top: 0.5rem; font-size: clamp(1rem, 3vmin, 1.8rem); font-weight: 300; color: var(--mute); }
    :global(.cam figcaption b) { color: var(--ink); font-weight: 400; }
    :global(.cam-off img) { opacity: 0.55; filter: saturate(0.4); }
    :global(.cam-off figcaption) { color: var(--amber); }
    @media (orientation: landscape) and (min-width: 900px) {
      .cams { grid-template-columns: 1fr 1fr; column-gap: 3vw; }
    }

    button:focus-visible, a:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; border-radius: 0.4rem; }
    @media (prefers-reduced-motion: reduce) {
      .g6, .big, .sky { transition: none; }
      /* Slow, not still — the brief is a breathing background. */
      .blob { animation-duration: 60s, 20s; }
      .refresh.busy span, .refresh-all.busy span { animation: none; opacity: 0.5; }
      .radar-you::before, .radar-you::after { animation: none; opacity: 0.6; transform: scale(1.8); }
      .card { transition: none; }
    }
  </style>

  <script>
    import { DECK } from '../../data/g6-deck';

    // LTA checkpoint cameras (camera_id → label), via the keyless
    // data.gov.sg v1 traffic-images feed. Order = what you'd want to see first
    // on a Woodlands run, then Tuas.
    const CAMS: [string, string][] = [
      ['2701', 'Woodlands Causeway — towards Johor'],
      ['2702', 'Woodlands Checkpoint — towards BKE'],
      ['2704', 'BKE Woodlands Flyover — approach'],
      ['4713', 'Tuas Checkpoint'],
      ['4703', 'Second Link at Tuas'],
      ['4712', 'Tuas Ave 1 / Tuas West Road — approach'],
    ];

    // WMO weather codes → a glyph. Night variants for clear / partly cloudy.
    const glyph = (code: number | null, day: boolean) => {
      if (code === null) return '·';
      // ︎ = text presentation, so the car doesn't swap in colour emoji.
      if (code === 0) return day ? '☀︎' : '☾︎';
      if (code <= 2) return day ? '⛅︎' : '☁︎';
      if (code === 3) return '☁︎';
      if (code === 45 || code === 48) return '≡';
      if (code <= 57) return '☂︎';
      if (code <= 67 || (code >= 80 && code <= 82)) return '☔︎';
      if (code >= 95) return '⚡︎';
      return '☂︎';
    };

    const NIGHT_BG = '#0a0e17';
    const DAY_BG = '#f3f4f7';

    // NEA's 50 km rain radar: a 5-minute PNG drawn over a fixed base map.
    // Same recipe as weather.gov.sg's own page (base-853.png + overlay).
    const RADAR = 'https://www.weather.gov.sg/files/rainarea/50km/v2/dpsri_70km_';
    // Base map bounds, copied from NEA's own calculatePosition(): the 853×479
    // image spans 1.4572°N → 1.1450°N, 103.565°E → 104.130°E. Used to drop a
    // "you are here" dot on the radar.
    const RADAR_BOUNDS = { top: 1.4572, bottom: 1.145, left: 103.565, right: 104.13 };

    let abort: AbortController | null = null;
    let tick: number | undefined;
    let camTick: number | undefined;
    let radarTick: number | undefined;

    const $ = (id: string) => document.getElementById(id)!;
    const fmt = (v: number | null, d = 0) => (typeof v === 'number' ? v.toFixed(d) : '--');
    const hhmm = (d = new Date()) => d.toLocaleTimeString('en-SG', { hour: '2-digit', minute: '2-digit', hour12: false });
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c);

    const init = () => {
      abort?.abort();
      abort = new AbortController();
      const { signal } = abort;
      const root = $('g6');
      if (!root) return;

      const setTheme = (day: boolean) => {
        root.dataset.theme = day ? 'day' : 'night';
        document.documentElement.style.setProperty('--page-bg', day ? DAY_BG : NIGHT_BG);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', day ? DAY_BG : NIGHT_BG);
      };

      const diag: Record<string, string> = {
        ua: navigator.userAgent,
        viewport: `${innerWidth}×${innerHeight} @${devicePixelRatio}`,
        geolocation: 'geolocation' in navigator ? 'available' : 'MISSING',
        permission: 'unknown',
        lastFix: 'none yet',
        lastFetch: 'none yet',
        radarDot: 'sheet not opened yet',
        card: 'none yet',
      };
      const renderDiag = () => { $('diag').textContent = Object.entries(diag).map(([k, v]) => `${k}: ${v}`).join('\n'); };

      // Theme: paint by local hour immediately, correct from the feed later.
      const h = new Date().getHours();
      setTheme(h >= 7 && h < 19);

      try {
        (navigator as any).permissions?.query({ name: 'geolocation' }).then((p: any) => {
          diag.permission = p.state;
          p.onchange = () => { diag.permission = p.state; renderDiag(); };
          renderDiag();
        });
      } catch {}

      // Last known fix, so the first paint is already local.
      let fix: { lat: number; lon: number } | null = null;
      try { fix = JSON.parse(localStorage.getItem('g6:fix') || 'null'); } catch {}

      // fresh=true (the ↻ button) refuses a cached fix and waits a bit longer.
      const locate = (fresh = false) => new Promise<void>((resolve) => {
        if (!('geolocation' in navigator)) return resolve();
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            fix = { lat: pos.coords.latitude, lon: pos.coords.longitude };
            diag.lastFix = `${fix.lat.toFixed(4)}, ${fix.lon.toFixed(4)} ±${Math.round(pos.coords.accuracy)}m @${hhmm()}`;
            try { localStorage.setItem('g6:fix', JSON.stringify(fix)); } catch {}
            resolve();
          },
          (err) => { diag.lastFix = `error ${err.code}: ${err.message} @${hhmm()}`; resolve(); },
          { enableHighAccuracy: fresh, maximumAge: fresh ? 0 : 60_000, timeout: fresh ? 12_000 : 8000 }
        );
      });

      // ── the card ──────────────────────────────────────────────────────
      // Jokes and quotes come live from two free keyless archives
      // (icanhazdadjoke: ~700 clean dad jokes; DummyJSON: ~1,450 quotes).
      // Words, and anything when offline / slow, come from the local deck.
      // Never repeats one of the last 40 local cards or last 300 live ids.
      type Shown = { k: 'joke'; a: string; b: string } | { k: 'word'; w: string; p: string; d: string } | { k: 'quote'; q: string; by: string };
      const remember = (key: string, id: string | number, keep: number) => {
        let seen: (string | number)[] = [];
        try { seen = JSON.parse(localStorage.getItem(key) || '[]') || []; } catch {}
        const dup = seen.includes(id);
        seen = [...seen.filter((x) => x !== id), id].slice(-keep);
        try { localStorage.setItem(key, JSON.stringify(seen)); } catch {}
        return dup;
      };
      const fromDeck = (kind?: Shown['k']): Shown => {
        let seen: number[] = [];
        try { seen = JSON.parse(localStorage.getItem('g6:seen') || '[]') || []; } catch {}
        const all = DECK.map((_, i) => i).filter((i) => !kind || DECK[i].k === kind);
        const pool = all.filter((i) => !seen.includes(i));
        const from = pool.length ? pool : all;
        const i = from[Math.floor(Math.random() * from.length)];
        remember('g6:seen', i, 40);
        return DECK[i];
      };
      const fetchJSON = async (url: string, headers: Record<string, string>) => {
        const ctl = new AbortController();
        const t = window.setTimeout(() => ctl.abort(), 4000);
        signal.addEventListener('abort', () => ctl.abort(), { once: true });
        try {
          const r = await fetch(url, { headers, signal: ctl.signal, cache: 'no-store' });
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return await r.json();
        } finally { clearTimeout(t); }
      };
      const liveJoke = async (): Promise<Shown> => {
        for (let tries = 0; tries < 2; tries++) {
          const d = await fetchJSON('https://icanhazdadjoke.com/', { Accept: 'application/json' });
          const text = String(d?.joke || '').trim();
          if (!text || text.length > 220) continue;
          if (remember('g6:seenJokes', `j:${d.id}`, 300) && tries === 0) continue;
          // Most are "setup? punchline." — split at the first question mark.
          const m = text.match(/^(.*?\?)\s+(.*)$/s);
          return m ? { k: 'joke', a: m[1], b: m[2] } : { k: 'joke', a: text, b: '' };
        }
        throw new Error('no joke');
      };
      const liveQuote = async (): Promise<Shown> => {
        for (let tries = 0; tries < 2; tries++) {
          const d = await fetchJSON('https://dummyjson.com/quotes/random', { Accept: 'application/json' });
          let q = String(d?.quote || '').trim();
          if (!q || q.length > 150) continue;
          if (remember('g6:seenQuotes', `q:${d.id}`, 300) && tries === 0) continue;
          // Some entries are Title Cased ("Believe You Can And You'Re…").
          // If most words start with a capital, drop to sentence case.
          const words = q.split(/\s+/);
          const caps = words.filter((w) => /^[A-Z]/.test(w)).length;
          if (words.length >= 4 && caps / words.length > 0.7) {
            q = q.toLowerCase().replace(/(^|[.!?]\s+)([a-z])/g, (_, p, c) => p + c.toUpperCase()).replace(/\bi\b/g, 'I').replace(/\bi'(m|ve|ll|d)\b/g, "I'$1");
          }
          return { k: 'quote', q, by: String(d.author || 'unknown').replace(/\s*\(R\.A\)\s*$/i, '') };
        }
        throw new Error('no quote');
      };
      const show = (c: Shown, live: boolean) => {
        $('card').dataset.kind = c.k;
        $('card').dataset.live = String(live);
        if (c.k === 'joke') {
          $('cardKind').textContent = 'joke';
          $('cardBody').innerHTML = c.b ? `${esc(c.a)}<span class="punch">${esc(c.b)}</span>` : esc(c.a);
          $('cardBy').textContent = '';
        } else if (c.k === 'word') {
          $('cardKind').textContent = 'word';
          $('cardBody').innerHTML = `<span class="w">${esc(c.w)}</span><span class="pos">${esc(c.p)}</span> ${esc(c.d)}`;
          $('cardBy').textContent = '';
        } else {
          $('cardKind').textContent = 'quote';
          $('cardBody').textContent = `“${c.q}”`;
          $('cardBy').textContent = `— ${c.by}`;
        }
      };
      // One card per 15-minute slot of the clock (:00 :15 :30 :45), swapped
      // behind a 1.5s cross-fade. No buttons: the card is meant to feel
      // settled, not skippable (Mick, 1 Nov).
      const SLOT = 15 * 60_000;
      const slotOf = (t = Date.now()) => Math.floor(t / SLOT);
      let dealing = 0;
      let dealtSlot = -1;
      let cardTimer: number | undefined;
      const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
      const deal = async () => {
        const my = ++dealing;
        dealtSlot = slotOf();
        // Weighting: jokes 40%, quotes 35%, words 25%.
        const r = Math.random();
        const kind: Shown['k'] = r < 0.4 ? 'joke' : r < 0.75 ? 'quote' : 'word';
        let c: Shown;
        let live = false;
        if (kind === 'word') {
          c = fromDeck('word');
          diag.card = `word @${hhmm()}`;
        } else {
          try {
            c = await (kind === 'joke' ? liveJoke() : liveQuote());
            live = true;
            diag.card = `live ${kind} @${hhmm()}`;
          } catch (err) {
            if ((err as Error).name === 'AbortError' && signal.aborted) return;
            c = fromDeck(kind);
            diag.card = `local ${kind} @${hhmm()} (live failed: ${(err as Error).message})`;
          }
        }
        if (my !== dealing) return; // a newer deal won
        const card = $('card');
        if (card.dataset.kind && !reduce()) {
          card.classList.add('fading');
          await new Promise((r) => setTimeout(r, 1500));
          if (my !== dealing) return;
        }
        show(c, live);
        card.classList.remove('fading');
        renderDiag();
      };
      const scheduleCard = () => {
        if (cardTimer) clearTimeout(cardTimer);
        const next = (slotOf() + 1) * SLOT;
        cardTimer = window.setTimeout(async () => { await deal(); scheduleCard(); }, next - Date.now() + 250);
      };

      // ── forecast sheet rendering (from the same /api/g6 payload) ───────
      let last: any = null;
      const fsheet = $('fsheet');
      const shortWhen = (s: string) =>
        s.replace(/\s\d{1,2}\s[A-Za-z]{3}/g, '').replace(/\bMidday\b/g, 'midday').replace(/\s+to\s+/g, ' – ').trim();
      const range = (lo: any, hi: any, unit = '') =>
        typeof lo === 'number' && typeof hi === 'number' ? `${lo}–${hi}${unit}` : '--';
      // NEA forecast code / text → the same glyph set the hour strip uses.
      // Text is matched first (robust), the two-letter code as a backstop.
      const neaGlyph = (code: string | null, text: string | null, night: boolean) => {
        const c = String(code || '').toUpperCase();
        const t = String(text || '').toLowerCase();
        if (/^(TL|HT|HG)$/.test(c) || t.includes('thunder')) return '⚡︎';
        if (/^(HR|HS|RA|SR|WR|SK)$/.test(c) || /heavy|moderate rain/.test(t)) return '☔︎';
        if (/^(DR|LR|LS|PS|SH|WS)$/.test(c) || /shower|rain|drizzle/.test(t)) return '☂︎';
        if (/^(BR|FG|HZ|SL|MI)$/.test(c) || /haz|mist|fog/.test(t)) return '≡';
        if (/^(PC|PN)$/.test(c) || t.includes('partly')) return night ? '☁︎' : '⛅︎';
        if (/^(CL|OC|WC|WD)$/.test(c) || /cloud|overcast|windy/.test(t)) return '☁︎';
        if (/^(FA|FW|SU|WF|FN)$/.test(c) || /fair|sunny/.test(t)) return night || c === 'FN' || t.includes('night') ? '☾︎' : '☀︎';
        return '·';
      };
      // NEA's three periods always start at 06, 12 or 18 local.
      const periodName = (startIso: string | null) => {
        if (!startIso) return '';
        const s = new Date(startIso);
        const h = s.getHours();
        if (h >= 6 && h < 12) return 'morning';
        if (h >= 12 && h < 18) return 'afternoon';
        return s.toDateString() === new Date().toDateString() ? 'tonight' : 'night';
      };
      const tidy = (s: string | null) => String(s || '—').toLowerCase().replace(/\s*\((day|night)\)/, '');
      const renderForecast = () => {
        const d = last;
        if (!d) return;
        const g = d.day24;
        const now = Date.now();
        $('fc24Head').textContent = `next 24 hours${d.region ? ` · ${d.region}` : ''}`;
        $('fc24Glyph').textContent = g ? neaGlyph(g.code, g.text, !d.isDay) : '';
        $('fc24Text').textContent = g ? tidy(g.text) : 'not in yet — retries each minute';
        $('fc24Range').textContent = g ? range(g.tempLo, g.tempHi, '°') : '';
        $('fcPeriods').innerHTML = (g?.periods || []).map((p: any) => {
          const s = p.start ? new Date(p.start).getTime() : 0;
          const e = p.end ? new Date(p.end).getTime() : 0;
          const on = s && e && now >= s && now < e;
          const name = periodName(p.start);
          const night = name !== 'morning' && name !== 'afternoon';
          return `<li${on ? ' class="on"' : ''}>
            <span class="t-name">${name}</span>
            <span class="t-when">${esc(shortWhen(p.when))}</span>
            <span class="t-g" aria-hidden="true">${neaGlyph(p.code, p.text, night)}</span>
            <span class="t-text">${esc(tidy(p.text))}</span>
          </li>`;
        }).join('');
        const dir = String(g?.windDir || '');
        $('fcChips').innerHTML = g
          ? `<div><dt>humidity</dt><dd>${range(g.humLo, g.humHi, '%')}</dd></div>
             <div><dt>wind</dt><dd>${esc(dir.length > 3 ? dir.toLowerCase() : dir)} ${range(g.windLo, g.windHi)} km/h</dd></div>
             <div><dt>issued</dt><dd>${g.updated ? hhmm(new Date(g.updated)) : '--'}</dd></div>`
          : '';
        $('fcDays').innerHTML = (d.days || []).map((x: any) =>
          `<li><span class="d-day">${esc(String(x.day || '').slice(0, 3))}</span><span class="d-g" aria-hidden="true">${neaGlyph(x.code, x.summary || x.text, false)}</span><span class="d-text">${esc(tidy(x.summary || x.text))}</span><span class="d-t">${range(x.lo, x.hi, '°')}</span></li>`).join('');
        $('fcTs').textContent = g?.valid ? `to ${String(g.valid).split(' to ')[1] || ''}`.toLowerCase() : '';
      };

      // Radar: newest 5-minute slot, published ~5 min behind the clock.
      // Try now−5, then step back 5 min at a time if the file isn't there yet.
      const radarImg = $('radarImg') as HTMLImageElement;
      const slot = (minutesBack: number) => {
        const ms = Date.now() + 8 * 3600e3 - minutesBack * 60e3; // SGT = UTC+8, no DST
        const t = new Date(ms - (ms % 300e3));
        const p = (n: number) => String(n).padStart(2, '0');
        return {
          stamp: `${t.getUTCFullYear()}${p(t.getUTCMonth() + 1)}${p(t.getUTCDate())}${p(t.getUTCHours())}${p(t.getUTCMinutes())}`,
          label: `${p(t.getUTCHours())}:${p(t.getUTCMinutes())}`,
        };
      };
      const loadRadar = (attempt = 0) => {
        if (attempt > 5) { $('radarTs').textContent = 'unavailable'; return; }
        const s = slot(5 + attempt * 5);
        const probe = new Image();
        probe.onload = () => { radarImg.src = probe.src; $('radarTs').textContent = s.label; };
        probe.onerror = () => loadRadar(attempt + 1);
        probe.src = `${RADAR}${s.stamp}0000dBR.dpsri.png`;
      };
      const placeYou = () => {
        const you = $('radarYou');
        const note = $('radarNote');
        if (!fix) {
          you.setAttribute('hidden', '');
          note.textContent = ' · no gps fix yet, so no car marker';
          diag.radarDot = 'hidden: no fix';
          return;
        }
        const x = (fix.lon - RADAR_BOUNDS.left) / (RADAR_BOUNDS.right - RADAR_BOUNDS.left);
        const y = (RADAR_BOUNDS.top - fix.lat) / (RADAR_BOUNDS.top - RADAR_BOUNDS.bottom);
        if (x < 0 || x > 1 || y < 0 || y > 1) {
          you.setAttribute('hidden', '');
          note.textContent = ' · car is off this map';
          diag.radarDot = `hidden: outside map (${fix.lat.toFixed(3)}, ${fix.lon.toFixed(3)})`;
          return;
        }
        you.style.left = `${(x * 100).toFixed(2)}%`;
        you.style.top = `${(y * 100).toFixed(2)}%`;
        you.removeAttribute('hidden');
        note.textContent = '';
        diag.radarDot = `at ${(x * 100).toFixed(0)}%, ${(y * 100).toFixed(0)}% of the map`;
        renderDiag();
      };

      const paint = (d: any) => {
        last = d;
        $('area').textContent = d.area || 'Singapore';
        $('locdot').dataset.src = d.locSource;
        $('forecast').textContent = d.forecast || '';
        $('temp').textContent = fmt(d.tempC);
        $('feels').textContent = fmt(d.feelsC);
        $('hum').textContent = fmt(d.humidity);
        $('psi').textContent = fmt(d.psi);
        $('psiband').textContent = d.psiBand || '';
        $('air').dataset.band = d.psiBand || '';
        $('pm25').textContent = fmt(d.pm25);
        $('pm25band').textContent = d.pm25Band || '';
        $('region').textContent = d.region ? `${d.region} region` : '';
        const hours: any[] = Array.isArray(d.hours) ? d.hours : [];
        $('hours').innerHTML = hours.map((h, i) => {
          const t = new Date(h.t);
          const hh = t.toLocaleTimeString('en-SG', { hour: '2-digit', hour12: false }).replace(/^24/, '00');
          const wet = typeof h.pop === 'number' && h.pop >= 40;
          return `<li${i === 0 ? ' class="now-ish"' : ''}>
            <span class="h-t">${hh}</span>
            <span class="h-g" aria-hidden="true">${glyph(h.code, !!h.day)}</span>
            <span class="h-c">${fmt(h.temp)}°</span>
            <span class="h-p${wet ? ' wet' : ''}">${typeof h.pop === 'number' ? h.pop + '%' : ''}</span>
          </li>`;
        }).join('');
        setTheme(!!d.isDay);
        const src = d.locSource === 'gps' ? 'car gps' : d.locSource === 'ip' ? 'rough fix (no gps)' : 'no location — showing central';
        const flag = d.source === 'stub' ? ' · OFFLINE STUB' : d.stale ? ' · nea slow, showing last' : '';
        $('status').textContent = `${src} · updated ${hhmm()}${flag}`;
        if (!fsheet.hasAttribute('hidden')) { renderForecast(); placeYou(); }
      };

      const refresh = async (fresh = false) => {
        await locate(fresh);
        const q = fix ? `?lat=${fix.lat.toFixed(4)}&lon=${fix.lon.toFixed(4)}` : '';
        try {
          const res = await fetch(`/api/g6${q}`, { signal, cache: 'no-store' });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const d = await res.json();
          diag.lastFetch = `ok @${hhmm()} (${d.source}, ${d.locSource})`;
          paint(d);
        } catch (err) {
          if ((err as Error).name === 'AbortError') return;
          diag.lastFetch = `failed @${hhmm()}: ${(err as Error).message}`;
          $('status').textContent = `offline · ${$('status').textContent}`.slice(0, 80);
        }
        renderDiag();
      };
      const startTick = () => {
        if (tick) clearInterval(tick);
        tick = window.setInterval(() => refresh(), 60_000);
      };

      renderDiag();
      deal();
      scheduleCard();
      refresh();
      startTick();
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) return;
        refresh();
        // Timers crawl while the tab is hidden; catch up on a missed slot.
        if (slotOf() !== dealtSlot) { deal(); scheduleCard(); }
      }, { signal });

      // ↻ on the main page: new GPS fix + fresh data. Leaves the card alone.
      const refreshAll = $('refreshAll');
      refreshAll.addEventListener('click', async () => {
        if (refreshAll.classList.contains('busy')) return;
        refreshAll.classList.add('busy');
        $('status').textContent = 'refreshing — getting a new gps fix…';
        await refresh(true);
        startTick();
        window.setTimeout(() => refreshAll.classList.remove('busy'), 350);
      }, { signal });

      $('diagToggle').addEventListener('click', () => {
        const el = $('diag');
        const open = el.hasAttribute('hidden');
        el.toggleAttribute('hidden', !open);
        $('diagToggle').setAttribute('aria-expanded', String(open));
      }, { signal });

      // ── forecast sheet open/close ────────────────────────────────────
      const refreshFc = $('refreshFc');
      const openForecast = () => {
        fsheet.removeAttribute('hidden');
        fsheet.scrollTop = 0;
        renderForecast();
        placeYou();
        loadRadar();
        if (radarTick) clearInterval(radarTick);
        radarTick = window.setInterval(() => loadRadar(), 5 * 60_000);
        $('closeForecast').focus();
      };
      const closeForecast = () => {
        fsheet.setAttribute('hidden', '');
        if (radarTick) clearInterval(radarTick);
        radarTick = undefined;
        $('openForecast').focus();
      };
      $('openForecast').addEventListener('click', openForecast, { signal });
      $('closeForecast').addEventListener('click', closeForecast, { signal });
      refreshFc.addEventListener('click', async () => {
        if (refreshFc.classList.contains('busy')) return;
        refreshFc.classList.add('busy');
        loadRadar();
        await refresh();
        renderForecast();
        window.setTimeout(() => refreshFc.classList.remove('busy'), 350);
      }, { signal });

      // ── checkpoint cams sheet ────────────────────────────────────────
      const sheet = $('sheet');
      const cams = $('cams');
      const refreshBtn = $('refreshCams');
      let lastSeen: Record<string, { image: string; ts: string }> = {};
      try { lastSeen = JSON.parse(localStorage.getItem('g6:cams') || '{}') || {}; } catch {}
      // "21:30" if today, "yesterday 21:30" / "28 Oct 21:30" if older.
      const when = (iso: string) => {
        const t = new Date(iso);
        const now = new Date();
        const sameDay = t.toDateString() === now.toDateString();
        if (sameDay) return hhmm(t);
        const y = new Date(now); y.setDate(now.getDate() - 1);
        if (t.toDateString() === y.toDateString()) return `yesterday ${hhmm(t)}`;
        return `${t.toLocaleDateString('en-SG', { day: 'numeric', month: 'short' })} ${hhmm(t)}`;
      };
      const loadCams = async () => {
        cams.classList.add('busy');
        refreshBtn.classList.add('busy');
        try {
          const res = await fetch('https://api.data.gov.sg/v1/transport/traffic-images', { signal, cache: 'no-store' });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const d = await res.json();
          const list: any[] = d.items?.[0]?.cameras || [];
          const byId = new Map(list.map((c) => [String(c.camera_id), c]));
          // LTA drops cameras from the list when they stall. Remember the
          // last frame each one gave us so a dropped camera still shows
          // something useful, clearly labelled with how old it is.
          for (const [id] of CAMS) {
            const c = byId.get(id);
            if (c?.image) lastSeen[id] = { image: c.image, ts: c.timestamp };
          }
          try { localStorage.setItem('g6:cams', JSON.stringify(lastSeen)); } catch {}
          cams.innerHTML = CAMS.map(([id, label]) => {
            const c = byId.get(id);
            if (c) {
              return `<figure class="cam"><img src="${c.image}" alt="${label}" loading="lazy" decoding="async"><figcaption><b>${label}</b> · ${hhmm(new Date(c.timestamp))}</figcaption></figure>`;
            }
            const old = lastSeen[id];
            if (!old) return `<figure class="cam cam-off"><figcaption><b>${label}</b> · camera offline, no photo yet</figcaption></figure>`;
            return `<figure class="cam cam-off"><img src="${old.image}" alt="${label}, older photo" loading="lazy" decoding="async"><figcaption><b>${label}</b> · offline · last seen ${when(old.ts)}</figcaption></figure>`;
          }).join('');
          $('camTs').textContent = hhmm();
        } catch (err) {
          if ((err as Error).name === 'AbortError') return;
          cams.innerHTML = `<p>cameras unavailable right now — <a href="https://www.checkpoint.sg/" target="_blank" rel="noopener">checkpoint.sg</a></p>`;
        } finally {
          // Hold the dim for a beat so a fast refresh still visibly happened.
          window.setTimeout(() => { cams.classList.remove('busy'); refreshBtn.classList.remove('busy'); }, 350);
        }
      };
      const startCamTick = () => {
        if (camTick) clearInterval(camTick);
        camTick = window.setInterval(loadCams, 60_000);
      };
      const openSheet = () => {
        sheet.removeAttribute('hidden');
        sheet.scrollTop = 0;
        loadCams();
        startCamTick();
        $('closeCauseway').focus();
      };
      const closeSheet = () => {
        sheet.setAttribute('hidden', '');
        if (camTick) clearInterval(camTick);
        camTick = undefined;
        cams.innerHTML = '';
        $('openCauseway').focus();
      };
      $('openCauseway').addEventListener('click', openSheet, { signal });
      $('closeCauseway').addEventListener('click', closeSheet, { signal });
      refreshBtn.addEventListener('click', () => { loadCams(); startCamTick(); }, { signal });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (!sheet.hasAttribute('hidden')) closeSheet();
        if (!fsheet.hasAttribute('hidden')) closeForecast();
      }, { signal });
      // bfcache can restore the page with a sheet open and timers dead.
      window.addEventListener('pageshow', (e) => {
        if ((e as PageTransitionEvent).persisted) { closeSheet(); closeForecast(); startTick(); scheduleCard(); }
      }, { signal });
      signal.addEventListener('abort', () => { if (cardTimer) clearTimeout(cardTimer); }, { once: true });
    };

    const teardown = () => {
      if (tick) clearInterval(tick);
      if (camTick) clearInterval(camTick);
      if (radarTick) clearInterval(radarTick);
      tick = camTick = radarTick = undefined;
      abort?.abort();
    };

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', teardown);
  </script>
</Layout>
