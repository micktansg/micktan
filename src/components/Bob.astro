---
// Bob — resident troll, involuntary docent. Site-wide summonable chat overlay.
// Rendered by Layout on every page EXCEPT the VOID homepage (the void stays
// one lonely word; also Bob is not allowed in there. it's a whole thing).
//
// Styled in the site-chrome palette (dark warm-grey + cream) so he reads as
// part of the building, not of any one room. Conversation lives in
// sessionStorage only — follows the visitor across rooms, gone when the tab
// closes. Backend: /api/docent (rate-limited, page-aware).
---

<div class="bob-root" id="bobRoot">
  <button
    class="bob-summon"
    id="bobSummon"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="bobPanel"
  >bob.</button>

  <section class="bob-panel" id="bobPanel" role="dialog" aria-label="bob — resident troll" hidden>
    <header class="bob-head">
      <div class="bob-title">
        <p class="bob-name">bob.</p>
        <p class="bob-sub">resident troll. involuntary docent.</p>
      </div>
      <button class="bob-close" id="bobClose" type="button" aria-label="dismiss bob">&times;</button>
    </header>
    <div class="bob-log" id="bobLog" aria-live="polite"></div>
    <form class="bob-form" id="bobForm">
      <input
        id="bobInput"
        type="text"
        maxlength="500"
        placeholder="bother the troll…"
        autocomplete="off"
        aria-label="message to bob"
      />
      <button type="submit" id="bobSend" class="bob-send">poke</button>
    </form>
  </section>
</div>

<style>
  .bob-root {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 8000; /* below the exit veils (9999) — veils cover bob on the way out */
    font-family: 'Lora', Georgia, serif;
  }

  /* MOS's full-width tap pads own the bottom of the screen — a player
     mashing R would summon a troll mid-silly-walk. Bob perches above them. */
  :global(html:has(main.mos)) .bob-root { bottom: 8rem; }

  .bob-summon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.55rem 1rem;
    border: 1px solid rgba(240, 236, 228, 0.25);
    border-radius: 999px;
    background: rgba(42, 42, 39, 0.82);
    color: #f0ece4;
    font-family: inherit;
    font-style: italic;
    font-size: 0.9rem;
    cursor: pointer;
    opacity: 0.55;
    backdrop-filter: blur(4px);
    transition: opacity 200ms, transform 200ms;
  }
  .bob-summon:hover { opacity: 1; transform: translateY(-1px); }
  .bob-summon:focus-visible {
    outline: 2px dashed #f0ece4;
    outline-offset: 3px;
    opacity: 1;
  }
  .bob-summon[aria-expanded="true"] { display: none; }

  .bob-panel {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(30rem, calc(100vh - 2rem));
    display: flex;
    flex-direction: column;
    background: #2a2a27;
    color: #f0ece4;
    border: 1px solid rgba(240, 236, 228, 0.18);
    border-radius: 14px;
    box-shadow: 0 18px 50px rgba(10, 10, 8, 0.45);
    overflow: hidden;
    animation: bob-rise 240ms cubic-bezier(.2,.8,.2,1);
  }

  @keyframes bob-rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .bob-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem 0.7rem;
    border-bottom: 1px solid rgba(240, 236, 228, 0.12);
  }
  .bob-name {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.1;
  }
  .bob-sub {
    font-size: 0.72rem;
    font-style: italic;
    opacity: 0.5;
    margin-top: 0.15rem;
  }
  .bob-close {
    min-width: 44px;
    min-height: 44px;
    border: none;
    background: transparent;
    color: #f0ece4;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.5;
    border-radius: 8px;
    transition: opacity 150ms;
  }
  .bob-close:hover { opacity: 1; }
  .bob-close:focus-visible { outline: 2px dashed #f0ece4; outline-offset: 2px; opacity: 1; }

  .bob-log {
    flex: 1;
    overflow-y: auto;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 8rem;
    scrollbar-width: thin;
  }

  /* Messages are created from JS — global within the component's reach. */
  :global(.bob-msg) {
    max-width: 88%;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    font-size: 0.88rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  :global(.bob-msg.from-bob) {
    align-self: flex-start;
    background: rgba(240, 236, 228, 0.08);
    border: 1px solid rgba(240, 236, 228, 0.1);
  }
  :global(.bob-msg.from-user) {
    align-self: flex-end;
    background: rgba(138, 154, 107, 0.18);
    border: 1px solid rgba(138, 154, 107, 0.25);
  }
  :global(.bob-msg.bob-thinking) {
    font-style: italic;
    opacity: 0.55;
  }

  .bob-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.7rem;
    border-top: 1px solid rgba(240, 236, 228, 0.12);
  }
  .bob-form input {
    flex: 1;
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(240, 236, 228, 0.2);
    border-radius: 10px;
    background: rgba(240, 236, 228, 0.06);
    color: #f0ece4;
    font-family: inherit;
    font-size: 16px; /* prevents iOS zoom */
  }
  .bob-form input::placeholder { color: rgba(240, 236, 228, 0.4); font-style: italic; }
  .bob-form input:focus-visible { outline: 2px dashed rgba(240, 236, 228, 0.6); outline-offset: 2px; }
  .bob-send {
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border: 1px solid rgba(240, 236, 228, 0.25);
    border-radius: 10px;
    background: rgba(240, 236, 228, 0.1);
    color: #f0ece4;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 150ms;
  }
  .bob-send:hover:not(:disabled) { background: rgba(240, 236, 228, 0.2); }
  .bob-send:disabled { opacity: 0.4; cursor: default; }
  .bob-send:focus-visible { outline: 2px dashed #f0ece4; outline-offset: 2px; }

  @media (max-width: 480px) {
    .bob-panel {
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      max-height: 72vh;
      border-radius: 14px 14px 0 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bob-panel { animation: none; }
    .bob-summon { transition: opacity 150ms; }
    .bob-summon:hover { transform: none; }
  }
</style>

<script>
  // Standard site lifecycle: init on astro:page-load, AbortController for
  // listeners. Conversation persists in sessionStorage across the full-page
  // navigations the rooms use, so bob follows visitors around the building.
  let bobAbort: AbortController | null = null;

  const CONVO_KEY = 'bob.convo.v1';
  const GREETS = [
    'what. i was napping.',
    'oh. a visitor. fine.',
    'you rang. regrettably.',
    'yes? the exhibits are that way. or ask.',
  ];

  type Msg = { role: 'user' | 'bob'; text: string };

  const loadConvo = (): Msg[] => {
    try {
      const raw = sessionStorage.getItem(CONVO_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      if (!Array.isArray(parsed)) return [];
      return parsed
        .filter((m: any) => m && typeof m.text === 'string')
        .map((m: any) => ({ role: m.role === 'bob' ? 'bob' as const : 'user' as const, text: String(m.text).slice(0, 600) }))
        .slice(-40);
    } catch { return []; }
  };

  const saveConvo = (convo: Msg[]) => {
    try { sessionStorage.setItem(CONVO_KEY, JSON.stringify(convo.slice(-40))); } catch {}
  };

  const initBob = () => {
    const root = document.getElementById('bobRoot');
    if (!root) return; // page without bob (the void)

    bobAbort?.abort();
    bobAbort = new AbortController();
    const { signal } = bobAbort;

    const summon = document.getElementById('bobSummon') as HTMLButtonElement;
    const panel = document.getElementById('bobPanel') as HTMLElement;
    const closeBtn = document.getElementById('bobClose') as HTMLButtonElement;
    const log = document.getElementById('bobLog') as HTMLElement;
    const form = document.getElementById('bobForm') as HTMLFormElement;
    const input = document.getElementById('bobInput') as HTMLInputElement;
    const send = document.getElementById('bobSend') as HTMLButtonElement;
    if (!summon || !panel || !log || !form || !input || !send) return;

    let convo: Msg[] = loadConvo();
    let pending = false;

    const addBubble = (msg: Msg, extraClass = '') => {
      const el = document.createElement('p');
      el.className = `bob-msg from-${msg.role}${extraClass ? ' ' + extraClass : ''}`;
      el.textContent = msg.text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };

    const renderConvo = () => {
      log.textContent = '';
      convo.forEach((m) => addBubble(m));
    };

    // On touch devices, focusing the input summons the on-screen keyboard —
    // doing that on open buried the panel before anyone read the greeting.
    // There, let the visitor tap the input themselves.
    const coarsePointer = matchMedia('(pointer: coarse)').matches;

    const openPanel = () => {
      if (convo.length === 0) {
        convo.push({ role: 'bob', text: GREETS[Math.floor(Math.random() * GREETS.length)] });
        saveConvo(convo);
      }
      renderConvo();
      panel.hidden = false;
      summon.setAttribute('aria-expanded', 'true');
      if (!coarsePointer) input.focus();
      adjustForKeyboard();
    };

    const closePanel = () => {
      panel.hidden = true;
      panel.style.bottom = '';
      panel.style.maxHeight = '';
      summon.setAttribute('aria-expanded', 'false');
      summon.focus();
    };

    // Keep the panel above the on-screen keyboard. Mobile keyboards shrink
    // the VISUAL viewport but not the layout viewport, so position:fixed
    // elements stay put — hidden behind the keys. Ride the visual viewport:
    // lift the panel by the keyboard's height and cap it to what remains.
    const vv = window.visualViewport;
    const adjustForKeyboard = () => {
      if (!vv || panel.hidden) return;
      const kb = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
      if (kb > 0) {
        panel.style.bottom = `${kb}px`;
        panel.style.maxHeight = `${Math.round(vv.height * 0.94)}px`;
      } else {
        panel.style.bottom = '';
        panel.style.maxHeight = '';
      }
      log.scrollTop = log.scrollHeight;
    };
    vv?.addEventListener('resize', adjustForKeyboard, { signal });
    vv?.addEventListener('scroll', adjustForKeyboard, { signal });

    summon.addEventListener('click', openPanel, { signal });
    closeBtn.addEventListener('click', closePanel, { signal });

    // Explicit Enter→submit. Implicit form submission covers this in normal
    // browsers, but rooms with their own document-level key handlers (MOS)
    // shouldn't get a say in whether bob hears you.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      } else if (e.key === 'Escape') {
        closePanel();
      }
      e.stopPropagation(); // typing at bob is not gameplay input
    }, { signal });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { closePanel(); return; }
      // "b" summons bob — but never while typing somewhere, mid-shortcut,
      // or over another interactive control.
      if (e.key === 'b' && panel.hidden && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const t = e.target as HTMLElement;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
        openPanel();
      }
    }, { signal });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim().slice(0, 500);
      if (!text || pending) return;

      convo.push({ role: 'user', text });
      saveConvo(convo);
      addBubble({ role: 'user', text });
      input.value = '';

      pending = true;
      send.disabled = true;
      const thinking = addBubble({ role: 'bob', text: 'bob is grumbling…' }, 'bob-thinking');

      try {
        const r = await fetch('/api/docent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: text,
            path: location.pathname,
            history: convo.slice(-13, -1), // context minus the message itself
          }),
          signal: AbortSignal.timeout(25_000),
        });
        thinking.remove();
        let reply: string;
        if (r.ok) {
          const data = await r.json();
          reply = String(data?.reply || 'hm. lost my train of thought. it happens after the first few centuries.').slice(0, 1200);
        } else if (r.status === 429) {
          const data = await r.json().catch(() => ({}));
          reply = String((data as any)?.error || 'bob is ignoring you. try again in a bit.');
        } else {
          reply = 'something rattled in the walls. say that again.';
        }
        convo.push({ role: 'bob', text: reply });
        saveConvo(convo);
        addBubble({ role: 'bob', text: reply });
      } catch {
        thinking.remove();
        const reply = 'the connection to the underside dropped. not my fault. probably. say that again.';
        convo.push({ role: 'bob', text: reply });
        saveConvo(convo);
        addBubble({ role: 'bob', text: reply });
      } finally {
        pending = false;
        send.disabled = false;
        input.focus();
      }
    }, { signal });
  };

  document.addEventListener('astro:page-load', initBob);
</script>
